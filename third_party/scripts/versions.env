# Pinned native dependency inputs. Source this file; do not execute it directly.
NDK_VERSION=r27c
NDK_URL=https://dl.google.com/android/repository/android-ndk-r27c-linux.zip
# Google publishes the r27c Linux archive checksum as SHA-1.
NDK_SHA1=090e8083a715fdb1a3e402d0763c388abb03fb4e

JELLYFIN_FFMPEG_VERSION=v7.1.4-3
JELLYFIN_FFMPEG_URL=https://github.com/jellyfin/jellyfin-ffmpeg.git
JELLYFIN_FFMPEG_COMMIT=d4590e12452f94d40e413caecb34b08de608353b

LIBARIBCAPTION_VERSION=v1.1.1
LIBARIBCAPTION_URL=https://github.com/xqq/libaribcaption.git
LIBARIBCAPTION_COMMIT=0a3a209d3f0b3650b92941248b9701bf69584a1f

# Cloned from the GitHub mirror; savannah.gnu.org intermittently 502s.
# Integrity is enforced by the pinned commit hash.
FREETYPE_VERSION=2.13.3
FREETYPE_URL=https://github.com/freetype/freetype.git
FREETYPE_TAG=VER-2-13-3
FREETYPE_COMMIT=42608f77f20749dd6ddc9e0536788eaad70ea4b5

OPENCL_HEADERS_VERSION=v2024.10.24
OPENCL_HEADERS_URL=https://github.com/KhronosGroup/OpenCL-Headers.git
OPENCL_HEADERS_COMMIT=4ea6df132107e3b4b9407f903204b5522fdffcd6

ANDROID_API=26
# ARIB_ABI selects the native target. Retain ANDROID_ABI as a fallback for
# callers that already export it, and keep arm64-v8a as the local default.
ANDROID_ABI="${ARIB_ABI:-${ANDROID_ABI:-arm64-v8a}}"

case "$ANDROID_ABI" in
    arm64-v8a)
        TARGET_TRIPLE=aarch64-linux-android
        NDK_LIBCXX_TRIPLE=aarch64-linux-android
        FFMPEG_ARCH=aarch64
        FFMPEG_CPU=armv8-a
        FFMPEG_ENABLE_NEON=1
        FFMPEG_ENABLE_THUMB=0
        ;;
    x86_64)
        TARGET_TRIPLE=x86_64-linux-android
        NDK_LIBCXX_TRIPLE=x86_64-linux-android
        FFMPEG_ARCH=x86_64
        FFMPEG_CPU=generic
        FFMPEG_ENABLE_NEON=0
        FFMPEG_ENABLE_THUMB=0
        ;;
    armeabi-v7a)
        TARGET_TRIPLE=armv7a-linux-androideabi
        NDK_LIBCXX_TRIPLE=arm-linux-androideabi
        FFMPEG_ARCH=arm
        FFMPEG_CPU=armv7-a
        FFMPEG_ENABLE_NEON=1
        FFMPEG_ENABLE_THUMB=1
        ;;
    *)
        printf 'Unsupported Android ABI: %s\n' "$ANDROID_ABI" >&2
        return 1 2>/dev/null || exit 1
        ;;
esac

THIRD_PARTY_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Keep every generated build tree, source checkout, and NDK isolated by ABI.
BUILD_ROOT="${ARIB_BUILD_DIR:-$THIRD_PARTY_DIR/build}"
BUILD_DIR="$BUILD_ROOT/$ANDROID_ABI"
SOURCE_DIR="$BUILD_DIR/src"
INSTALL_PREFIX="$BUILD_DIR/sysroot"
SYSROOT_OUTPUT_DIR="$THIRD_PARTY_DIR/prebuilt/sysroot-$ANDROID_ABI"
