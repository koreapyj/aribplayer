<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="true"
        android:label="ARIB Player"
        android:supportsRtl="true"
        android:theme="@style/Theme.ARIBPlayer">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" android:mimeType="video/mp2t" />
                <data android:scheme="content" android:mimeType="video/mp2ts" />
                <data android:scheme="content" android:mimeType="video/vnd.dlna.mpeg-tts" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
                <data android:scheme="file" android:mimeType="video/mp2t" />
                <data android:scheme="file" android:mimeType="video/mp2ts" />
                <data android:scheme="file" android:mimeType="video/vnd.dlna.mpeg-tts" />
                <data android:scheme="file" android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- Extension match for providers that report no useful MIME type. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.ts" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.m2ts" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.mts" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.ts" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.m2ts" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.mts" />
            </intent-filter>
        </activity>

        <!-- Vendor OpenCL driver for hardware IVTC/deinterlace. Required for
             targetSdk 31+: undeclared vendor libs are invisible to dlopen even
             when listed in public.libraries.txt. -->
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
    </application>
</manifest>
