++struct DirectWriteFileFontCollectionState {
++    explicit DirectWriteFileFontCollectionState(IDWriteFactory *factory)
++        : factory_(factory) {}
++
++    ~DirectWriteFileFontCollectionState()
++    {
++        for (auto &entry : collections_)
++            entry.second.Reset();
++
++        if (loader_registered_) {
++            HRESULT hr = factory_->UnregisterFontCollectionLoader(loader_.Get());
++            assert(SUCCEEDED(hr));
++            loader_registered_ = false;
++        }
++
++        // DirectWrite's registration reference is gone before our owning reference.
++        loader_.Reset();
++        collections_.clear();
++    }
++
++    HRESULT GetCollection(const std::wstring &path,
++                          ComPtr<IDWriteFontCollection> &collection)
++    {
++        std::lock_guard<std::mutex> lock(mutex_);
++
++        auto it = collections_.find(path);
++        if (it != collections_.end() && it->second) {
++            collection = it->second;
++            return S_OK;
++        }
++
++        const size_t max_chars =
++            std::numeric_limits<UINT32>::max() / sizeof(wchar_t);
++        if (path.size() >= max_chars)
++            return E_INVALIDARG;
++
++        if (!loader_) {
++            auto *loader = new (std::nothrow) FontFileCollectionLoader();
++            if (!loader)
++                return E_OUTOFMEMORY;
++            loader_.Attach(loader);
++        }
++
++        if (!loader_registered_) {
++            HRESULT hr = factory_->RegisterFontCollectionLoader(loader_.Get());
++            if (FAILED(hr))
++                return hr;
++            loader_registered_ = true;
++        }
++
++        if (it == collections_.end())
++            it = collections_.emplace(path, ComPtr<IDWriteFontCollection>()).first;
++
++        const UINT32 key_size =
++            static_cast<UINT32>((it->first.size() + 1) * sizeof(wchar_t));
++        ComPtr<IDWriteFontCollection> created_collection;
++        HRESULT hr = factory_->CreateCustomFontCollection(
++            loader_.Get(), it->first.c_str(), key_size, &created_collection);
++        if (FAILED(hr) || !created_collection)
++            return FAILED(hr) ? hr : E_FAIL;
++
++        it->second = created_collection;
++        collection = std::move(created_collection);
++        return S_OK;
++    }
++
++private:
++    // Borrowed from FontProviderDirectWrite; that provider destroys this state first.
++    IDWriteFactory *factory_ = nullptr;
++    ComPtr<IDWriteFontCollectionLoader> loader_;
++    bool loader_registered_ = false;
++    std::mutex mutex_;
++    // Map nodes are stable, and their key buffers live until after unregistration.
++    std::map<std::wstring, ComPtr<IDWriteFontCollection>> collections_;
++};
