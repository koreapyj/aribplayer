+static int ffp_post_sync(FFPlayer *ffp, FFPCmd *c)
+{
+    c->result = FFP_EINVAL;
+    if (!(c->done = SDL_CreateSemaphore(0)))
+        return AVERROR(ENOMEM);
+    ffp_post(ffp, c);
+    SDL_SemWait(c->done);
+    SDL_DestroySemaphore(c->done);
+    return c->result;
+}
