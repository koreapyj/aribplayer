+                                            ffp_subtitle_duration_ms(&sub));
+            avsubtitle_free(&sub);
+            if (ret < 0)
+                goto end;
+            continue;
+        }
+        for (r = 0; r < sub.num_rects; r++)
+            if (sub.rects[r])
+                bitmap_bytes += (int64_t)sub.rects[r]->linesize[0] * sub.rects[r]->h + AVPALETTE_SIZE;
+        if (sub.format != 0 || bitmap_bytes > FFP_SUB_MAX_BITMAP_BYTES) {
+            capped |= bitmap_bytes > FFP_SUB_MAX_BITMAP_BYTES;
+            avsubtitle_free(&sub);
+            continue;
+        }
+        if ((ret = ffp_ext_add_cue(x, &sub)) < 0) {
+            avsubtitle_free(&sub);
+            goto end;
+        }
+        x->width = avctx->width;
+        x->height = avctx->height;
+    }
+    if (ret != AVERROR_EOF)
+        av_log(NULL, AV_LOG_WARNING, "%s: subtitle read stopped early: %s\n", path, av_err2str(ret));
+    if (capped)
+        av_log(NULL, AV_LOG_WARNING, "%s: bitmap subtitles beyond %d MiB dropped\n", path, FFP_SUB_MAX_BITMAP_BYTES >> 20);
+    for (i = 0; i < nb; i++)
+        if (tracks[i]->kind == FFP_LAYER_BITMAP)
+            ffp_ext_finish_cues(tracks[i]);
+    *out = tracks;
+    *nb_out = nb;
+    tracks = NULL;
+    ret = 0;
+end:
+    for (i = 0; tracks && i < nb; i++)
+        ffp_ext_track_free(&tracks[i]);
+    av_free(tracks);
+    for (i = 0; dec && i < ic->nb_streams; i++)
+        avcodec_free_context(&dec[i]);
+    av_free(dec);
+    av_free(slot);
+    av_packet_free(&pkt);
+    avformat_close_input(&ic);
+    return ret;
+}
+
+FFP_API int FFP_CALL ffp_add_subtitle_file(FFPlayer *ffp, const char *path_utf8)
+{
+    FFPExtTrack **tracks;
+    FFPCmd c;
+    int nb, ret, i;
+
+    if (!ffp || !path_utf8 || !*path_utf8)
+        return FFP_EINVAL;
+    if ((ret = ffp_ext_load(path_utf8, &tracks, &nb)) < 0) {
+        av_log(NULL, AV_LOG_ERROR, "%s: %s\n", path_utf8, av_err2str(ret));
+        return ret;
+    }
+    memset(&c, 0, sizeof(c));
+    c.type = FFP_CMD_ADD_SUBTITLE;
+    c.p = tracks;
+    c.i = nb;
+    ret = ffp_post_sync(ffp, &c);
+    if (c.p) {
+        for (i = 0; i < nb; i++)
+            ffp_ext_track_free(&tracks[i]);
+        av_free(tracks);
+    }
+    return ret;
+}
+
+FFP_API int FFP_CALL ffp_set_subtitle_style(FFPlayer *ffp, const FFPSubtitleStyle *style)
+{
+    if (!ffp || !style || style->struct_size != sizeof(*style))
+        return FFP_EINVAL;
+    SDL_LockMutex(ffp->mutex);
+    ffp->sub_style = *style;
+    ffp->sub_style.font_family[sizeof(ffp->sub_style.font_family) - 1] = 0;
+    if (!++ffp->sub_style_gen)
+        ffp->sub_style_gen = 1;
+    SDL_UnlockMutex(ffp->mutex);
+    return ffp_post_simple(ffp, FFP_CMD_SUB_REFRESH, 0, 0);
+}
+
+FFP_API int FFP_CALL ffp_set_subtitle_delay(FFPlayer *ffp, int64_t delay_ms)
+{
+    if (!ffp)
+        return FFP_EINVAL;
+    SDL_AtomicSet(&ffp->sub_delay_ms, (int)av_clip64(delay_ms, -(INT_MAX / 2), INT_MAX / 2));
+    return ffp_post_simple(ffp, FFP_CMD_SUB_REFRESH, 0, 0);
+}
+
+FFP_API int64_t FFP_CALL ffp_get_subtitle_delay(FFPlayer *ffp)
+{
+    return ffp ? SDL_AtomicGet(&ffp->sub_delay_ms) : 0;
+}
