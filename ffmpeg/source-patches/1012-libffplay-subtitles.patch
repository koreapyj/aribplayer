+/* the subtitle canvas (the ARIB canvas at an open, the libass frame): the displayed video area the presenter reported
+ * last, else the video's display size */
+static void ffp_subtitle_canvas_size(VideoState *is, int video_w, int video_h, AVRational sar,
+                                     int *canvas_w, int *canvas_h)
+{
+    FFPlayer *ffp = is->ffp;
+    int w, h;
+
+    SDL_AtomicLock(&ffp->sink_lock);
+    w = ffp->shown_width;
+    h = ffp->shown_height;
+    SDL_AtomicUnlock(&ffp->sink_lock);
+    if ((w <= 0 || h <= 0) && video_w > 0 && video_h > 0) {
+        if (sar.num <= 0 || sar.den <= 0)
+            sar = (AVRational){ 1, 1 };
+        w = video_w;
+        h = video_h;
+        if (av_cmp_q(sar, (AVRational){ 1, 1 }) > 0)
+            w = (int)av_rescale(video_w, sar.num, sar.den);
+        else
+            h = (int)av_rescale(video_h, sar.den, sar.num);
+    }
+    *canvas_w = FFMAX(w, 1);
+    *canvas_h = FFMAX(h, 1);
+}
+
+static int ffp_subtitle_kind(enum AVCodecID codec_id)
+{
+    const AVCodecDescriptor *desc = avcodec_descriptor_get(codec_id);
+
+    if (codec_id == AV_CODEC_ID_ARIB_CAPTION)
+        return FFP_LAYER_ARIB;
+    if (desc && (desc->props & AV_CODEC_PROP_BITMAP_SUB))
+        return FFP_LAYER_BITMAP;
+    return FFP_LAYER_ASS;
+}
+
+/* plain-text codecs get the style override; ASS / SSA only with FFPSubtitleStyle.apply_to_ass */
+static int ffp_subtitle_plain(enum AVCodecID codec_id)
+{
+    return codec_id != AV_CODEC_ID_ASS && codec_id != AV_CODEC_ID_SSA;
+}
+
+static int64_t ffp_subtitle_duration_ms(const AVSubtitle *sub)
+{
+    if (sub->end_display_time == UINT32_MAX || sub->end_display_time <= sub->start_display_time)
+        return FFP_SUB_DEFAULT_DURATION_MS;
+    return sub->end_display_time - sub->start_display_time;
+}
+
+static void ffp_overlay_reset(SubtitleLayer *layer);
+
+static int ffp_overlay_reserve(SubtitleLayer *layer, int n)
+{
+    FFPOverlayRect *rects;
+    uint8_t **pixels;
+
+    if (n <= layer->ov_alloc)
+        return 0;
+    rects = av_realloc_array(layer->ov_rects, n, sizeof(*rects));
+    if (!rects)
+        return AVERROR(ENOMEM);
+    layer->ov_rects = rects;
+    pixels = av_realloc_array(layer->ov_pixels, n, sizeof(*pixels));
+    if (!pixels)
+        return AVERROR(ENOMEM);
+    layer->ov_pixels = pixels;
+    layer->ov_alloc = n;
+    return 0;
+}
+
+static void ffp_ass_log(int level, const char *fmt, va_list va, void *data)
+{
+    char line[1024];
+
+    vsnprintf(line, sizeof(line), fmt, va);
+    /* libass levels 0 fatal .. 7 debug; its warnings are mostly font fallbacks (Hangul in a Latin style font) */
+    av_log(NULL, level <= 1 ? AV_LOG_ERROR : level <= 5 ? AV_LOG_VERBOSE : AV_LOG_DEBUG,
+           "libass: %s\n", line);
+}
+
+static int ffp_is_font_attachment(const AVStream *st)
+{
+    static const char *const mimetypes[] = {
+        "font/ttf", "font/otf", "font/sfnt", "font/collection", "application/x-truetype-font",
+        "application/x-font-ttf", "application/x-font-otf", "application/vnd.ms-opentype", "application/font-sfnt",
+        NULL
+    };
+    const AVDictionaryEntry *t = av_dict_get(st->metadata, "mimetype", NULL, 0);
+    int i;
+
+    if (st->codecpar->codec_type != AVMEDIA_TYPE_ATTACHMENT || st->codecpar->extradata_size <= 0)
+        return 0;
+    if (st->codecpar->codec_id == AV_CODEC_ID_TTF || st->codecpar->codec_id == AV_CODEC_ID_OTF)
+        return 1;
+    for (i = 0; t && mimetypes[i]; i++)
+        if (!av_strcasecmp(t->value, mimetypes[i]))
+            return 1;
+    return 0;
+}
+
+static uint32_t ffp_ass_color(uint32_t rgba)
+{
+    return (rgba & 0xffffff00u) | (255 - (rgba & 0xff));
+}
+
+/* FFPAss.mutex held. The library gets the fonts dir and the container's font attachments before the renderer's
+ * ass_set_fonts, which is the only point where libass reads them. */
+static int ffp_ass_init(VideoState *is)
+{
+    FFPAss *a = &is->ass;
+    const char *family;
+    int i;
+
+    if (a->renderer)
+        return 0;
+    if (!a->lib) {
+        if (!(a->lib = ass_library_init()))
+            return AVERROR(ENOMEM);
+        ass_set_message_cb(a->lib, ffp_ass_log, NULL);
+        if (is->o->sub_fontsdir && *is->o->sub_fontsdir)
+            ass_set_fonts_dir(a->lib, is->o->sub_fontsdir);
+        for (i = 0; is->ic && i < is->ic->nb_streams; i++) {
+            AVStream *st = is->ic->streams[i];
+            const AVDictionaryEntry *name = av_dict_get(st->metadata, "filename", NULL, 0);
+            if (ffp_is_font_attachment(st))
+                ass_add_font(a->lib, name ? name->value : "", (const char *)st->codecpar->extradata,
+                             st->codecpar->extradata_size);
+        }
+    }
+    if (!(a->renderer = ass_renderer_init(a->lib)))
+        return AVERROR(ENOMEM);
+    SDL_LockMutex(is->ffp->mutex);
+    family = is->ffp->sub_style.font_family[0] ? is->ffp->sub_style.font_family : FFP_SUB_DEFAULT_FAMILY;
+    av_strlcpy(a->family, family, sizeof(a->family));
+    SDL_UnlockMutex(is->ffp->mutex);
+    ass_set_fonts(a->renderer, NULL, a->family, ASS_FONTPROVIDER_AUTODETECT, NULL, 1);
+    a->style_gen = 0;
+    a->frame_w = a->frame_h = a->storage_w = a->storage_h = 0;
+    return 0;
+}
+
+/* FFPAss.mutex held, renderer present. libass replaces style fields in groups (ASS_OVERRIDE_BIT_*), so the override
+ * ASS_Style starts as the track's default style and only the flagged fields change; the fields of a group no flag
+ * covers keep the track's values. The override ASS_Style is in PlayResY 288 units (libass rescales it to the script);
+ * it has to be complete, a zero ScaleX / ScaleY or BorderStyle renders nothing. */
+static void ffp_ass_apply_style(VideoState *is)
+{
+    FFPAss *a = &is->ass;
+    const ASS_Track *t = a->track;
+    FFPSubtitleStyle s;
+    ASS_Style st = { 0 };
+    unsigned gen, flags;
+    double scale = 1.0;
+    int bits = 0;
+
+    SDL_LockMutex(is->ffp->mutex);
+    s = is->ffp->sub_style;
+    gen = is->ffp->sub_style_gen;
+    SDL_UnlockMutex(is->ffp->mutex);
+    if (gen == a->style_gen)
+        return;
+    a->style_gen = gen;
+    if (strcmp(s.font_family[0] ? s.font_family : FFP_SUB_DEFAULT_FAMILY, a->family)) {
+        av_strlcpy(a->family, s.font_family[0] ? s.font_family : FFP_SUB_DEFAULT_FAMILY, sizeof(a->family));
+        ass_set_fonts(a->renderer, NULL, a->family, ASS_FONTPROVIDER_AUTODETECT, NULL, 1);
+    }
+    flags = a->plain ? s.override_flags | s.fallback_flags : s.apply_to_ass ? s.override_flags : 0;
+    if (t && t->n_styles > 0) {
+        double to288 = t->PlayResY > 0 ? 288.0 / t->PlayResY : 1.0;
+        st = t->styles[t->default_style >= 0 && t->default_style < t->n_styles ? t->default_style : 0];
+        st.FontSize *= to288;
+        st.Spacing *= to288;
+        st.Outline *= to288;
+        st.Shadow *= to288;
+        st.Blur *= to288;
+    } else {
+        st.FontSize = 16;
+        st.PrimaryColour = st.SecondaryColour = 0xffffff00;
+        st.ScaleX = st.ScaleY = 1.0;
+        st.BorderStyle = 1;
+        st.Outline = 1;
+        st.Alignment = 2;
+        st.MarginL = st.MarginR = st.MarginV = 10;
+        st.Encoding = 1;
+    }
+    st.Name = (char *)"";
+    st.FontName = a->family;
+    if (flags & FFP_SUBSTYLE_FONT)
+        bits |= ASS_OVERRIDE_BIT_FONT_NAME;
+    if (flags & FFP_SUBSTYLE_FONT_STYLE) {
+        bits |= ASS_OVERRIDE_BIT_ATTRIBUTES;
+        st.Bold = av_clip(s.font_weight ? s.font_weight : 400, 100, 900);   /* libass: values above 1 are weights */
+        st.Italic = !!s.italic;
+    }
+    if (flags & FFP_SUBSTYLE_SIZE) {
+        if (s.font_size > 0) {
+            bits |= ASS_OVERRIDE_BIT_FONT_SIZE_FIELDS;
+            st.FontSize = s.font_size * 96.0 / 72.0 * 288.0 / 1080.0;
+        }
+        if (s.font_scale > 0)
+            scale = s.font_scale;
+    }
+    if (flags & (FFP_SUBSTYLE_TEXT_COLOR | FFP_SUBSTYLE_OUTLINE_COLOR | FFP_SUBSTYLE_BACKGROUND))
+        bits |= ASS_OVERRIDE_BIT_COLORS;
+    if (flags & FFP_SUBSTYLE_TEXT_COLOR)
+        st.PrimaryColour = st.SecondaryColour = ffp_ass_color(s.primary_rgba);
+    if (flags & FFP_SUBSTYLE_OUTLINE_COLOR)
+        st.OutlineColour = ffp_ass_color(s.outline_rgba);
+    if (flags & (FFP_SUBSTYLE_BORDER | FFP_SUBSTYLE_BACKGROUND))
+        bits |= ASS_OVERRIDE_BIT_BORDER;
+    if (flags & FFP_SUBSTYLE_BORDER) {
+        st.BorderStyle = 1;
+        st.Outline = FFMAX(s.outline_width, 0.0) * 288.0 / 1080.0;
+        st.Shadow = FFMAX(s.shadow, 0.0) * 288.0 / 1080.0;
+    }
+    if (flags & FFP_SUBSTYLE_BACKGROUND) {
+        /* libass BorderStyle 4: one BackColour box around the whole event, padded by Shadow; no shadow is drawn */
+        st.BorderStyle = 4;
+        st.BackColour = ffp_ass_color(s.back_rgba);
+        st.Shadow = FFP_SUB_BOX_PADDING * 288.0 / 1080.0;
+    }
+    ass_set_selective_style_override(a->renderer, &st);
+    ass_set_selective_style_override_enabled(a->renderer, bits);
+    ass_set_font_scale(a->renderer, scale);
+}
+
+static void ffp_ass_set_size(FFPAss *a, int w, int h, int storage_w, int storage_h)
+{
+    if (w != a->frame_w || h != a->frame_h) {
+        ass_set_frame_size(a->renderer, w, h);
+        a->frame_w = w;
+        a->frame_h = h;
+    }
+    if (storage_w != a->storage_w || storage_h != a->storage_h) {
+        ass_set_storage_size(a->renderer, storage_w, storage_h);
+        a->storage_w = storage_w;
+        a->storage_h = storage_h;
+    }
+}
