+/* FFPAss.mutex held. Every chunk gets its own ReadOrder: libass drops a chunk whose ReadOrder it has seen, and the text
+ * decoders restart theirs at every flush. */
+static void ffp_ass_chunk(FFPAss *a, ASS_Track *track, const char *line, int64_t start_ms, int64_t duration_ms)
+{
+    const char *rest = strchr(line, ',');
+    char *chunk;
+
+    if (!rest || !(chunk = av_asprintf("%"PRId64"%s", a->read_order++, rest)))
+        return;
+    ass_process_chunk(track, chunk, (int)strlen(chunk), start_ms, duration_ms);
+    av_free(chunk);
+}
+
+/* the track of an embedded text stream, before its subtitle thread starts */
+static int ffp_ass_open_embedded(VideoState *is, const AVCodecContext *avctx)
+{
+    FFPAss *a = &is->ass;
+    int ret;
+
+    SDL_LockMutex(a->mutex);
+    ret = ffp_ass_init(is);
+    if (ret >= 0 && !(a->embedded = ass_new_track(a->lib)))
+        ret = AVERROR(ENOMEM);
+    if (ret >= 0) {
+        if (avctx->subtitle_header && avctx->subtitle_header_size > 0)
+            ass_process_codec_private(a->embedded, (char *)avctx->subtitle_header, avctx->subtitle_header_size);
+        a->track = a->embedded;
+        a->plain = ffp_subtitle_plain(avctx->codec_id);
+        a->external = 0;
+        a->serial = -1;
+        a->changed = 1;
+        a->style_gen = 0;
+    }
+    SDL_UnlockMutex(a->mutex);
+    return ret;
+}
+
+static void ffp_ass_close_embedded(VideoState *is)
+{
+    FFPAss *a = &is->ass;
+
+    SDL_LockMutex(a->mutex);
+    if (a->track == a->embedded)
+        a->track = NULL;
+    if (a->embedded)
+        ass_free_track(a->embedded);
+    a->embedded = NULL;
+    SDL_UnlockMutex(a->mutex);
+}
+
+/* subtitle thread: the decoded events of the embedded stream go into its track; a new packet serial (seek) starts
+ * the track over */
+static void ffp_ass_feed(SubtitleLayer *layer, const AVSubtitle *sub, int serial, int64_t pkt_pts)
+{
+    FFPAss *a = &layer->is->ass;
+    int64_t pts = sub->pts != AV_NOPTS_VALUE ? sub->pts : pkt_pts;
+    unsigned i;
+
+    if (pts == AV_NOPTS_VALUE)
+        return;
+    SDL_LockMutex(a->mutex);
+    if (a->embedded) {
+        if (a->serial != serial) {
+            ass_flush_events(a->embedded);
+            a->serial = serial;
+        }
+        for (i = 0; i < sub->num_rects; i++)
+            if (sub->rects[i] && sub->rects[i]->ass)
+                ffp_ass_chunk(a, a->embedded, sub->rects[i]->ass, pts / 1000 + sub->start_display_time,
+                              ffp_subtitle_duration_ms(sub));
+    }
+    SDL_UnlockMutex(a->mutex);
+}
+
+static void ffp_ass_blend_rgba(const ASS_Image *img, int x0, int y0, int x1, int y1,
+                               uint8_t *dst, int stride, int ox, int oy)
+{
+    unsigned r = img->color >> 24, g = (img->color >> 16) & 0xff, b = (img->color >> 8) & 0xff;
+    unsigned opacity = 255 - (img->color & 0xff);
+    int x, y;
+
+    for (y = y0; y < y1; y++) {
+        const uint8_t *src = img->bitmap + (size_t)(y - img->dst_y) * img->stride + (x0 - img->dst_x);
+        uint8_t *d = dst + (size_t)(y - oy) * stride + (size_t)(x0 - ox) * 4;
+        for (x = x0; x < x1; x++, src++, d += 4) {
+            unsigned sa = (*src * opacity + 127) / 255, da, oa;
+            if (!sa)
+                continue;
+            if (sa == 255 || !d[3]) {
+                d[0] = r; d[1] = g; d[2] = b; d[3] = sa;
+                continue;
+            }
+            /* straight-alpha "over", weights scaled by 255 */
+            da = d[3] * (255 - sa);
+            oa = sa * 255 + da;
+            d[0] = (r * sa * 255 + d[0] * da + oa / 2) / oa;
+            d[1] = (g * sa * 255 + d[1] * da + oa / 2) / oa;
+            d[2] = (b * sa * 255 + d[2] * da + oa / 2) / oa;
+            d[3] = (oa + 127) / 255;
+        }
+    }
+}
+
+typedef struct FFPBand {
+    int x0, y0, x1, y1;
+} FFPBand;
+
+static int ffp_ass_box(const ASS_Image *img, int width, int height, FFPBand *b)
+{
+    b->x0 = FFMAX(img->dst_x, 0);
+    b->y0 = FFMAX(img->dst_y, 0);
+    b->x1 = FFMIN(img->dst_x + img->w, width);
+    b->y1 = FFMIN(img->dst_y + img->h, height);
+    return b->x0 < b->x1 && b->y0 < b->y1 && (img->color & 0xff) != 0xff;
+}
+
+static void ffp_band_union(FFPBand *a, const FFPBand *b)
+{
+    a->x0 = FFMIN(a->x0, b->x0);
+    a->y0 = FFMIN(a->y0, b->y0);
+    a->x1 = FFMAX(a->x1, b->x1);
+    a->y1 = FFMAX(a->y1, b->y1);
+}
+
+/* Merges the ASS_Image list into at most FFP_ASS_MAX_BANDS horizontal bands of straight-alpha RGBA, so the presenter
+ * uploads a few textures instead of one per glyph run. */
+static int ffp_ass_composite(SubtitleLayer *layer, const ASS_Image *list, int width, int height)
+{
+    FFPBand band[FFP_ASS_MAX_BANDS + 1], b;
+    const ASS_Image *img;
+    int nb = 0, i, j;
+
+    ffp_overlay_reset(layer);
+    layer->ov_canvas_width = width;
+    layer->ov_canvas_height = height;
+    for (img = list; img; img = img->next) {
+        if (!ffp_ass_box(img, width, height, &b))
+            continue;
+        band[nb++] = b;
+        for (i = 0; i < nb; i++) {
+            for (j = i + 1; j < nb; j++) {
+                if (band[j].y0 <= band[i].y1 + FFP_ASS_BAND_GAP && band[i].y0 <= band[j].y1 + FFP_ASS_BAND_GAP) {
+                    ffp_band_union(&band[i], &band[j]);
+                    band[j] = band[--nb];
+                    i = -1;
+                    break;
+                }
+            }
+        }
+        while (nb > FFP_ASS_MAX_BANDS) {
+            int bi = 0, bj = 1, best = INT_MAX;
+            for (i = 0; i < nb; i++)
+                for (j = i + 1; j < nb; j++) {
+                    int gap = FFMAX(band[j].y0 - band[i].y1, band[i].y0 - band[j].y1);
+                    if (gap < best) {
+                        best = gap;
+                        bi = i;
+                        bj = j;
+                    }
+                }
+            ffp_band_union(&band[bi], &band[bj]);
+            band[bj] = band[--nb];
+        }
+    }
+    if (ffp_overlay_reserve(layer, nb) < 0)
+        return AVERROR(ENOMEM);
+    for (i = 0; i < nb; i++) {
+        FFPOverlayRect *o = &layer->ov_rects[i];
+        uint8_t *px = av_mallocz((size_t)(band[i].x1 - band[i].x0) * (band[i].y1 - band[i].y0) * 4);
+        if (!px) {
+            ffp_overlay_reset(layer);
+            return AVERROR(ENOMEM);
+        }
+        layer->ov_pixels[i] = px;
+        layer->ov_count++;
+        o->rgba = px;
+        o->x = band[i].x0;
+        o->y = band[i].y0;
+        o->width = band[i].x1 - band[i].x0;
+        o->height = band[i].y1 - band[i].y0;
+        o->stride = o->width * 4;
+    }
+    for (img = list; img; img = img->next) {
+        if (!ffp_ass_box(img, width, height, &b))
+            continue;
+        for (i = 0; i < nb; i++) {
+            if (band[i].x0 <= b.x0 && b.x1 <= band[i].x1 && band[i].y0 <= b.y0 && b.y1 <= band[i].y1) {
+                ffp_ass_blend_rgba(img, b.x0, b.y0, b.x1, b.y1, layer->ov_pixels[i], layer->ov_rects[i].stride,
+                                   band[i].x0, band[i].y0);
+                break;
+            }
+        }
+    }
+    return 0;
+}
+
+/* the plain text of a cue without the blank lines and spaces around it, NULL when nothing is left */
+static char *ffp_caption_text_dup(const char *text)
+{
+    size_t len;
+
+    if (!text)
+        return NULL;
+    while (*text == ' ' || *text == '\t' || *text == '\r' || *text == '\n')
+        text++;
+    len = strlen(text);
+    while (len && (text[len - 1] == ' ' || text[len - 1] == '\t' || text[len - 1] == '\r' || text[len - 1] == '\n'))
+        len--;
+    return len ? av_strndup(text, len) : NULL;
+}
+
+/* FFPAss.mutex held. The text of the events shown at t (ms), by layer then read order: override tags removed, \N and \n
+ * line breaks, \h a space. */
+static char *ffp_ass_active_text(const ASS_Track *track, int64_t t)
+{
+    AVBPrint bp;
+    int *active, n = 0, i, j;
+    char *out = NULL;
+
+    if (!track || track->n_events <= 0 || !(active = av_malloc_array(track->n_events, sizeof(*active))))
+        return NULL;
+    for (i = 0; i < track->n_events; i++) {
+        const ASS_Event *e = &track->events[i];
+        if (e->Start <= t && t < e->Start + e->Duration && e->Text)
+            active[n++] = i;
+    }
+    for (i = 1; i < n; i++) {
+        int cur = active[i];
+        const ASS_Event *c = &track->events[cur];
+        for (j = i; j > 0; j--) {
+            const ASS_Event *p = &track->events[active[j - 1]];
+            if (p->Layer < c->Layer || (p->Layer == c->Layer && p->ReadOrder <= c->ReadOrder))
+                break;
+            active[j] = active[j - 1];
+        }
+        active[j] = cur;
+    }
+    av_bprint_init(&bp, 0, AV_BPRINT_SIZE_UNLIMITED);
+    for (i = 0; i < n; i++) {
+        const char *s = track->events[active[i]].Text;
+        char *line;
+        AVBPrint lp;
+
+        av_bprint_init(&lp, 0, AV_BPRINT_SIZE_UNLIMITED);
+        while (*s) {
+            if (*s == '{') {
+                const char *end = strchr(s, '}');
+                if (end) {
+                    s = end + 1;
+                    continue;
+                }
+            }
+            if (s[0] == '\\' && (s[1] == 'N' || s[1] == 'n')) {
+                av_bprint_chars(&lp, '\n', 1);
+                s += 2;
+            } else if (s[0] == '\\' && s[1] == 'h') {
+                av_bprint_chars(&lp, ' ', 1);
+                s += 2;
+            } else {
+                av_bprint_chars(&lp, *s++, 1);
+            }
+        }
+        if (av_bprint_is_complete(&lp) && (line = ffp_caption_text_dup(lp.str))) {
+            if (bp.len)
+                av_bprint_chars(&bp, '\n', 1);
+            av_bprintf(&bp, "%s", line);
+            av_free(line);
+        }
+        av_bprint_finalize(&lp, NULL);
+    }
+    av_free(active);
+    if (!av_bprint_is_complete(&bp) || av_bprint_finalize(&bp, &out) < 0)
+        out = NULL;
+    return out;
+}
+
+/* display thread: renders the libass track at the displayed picture's time into the layer's overlay */
+static void ffp_ass_update_layer(SubtitleLayer *layer, double pts)
+{
+    VideoState *is = layer->is;
+    FFPAss *a = &is->ass;
+    AVStream *vst = is->video_st;
+    ASS_Image *img;
+    int w, h, change = 0, ret;
+    int64_t t;
+
+    if (isnan(pts) || !vst || vst->codecpar->width <= 0 || vst->codecpar->height <= 0)
+        return;
+    ffp_subtitle_canvas_size(is, vst->codecpar->width, vst->codecpar->height,
+                             av_guess_sample_aspect_ratio(is->ic, vst, NULL), &w, &h);
+    if (w != layer->canvas_width || h != layer->canvas_height) {
+        SDL_LockMutex(is->dbg_mutex);
+        layer->canvas_width = w;
+        layer->canvas_height = h;
+        SDL_UnlockMutex(is->dbg_mutex);
+    }
+    t = llrint(pts * 1000) - SDL_AtomicGet(&is->ffp->sub_delay_ms);
+    SDL_LockMutex(a->mutex);
+    if (!a->renderer || !a->track) {
+        if (layer->ov_count) {
+            ffp_overlay_reset(layer);
+            layer->generation++;
+            layer->ov_generation = layer->generation;
+        }
+        SDL_UnlockMutex(a->mutex);
+        return;
+    }
+    if (a->external)
+        t -= llrint(is->start_off_s * 1000);
+    ffp_ass_apply_style(is);
+    ffp_ass_set_size(a, w, h, vst->codecpar->width, vst->codecpar->height);
+    img = ass_render_frame(a->renderer, a->track, t, &change);
+    layer->ass_time_ms = t;
+    if (change || a->changed) {
+        a->changed = 0;
+        ret = ffp_ass_composite(layer, img, w, h);
+        if (ret < 0) {
+            av_log(NULL, AV_LOG_WARNING, "could not composite the subtitles: %s\n", av_err2str(ret));
+            a->changed = 1;
+        }
+        if (layer->ov_count)
+            layer->ov_text = ffp_ass_active_text(a->track, t);
+        layer->generation++;
+        layer->ov_generation = layer->generation;
+        if (layer->ov_count)
+            SDL_AtomicAdd(&layer->cues_uploaded, 1);
+    }
+    SDL_UnlockMutex(a->mutex);
+}
+
+/* snapshot thread, the media kept alive by snap_mutex: renders the track at the snapshot size into the opaque BGRA */
+static void ffp_ass_snapshot(VideoState *is, int64_t t, uint8_t *bgra, int width, int height, int stride)
+{
+    FFPAss *a = &is->ass;
+    ASS_Image *img;
+    FFPBand b;
+    int change, x, y;
+
+    SDL_LockMutex(a->mutex);
+    if (a->renderer && a->track && a->storage_w > 0 && a->storage_h > 0) {
+        ffp_ass_apply_style(is);
+        ffp_ass_set_size(a, width, height, a->storage_w, a->storage_h);
+        for (img = ass_render_frame(a->renderer, a->track, t, &change); img; img = img->next) {
+            unsigned r = img->color >> 24, g = (img->color >> 16) & 0xff, bl = (img->color >> 8) & 0xff;
+            unsigned opacity = 255 - (img->color & 0xff);
+            if (!ffp_ass_box(img, width, height, &b))
+                continue;
+            for (y = b.y0; y < b.y1; y++) {
+                const uint8_t *src = img->bitmap + (size_t)(y - img->dst_y) * img->stride + (b.x0 - img->dst_x);
+                uint8_t *d = bgra + (size_t)y * stride + (size_t)b.x0 * 4;
+                for (x = b.x0; x < b.x1; x++, src++, d += 4) {
+                    unsigned sa = (*src * opacity + 127) / 255, ia = 255 - sa;
+                    d[0] = (bl * sa + d[0] * ia + 127) / 255;
+                    d[1] = (g * sa + d[1] * ia + 127) / 255;
+                    d[2] = (r * sa + d[2] * ia + 127) / 255;
+                }
+            }
+        }
+        /* the next display render sets its own frame size again */
+        a->frame_w = a->frame_h = 0;
+    }
+    SDL_UnlockMutex(a->mutex);
+}
+
+/* FFPAss.mutex held */
+static int ffp_ext_track_build(FFPAss *a, FFPExtTrack *x)
+{
+    int i;
+
+    if (!(x->track = ass_new_track(a->lib)))
+        return AVERROR(ENOMEM);
+    if (x->header)
+        ass_process_codec_private(x->track, x->header, (int)strlen(x->header));
+    for (i = 0; i < x->nb_events; i++)
+        ffp_ass_chunk(a, x->track, x->events[i].line, x->events[i].start_ms, x->events[i].duration_ms);
+    return 0;
+}
+
+static void ffp_ext_track_free(FFPExtTrack **px)
+{
+    FFPExtTrack *x = *px;
+    int i;
+
+    if (!x)
+        return;
+    av_free(x->path);
+    av_free(x->language);
+    av_free(x->title);
+    av_free(x->header);
+    for (i = 0; i < x->nb_events; i++)
+        av_free(x->events[i].line);
+    av_free(x->events);
+    if (x->track)
+        ass_free_track(x->track);
+    for (i = 0; i < x->nb_cues; i++)
+        avsubtitle_free(&x->cues[i].sub);
+    av_free(x->cues);
+    av_freep(px);
+}
