+    }
+    if (!nb) {
+        ret = AVERROR_STREAM_NOT_FOUND;
+        goto end;
+    }
+    while ((ret = av_read_frame(ic, pkt)) >= 0) {
+        int k = pkt->stream_index < ic->nb_streams ? slot[pkt->stream_index] : -1;
+        AVCodecContext *avctx = k >= 0 ? dec[pkt->stream_index] : NULL;
+        FFPExtTrack *x = k >= 0 ? tracks[k] : NULL;
+        AVSubtitle sub;
+        int got = 0;
+        unsigned r;
+
+        if (!avctx || avcodec_decode_subtitle2(avctx, &sub, &got, pkt) < 0 || !got) {
+            av_packet_unref(pkt);
+            continue;
+        }
+        if (sub.pts == AV_NOPTS_VALUE && pkt->pts != AV_NOPTS_VALUE)
+            sub.pts = av_rescale_q(pkt->pts, ic->streams[pkt->stream_index]->time_base, AV_TIME_BASE_Q);
+        av_packet_unref(pkt);
+        if (sub.pts == AV_NOPTS_VALUE) {
+            avsubtitle_free(&sub);
+            continue;
+        }
+        if (x->kind == FFP_LAYER_ASS) {
+            for (r = 0, ret = 0; r < sub.num_rects && ret >= 0; r++)
