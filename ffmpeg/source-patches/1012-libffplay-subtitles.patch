+/* display thread. FFP_STREAM_SUBTITLE: the caption layer, -1 off; an embedded stream or an external track. */
+static int ffp_select_stream_index(VideoState *is, int type, int index)
+{
+    AVFormatContext *ic = is->ic;
+    SubtitleLayer *sl = &is->subtitles[FFP_SUBTITLE_CAPTION];
+    int base = ffp_ext_base(is), old, ret;
+
+    if (type == FFP_STREAM_SUBTITLE) {
+        if (index < -1 || index >= base + is->nb_ext)
+            return FFP_EINVAL;
+        if (index >= 0 && index < base &&
+            (index >= ic->nb_streams || ic->streams[index]->codecpar->codec_type != AVMEDIA_TYPE_SUBTITLE ||
+             ffp_arib_is_superimpose(ic->streams[index])))
+            return FFP_EINVAL;
+        if (index >= 0 && (index < base ? sl->stream_index == index : sl->ext_index == index - base))
+            return 0;
+        ffp_ext_deselect(is);
+        if (sl->stream_index >= 0)
+            stream_component_close(is, sl->stream_index, FFP_SUBTITLE_CAPTION);
+        if (index < 0)
+            return 0;
+        if (index >= base)
+            return ffp_ext_select(is, index - base);
+        ret = stream_component_open(is, index, FFP_SUBTITLE_CAPTION);
+        return ret < 0 ? ret : 0;
+    }
+    if (type != FFP_STREAM_AUDIO && type != FFP_STREAM_VIDEO)
+        return FFP_EINVAL;
+    /* ARIB: audio 1 / audio 2 are a preference (ffp_set_audio_preference) */
+    if (type == FFP_STREAM_AUDIO && is->arib)
+        return FFP_EINVAL;
+    if (index < 0 || index >= ic->nb_streams || ic->streams[index]->codecpar->codec_type != type ||
+        (type == FFP_STREAM_AUDIO && (!ic->streams[index]->codecpar->sample_rate ||
+                                      !ic->streams[index]->codecpar->ch_layout.nb_channels)))
+        return FFP_EINVAL;
+    old = type == FFP_STREAM_AUDIO ? is->audio_stream : is->video_stream;
+    if (old == index)
+        return 0;
+    if (old >= 0)
+        stream_component_close(is, old, -1);
+    ret = stream_component_open(is, index, -1);
+    return ret < 0 ? ret : 0;
 }
 
 
