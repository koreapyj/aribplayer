+/* Frames the field order probe inspects before it calls the stream progressive: three full 3:2 pulldown cycles,
+ * about half a second at 30 fps. A single interlaced frame decides at once. */
+#define FFP_FIELD_PROBE_FRAMES 15
+
+static void ffp_update_media_info(VideoState *is);
+
+/* Decoder output, before any filter (IVTC / deinterlacing rewrite the interlaced flag). */
+static void ffp_probe_field_order(VideoState *is, const AVFrame *frame)
+{
+    int order = AV_FIELD_UNKNOWN;
+    char json[64];
+
+    if (is->video_st->codecpar->field_order != AV_FIELD_UNKNOWN || SDL_AtomicGet(&is->field_probe_order))
+        return;
+    if (frame->flags & AV_FRAME_FLAG_INTERLACED)
+        order = (frame->flags & AV_FRAME_FLAG_TOP_FIELD_FIRST) ? AV_FIELD_TT : AV_FIELD_BB;
+    else if (++is->field_probe_frames >= FFP_FIELD_PROBE_FRAMES)
+        order = AV_FIELD_PROGRESSIVE;
+    if (order == AV_FIELD_UNKNOWN)
+        return;
+
+    SDL_AtomicSet(&is->field_probe_order, order);
+    ffp_update_media_info(is);
+    snprintf(json, sizeof(json), "{\"field_order\":\"%s\"}",
+             order == AV_FIELD_PROGRESSIVE ? "progressive" : order == AV_FIELD_TT ? "tt" : "bb");
+    ffp_emit(is->ffp, FFP_EVENT_MEDIA_INFO, json);
+}
