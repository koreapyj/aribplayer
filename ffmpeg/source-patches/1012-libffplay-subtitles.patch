+static int ffp_ext_select(VideoState *is, int k)
+{
+    SubtitleLayer *sl = &is->subtitles[FFP_SUBTITLE_CAPTION];
+    FFPExtTrack *x = is->ext[k];
+    FFPDebugSubtitle *s;
+    int ret = 0;
+
+    if (x->kind == FFP_LAYER_ASS) {
+        SDL_LockMutex(is->ass.mutex);
+        ret = ffp_ass_init(is);
+        if (ret >= 0 && !x->track)
+            ret = ffp_ext_track_build(&is->ass, x);
+        if (ret >= 0) {
+            is->ass.track = x->track;
+            is->ass.plain = ffp_subtitle_plain(x->codec_id);
+            is->ass.external = 1;
+            is->ass.changed = 1;
+            is->ass.style_gen = 0;
+        }
+        SDL_UnlockMutex(is->ass.mutex);
+        if (ret < 0)
+            return ret;
+    }
+    if ((x->width <= 0 || x->height <= 0) && is->video_st) {
+        x->width = is->video_st->codecpar->width;
+        x->height = is->video_st->codecpar->height;
+    }
+    sl->is = is;
+    sl->id = FFP_SUBTITLE_CAPTION;
+    sl->kind = x->kind;
+    sl->ext_index = k;
+    sl->ext_cue = -1;
+    sl->generation++;
+    SDL_LockMutex(is->dbg_mutex);
+    s = &is->dbg.subtitles[FFP_SUBTITLE_CAPTION];
+    memset(s, 0, sizeof(*s));
+    s->open = 1;
+    s->stream_index = ffp_ext_base(is) + k;
+    s->time_base = (AVRational){ 1, 1000 };
+    s->stream_start = s->active_start = s->active_end = NAN;
+    ffp_dbg_set_str(s->codec, sizeof(s->codec), avcodec_get_name(x->codec_id));
+    ffp_dbg_set_str(s->decoder, sizeof(s->decoder), "external");
+    ffp_dbg_set_str(s->caption_type, sizeof(s->caption_type), "caption");
+    SDL_UnlockMutex(is->dbg_mutex);
+    return 0;
+}
