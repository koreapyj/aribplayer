+/* display thread: the cue of the selected external bitmap track at the displayed picture's time */
+static void ffp_ext_bitmap_update(SubtitleLayer *layer, double pts)
+{
+    VideoState *is = layer->is;
+    FFPExtTrack *x = is->ext[layer->ext_index];
+    int64_t t;
+    int lo = 0, hi = x->nb_cues - 1, idx = -1;
+
+    if (isnan(pts))
+        return;
+    t = llrint((pts - is->start_off_s) * 1000) - SDL_AtomicGet(&is->ffp->sub_delay_ms);
+    while (lo <= hi) {
+        int mid = (lo + hi) / 2;
+        if (x->cues[mid].start_ms <= t) {
+            idx = mid;
+            lo = mid + 1;
+        } else {
+            hi = mid - 1;
+        }
+    }
+    if (idx >= 0 && t >= x->cues[idx].end_ms)
+        idx = -1;
+    if (idx == layer->ext_cue)
+        return;
+    ffp_subtitle_clear_active(layer, layer->ext_cue >= 0);
+    layer->ext_cue = -1;
+    if (idx >= 0 && ffp_subtitle_copy(&layer->active, &x->cues[idx].sub) >= 0) {
+        layer->ext_cue = idx;
+        layer->generation++;
+        layer->active_valid = 1;
+        layer->active_counted_shown = 0;
+        layer->active_serial = -1;
+        layer->active_width = x->width;
+        layer->active_height = x->height;
+        layer->active_start = x->cues[idx].start_ms / 1000.0;
+        layer->active_end = x->cues[idx].end_ms / 1000.0;
+        layer->active_generation = layer->generation;
+    }
+}
