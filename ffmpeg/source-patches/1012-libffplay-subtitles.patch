+        slot[i] = nb++;
+        x->kind = kind;
+        x->codec_id = st->codecpar->codec_id;
+        if (!(x->path = av_strdup(path))) {
+            ret = AVERROR(ENOMEM);
+            goto end;
+        }
+        if ((t = av_dict_get(st->metadata, "language", NULL, 0)) && *t->value)
+            x->language = av_strdup(t->value);
+        if ((t = av_dict_get(st->metadata, "title", NULL, 0)) && *t->value)
+            x->title = av_strdup(t->value);
+        if ((ret = avcodec_parameters_to_context(dec[i], st->codecpar)) < 0)
