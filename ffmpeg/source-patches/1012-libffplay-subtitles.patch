+FFP_API int FFP_CALL ffp_get_caption_text_at(FFPlayer *ffp, double x, double y, char *buf, int size)
+{
+    int i, j, ret = 0;
+
+    if (!ffp || !(x >= 0 && x <= 1) || !(y >= 0 && y <= 1) || size < 0 || (size > 0 && !buf))
+        return FFP_EINVAL;
+    if (size > 0)
+        buf[0] = 0;
+    SDL_LockMutex(ffp->caption_mutex);
+    for (i = 0; i < FFP_OVERLAY_LAYER_COUNT && !ret; i++) {
+        const FFPCaptionHit *h = &ffp->caption_hit[i];
+        double px, py, tol;
+
+        if (!h->visible || !h->text || !SDL_AtomicGet(&ffp->subtitle_visible[i]) ||
+            h->canvas_width <= 0 || h->canvas_height <= 0)
+            continue;
+        px = x * h->canvas_width;
+        py = y * h->canvas_height;
+        tol = h->canvas_height * 0.01;
+        for (j = 0; j < h->count; j++) {
+            if (px >= h->rects[j].x - tol && px <= h->rects[j].x + h->rects[j].w + tol &&
+                py >= h->rects[j].y - tol && py <= h->rects[j].y + h->rects[j].h + tol) {
+                size_t len = strlen(h->text);
+
+                ret = (int)FFMIN(len, (size_t)INT_MAX);
+                if (size > 0) {
+                    size_t n = FFMIN(len, (size_t)size - 1);
+                    memcpy(buf, h->text, n);
+                    buf[n] = 0;
+                }
+                break;
+            }
+        }
+    }
+    SDL_UnlockMutex(ffp->caption_mutex);
+    return ret;
+}
