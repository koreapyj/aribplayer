+static int ffp_bitmap_cue_cmp(const void *a, const void *b)
+{
+    const FFPBitmapCue *x = a, *y = b;
+    return (x->start_ms > y->start_ms) - (x->start_ms < y->start_ms);
+}
+
+/* A bitmap cue holds until the next decoded subtitle (an empty one only clears) or its own end; the empty ones are
+ * dropped afterwards. */
+static void ffp_ext_finish_cues(FFPExtTrack *x)
+{
+    int i, n = 0;
+
+    qsort(x->cues, x->nb_cues, sizeof(*x->cues), ffp_bitmap_cue_cmp);
+    for (i = 0; i + 1 < x->nb_cues; i++)
+        if (x->cues[i + 1].start_ms < x->cues[i].end_ms)
+            x->cues[i].end_ms = x->cues[i + 1].start_ms;
+    for (i = 0; i < x->nb_cues; i++) {
+        if (!x->cues[i].sub.num_rects || x->cues[i].end_ms <= x->cues[i].start_ms) {
+            avsubtitle_free(&x->cues[i].sub);
+            continue;
+        }
+        x->cues[n++] = x->cues[i];
+    }
+    x->nb_cues = n;
+}
+
+static int ffp_ext_add_cue(FFPExtTrack *x, AVSubtitle *sub)
+{
+    FFPBitmapCue *cues = av_realloc_array(x->cues, x->nb_cues + 1, sizeof(*cues));
+
+    if (!cues)
+        return AVERROR(ENOMEM);
+    x->cues = cues;
+    cues[x->nb_cues].start_ms = sub->pts / 1000 + sub->start_display_time;
+    cues[x->nb_cues].end_ms = sub->end_display_time == UINT32_MAX || sub->end_display_time <= sub->start_display_time ?
+                              INT64_MAX : sub->pts / 1000 + sub->end_display_time;
+    cues[x->nb_cues].sub = *sub;
+    memset(sub, 0, sizeof(*sub));
+    x->nb_cues++;
+    return 0;
+}
