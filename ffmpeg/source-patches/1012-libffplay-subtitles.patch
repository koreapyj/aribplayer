+static int ffp_ext_add_event(FFPExtTrack *x, const char *line, int64_t start_ms, int64_t duration_ms)
+{
+    FFPAssEvent *ev = av_realloc_array(x->events, x->nb_events + 1, sizeof(*ev));
+
+    if (!ev)
+        return AVERROR(ENOMEM);
+    x->events = ev;
+    ev = &x->events[x->nb_events];
+    if (!(ev->line = av_strdup(line)))
+        return AVERROR(ENOMEM);
+    ev->start_ms = start_ms;
+    ev->duration_ms = duration_ms;
+    x->nb_events++;
+    return 0;
+}
