+/* display thread: what the presenter is about to be given for the layer */
+static void ffp_caption_hit_store(FFPlayer *ffp, int id, const FFPOverlayLayer *ov, const char *text)
+{
+    FFPCaptionHit *h = &ffp->caption_hit[id];
+    int i;
+
+    SDL_LockMutex(ffp->caption_mutex);
+    h->visible = ov->visible;
+    h->canvas_width = ov->canvas_width;
+    h->canvas_height = ov->canvas_height;
+    h->count = 0;
+    if (ov->rect_count > h->alloc) {
+        void *rects = av_realloc_array(h->rects, ov->rect_count, sizeof(*h->rects));
+        if (rects) {
+            h->rects = rects;
+            h->alloc = ov->rect_count;
+        }
+    }
+    if (ov->rect_count <= h->alloc) {
+        for (i = 0; i < ov->rect_count; i++) {
+            h->rects[i].x = ov->rects[i].x;
+            h->rects[i].y = ov->rects[i].y;
+            h->rects[i].w = ov->rects[i].width;
+            h->rects[i].h = ov->rects[i].height;
+        }
+        h->count = ov->rect_count;
+    }
+    if (!text != !h->text || (text && strcmp(text, h->text))) {
+        av_free(h->text);
+        h->text = text ? av_strdup(text) : NULL;
+    }
+    SDL_UnlockMutex(ffp->caption_mutex);
+}
