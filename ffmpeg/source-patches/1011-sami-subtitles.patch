+/* Decodes the entity at in (pointing to '&'); returns its length or 0. */
+static int html_entity_to_ass(AVBPrint *dst, const char *in)
+{
+    const char *end = strchr(in, ';');
+    int len;
+
+    if (!end || end - in > 10)
+        return 0;
+    len = end - in + 1;
+
+    if (in[1] == '#') {
+        const int hex = in[2] == 'x' || in[2] == 'X';
+        char *num_end;
+        unsigned long cp = strtoul(in + 2 + hex, &num_end, hex ? 16 : 10);
+        if (num_end != end || end == in + 2 + hex || !cp || cp > 0x10FFFF ||
+            (cp >= 0xD800 && cp < 0xE000))
+            return 0;
+        if (cp < 0x80) {
+            av_bprint_chars(dst, cp, 1);
+        } else if (cp < 0x800) {
+            av_bprint_chars(dst, 0xC0 | cp >> 6, 1);
+            av_bprint_chars(dst, 0x80 | (cp & 0x3F), 1);
+        } else if (cp < 0x10000) {
+            av_bprint_chars(dst, 0xE0 | cp >> 12, 1);
+            av_bprint_chars(dst, 0x80 | (cp >> 6 & 0x3F), 1);
+            av_bprint_chars(dst, 0x80 | (cp & 0x3F), 1);
+        } else {
+            av_bprint_chars(dst, 0xF0 | cp >> 18, 1);
+            av_bprint_chars(dst, 0x80 | (cp >> 12 & 0x3F), 1);
+            av_bprint_chars(dst, 0x80 | (cp >> 6 & 0x3F), 1);
+            av_bprint_chars(dst, 0x80 | (cp & 0x3F), 1);
+        }
+        return len;
+    }
+
+    for (int i = 0; i < FF_ARRAY_ELEMS(html_entities); i++) {
+        if (strlen(html_entities[i].name) == len - 2 &&
+            !strncmp(in + 1, html_entities[i].name, len - 2)) {
+            av_bprintf(dst, "%s", html_entities[i].text);
+            return len;
+        }
+    }
+    return 0;
+}
