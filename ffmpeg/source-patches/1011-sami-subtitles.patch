+static int sami_read_packet(AVFormatContext *s, AVPacket *pkt)
+{
+    SAMIContext *sami = s->priv_data;
+    int best = -1;
+
+    for (int i = 0; i < sami->nb_q; i++) {
+        const FFDemuxSubtitlesQueue *q = &sami->q[i];
+        if (q->current_sub_idx < q->nb_subs &&
+            (best < 0 || q->subs[q->current_sub_idx]->pts <
+                         sami->q[best].subs[sami->q[best].current_sub_idx]->pts))
+            best = i;
+    }
+    if (best < 0)
+        return AVERROR_EOF;
+    return ff_subtitles_queue_read_packet(&sami->q[best], pkt);
+}
+
+static int sami_read_seek(AVFormatContext *s, int stream_index,
+                          int64_t min_ts, int64_t ts, int64_t max_ts, int flags)
+{
+    SAMIContext *sami = s->priv_data;
+    int ret = 0;
+
+    for (int i = 0; i < sami->nb_q && ret >= 0; i++)
+        ret = ff_subtitles_queue_seek(&sami->q[i], s, -1, min_ts, ts, max_ts, flags);
+    return ret;
+}
+
+static int sami_read_close(AVFormatContext *s)
+{
+    SAMIContext *sami = s->priv_data;
+    for (int i = 0; i < sami->nb_q; i++)
+        ff_subtitles_queue_clean(&sami->q[i]);
+    av_freep(&sami->q);
+    return 0;
+}
