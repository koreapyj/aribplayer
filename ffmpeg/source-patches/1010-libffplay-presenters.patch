+    *out = NULL;
+    snprintf(err, n, "not supported on this platform");
+    return AVERROR(ENOSYS);
+}
+int ffp_cuda_ordinal_for_luid(const FFPD3D11Config *cfg, int *ordinal, char *err, size_t n)
