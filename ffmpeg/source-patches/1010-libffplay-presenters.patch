+static LONG g_class_refs;
+static const WCHAR ffp_wnd_class[] = L"libffplay.d3d11";
+
+#define FFP_WM_SHOW  (WM_APP + 1)
+#define FFP_WM_SIZE  (WM_APP + 2)   /* wp = width, lp = height */
+#define FFP_WM_QUIT  (WM_APP + 3)
+
+static LRESULT CALLBACK ffp_child_proc(HWND h, UINT msg, WPARAM wp, LPARAM lp)
+{
+    switch (msg) {
+    case FFP_WM_SHOW:
+        ShowWindow(h, SW_SHOWNA);
+        return 0;
+    case FFP_WM_SIZE:
+        SetWindowPos(h, NULL, 0, 0, (int)wp, (int)lp, SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOMOVE);
+        return 0;
+    case FFP_WM_QUIT:
+        DestroyWindow(h);
+        return 0;
+    case WM_NCDESTROY:
+        DefWindowProcW(h, msg, wp, lp);
+        PostQuitMessage(0);
+        return 0;
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_NCHITTEST:
+        /* never takes the pointer (also covered by WS_DISABLED): the host window underneath gets hit-testing, mouse
+         * input and cursor handling directly on its own thread, so its own hit-test rules (popups, bars) apply */
+        return HTTRANSPARENT;
+    }
+    return DefWindowProcW(h, msg, wp, lp);
+}
+
+static HMODULE ffp_this_module(void)
+{
+    HMODULE m = NULL;
+    GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                       (LPCWSTR)(void *)ffp_child_proc, &m);
+    return m;
+}
+
+/* The child window lives on its own thread with a real message loop: a window owned by a thread that does not pump
+ * deadlocks every cross-thread SendMessage of the host (SetWindowPos / ShowWindow / SetParent on the video window).
+ * Everything the loop thread does to the window is posted (or SWP_ASYNCWINDOWPOS); the window thread never sends
+ * to the host (WS_EX_NOPARENTNOTIFY, mouse input is posted), so ffp_d3d11_destroy cannot deadlock with a blocked host. */
+static DWORD WINAPI ffp_window_thread(LPVOID arg)
+{
+    FFPD3D11 *p = arg;
+    MSG m;
+
+    p->child = CreateWindowExW(WS_EX_NOPARENTNOTIFY | WS_EX_NOACTIVATE, ffp_wnd_class, L"",
+                               WS_CHILD | WS_CLIPSIBLINGS | WS_DISABLED, 0, 0, p->wcw, p->wch, p->host, NULL, ffp_this_module(), NULL);
+    p->wres = p->child ? 0 : (int)GetLastError();
+    SetEvent(p->wready);
+    if (!p->child)
+        return 0;
+    while (GetMessageW(&m, NULL, 0, 0) > 0) {
+        TranslateMessage(&m);
+        DispatchMessageW(&m);
+    }
+    return 0;
+}
+
+static int ffp_start_window(FFPD3D11 *p, int w, int h)
+{
+    p->wcw = w;
+    p->wch = h;
+    p->wready = CreateEventW(NULL, TRUE, FALSE, NULL);
+    if (!p->wready)
+        return -1;
+    p->wthread = CreateThread(NULL, 0, ffp_window_thread, p, 0, &p->wtid);
+    if (!p->wthread) {
+        CloseHandle(p->wready);
+        p->wready = NULL;
+        return -1;
+    }
+    WaitForSingleObject(p->wready, INFINITE);       /* the thread needs nothing from the caller or the host */
+    if (p->wres) {
+        WaitForSingleObject(p->wthread, INFINITE);
+        CloseHandle(p->wthread);
+        CloseHandle(p->wready);
+        p->wthread = p->wready = NULL;
+        p->child = NULL;
+        return -1;
+    }
+    return 0;
+}
+
+static void ffp_stop_window(FFPD3D11 *p)
+{
+    if (!p->wthread)
+        return;
+    if (IsWindow(p->child))
+        PostMessageW(p->child, FFP_WM_QUIT, 0, 0);
+    else
+        PostThreadMessageW(p->wtid, WM_QUIT, 0, 0);
+    WaitForSingleObject(p->wthread, 5000);
+    CloseHandle(p->wthread);
+    CloseHandle(p->wready);
+    p->wthread = p->wready = NULL;
+    p->child = NULL;
+}
+
+static int ffp_register_class(void)
+{
+    WNDCLASSEXW wc;
+
+    if (InterlockedIncrement(&g_class_refs) > 1)
+        return 0;
+    memset(&wc, 0, sizeof(wc));
+    wc.cbSize = sizeof(wc);
+    wc.style = CS_DBLCLKS;
+    wc.lpfnWndProc = ffp_child_proc;
+    wc.hInstance = ffp_this_module();
+    wc.lpszClassName = ffp_wnd_class;
+    if (!RegisterClassExW(&wc) && GetLastError() != ERROR_CLASS_ALREADY_EXISTS) {
+        InterlockedDecrement(&g_class_refs);
+        return -1;
+    }
+    return 0;
+}
+
+static void ffp_unregister_class(void)
+{
+    if (InterlockedDecrement(&g_class_refs) == 0)
+        UnregisterClassW(ffp_wnd_class, ffp_this_module());
+}
