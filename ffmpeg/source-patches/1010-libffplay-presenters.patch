+static void ffp_vp_free(FFPVP *v)
+{
+    ffp_vp_free_views(v);
+    FFP_REL(v->vp);
+    FFP_REL(v->en);
+    v->in_w = v->in_h = v->out_w = v->out_h = 0;
+}
+
+static int ffp_vp_ensure(ID3D11VideoDevice *vdev, FFPVP *v, int iw, int ih, int ow, int oh, char *err, size_t err_size)
+{
+    D3D11_VIDEO_PROCESSOR_CONTENT_DESC cd;
+
+    if (v->vp && v->in_w == iw && v->in_h == ih && v->out_w == ow && v->out_h == oh)
+        return 0;
+    ffp_vp_free(v);
+    memset(&cd, 0, sizeof(cd));
+    cd.InputFrameFormat = D3D11_VIDEO_FRAME_FORMAT_PROGRESSIVE;
+    cd.InputWidth = iw;
+    cd.InputHeight = ih;
+    cd.OutputWidth = ow;
+    cd.OutputHeight = oh;
+    cd.Usage = D3D11_VIDEO_USAGE_PLAYBACK_NORMAL;
+    CHECK_HR(vdev->lpVtbl->CreateVideoProcessorEnumerator(vdev, &cd, &v->en), "CreateVideoProcessorEnumerator");
+    CHECK_HR(vdev->lpVtbl->CreateVideoProcessor(vdev, v->en, 0, &v->vp), "CreateVideoProcessor");
+    v->in_w = iw;
+    v->in_h = ih;
+    v->out_w = ow;
+    v->out_h = oh;
+    return 0;
+fail:
+    ffp_vp_free(v);
+    return -1;
+}
+
+static ID3D11VideoProcessorInputView *ffp_vp_input_view(ID3D11VideoDevice *vdev, FFPVP *v, ID3D11Texture2D *tex,
+                                                        int slice, char *err, size_t err_size)
+{
+    D3D11_VIDEO_PROCESSOR_INPUT_VIEW_DESC d;
+    ID3D11VideoProcessorInputView *view = NULL;
+    int i;
+
+    for (i = 0; i < v->nb_views; i++)
+        if (v->views[i].tex == tex && v->views[i].slice == slice) {
+            v->views[i].used = ++v->tick;
+            return v->views[i].view;
+        }
+    memset(&d, 0, sizeof(d));
+    d.ViewDimension = D3D11_VPIV_DIMENSION_TEXTURE2D;
+    d.Texture2D.ArraySlice = slice;
+    CHECK_HR(vdev->lpVtbl->CreateVideoProcessorInputView(vdev, (ID3D11Resource *)tex, v->en, &d, &view),
+             "CreateVideoProcessorInputView");
+    if (v->nb_views >= FFP_VIEW_CACHE) {
+        int lru = 0;
+
+        for (i = 1; i < v->nb_views; i++)
+            if (v->views[i].used < v->views[lru].used)
+                lru = i;
+        FFP_REL(v->views[lru].view);
+        FFP_REL(v->views[lru].tex);
+        v->views[lru] = v->views[--v->nb_views];
+    }
+    tex->lpVtbl->AddRef(tex);
+    v->views[v->nb_views].tex = tex;
+    v->views[v->nb_views].slice = slice;
+    v->views[v->nb_views].view = view;
+    v->views[v->nb_views].used = ++v->tick;
+    v->nb_views++;
+    return view;
+fail:
+    return NULL;
+}
+
+#define FFP_LV_OFF INT_MIN
+/* RGB code values (0..255) per unit of ffmpeg eq brightness: eq adds b * 255 to the 8-bit luma code, the video
+ * processor's limited -> full range conversion gains 255 / 219 */
+#define FFP_RGB_PER_EQ_BRIGHT (255.0 * 255.0 / 219.0)
+/* eq contrast pivots at luma code 128 = RGB 130.4 */
+#define FFP_EQ_PIVOT_RGB (112.0 * 255.0 / 219.0)
+
+/* ffmpeg eq parameters -> raw video processor filter levels (FFP_LV_OFF: filter off), see the file header. The video
+ * processor scales contrast about black while eq scales about mid grey; the difference, c * x + 130.4 * (1 - c), is an
+ * offset that is added with the brightness filter (calibrated by the probe: bri_k RGB codes per level, applied after the
+ * contrast scaling or before it, bri_after). Returns -1 if a filter is missing or a level is outside the driver's range
+ * (lv[] then holds clamped levels). */
+static int ffp_pp_levels(const FFPD3D11Limits *l, const FFPPresParams *pp, int lv[3])
+{
+    double c = pp->contrast, s = pp->saturation, b_rgb, v;
+    int bad = 0;
+
+    lv[0] = lv[1] = lv[2] = FFP_LV_OFF;
+    if (!pp->eq_on)
+        return 0;
+    b_rgb = pp->brightness * FFP_RGB_PER_EQ_BRIGHT + (c != 1.0 ? FFP_EQ_PIVOT_RGB * (1.0 - c) : 0.0);
+    if (c != 1.0) {
+        if (!l->has_contrast) {
+            bad = 1;
+        } else {
+            v = c * l->lv_def[1];
+            bad |= v < l->lv_min[1] - 0.5 || v > l->lv_max[1] + 0.5;
+            lv[1] = av_clip((int)lrint(v), l->lv_min[1], l->lv_max[1]);
+        }
+    }
+    if (s != 1.0) {
+        if (!l->has_saturation) {
+            bad = 1;
+        } else {
+            v = s * l->lv_def[2];
+            bad |= v < l->lv_min[2] - 0.5 || v > l->lv_max[2] + 0.5;
+            lv[2] = av_clip((int)lrint(v), l->lv_min[2], l->lv_max[2]);
+        }
+    }
+    if (fabs(b_rgb) > 1e-9) {
+        if (!l->has_brightness || l->bri_k <= 0) {
+            bad = 1;
+        } else {
+            v = b_rgb / l->bri_k;
+            if (!l->bri_after && lv[1] != FFP_LV_OFF && c != 0.0)
+                v /= c;
+            bad |= v < l->lv_min[0] - 0.5 || v > l->lv_max[0] + 0.5;
+            lv[0] = av_clip((int)lrint(v), l->lv_min[0], l->lv_max[0]);
+        }
+    }
+    return bad ? -1 : 0;
+}
+
+static void ffp_vp_setup(ID3D11VideoContext *vc, ID3D11VideoContext1 *vc1, ID3D11VideoProcessor *vp,
+                         const FFPD3D11Limits *l, const FFPPresParams *pp, const int lv[3], DXGI_COLOR_SPACE_TYPE in_cs,
+                         const RECT *src, const RECT *dst, const RECT *target)
+{
+    D3D11_VIDEO_COLOR bg;
+    int rot = pp->rotation, fh = pp->flip_h, fv = pp->flip_v;
+    static const D3D11_VIDEO_PROCESSOR_FILTER filt[3] = {
+        D3D11_VIDEO_PROCESSOR_FILTER_BRIGHTNESS, D3D11_VIDEO_PROCESSOR_FILTER_CONTRAST, D3D11_VIDEO_PROCESSOR_FILTER_SATURATION,
+    };
+    int i;
+
+    memset(&bg, 0, sizeof(bg));
+    bg.RGBA.A = 1.0f;
+    vc->lpVtbl->VideoProcessorSetOutputBackgroundColor(vc, vp, FALSE, &bg);
+    vc->lpVtbl->VideoProcessorSetOutputTargetRect(vc, vp, TRUE, target);
+    vc->lpVtbl->VideoProcessorSetStreamFrameFormat(vc, vp, 0, D3D11_VIDEO_FRAME_FORMAT_PROGRESSIVE);
+    vc->lpVtbl->VideoProcessorSetStreamAutoProcessingMode(vc, vp, 0, FALSE);
+    vc->lpVtbl->VideoProcessorSetStreamSourceRect(vc, vp, 0, TRUE, src);
+    vc->lpVtbl->VideoProcessorSetStreamDestRect(vc, vp, 0, TRUE, dst);
+    if (vc1) {
+        vc1->lpVtbl->VideoProcessorSetStreamColorSpace1(vc1, vp, 0, in_cs);
+        vc1->lpVtbl->VideoProcessorSetOutputColorSpace1(vc1, vp, DXGI_COLOR_SPACE_RGB_FULL_G22_NONE_P709);
+    } else {
+        D3D11_VIDEO_PROCESSOR_COLOR_SPACE cs;
+        memset(&cs, 0, sizeof(cs));
+        if (in_cs == DXGI_COLOR_SPACE_RGB_FULL_G22_NONE_P709) {
+            cs.RGB_Range = 0;
+        } else {
+            cs.YCbCr_Matrix = (in_cs == DXGI_COLOR_SPACE_YCBCR_STUDIO_G22_LEFT_P601 ||
+                               in_cs == DXGI_COLOR_SPACE_YCBCR_FULL_G22_LEFT_P601) ? 0 : 1;
+            cs.Nominal_Range = (in_cs == DXGI_COLOR_SPACE_YCBCR_FULL_G22_LEFT_P601 ||
+                                in_cs == DXGI_COLOR_SPACE_YCBCR_FULL_G22_LEFT_P709 ||
+                                in_cs == DXGI_COLOR_SPACE_YCBCR_FULL_G22_LEFT_P2020) ? 2 : 1;
+        }
+        vc->lpVtbl->VideoProcessorSetStreamColorSpace(vc, vp, 0, &cs);
+        memset(&cs, 0, sizeof(cs));
+        vc->lpVtbl->VideoProcessorSetOutputColorSpace(vc, vp, &cs);
+    }
+
+    /* rotation (clockwise), then the flips; a driver that mirrors before it rotates gets the flips of the
+     * other axis for 90/270 (H after a 90 degree rotation == V before it) */
+    if (l->mirror_before_rot && (rot == 90 || rot == 270)) {
+        int t = fh;
+        fh = fv;
+        fv = t;
+    }
+    vc->lpVtbl->VideoProcessorSetStreamRotation(vc, vp, 0, rot != 0,
+                                                rot == 90 ? D3D11_VIDEO_PROCESSOR_ROTATION_90 :
+                                                rot == 180 ? D3D11_VIDEO_PROCESSOR_ROTATION_180 :
+                                                rot == 270 ? D3D11_VIDEO_PROCESSOR_ROTATION_270 :
+                                                             D3D11_VIDEO_PROCESSOR_ROTATION_IDENTITY);
+    if (vc1 && l->mirror)
+        vc1->lpVtbl->VideoProcessorSetStreamMirror(vc1, vp, 0, fh || fv, fh, fv);
+
+    for (i = 0; i < 3; i++) {
+        int has = i == 0 ? l->has_brightness : i == 1 ? l->has_contrast : l->has_saturation;
+
+        if (!has)
+            continue;
+        if (lv[i] == FFP_LV_OFF)
+            vc->lpVtbl->VideoProcessorSetStreamFilter(vc, vp, 0, filt[i], FALSE, 0);
+        else
+            vc->lpVtbl->VideoProcessorSetStreamFilter(vc, vp, 0, filt[i], TRUE, lv[i]);
+    }
+}
+
+
+static ID3D11Texture2D *ffp_make_tex(ID3D11Device *dev, int w, int h, DXGI_FORMAT fmt, D3D11_USAGE usage, UINT bind,
+                                     UINT cpu, const void *data, UINT pitch)
+{
+    D3D11_TEXTURE2D_DESC t;
+    D3D11_SUBRESOURCE_DATA sd;
+    ID3D11Texture2D *tx = NULL;
+
+    memset(&t, 0, sizeof(t));
+    t.Width = w;
+    t.Height = h;
+    t.MipLevels = 1;
+    t.ArraySize = 1;
+    t.Format = fmt;
+    t.SampleDesc.Count = 1;
+    t.Usage = usage;
+    t.BindFlags = bind;
+    t.CPUAccessFlags = cpu;
+    sd.pSysMem = data;
+    sd.SysMemPitch = pitch;
+    sd.SysMemSlicePitch = 0;
+    if (FAILED(dev->lpVtbl->CreateTexture2D(dev, &t, data ? &sd : NULL, &tx)))
+        return NULL;
+    return tx;
+}
+
+static int ffp_quadrant_color(uint32_t px)
+{
+    switch (px & 0xFFFFFF) {
+    case 0xFF0000: return 'R';
+    case 0x00FF00: return 'G';
+    case 0x0000FF: return 'B';
+    case 0xFFFFFF: return 'W';
+    case 0x000000: return 'K';
+    }
+    return '?';
+}
+
+/* renders a 64x32 R/G/B/W quadrant picture into 64x64 with the given rotation / mirror and returns the colours at
+ * the centres of the four output quadrants (TL TR BL BR) */
+static int ffp_selftest_blt(ID3D11Device *dev, ID3D11DeviceContext *ctx, ID3D11VideoDevice *vd, ID3D11VideoContext *vc,
+                            ID3D11VideoContext1 *vc1, const FFPD3D11Limits *l, int rot, int mirror_h, int nv12_y,
+                            const int lv_in[3], int *center, char out[5])
+{
+    FFPVP v;
+    uint32_t px[64 * 32];
+    ID3D11Texture2D *in = NULL, *tex_out = NULL, *stg = NULL;
+    ID3D11VideoProcessorInputView *iv = NULL;
+    ID3D11VideoProcessorOutputView *ov = NULL;
+    D3D11_VIDEO_PROCESSOR_OUTPUT_VIEW_DESC od;
+    D3D11_VIDEO_PROCESSOR_STREAM st;
+    D3D11_MAPPED_SUBRESOURCE m;
+    FFPPresParams pp;
+    RECT src = { 0, 0, 64, 32 }, dst = { 0, 0, 64, 64 };
+    char err[64];
+    int x, y, ret = -1;
+    int lv_off[3] = { FFP_LV_OFF, FFP_LV_OFF, FFP_LV_OFF };
+    uint8_t nv[64 * 32 * 3 / 2];
+
+    memset(&v, 0, sizeof(v));
+    for (y = 0; y < 32; y++)
+        for (x = 0; x < 64; x++)
+            px[y * 64 + x] = (y < 16) ? (x < 32 ? 0xFFFF0000u : 0xFF00FF00u) : (x < 32 ? 0xFF0000FFu : 0xFFFFFFFFu);
+    if (nv12_y >= 0) {              /* flat NV12 gray (limited range BT.709) */
+        memset(nv, nv12_y, 64 * 32);
+        memset(nv + 64 * 32, 128, 64 * 16);
+        in = ffp_make_tex(dev, 64, 32, DXGI_FORMAT_NV12, D3D11_USAGE_DEFAULT,
+                          D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET, 0, nv, 64);
+    } else
+    in = ffp_make_tex(dev, 64, 32, DXGI_FORMAT_B8G8R8A8_UNORM, D3D11_USAGE_DEFAULT,
+                      D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET, 0, px, 64 * 4);
+    tex_out = ffp_make_tex(dev, 64, 64, DXGI_FORMAT_B8G8R8A8_UNORM, D3D11_USAGE_DEFAULT, D3D11_BIND_RENDER_TARGET, 0, NULL, 0);
+    stg = ffp_make_tex(dev, 64, 64, DXGI_FORMAT_B8G8R8A8_UNORM, D3D11_USAGE_STAGING, 0, D3D11_CPU_ACCESS_READ, NULL, 0);
+    if (!in || !tex_out || !stg)
+        goto end;
+    if (ffp_vp_ensure(vd, &v, 64, 32, 64, 64, err, sizeof(err)) < 0)
+        goto end;
+    iv = ffp_vp_input_view(vd, &v, in, 0, err, sizeof(err));
+    memset(&od, 0, sizeof(od));
+    od.ViewDimension = D3D11_VPOV_DIMENSION_TEXTURE2D;
+    if (!iv || FAILED(vd->lpVtbl->CreateVideoProcessorOutputView(vd, (ID3D11Resource *)tex_out, v.en, &od, &ov)))
+        goto end;
+    ffp_pres_params_identity(&pp);
+    pp.rotation = rot;
+    pp.flip_h = mirror_h;
+    {
+        FFPD3D11Limits tl = *l;
+        tl.mirror = mirror_h ? 1 : l->mirror;
+        tl.mirror_before_rot = 0;
+        ffp_vp_setup(vc, vc1, v.vp, &tl, &pp, lv_in ? lv_in : lv_off,
+                      nv12_y >= 0 ? DXGI_COLOR_SPACE_YCBCR_STUDIO_G22_LEFT_P709 : DXGI_COLOR_SPACE_RGB_FULL_G22_NONE_P709, &src, &dst, &dst);
+    }
+    memset(&st, 0, sizeof(st));
+    st.Enable = TRUE;
+    st.pInputSurface = iv;
+    if (FAILED(vc->lpVtbl->VideoProcessorBlt(vc, v.vp, ov, 0, 1, &st)))
+        goto end;
+    ctx->lpVtbl->CopyResource(ctx, (ID3D11Resource *)stg, (ID3D11Resource *)tex_out);
+    if (FAILED(ctx->lpVtbl->Map(ctx, (ID3D11Resource *)stg, 0, D3D11_MAP_READ, 0, &m)))
+        goto end;
+#define PXAT(x_, y_) (*(uint32_t *)((char *)m.pData + (y_) * m.RowPitch + (x_) * 4))
+    if (center)
+        *center = PXAT(32, 32) & 0xFF;
+    out[0] = ffp_quadrant_color(PXAT(16, 16));
+    out[1] = ffp_quadrant_color(PXAT(48, 16));
+    out[2] = ffp_quadrant_color(PXAT(16, 48));
+    out[3] = ffp_quadrant_color(PXAT(48, 48));
+#undef PXAT
+    out[4] = 0;
+    ctx->lpVtbl->Unmap(ctx, (ID3D11Resource *)stg, 0);
+    ret = 0;
+end:
+    ffp_vp_free(&v);
+    FFP_REL(ov);
+    FFP_REL(in);
+    FFP_REL(tex_out);
+    FFP_REL(stg);
+    return ret;
+}
+
+static void ffp_probe_filters(ID3D11VideoProcessorEnumerator *en, const D3D11_VIDEO_PROCESSOR_CAPS *caps, FFPD3D11Limits *l)
+{
+    static const D3D11_VIDEO_PROCESSOR_FILTER filt[3] = {
+        D3D11_VIDEO_PROCESSOR_FILTER_BRIGHTNESS, D3D11_VIDEO_PROCESSOR_FILTER_CONTRAST, D3D11_VIDEO_PROCESSOR_FILTER_SATURATION,
+    };
+    static const UINT bits[3] = {
+        D3D11_VIDEO_PROCESSOR_FILTER_CAPS_BRIGHTNESS, D3D11_VIDEO_PROCESSOR_FILTER_CAPS_CONTRAST,
+        D3D11_VIDEO_PROCESSOR_FILTER_CAPS_SATURATION,
+    };
+    int *has[3] = { &l->has_brightness, &l->has_contrast, &l->has_saturation };
+    double *lo[3] = { &l->bri_min, &l->con_min, &l->sat_min };
+    double *hi[3] = { &l->bri_max, &l->con_max, &l->sat_max };
+    int i;
+
+    for (i = 0; i < 3; i++) {
+        D3D11_VIDEO_PROCESSOR_FILTER_RANGE r;
+
+        *has[i] = 0;
+        *lo[i] = i == 0 ? 0.0 : 1.0;
+        *hi[i] = *lo[i];
+        if (!(caps->FilterCaps & bits[i]))
+            continue;
+        if (FAILED(en->lpVtbl->GetVideoProcessorFilterRange(en, filt[i], &r)))
+            continue;
+        if (r.Multiplier <= 0 || r.Minimum > r.Maximum)
+            continue;
+        l->lv_min[i] = r.Minimum;
+        l->lv_max[i] = r.Maximum;
+        l->lv_def[i] = r.Default;
+        l->lv_mult[i] = r.Multiplier;
+        *has[i] = 1;
+        if (i == 0) {
+            double unit = r.Multiplier * (fabs(r.Maximum * r.Multiplier) <= 1.5 ? 100.0 : 1.0);
+            *lo[i] = r.Minimum * unit / 100.0;
+            *hi[i] = r.Maximum * unit / 100.0;
+        } else {
+            double def = r.Default * r.Multiplier;
+            if (def <= 0)
+                def = r.Multiplier * 1.0;
+            *lo[i] = r.Minimum * r.Multiplier / def;
+            *hi[i] = r.Maximum * r.Multiplier / def;
+        }
+    }
+    l->procamp = l->has_brightness || l->has_contrast || l->has_saturation;
+}
+
+/* Measures the brightness filter of this driver with a flat gray picture: RGB code values per level (bri_k) and
+ * whether it acts after the contrast scaling (bri_after). A filter that does nothing is not offered. */
+static void ffp_calibrate_procamp(ID3D11Device *dev, ID3D11DeviceContext *ctx, ID3D11VideoDevice *vd, ID3D11VideoContext *vc,
+                                  ID3D11VideoContext1 *vc1, FFPD3D11Limits *l)
+{
+    const int gray = 102;                       /* NV12 Y code 102 = RGB 100 (limited range) */
+    int off[3] = { FFP_LV_OFF, FFP_LV_OFF, FFP_LV_OFF };
+    int lv[3], c0 = -1, c1 = -1, c2 = -1, c3 = -1, test;
+    char q[5];
+
+    l->bri_k = 0;
+    l->bri_after = 1;
+    if (!l->has_brightness)
+        return;
+    test = av_clip(30, l->lv_min[0], l->lv_max[0]);
+    lv[0] = test; lv[1] = lv[2] = FFP_LV_OFF;
+    if (test <= 0 || ffp_selftest_blt(dev, ctx, vd, vc, vc1, l, 0, 0, gray, off, &c0, q) < 0 ||
+        ffp_selftest_blt(dev, ctx, vd, vc, vc1, l, 0, 0, gray, lv, &c1, q) < 0 || c1 <= c0) {
+        l->has_brightness = 0;
+        l->procamp = l->has_contrast || l->has_saturation;
+        return;
+    }
+    l->bri_k = (double)(c1 - c0) / test;
+    if (l->has_contrast) {
+        int lvc = av_clip((int)lrint(1.5 * l->lv_def[1]), l->lv_min[1], l->lv_max[1]);
+        double s;
+
+        lv[0] = FFP_LV_OFF; lv[1] = lvc; lv[2] = FFP_LV_OFF;
+        if (ffp_selftest_blt(dev, ctx, vd, vc, vc1, l, 0, 0, gray, lv, &c3, q) >= 0 && c3 > 0) {
+            s = (double)c3 / c0;
+            lv[0] = av_clip(20, l->lv_min[0], l->lv_max[0]);
+            if (ffp_selftest_blt(dev, ctx, vd, vc, vc1, l, 0, 0, gray, lv, &c2, q) >= 0 && c2 > 0) {
+                double after = s * c0 + lv[0] * l->bri_k, before = s * (c0 + lv[0] * l->bri_k);
+                l->bri_after = fabs(c2 - after) <= fabs(c2 - before);
+            }
+        }
+    }
+    l->bri_min = l->lv_min[0] * l->bri_k / FFP_RGB_PER_EQ_BRIGHT;
+    l->bri_max = l->lv_max[0] * l->bri_k / FFP_RGB_PER_EQ_BRIGHT;
+}
+
+static int ffp_probe_limits_dev(ID3D11Device *dev, ID3D11DeviceContext *ctx, FFPD3D11Limits *l)
+{
+    ID3D11VideoDevice *vd = NULL;
+    ID3D11VideoContext *vc = NULL;
+    ID3D11VideoContext1 *vc1 = NULL;
+    ID3D11VideoProcessorEnumerator *en = NULL;
+    D3D11_VIDEO_PROCESSOR_CONTENT_DESC cd;
+    D3D11_VIDEO_PROCESSOR_CAPS caps;
+    char q[5];
+    UINT i, fm;
+    HRESULT hr;
+    FFPAdapter ad;
+
+    if (ffp_dev_adapter(dev, &ad) == 0) {
+        av_strlcpy(l->adapter_name, ad.name, sizeof(l->adapter_name));
+        l->adapter_vendor = ad.vendor_id;
+        l->adapter_device = ad.device_id;
+        l->luid_high = ad.luid_high;
+        l->luid_low = ad.luid_low;
+    }
+    if (FAILED(hr = dev->lpVtbl->QueryInterface(dev, &ffp_IID_ID3D11VideoDevice, (void **)&vd)) ||
+        FAILED(hr = ctx->lpVtbl->QueryInterface(ctx, &ffp_IID_ID3D11VideoContext, (void **)&vc))) {
+        snprintf(l->error, sizeof(l->error), "no video device / context (0x%08lx)", (unsigned long)hr);
+        goto end;
+    }
+    ctx->lpVtbl->QueryInterface(ctx, &ffp_IID_ID3D11VideoContext1, (void **)&vc1);
+    memset(&cd, 0, sizeof(cd));
+    cd.InputFrameFormat = D3D11_VIDEO_FRAME_FORMAT_PROGRESSIVE;
+    cd.InputWidth = 64;
+    cd.InputHeight = 32;
+    cd.OutputWidth = 64;
+    cd.OutputHeight = 64;
+    cd.Usage = D3D11_VIDEO_USAGE_PLAYBACK_NORMAL;
+    if (FAILED(hr = vd->lpVtbl->CreateVideoProcessorEnumerator(vd, &cd, &en)) ||
+        FAILED(hr = en->lpVtbl->GetVideoProcessorCaps(en, &caps))) {
+        snprintf(l->error, sizeof(l->error), "video processor enumerator failed (0x%08lx)", (unsigned long)hr);
+        goto end;
+    }
+    ffp_probe_filters(en, &caps, l);
+    for (i = 0; i < caps.RateConversionCapsCount; i++) {
+        D3D11_VIDEO_PROCESSOR_RATE_CONVERSION_CAPS rc;
+        if (SUCCEEDED(en->lpVtbl->GetVideoProcessorRateConversionCaps(en, i, &rc))) {
+            l->proc_caps |= rc.ProcessorCaps;
+            l->telecine_caps |= rc.ITelecineCaps;
+        }
+    }
+    if (SUCCEEDED(en->lpVtbl->CheckVideoProcessorFormat(en, DXGI_FORMAT_NV12, &fm)))
+        l->nv12 = (fm & D3D11_VIDEO_PROCESSOR_FORMAT_SUPPORT_INPUT) != 0;
+    if (SUCCEEDED(en->lpVtbl->CheckVideoProcessorFormat(en, DXGI_FORMAT_P010, &fm)))
+        l->p010 = (fm & D3D11_VIDEO_PROCESSOR_FORMAT_SUPPORT_INPUT) != 0;
+    if (!l->nv12) {
+        snprintf(l->error, sizeof(l->error), "the video processor does not take NV12 input");
+        goto end;
+    }
+
+    /* what the driver really does (the capability bits are not reliable) */
+    if (
+        ffp_selftest_blt(dev, ctx, vd, vc, vc1, l, 90, 0, -1, NULL, NULL, q) >= 0 && !strcmp(q, "BRWG")) {
+        char q2[5];
+        l->rotate = 1;
+        if (ffp_selftest_blt(dev, ctx, vd, vc, vc1, l, 180, 0, -1, NULL, NULL, q2) < 0 || strcmp(q2, "WBGR") ||
+            ffp_selftest_blt(dev, ctx, vd, vc, vc1, l, 270, 0, -1, NULL, NULL, q2) < 0 || strcmp(q2, "GWRB"))
+            l->rotate = 0;
+    }
+    if (vc1) {              /* the MIRROR feature bit is not trusted either way: test it */
+        /* on a video processor without the feature bit the attempt is an error of the debug layer: expected, not reported */
+        int quiet = !(caps.FeatureCaps & D3D11_VIDEO_PROCESSOR_FEATURE_CAPS_MIRROR);
+
+        if (quiet)
+            ffp_dbg_quiet(dev, 1);
+        if (ffp_selftest_blt(dev, ctx, vd, vc, vc1, l, 0, 1, -1, NULL, NULL, q) >= 0 && !strcmp(q, "GRWB")) {
+            l->mirror = 1;
+            if (l->rotate && ffp_selftest_blt(dev, ctx, vd, vc, vc1, l, 90, 1, -1, NULL, NULL, q) >= 0) {
+                /* rotate 90 then mirror: R B G W; mirror then rotate 90: W G B R */
+                if (!strcmp(q, "RBGW"))
+                    l->mirror_before_rot = 0;
+                else if (!strcmp(q, "WGBR"))
+                    l->mirror_before_rot = 1;
+                else
+                    l->mirror = 0;
+            }
+        }
+        if (quiet)
+            ffp_dbg_quiet(dev, 0);
+    }
+    ffp_calibrate_procamp(dev, ctx, vd, vc, vc1, l);
+    l->ok = 1;
+end:
+    FFP_REL(en);
+    FFP_REL(vc1);
+    FFP_REL(vc);
+    FFP_REL(vd);
+    return l->ok ? 0 : -1;
+}
+
+#define FFP_LIMITS_CACHE 4
+
+static SRWLOCK g_limits_lock = SRWLOCK_INIT;
+static struct {
+    int used, adapter_set;
+    uint32_t high, low;
+    FFPD3D11Limits l;               /* as probed: no capability masked */
+} g_limits_cache[FFP_LIMITS_CACHE];
+static FFPD3D11Config g_probe_cfg;
+
+void ffp_d3d11_set_probe_config(const FFPD3D11Config *cfg)
+{
+    g_probe_cfg = *cfg;
+}
+
+const FFPD3D11Config *ffp_d3d11_probe_config(void)
+{
+    return &g_probe_cfg;
+}
+
+/* d3d11_force_caps, the bits that belong to the video processor limits (the others are applied by the presenter) */
+static void ffp_apply_force(FFPD3D11Limits *l, unsigned mask)
+{
+    l->forced = mask;
+    if (mask & FFP_FORCE_P010)
+        l->p010 = 0;
+    if (mask & FFP_FORCE_ROTATE)
+        l->rotate = 0;
+    if (mask & FFP_FORCE_MIRROR)
+        l->mirror = 0;
+    if (mask & FFP_FORCE_PROCAMP) {
+        l->procamp = 0;
+        l->has_brightness = l->has_contrast = l->has_saturation = 0;
+        l->bri_min = l->bri_max = 0.0;
+        l->con_min = l->con_max = l->sat_min = l->sat_max = 1.0;
+    }
+}
+
+int ffp_d3d11_get_limits_cfg(const FFPD3D11Config *cfg, FFPD3D11Limits *out)
+{
+    int set = cfg && cfg->adapter_set, i;
+
+    AcquireSRWLockExclusive(&g_limits_lock);
+    for (i = 0; i < FFP_LIMITS_CACHE; i++)
+        if (g_limits_cache[i].used && g_limits_cache[i].adapter_set == set &&
+            (!set || (g_limits_cache[i].high == cfg->luid_high && g_limits_cache[i].low == cfg->luid_low)))
+            break;
+    if (i == FFP_LIMITS_CACHE) {
+        FFPD3D11Limits l;
+        FFPD3D11Config dc;
+        ID3D11Device *dev = NULL;
+        ID3D11DeviceContext *ctx = NULL;
+        FFPD3DDebug *dbg = NULL;
+        HRESULT hr;
+
+        memset(&l, 0, sizeof(l));
+        l.con_min = l.con_max = l.sat_min = l.sat_max = 1.0;
+        memset(&dc, 0, sizeof(dc));
+        if (set) {
+            dc.adapter_set = 1;
+            dc.luid_high = cfg->luid_high;
+            dc.luid_low = cfg->luid_low;
+        }
+        dc.debug = cfg ? cfg->debug : 0;
+        hr = ffp_create_device(&dc, &dev, &ctx, &dbg);
+        if (FAILED(hr)) {
+            ffp_create_device_error(&dc, hr, l.error, sizeof(l.error));
+        } else {
+            ffp_probe_limits_dev(dev, ctx, &l);
+            ffp_dbg_drain(dbg, "probe", 0);
+        }
+        ffp_dbg_free(dbg);
+        FFP_REL(ctx);
+        FFP_REL(dev);
+        if (hr == DXGI_ERROR_NOT_FOUND) {           /* not cached: the GPU may show up later */
+            *out = l;
+            ReleaseSRWLockExclusive(&g_limits_lock);
+            return 0;
+        }
+        for (i = 0; i < FFP_LIMITS_CACHE && g_limits_cache[i].used; i++)
+            ;
+        if (i == FFP_LIMITS_CACHE) {
+            memmove(g_limits_cache, g_limits_cache + 1, (FFP_LIMITS_CACHE - 1) * sizeof(g_limits_cache[0]));
+            i = FFP_LIMITS_CACHE - 1;
+        }
+        g_limits_cache[i].used = 1;
+        g_limits_cache[i].adapter_set = set;
+        g_limits_cache[i].high = set ? cfg->luid_high : 0;
+        g_limits_cache[i].low = set ? cfg->luid_low : 0;
+        g_limits_cache[i].l = l;
+    }
+    *out = g_limits_cache[i].l;
+    ffp_apply_force(out, cfg ? cfg->force : 0);
+    ReleaseSRWLockExclusive(&g_limits_lock);
+    return out->ok ? 1 : 0;
+}
+
+int ffp_d3d11_get_limits(FFPD3D11Limits *out)
+{
+    return ffp_d3d11_get_limits_cfg(NULL, out);
+}
+
+int ffp_d3d11_get_probe_limits(FFPD3D11Limits *out)
+{
+    return ffp_d3d11_get_limits_cfg(&g_probe_cfg, out);
+}
+
+int ffp_d3d11_check_params(const FFPD3D11Limits *l, const FFPPresParams *p, char *err, size_t err_size)
+{
+    const double eps = 1e-6;
+
+    if (!l->ok) {
+        snprintf(err, err_size, "d3d11 presenter unavailable: %s", l->error);
+        return -1;
+    }
+    if (p->rotation && !l->rotate) {
+        snprintf(err, err_size, "the video processor cannot rotate");
+        return -1;
+    }
+    if ((p->flip_h || p->flip_v) && !l->mirror) {
+        snprintf(err, err_size, "the video processor cannot mirror on this GPU/driver");
+        return -1;
+    }
+    if (!p->eq_on)
+        return 0;
+    if (fabs(p->gamma - 1.0) > eps) {
+        snprintf(err, err_size, "gamma is not supported by the video processor");
+        return -1;
+    }
+    {
+        int lv[3];
+
+        if (ffp_pp_levels(l, p, lv) < 0) {
+            snprintf(err, err_size, "eq (brightness %.3f contrast %.3f saturation %.3f) outside what the video processor does: "
+                     "brightness %s[%.3f, %.3f] at contrast 1, contrast %s[%.2f, %.2f], saturation %s[%.2f, %.2f] "
+                     "(a contrast other than 1 uses part of the brightness range)",
+                     p->brightness, p->contrast, p->saturation,
+                     l->has_brightness ? "" : "unsupported ", l->has_brightness ? l->bri_min : 0.0, l->has_brightness ? l->bri_max : 0.0,
+                     l->has_contrast ? "" : "unsupported ", l->has_contrast ? l->con_min : 1.0, l->has_contrast ? l->con_max : 1.0,
+                     l->has_saturation ? "" : "unsupported ", l->has_saturation ? l->sat_min : 1.0, l->has_saturation ? l->sat_max : 1.0);
+            return -1;
+        }
+    }
+    return 0;
+}
+
+void ffp_d3d11_caps_entry(AVBPrint *bp)
+{
+    FFPD3D11Limits l;
+    int ok = ffp_d3d11_get_probe_limits(&l);
+    int first = 1;
+
+    av_bprintf(bp, "{\"name\":\"d3d11\",\"ok\":%s,\"error\":\"", ok ? "true" : "false");
+    {
+        const char *s;
+        for (s = l.error; *s; s++) {
+            if (*s == '"' || *s == '\\')
+                av_bprintf(bp, "\\%c", *s);
+            else if ((unsigned char)*s >= 0x20)
+                av_bprintf(bp, "%c", *s);
+        }
+    }
+    av_bprintf(bp, "\",\"inputs\":[\"d3d11\",\"system\"],\"import\":{\"cuda\":false},\"vp\":{");
+    av_bprintf(bp, "\"rotate\":%s,\"mirror\":%s,\"procamp\":%s,\"p010\":%s,", l.rotate ? "true" : "false",
+               l.mirror ? "true" : "false", l.procamp ? "true" : "false", l.p010 ? "true" : "false");
+    av_bprintf(bp, "\"brightness\":[%.3f,%.3f],\"contrast\":[%.3f,%.3f],\"saturation\":[%.3f,%.3f],",
+               l.has_brightness ? l.bri_min * 100.0 : 0.0, l.has_brightness ? l.bri_max * 100.0 : 0.0,
+               l.con_min, l.con_max, l.sat_min, l.sat_max);
+    av_bprintf(bp, "\"deinterlace\":[");
+    if (l.proc_caps & D3D11_VIDEO_PROCESSOR_PROCESSOR_CAPS_DEINTERLACE_BLEND) {
+        av_bprintf(bp, "%s\"blend\"", first ? "" : ",");
+        first = 0;
+    }
+    if (l.proc_caps & D3D11_VIDEO_PROCESSOR_PROCESSOR_CAPS_DEINTERLACE_BOB) {
+        av_bprintf(bp, "%s\"bob\"", first ? "" : ",");
+        first = 0;
+    }
+    if (l.proc_caps & D3D11_VIDEO_PROCESSOR_PROCESSOR_CAPS_DEINTERLACE_ADAPTIVE) {
+        av_bprintf(bp, "%s\"adaptive\"", first ? "" : ",");
+        first = 0;
+    }
+    if (l.proc_caps & D3D11_VIDEO_PROCESSOR_PROCESSOR_CAPS_DEINTERLACE_MOTION_COMPENSATION) {
+        av_bprintf(bp, "%s\"motion\"", first ? "" : ",");
+        first = 0;
+    }
+    av_bprintf(bp, "],\"telecine\":%s},\"shader\":false", l.telecine_caps ? "true" : "false");
+    if (l.forced) {
+        av_bprintf(bp, ",\"forced\":[");
+        ffp_d3d11_force_names_json(bp, l.forced);
+        av_bprintf(bp, "]");
+    }
+    av_bprintf(bp, "}");
+}
