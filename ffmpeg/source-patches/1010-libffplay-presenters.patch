+void ffp_d3d11_record_fallback(FFPD3D11 *p, const char *name)
+{
+    int i;
+
+    if (!p || !name)
+        return;
+    EnterCriticalSection(&p->fb_cs);
+    for (i = 0; i < p->nb_fallbacks; i++)
+        if (!strcmp(p->fallbacks[i], name))
+            break;
+    if (i == p->nb_fallbacks && i < FFP_MAX_FALLBACKS) {
+        av_strlcpy(p->fallbacks[i], name, sizeof(p->fallbacks[i]));
+        p->nb_fallbacks++;
+        av_log(NULL, AV_LOG_VERBOSE, "d3d11 presenter fallback: %s\n", name);
+    }
+    LeaveCriticalSection(&p->fb_cs);
+}
+
+static void ffp_json_str(AVBPrint *bp, const char *s)
+{
+    av_bprintf(bp, "\"");
+    for (; *s; s++) {
+        if (*s == '"' || *s == '\\')
+            av_bprintf(bp, "\\%c", *s);
+        else if ((unsigned char)*s >= 0x20)
+            av_bprintf(bp, "%c", *s);
+    }
+    av_bprintf(bp, "\"");
+}
+
+void ffp_d3d11_debug_json(FFPD3D11 *p, AVBPrint *bp)
+{
+    char luid[24];
+    int i;
+
+    ffp_luid_text(luid, sizeof(luid), p->adapter.luid_high, p->adapter.luid_low);
+    av_bprintf(bp, ",\"adapter\":{\"name\":");
+    ffp_json_str(bp, p->adapter.name);
+    av_bprintf(bp, ",\"vendor_id\":%u,\"luid\":\"%s\"},\"debug_layer\":%s,\"debug_messages\":%ld,\"fallbacks\":[",
+               p->adapter.vendor_id, luid, p->dbg ? "true" : "false",
+               p->dbg ? (long)InterlockedCompareExchange(&p->dbg->messages, 0, 0) : 0L);
+    EnterCriticalSection(&p->fb_cs);
+    for (i = 0; i < p->nb_fallbacks; i++) {
+        av_bprintf(bp, "%s", i ? "," : "");
+        ffp_json_str(bp, p->fallbacks[i]);
+    }
+    LeaveCriticalSection(&p->fb_cs);
+    av_bprintf(bp, "]");
+}
