+/* D3D11 devices of libffplay: adapter selection by LUID, the D3D11 debug layer, AVHWDeviceContext wrapping and the
+ * CUDA device of an adapter. Included by ffplay_d3d11.c (Windows only) after the IIDs. */
+
+static const GUID ffp_IID_IDXGIFactory1   = { 0x770aae78, 0xf26f, 0x4dba, { 0xa8, 0x29, 0x25, 0x3c, 0x83, 0xd1, 0xb3, 0x87 } };
+static const GUID ffp_IID_ID3D11InfoQueue = { 0x6543dbb6, 0x1b48, 0x42f5, { 0xab, 0x82, 0xe9, 0x7e, 0xc7, 0x43, 0x26, 0xf6 } };
+
+typedef struct FFPAdapter {
+    char name[128];
+    unsigned vendor_id, device_id;
+    uint32_t luid_high, luid_low;
+} FFPAdapter;
+
+static void ffp_luid_text(char *buf, size_t n, uint32_t high, uint32_t low)
+{
+    snprintf(buf, n, "%08lx:%08lx", (unsigned long)high, (unsigned long)low);
+}
+
+static void ffp_adapter_from_desc(const DXGI_ADAPTER_DESC *d, FFPAdapter *a)
+{
+    memset(a, 0, sizeof(*a));
+    WideCharToMultiByte(CP_UTF8, 0, d->Description, -1, a->name, sizeof(a->name) - 1, NULL, NULL);
+    a->vendor_id = d->VendorId;
+    a->device_id = d->DeviceId;
+    a->luid_high = (uint32_t)d->AdapterLuid.HighPart;
+    a->luid_low = d->AdapterLuid.LowPart;
+}
+
+static int ffp_dev_adapter(ID3D11Device *dev, FFPAdapter *a)
+{
+    IDXGIDevice *dxdev = NULL;
+    IDXGIAdapter *ad = NULL;
+    DXGI_ADAPTER_DESC desc;
+    int ret = -1;
+
+    if (SUCCEEDED(dev->lpVtbl->QueryInterface(dev, &ffp_IID_IDXGIDevice, (void **)&dxdev)) &&
+        SUCCEEDED(dxdev->lpVtbl->GetAdapter(dxdev, &ad)) && SUCCEEDED(ad->lpVtbl->GetDesc(ad, &desc))) {
+        ffp_adapter_from_desc(&desc, a);
+        ret = 0;
+    }
+    FFP_REL(ad);
+    FFP_REL(dxdev);
+    return ret;
+}
+
+/* a new DXGI factory every time: after a device loss the old one enumerates stale adapters */
+static HRESULT ffp_create_factory(IDXGIFactory1 **f)
+{
+    HMODULE m = LoadLibraryW(L"dxgi.dll");
+    HRESULT (WINAPI *create)(const GUID *, void **);
+
+    *f = NULL;
+    if (!m)
+        return E_FAIL;
+    create = (HRESULT (WINAPI *)(const GUID *, void **))(void *)GetProcAddress(m, "CreateDXGIFactory1");
+    return create ? create(&ffp_IID_IDXGIFactory1, (void **)f) : E_FAIL;
+}
+
+/* The adapter with this LUID (new reference) and its DXGI enumeration index (what the "device" string of the d3d11va /
+ * d3d12va hwcontexts means); DXGI_ERROR_NOT_FOUND if the machine has none. */
+static HRESULT ffp_find_adapter(uint32_t high, uint32_t low, IDXGIAdapter1 **out, int *index)
+{
+    IDXGIFactory1 *f = NULL;
+    HRESULT hr = ffp_create_factory(&f);
+    UINT i;
+
+    *out = NULL;
+    if (FAILED(hr))
+        return hr;
+    hr = DXGI_ERROR_NOT_FOUND;
+    for (i = 0; ; i++) {
+        IDXGIAdapter1 *a = NULL;
+        DXGI_ADAPTER_DESC1 d;
+
+        if (FAILED(f->lpVtbl->EnumAdapters1(f, i, &a)))
+            break;
+        if (SUCCEEDED(a->lpVtbl->GetDesc1(a, &d)) && (uint32_t)d.AdapterLuid.HighPart == high &&
+            d.AdapterLuid.LowPart == low) {
+            *out = a;
+            if (index)
+                *index = (int)i;
+            hr = S_OK;
+            break;
+        }
+        a->lpVtbl->Release(a);
+    }
+    f->lpVtbl->Release(f);
+    return hr;
+}
+
+static void ffp_adapter_error(const FFPD3D11Config *cfg, HRESULT hr, char *err, size_t err_size)
+{
+    char luid[24];
+
+    ffp_luid_text(luid, sizeof(luid), cfg->luid_high, cfg->luid_low);
+    if (hr == DXGI_ERROR_NOT_FOUND)
+        snprintf(err, err_size, "d3d11_adapter_luid %s: this machine has no GPU with that LUID", luid);
+    else
+        snprintf(err, err_size, "d3d11_adapter_luid %s: DXGI adapter lookup failed (0x%08lx)", luid, (unsigned long)hr);
+}
+
+int ffp_d3d11_check_adapter(const FFPD3D11Config *cfg, char *err, size_t err_size)
+{
+    IDXGIAdapter1 *ad = NULL;
+    HRESULT hr;
+
+    if (!cfg || !cfg->adapter_set)
+        return 0;
+    hr = ffp_find_adapter(cfg->luid_high, cfg->luid_low, &ad, NULL);
+    if (FAILED(hr)) {
+        ffp_adapter_error(cfg, hr, err, err_size);
+        return -1;
+    }
+    FFP_REL(ad);
+    return 0;
+}
+
+#define FFP_DBG_IDS 128
+
+typedef struct FFPD3DDebug {
+    ID3D11InfoQueue *iq;
+    CRITICAL_SECTION cs;
+    volatile LONG messages;         /* every message seen, repeated ones included */
+    int nids;
+    int ids[FFP_DBG_IDS];           /* distinct message IDs logged so far */
+    unsigned counts[FFP_DBG_IDS];
+    int64_t last_us;
+} FFPD3DDebug;
+
+/* NULL when the device has no debug layer */
+static FFPD3DDebug *ffp_dbg_create(ID3D11Device *dev)
+{
+    ID3D11InfoQueue *iq = NULL;
+    FFPD3DDebug *d;
+
+    if (FAILED(dev->lpVtbl->QueryInterface(dev, &ffp_IID_ID3D11InfoQueue, (void **)&iq)) || !iq)
+        return NULL;
+    d = av_mallocz(sizeof(*d));
+    if (!d) {
+        iq->lpVtbl->Release(iq);
+        return NULL;
+    }
+    d->iq = iq;
+    InitializeCriticalSection(&d->cs);
+    return d;
+}
+
+static void ffp_dbg_log(FFPD3DDebug *d, const D3D11_MESSAGE *m, const char *where)
+{
+    static const char *const sev[] = { "corruption", "error", "warning", "info", "message" };
+    static const char *const cat[] = { "application", "misc", "initialization", "cleanup", "compilation",
+                                       "state_creation", "state_setting", "state_getting", "resource",
+                                       "execution", "shader" };
+    int level, i;
+
+    InterlockedIncrement(&d->messages);
+    for (i = 0; i < d->nids; i++)
+        if (d->ids[i] == (int)m->ID)
+            break;
+    if (i < d->nids) {
+        d->counts[i]++;
+        return;
+    }
+    if (d->nids < FFP_DBG_IDS) {
+        d->ids[d->nids] = (int)m->ID;
+        d->counts[d->nids++] = 1;
+    }
+    switch (m->Severity) {
+    case D3D11_MESSAGE_SEVERITY_CORRUPTION:
+    case D3D11_MESSAGE_SEVERITY_ERROR:   level = AV_LOG_ERROR;   break;
+    case D3D11_MESSAGE_SEVERITY_WARNING: level = AV_LOG_WARNING; break;
+    case D3D11_MESSAGE_SEVERITY_INFO:    level = AV_LOG_INFO;    break;
+    default:                             level = AV_LOG_VERBOSE; break;
+    }
+    av_log(NULL, level, "d3d11-debug: %s: [%s %s #%d] %s\n", where,
+           (unsigned)m->Severity < FF_ARRAY_ELEMS(sev) ? sev[m->Severity] : "?",
+           (unsigned)m->Category < FF_ARRAY_ELEMS(cat) ? cat[m->Category] : "?", (int)m->ID,
+           m->pDescription ? m->pDescription : "");
+}
+
+/* (windows.h turns the GetMessage member of the vtable into GetMessageA / W: the same macro hits this call) */
+static HRESULT ffp_iq_get_message(ID3D11InfoQueue *iq, UINT64 index, D3D11_MESSAGE *m, SIZE_T *len)
+{
+    return iq->lpVtbl->GetMessage(iq, index, m, len);
+}
+
+/* Moves the stored messages of the device to av_log ("d3d11-debug:"), each message ID once. rate_limited: at most every
+ * 250 ms (the per-frame call). */
+static void ffp_dbg_drain(FFPD3DDebug *d, const char *where, int rate_limited)
+{
+    UINT64 n, i;
+
+    if (!d)
+        return;
+    if (rate_limited && av_gettime_relative() - d->last_us < 250000)
+        return;
+    if (!TryEnterCriticalSection(&d->cs))
+        return;
+    d->last_us = av_gettime_relative();
+    n = d->iq->lpVtbl->GetNumStoredMessages(d->iq);
+    for (i = 0; i < n; i++) {
+        SIZE_T len = 0;
+        D3D11_MESSAGE *m;
+
+        if (FAILED(ffp_iq_get_message(d->iq, i, NULL, &len)) || !len)
+            continue;
+        m = av_malloc(len);
+        if (!m)
+            continue;
+        if (SUCCEEDED(ffp_iq_get_message(d->iq, i, m, &len)))
+            ffp_dbg_log(d, m, where);
+        av_free(m);
+    }
+    if (n)
+        d->iq->lpVtbl->ClearStoredMessages(d->iq);
+    LeaveCriticalSection(&d->cs);
+}
+
+/* on: the debug layer does not store the errors of the calls that follow (a capability self test that is expected to fail);
+ * off: back to normal. No effect without the debug layer. */
+static void ffp_dbg_quiet(ID3D11Device *dev, int on)
+{
+    ID3D11InfoQueue *iq = NULL;
+
+    if (FAILED(dev->lpVtbl->QueryInterface(dev, &ffp_IID_ID3D11InfoQueue, (void **)&iq)) || !iq)
+        return;
+    if (on) {
+        /* (the pushed filter replaces the default one, which does not store INFO messages either) */
+        D3D11_MESSAGE_SEVERITY sev[2] = { D3D11_MESSAGE_SEVERITY_ERROR, D3D11_MESSAGE_SEVERITY_INFO };
+        D3D11_INFO_QUEUE_FILTER f;
+
+        memset(&f, 0, sizeof(f));
+        f.DenyList.NumSeverities = 2;
+        f.DenyList.pSeverityList = sev;
+        iq->lpVtbl->PushStorageFilter(iq, &f);
+    } else {
+        iq->lpVtbl->PopStorageFilter(iq);
+    }
+    iq->lpVtbl->Release(iq);
+}
+
+static void ffp_dbg_free(FFPD3DDebug *d)
+{
+    int i;
+
+    if (!d)
+        return;
+    ffp_dbg_drain(d, "close", 0);
+    for (i = 0; i < d->nids; i++)
+        if (d->counts[i] > 1)
+            av_log(NULL, AV_LOG_INFO, "d3d11-debug: message #%d was repeated %u times\n", d->ids[i], d->counts[i]);
+    d->iq->lpVtbl->Release(d->iq);
+    DeleteCriticalSection(&d->cs);
+    av_free(d);
+}
+
+/* The one place that creates ID3D11Devices. cfg selects the adapter (LUID) and the debug layer (cfg may be NULL). When
+ * dbg is not NULL it receives the debug layer state of the device, NULL if the layer is off or not installed (the
+ * device is then created without D3D11_CREATE_DEVICE_DEBUG). Returns DXGI_ERROR_NOT_FOUND for an unknown LUID. */
+static HRESULT ffp_create_device(const FFPD3D11Config *cfg, ID3D11Device **dev, ID3D11DeviceContext **ctx,
+                                 FFPD3DDebug **dbg)
+{
+    static const D3D_FEATURE_LEVEL levels[] = { D3D_FEATURE_LEVEL_11_1, D3D_FEATURE_LEVEL_11_0 };
+    const UINT base = D3D11_CREATE_DEVICE_VIDEO_SUPPORT | D3D11_CREATE_DEVICE_BGRA_SUPPORT;
+    PFN_D3D11_CREATE_DEVICE fn;
+    HMODULE m = LoadLibraryW(L"d3d11.dll");
+    IDXGIAdapter1 *ad = NULL;
+    ID3D10Multithread *mt = NULL;
+    HRESULT hr = E_FAIL;
+    int pass;
+
+    if (dbg)
+        *dbg = NULL;
+    if (!m)
+        return E_FAIL;
+    fn = (PFN_D3D11_CREATE_DEVICE)(void *)GetProcAddress(m, "D3D11CreateDevice");
+    if (!fn)
+        return E_FAIL;
+    if (cfg && cfg->adapter_set) {
+        hr = ffp_find_adapter(cfg->luid_high, cfg->luid_low, &ad, NULL);
+        if (FAILED(hr))
+            return hr;
+    }
+    for (pass = cfg && cfg->debug ? 1 : 0; pass >= 0; pass--) {
+        UINT flags = base | (pass ? D3D11_CREATE_DEVICE_DEBUG : 0);
+
+        hr = fn((IDXGIAdapter *)ad, ad ? D3D_DRIVER_TYPE_UNKNOWN : D3D_DRIVER_TYPE_HARDWARE, NULL, flags,
+                levels, 2, D3D11_SDK_VERSION, dev, NULL, ctx);
+        if (FAILED(hr))
+            hr = fn((IDXGIAdapter *)ad, ad ? D3D_DRIVER_TYPE_UNKNOWN : D3D_DRIVER_TYPE_HARDWARE, NULL, flags,
+                    levels + 1, 1, D3D11_SDK_VERSION, dev, NULL, ctx);
+        if (SUCCEEDED(hr))
+            break;
+        if (pass)
+            av_log(NULL, AV_LOG_WARNING, "d3d11-debug: the D3D11 debug layer is not available (0x%08lx, "
+                   "DXGI_ERROR_SDK_COMPONENT_MISSING = 0x%08lx), creating the device without it\n",
+                   (unsigned long)hr, (unsigned long)DXGI_ERROR_SDK_COMPONENT_MISSING);
+    }
+    FFP_REL(ad);
+    if (FAILED(hr))
+        return hr;
+    if (dbg && cfg && cfg->debug)
+        *dbg = ffp_dbg_create(*dev);
+    if (SUCCEEDED((*ctx)->lpVtbl->QueryInterface(*ctx, &ffp_IID_ID3D10Multithread, (void **)&mt)) && mt) {
+        ((ID3D10Multithread *)mt)->lpVtbl->SetMultithreadProtected((ID3D10Multithread *)mt, TRUE);
+        ((ID3D10Multithread *)mt)->lpVtbl->Release((ID3D10Multithread *)mt);
+    }
+    return S_OK;
+}
+
+static void ffp_create_device_error(const FFPD3D11Config *cfg, HRESULT hr, char *err, size_t err_size)
+{
+    if (cfg && cfg->adapter_set && hr == DXGI_ERROR_NOT_FOUND)
+        ffp_adapter_error(cfg, hr, err, err_size);
+    else
+        snprintf(err, err_size, "D3D11CreateDevice failed (0x%08lx)", (unsigned long)hr);
+}
+
+static void ffp_hwdev_free(AVHWDeviceContext *ctx)
+{
+    ffp_dbg_free(ctx->user_opaque);
+    ctx->user_opaque = NULL;
+}
+
+/* An AVHWDeviceContext (D3D11VA) around dev, like the one hwcontext_d3d11va creates itself: it takes its own reference
+ * of dev and fills what only d3d11va_device_create fills (device_desc: libavcodec/dxva2.c reads VendorId for its Intel /
+ * AMD workarounds; is_uma). On success the hwdevice owns dbg (final drain when it is freed). flags_nv12 / flags_p010:
+ * AVD3D11VADeviceContext.decoder_bind_flags[_p010]. */
+static int ffp_wrap_hwdevice(ID3D11Device *dev, FFPD3DDebug *dbg, UINT flags_nv12, UINT flags_p010,
+                             AVBufferRef **out, char *err, size_t err_size)
+{
+    AVBufferRef *ref = av_hwdevice_ctx_alloc(AV_HWDEVICE_TYPE_D3D11VA);
+    AVHWDeviceContext *hd;
+    AVD3D11VADeviceContext *hw;
+    IDXGIDevice *dxdev = NULL;
+    IDXGIAdapter *ad = NULL;
+    D3D11_FEATURE_DATA_D3D11_OPTIONS2 o2;
+    int ret;
+
+    *out = NULL;
+    if (!ref) {
+        snprintf(err, err_size, "av_hwdevice_ctx_alloc failed");
+        return AVERROR(ENOMEM);
+    }
+    hd = (AVHWDeviceContext *)ref->data;
+    hw = hd->hwctx;
+    dev->lpVtbl->AddRef(dev);
+    hw->device = dev;
+    memset(&o2, 0, sizeof(o2));
+    if (SUCCEEDED(dev->lpVtbl->CheckFeatureSupport(dev, D3D11_FEATURE_D3D11_OPTIONS2, &o2, sizeof(o2))))
+        hw->is_uma = o2.UnifiedMemoryArchitecture;
+    if (SUCCEEDED(dev->lpVtbl->QueryInterface(dev, &ffp_IID_IDXGIDevice, (void **)&dxdev)) &&
+        SUCCEEDED(dxdev->lpVtbl->GetAdapter(dxdev, &ad)))
+        ad->lpVtbl->GetDesc(ad, &hw->device_desc);
+    FFP_REL(ad);
+    FFP_REL(dxdev);
+    av_log(NULL, AV_LOG_VERBOSE, "d3d11 device: vendor %04x device %04x (%ls), UMA %d\n", (unsigned)hw->device_desc.VendorId,
+           (unsigned)hw->device_desc.DeviceId, hw->device_desc.Description, hw->is_uma);
+    hw->decoder_bind_flags = flags_nv12;
+    hw->decoder_bind_flags_p010 = flags_p010;
+    ret = av_hwdevice_ctx_init(ref);
+    if (ret < 0) {
+        snprintf(err, err_size, "av_hwdevice_ctx_init failed (%s)", av_err2str(ret));
+        av_buffer_unref(&ref);
+        return ret;
+    }
+    if (dbg) {
+        hd->user_opaque = dbg;
+        hd->free = ffp_hwdev_free;
+    }
+    *out = ref;
+    return 0;
+}
+
+int ffp_d3d11_create_hwdevice(const FFPD3D11Config *cfg, AVBufferRef **out, char *err, size_t err_size)
+{
+    ID3D11Device *dev = NULL;
+    ID3D11DeviceContext *ctx = NULL;
+    FFPD3DDebug *dbg = NULL;
+    HRESULT hr;
+    int ret;
+
+    *out = NULL;
+    hr = ffp_create_device(cfg, &dev, &ctx, &dbg);
+    if (FAILED(hr)) {
+        ffp_create_device_error(cfg, hr, err, err_size);
+        return AVERROR_EXTERNAL;
+    }
+    ret = ffp_wrap_hwdevice(dev, dbg, 0, 0, out, err, err_size);
+    FFP_REL(ctx);
+    FFP_REL(dev);
+    if (ret < 0) {
+        ffp_dbg_free(dbg);
+        return ret;
+    }
+    ffp_dbg_drain(dbg, "init", 0);
+    return 0;
+}
+
+unsigned ffp_d3d11_removed_reason(const void *dev)
+{
+    return dev ? (unsigned)((ID3D11Device *)dev)->lpVtbl->GetDeviceRemovedReason((ID3D11Device *)dev) : 0;
+}
+
+int ffp_cuda_ordinal_for_luid(const FFPD3D11Config *cfg, int *ordinal, char *err, size_t err_size)
+{
+    typedef int (__stdcall *FnInit)(unsigned);
+    typedef int (__stdcall *FnCount)(int *);
+    typedef int (__stdcall *FnGet)(int *, int);
+    typedef int (__stdcall *FnLuid)(LUID *, unsigned *, int);
+    HMODULE dll = LoadLibraryW(L"nvcuda.dll");
+    FnInit init;
+    FnCount count;
+    FnGet get;
+    FnLuid luid;
+    char text[24];
+    int n = 0, i;
+
+    ffp_luid_text(text, sizeof(text), cfg->luid_high, cfg->luid_low);
+    if (!dll) {
+        snprintf(err, err_size, "no CUDA device on the adapter with LUID %s: nvcuda.dll is not installed", text);
+        return -1;
+    }
+    init  = (FnInit)(void *)GetProcAddress(dll, "cuInit");
+    count = (FnCount)(void *)GetProcAddress(dll, "cuDeviceGetCount");
+    get   = (FnGet)(void *)GetProcAddress(dll, "cuDeviceGet");
+    luid  = (FnLuid)(void *)GetProcAddress(dll, "cuDeviceGetLuid");
+    if (!init || !count || !get || !luid || init(0) != 0 || count(&n) != 0) {
+        snprintf(err, err_size, "no CUDA device on the adapter with LUID %s: CUDA is not usable", text);
+        return -1;
+    }
+    for (i = 0; i < n; i++) {
+        int dev = 0;
+        LUID l;
+        unsigned mask = 0;
+
+        if (get(&dev, i) == 0 && luid(&l, &mask, dev) == 0 && (uint32_t)l.HighPart == cfg->luid_high &&
+            l.LowPart == cfg->luid_low) {
+            *ordinal = i;
+            return 0;
+        }
+    }
+    snprintf(err, err_size, "no CUDA device on the adapter with LUID %s", text);
+    return -1;
+}
