+/* same rules as ffplay.c calculate_display_rect() */
+static RECT ffp_letterbox(int bw, int bh, int pw, int ph, AVRational sar)
+{
+    AVRational ar = sar;
+    int64_t w, h, x, y;
+    RECT r;
+
+    if (av_cmp_q(ar, av_make_q(0, 1)) <= 0)
+        ar = av_make_q(1, 1);
+    ar = av_mul_q(ar, av_make_q(pw, ph));
+    h = bh;
+    w = av_rescale(h, ar.num, ar.den) & ~1;
+    if (w > bw) {
+        w = bw;
+        h = av_rescale(w, ar.den, ar.num) & ~1;
+    }
+    w = FFMAX(w, 1);
+    h = FFMAX(h, 1);
+    x = (bw - w) / 2;
+    y = (bh - h) / 2;
+    r.left = (LONG)x;
+    r.top = (LONG)y;
+    r.right = (LONG)(x + w);
+    r.bottom = (LONG)(y + h);
+    return r;
+}
