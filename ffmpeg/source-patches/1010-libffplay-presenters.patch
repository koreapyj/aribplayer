+    return -1;
+}
+int ffp_d3d11_check_adapter(const FFPD3D11Config *cfg, char *err, size_t n)
+{
+    if (!cfg || !cfg->adapter_set)
+        return 0;
+    snprintf(err, n, "d3d11_adapter_luid is not supported on this platform");
+    return -1;
+}
+int ffp_d3d11_create_hwdevice(const FFPD3D11Config *cfg, AVBufferRef **out, char *err, size_t n)
