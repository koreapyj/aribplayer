+typedef struct FFPJson {
+    const char *p;
+    char *err;
+    size_t err_size;
+} FFPJson;
+
+static int ffp_json_fail(FFPJson *j, const char *what)
+{
+    if (j->err && j->err_size)
+        snprintf(j->err, j->err_size, "%s", what);
+    return AVERROR(EINVAL);
+}
+
+static void ffp_json_ws(FFPJson *j)
+{
+    while (*j->p == ' ' || *j->p == '\t' || *j->p == '\r' || *j->p == '\n')
+        j->p++;
+}
+
+static int ffp_json_lit(FFPJson *j, const char *lit)
+{
+    size_t n = strlen(lit);
+    if (strncmp(j->p, lit, n))
+        return 0;
+    j->p += n;
+    return 1;
+}
+
+/* string; the decoded value is only kept when out != NULL (every escape is reduced to the escaped char) */
+static int ffp_json_string(FFPJson *j, char *out, size_t size)
+{
+    size_t n = 0;
+
+    if (*j->p != '"')
+        return ffp_json_fail(j, "string expected");
+    j->p++;
+    while (*j->p && *j->p != '"') {
+        char c = *j->p++;
+        if (c == '\\') {
+            if (!*j->p)
+                break;
+            c = *j->p++;
+            if (c == 'u') {
+                int i;
+                for (i = 0; i < 4 && av_isxdigit(*j->p); i++)
+                    j->p++;
+                c = '?';
+            }
+        }
+        if (out && n + 1 < size)
+            out[n++] = c;
+    }
+    if (*j->p != '"')
+        return ffp_json_fail(j, "unterminated string");
+    j->p++;
+    if (out)
+        out[n] = 0;
+    return 0;
+}
+
+static int ffp_json_number(FFPJson *j, double *out)
+{
+    char buf[64];
+    char *tail;
+    size_t n = 0;
+
+    while (n < sizeof(buf) - 1 && (av_isdigit(*j->p) || *j->p == '-' || *j->p == '+' || *j->p == '.' || *j->p == 'e' || *j->p == 'E'))
+        buf[n++] = *j->p++;
+    buf[n] = 0;
+    if (!n)
+        return ffp_json_fail(j, "number expected");
+    *out = av_strtod(buf, &tail);
+    if (*tail || !isfinite(*out))
+        return ffp_json_fail(j, "invalid number");
+    return 0;
+}
+
+static int ffp_json_skip(FFPJson *j, int depth)
+{
+    double d;
+    int ret;
+
+    if (depth > 16)
+        return ffp_json_fail(j, "nesting too deep");
+    ffp_json_ws(j);
+    if (*j->p == '"')
+        return ffp_json_string(j, NULL, 0);
+    if (ffp_json_lit(j, "true") || ffp_json_lit(j, "false") || ffp_json_lit(j, "null"))
+        return 0;
+    if (*j->p == '{' || *j->p == '[') {
+        char close = *j->p == '{' ? '}' : ']';
+        int obj = *j->p == '{';
+        j->p++;
+        ffp_json_ws(j);
+        if (*j->p == close) {
+            j->p++;
+            return 0;
+        }
+        for (;;) {
+            ffp_json_ws(j);
+            if (obj) {
+                if ((ret = ffp_json_string(j, NULL, 0)) < 0)
+                    return ret;
+                ffp_json_ws(j);
+                if (*j->p++ != ':')
+                    return ffp_json_fail(j, "colon expected");
+            }
+            if ((ret = ffp_json_skip(j, depth + 1)) < 0)
+                return ret;
+            ffp_json_ws(j);
+            if (*j->p == ',') {
+                j->p++;
+                continue;
+            }
+            if (*j->p == close) {
+                j->p++;
+                return 0;
+            }
+            return ffp_json_fail(j, "comma or end expected");
+        }
+    }
+    return ffp_json_number(j, &d);
+}
+
+static int ffp_json_bool(FFPJson *j, int *out)
+{
+    ffp_json_ws(j);
+    if (ffp_json_lit(j, "true"))
+        *out = 1;
+    else if (ffp_json_lit(j, "false"))
+        *out = 0;
+    else
+        return ffp_json_fail(j, "true or false expected");
+    return 0;
+}
+
+static int ffp_json_eq(FFPJson *j, FFPPresParams *pp)
+{
+    char key[32];
+    double d;
+    int ret;
+
+    ffp_json_ws(j);
+    if (ffp_json_lit(j, "null")) {
+        pp->eq_on = 0;
+        pp->brightness = 0.0;
+        pp->contrast = pp->saturation = pp->gamma = 1.0;
+        return 0;
+    }
+    if (*j->p++ != '{')
+        return ffp_json_fail(j, "\"eq\" must be an object or null");
+    pp->eq_on = 1;
+    ffp_json_ws(j);
+    if (*j->p == '}') {
+        j->p++;
+        return 0;
+    }
+    for (;;) {
+        double *dst = NULL;
+
+        ffp_json_ws(j);
+        if ((ret = ffp_json_string(j, key, sizeof(key))) < 0)
+            return ret;
+        ffp_json_ws(j);
+        if (*j->p++ != ':')
+            return ffp_json_fail(j, "colon expected");
+        ffp_json_ws(j);
+        if (!strcmp(key, "brightness"))      dst = &pp->brightness;
+        else if (!strcmp(key, "contrast"))   dst = &pp->contrast;
+        else if (!strcmp(key, "saturation")) dst = &pp->saturation;
+        else if (!strcmp(key, "gamma"))      dst = &pp->gamma;
+        if (dst) {
+            if ((ret = ffp_json_number(j, &d)) < 0)
+                return ret;
+            *dst = d;
+        } else if ((ret = ffp_json_skip(j, 2)) < 0) {
+            return ret;
+        }
+        ffp_json_ws(j);
+        if (*j->p == ',') {
+            j->p++;
+            continue;
+        }
+        if (*j->p++ == '}')
+            break;
+        return ffp_json_fail(j, "comma or closing brace expected");
+    }
+    if (pp->brightness < -1.0 || pp->brightness > 1.0)
+        return ffp_json_fail(j, "eq.brightness must be in -1..1");
+    if (pp->saturation < 0.0 || pp->saturation > 3.0)
+        return ffp_json_fail(j, "eq.saturation must be in 0..3");
+    if (pp->contrast < -1000.0 || pp->contrast > 1000.0)
+        return ffp_json_fail(j, "eq.contrast must be in -1000..1000");
+    if (pp->gamma < 0.1 || pp->gamma > 10.0)
+        return ffp_json_fail(j, "eq.gamma must be in 0.1..10");
+    return 0;
+}
+
+/* {"rotation":90,"flip_h":false,"flip_v":false,"eq":{"brightness":0.1,"contrast":1.2,"saturation":1,"gamma":1}}
+ * Absent members are identity (the object replaces all parameters). */
+static int ffp_parse_presenter_params(const char *json, FFPPresParams *out, char *err, size_t err_size)
+{
+    FFPJson j = { json, err, err_size };
+    FFPPresParams pp;
+    char key[32];
+    double d;
+    int ret;
+
+    ffp_pres_params_identity(&pp);
+    ffp_json_ws(&j);
+    if (*j.p++ != '{')
+        return ffp_json_fail(&j, "a JSON object expected");
+    ffp_json_ws(&j);
+    if (*j.p == '}') {
+        j.p++;
+    } else {
+        for (;;) {
+            ffp_json_ws(&j);
+            if ((ret = ffp_json_string(&j, key, sizeof(key))) < 0)
+                return ret;
+            ffp_json_ws(&j);
+            if (*j.p++ != ':')
+                return ffp_json_fail(&j, "colon expected");
+            ffp_json_ws(&j);
+            if (!strcmp(key, "rotation")) {
+                if ((ret = ffp_json_number(&j, &d)) < 0)
+                    return ret;
+                if (d != floor(d) || fmod(d, 90.0) != 0.0)
+                    return ffp_json_fail(&j, "rotation must be 0, 90, 180 or 270");
+                pp.rotation = (((int)d % 360) + 360) % 360;
+            } else if (!strcmp(key, "flip_h")) {
+                if ((ret = ffp_json_bool(&j, &pp.flip_h)) < 0)
+                    return ret;
+            } else if (!strcmp(key, "flip_v")) {
+                if ((ret = ffp_json_bool(&j, &pp.flip_v)) < 0)
+                    return ret;
+            } else if (!strcmp(key, "eq")) {
+                if ((ret = ffp_json_eq(&j, &pp)) < 0)
+                    return ret;
+            } else if ((ret = ffp_json_skip(&j, 1)) < 0) {
+                return ret;
+            }
+            ffp_json_ws(&j);
+            if (*j.p == ',') {
+                j.p++;
+                continue;
+            }
+            if (*j.p++ == '}')
+                break;
+            return ffp_json_fail(&j, "comma or closing brace expected");
+        }
+    }
+    ffp_json_ws(&j);
+    if (*j.p)
+        return ffp_json_fail(&j, "trailing characters");
+    *out = pp;
+    return 0;
+}
+
+static void ffp_json_params(AVBPrint *bp, const FFPPresParams *pp)
+{
+    av_bprintf(bp, "{\"rotation\":%d,\"flip_h\":%s,\"flip_v\":%s,\"eq\":", pp->rotation, pp->flip_h ? "true" : "false",
+               pp->flip_v ? "true" : "false");
+    if (pp->eq_on) {
+        av_bprintf(bp, "{\"brightness\":");
+        json_double(bp, pp->brightness);
+        av_bprintf(bp, ",\"contrast\":");
+        json_double(bp, pp->contrast);
+        av_bprintf(bp, ",\"saturation\":");
+        json_double(bp, pp->saturation);
+        av_bprintf(bp, ",\"gamma\":");
+        json_double(bp, pp->gamma);
+        av_bprintf(bp, "}");
+    } else {
+        av_bprintf(bp, "null");
+    }
+    av_bprintf(bp, "}");
+}
+
+/* can the presenter `d3d11` (0: sdl) apply pp? 0 or a negative value with the reason in err */
+static int ffp_pres_check(int d3d11, const FFPD3D11Config *cfg, const FFPPresParams *pp, char *err, size_t err_size)
+{
+    if (ffp_pres_params_is_identity(pp))
+        return 0;
+    if (!d3d11) {
+        snprintf(err, err_size, "the sdl presenter applies no presenter parameters (keep rotation/flip/eq in the filter graph)");
+        return AVERROR(EINVAL);
+    }
+    {
+        FFPD3D11Limits l;
+
+        ffp_d3d11_get_limits_cfg(cfg, &l);      /* the first call probes the video processor (a few 10 ms) */
+        return ffp_d3d11_check_params(&l, pp, err, err_size) < 0 ? AVERROR(EINVAL) : 0;
+    }
+}
