+void ffp_d3d11_force_names_json(AVBPrint *bp, unsigned mask)
+{
+    size_t i;
+    int first = 1;
+
+    for (i = 0; i < FF_ARRAY_ELEMS(ffp_force_keys); i++) {
+        /* decoder_srv is the pair nv12_srv + p010_srv: listed as those two */
+        if (!strcmp(ffp_force_keys[i].name, "decoder_srv") || !(mask & ffp_force_keys[i].bits))
+            continue;
+        av_bprintf(bp, "%s\"%s=0\"", first ? "" : ",", ffp_force_keys[i].name);
+        first = 0;
+    }
+}
