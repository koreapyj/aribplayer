+/* one side of a LUID: 1..8 hex digits up to the end of s or `stop` */
+static int ffp_parse_hex32(const char *s, char stop, uint32_t *out, const char **end)
+{
+    uint32_t v = 0;
+    int n = 0;
+
+    for (; *s && *s != stop; s++, n++) {
+        int c = *s;
+        int d = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
+        if (d < 0 || n >= 8)
+            return -1;
+        v = v << 4 | d;
+    }
+    if (!n)
+        return -1;
+    *out = v;
+    *end = s;
+    return 0;
+}
+
+int ffp_d3d11_parse_luid(const char *s, FFPD3D11Config *cfg)
+{
+    uint32_t high, low;
+    const char *end;
+
+    if (!s || ffp_parse_hex32(s, ':', &high, &end) < 0 || *end != ':' || ffp_parse_hex32(end + 1, 0, &low, &end) < 0)
+        return -1;
+    cfg->adapter_set = 1;
+    cfg->luid_high = high;
+    cfg->luid_low = low;
+    return 0;
+}
+
+int ffp_d3d11_parse_force(const char *s, unsigned *mask, char *err, size_t err_size)
+{
+    char *copy = av_strdup(s ? s : ""), *tok, *save = NULL;
+    int ret = 0;
+
+    if (!copy) {
+        snprintf(err, err_size, "out of memory");
+        return -1;
+    }
+    for (tok = av_strtok(copy, ",", &save); tok; tok = av_strtok(NULL, ",", &save)) {
+        char *eq = strchr(tok, '=');
+        size_t i;
+
+        while (*tok == ' ')
+            tok++;
+        if (!*tok)
+            continue;
+        if (!eq || strcmp(eq + 1, "0")) {
+            snprintf(err, err_size, "d3d11_force_caps: '%s' is not key=0", tok);
+            ret = -1;
+            break;
+        }
+        *eq = 0;
+        for (i = 0; i < FF_ARRAY_ELEMS(ffp_force_keys); i++)
+            if (!strcmp(ffp_force_keys[i].name, tok))
+                break;
+        if (i == FF_ARRAY_ELEMS(ffp_force_keys)) {
+            snprintf(err, err_size, "d3d11_force_caps: unknown capability '%s' (nv12_srv, p010_srv, decoder_srv, p010, "
+                     "rotate, mirror, procamp, shader, cuda_import)", tok);
+            ret = -1;
+            break;
+        }
+        *mask |= ffp_force_keys[i].bits;
+    }
+    av_free(copy);
+    return ret;
+}
