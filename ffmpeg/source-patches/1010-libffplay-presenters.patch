+/* FFP_EVENT_PRESENTER_ERROR; the player is (or stays) on the SDL presenter. lost: the failure is a lost / removed GPU
+ * device (reason: its HRESULT): "device_lost":true,"removed_reason":"0x........" */
+static void ffp_pres_error(FFPlayer *ffp, const char *err, int lost, unsigned reason)
+{
+    AVBPrint bp;
+
+    av_log(NULL, AV_LOG_WARNING, "d3d11 presenter: %s; using the sdl presenter\n", err);
+    SDL_LockMutex(ffp->dbg_mutex);
+    av_strlcpy(ffp->dbg_pres_error, err, sizeof(ffp->dbg_pres_error));
+    SDL_UnlockMutex(ffp->dbg_mutex);
+    av_bprint_init(&bp, 0, AV_BPRINT_SIZE_AUTOMATIC);
+    av_bprintf(&bp, "{\"presenter\":\"d3d11\",\"error\":");
+    json_string(&bp, err);
+    av_bprintf(&bp, ",\"fallback\":\"sdl\"");
+    if (lost)
+        av_bprintf(&bp, ",\"device_lost\":true,\"removed_reason\":\"0x%08x\"", reason);
+    av_bprintf(&bp, "}");
+    ffp_emit(ffp, FFP_EVENT_PRESENTER_ERROR, bp.str);
+    av_bprint_finalize(&bp, NULL);
