+static void ffp_set_dbg_renderer(FFPlayer *ffp)
+{
+    SDL_LockMutex(ffp->dbg_mutex);
+    if (ffp->d3d)
+        av_strlcpy(ffp->dbg_renderer, "d3d11:videoprocessor", sizeof(ffp->dbg_renderer));
+    else if (ffp->vk_renderer)
+        av_strlcpy(ffp->dbg_renderer, "vulkan", sizeof(ffp->dbg_renderer));
