+/* Presenter parameters (ffp_set_presenter_params). The same meaning as the filter chain
+ * transpose -> hflip/vflip -> eq: rotation is clockwise, flips are applied after the rotation. */
+typedef struct FFPPresParams {
+    int rotation;                   /* 0, 90, 180, 270 (clockwise) */
+    int flip_h, flip_v;
+    int eq_on;
+    double brightness;              /* ffmpeg eq semantics: -1..1 (0) */
+    double contrast;                /* 1 */
+    double saturation;              /* 0..3 (1) */
+    double gamma;                   /* 1 */
+} FFPPresParams;
+
+static inline void ffp_pres_params_identity(FFPPresParams *p)
+{
+    p->rotation = 0;
+    p->flip_h = p->flip_v = 0;
+    p->eq_on = 0;
+    p->brightness = 0.0;
+    p->contrast = p->saturation = p->gamma = 1.0;
+}
+
+static inline int ffp_pres_params_is_identity(const FFPPresParams *p)
+{
+    return !p->rotation && !p->flip_h && !p->flip_v &&
+           (!p->eq_on || (p->brightness == 0.0 && p->contrast == 1.0 && p->saturation == 1.0 && p->gamma == 1.0));
+}
+
+/* d3d11_force_caps: probed capabilities that are masked off (to exercise the fallbacks on a GPU that has them) */
+enum {
+    FFP_FORCE_NV12_SRV    = 1 << 0,     /* decoder pool of NV12 can have SHADER_RESOURCE */
+    FFP_FORCE_P010_SRV    = 1 << 1,     /* ... of P010 */
+    FFP_FORCE_P010        = 1 << 2,     /* the video processor takes P010 input */
+    FFP_FORCE_ROTATE      = 1 << 3,
+    FFP_FORCE_MIRROR      = 1 << 4,
+    FFP_FORCE_PROCAMP     = 1 << 5,
+    FFP_FORCE_SHADER      = 1 << 6,
+    FFP_FORCE_CUDA_IMPORT = 1 << 7,
+};
+
+enum { FFP_ROUTE_VP = 1, FFP_ROUTE_SHADER = 2 };
+
+/* the d3d11_* open options (and the options of ffp_probe_caps_opts) */
+typedef struct FFPD3D11Config {
+    int adapter_set;                /* d3d11_adapter_luid was given: */
+    uint32_t luid_high, luid_low;   /* the DXGI adapter with this LUID is used for every D3D11 / CUDA device */
+    int debug;                      /* d3d11_debug: D3D11 debug layer when installed */
+    unsigned force;                 /* FFP_FORCE_* */
+    int route;                      /* FFP_ROUTE_* */
+    int srv_fail;                   /* TEST ONLY presenter_debug_srv_fail: this many decoder pools with SRV fail */
+} FFPD3D11Config;
+
+/* "HHHHHHHH:LLLLLLLL" (hex, LUID HighPart:LowPart, as "adapter.luid" of the capability JSON); 0, or -1 */
+int ffp_d3d11_parse_luid(const char *s, FFPD3D11Config *cfg);
+/* "key=0,key=0": ORs the FFP_FORCE_* bits into *mask; 0, or -1 with err */
+int ffp_d3d11_parse_force(const char *s, unsigned *mask, char *err, size_t err_size);
+/* appends the names of the bits of mask as JSON strings ("p010=0", ...), comma separated */
+void ffp_d3d11_force_names_json(AVBPrint *bp, unsigned mask);
+/* 0 if the machine has the adapter of cfg (or none is selected), else -1 with a message that names the LUID */
+int ffp_d3d11_check_adapter(const FFPD3D11Config *cfg, char *err, size_t err_size);
+/* a D3D11VA AVHWDeviceContext on the adapter of cfg (default adapter when none), with the debug layer of cfg */
+int ffp_d3d11_create_hwdevice(const FFPD3D11Config *cfg, AVBufferRef **out, char *err, size_t err_size);
+/* CUDA ordinal of the device on the adapter of cfg; -1 with a message when there is none */
+int ffp_cuda_ordinal_for_luid(const FFPD3D11Config *cfg, int *ordinal, char *err, size_t err_size);
+/* the options of the process-wide capability probe (the first ffp_probe_caps_opts call) */
+void ffp_d3d11_set_probe_config(const FFPD3D11Config *cfg);
+const FFPD3D11Config *ffp_d3d11_probe_config(void);
+/* HRESULT of ID3D11Device::GetDeviceRemovedReason() of a device pointer (any thread); 0 = not removed */
+unsigned ffp_d3d11_removed_reason(const void *dev);
+
+/* what the D3D11 VideoProcessor of this machine can do (probed once per process and adapter, with a real device
+ * and a self test of rotation / mirroring) */
+typedef struct FFPD3D11Limits {
+    int ok;
+    char error[192];
+    int rotate;
+    int mirror;
+    int mirror_before_rot;          /* the driver mirrors before it rotates (else after) */
+    int procamp;
+    int has_brightness, has_contrast, has_saturation;
+    /* ffmpeg eq units that the driver ranges map to (see ffplay_d3d11.c) */
+    double bri_min, bri_max;        /* brightness, -1..1 scale */
+    double con_min, con_max;
+    double sat_min, sat_max;
+    int lv_min[3], lv_max[3], lv_def[3];    /* raw driver levels: brightness, contrast, saturation */
+    double bri_k;                   /* brightness filter: RGB code values per level (measured) */
+    int bri_after;                  /* the brightness is added after the contrast scaling (measured) */
+    float lv_mult[3];
+    unsigned proc_caps;             /* D3D11_VIDEO_PROCESSOR_RATE_CONVERSION_CAPS.ProcessorCaps, all indexes ORed */
+    unsigned telecine_caps;         /* ITelecineCaps, ORed */
+    int nv12, p010;
+    unsigned forced;                /* FFP_FORCE_* bits that were masked off in this copy */
+    char adapter_name[128];         /* the adapter the limits belong to */
+    unsigned adapter_vendor, adapter_device;
+    uint32_t luid_high, luid_low;
+} FFPD3D11Limits;
+
+/* process-wide cached probe of the default adapter; returns limits->ok */
+int ffp_d3d11_get_limits(FFPD3D11Limits *out);
+/* the same for the adapter of cfg (cached per LUID), with cfg->force applied to the copy; cfg NULL = default adapter */
+int ffp_d3d11_get_limits_cfg(const FFPD3D11Config *cfg, FFPD3D11Limits *out);
+int ffp_d3d11_get_probe_limits(FFPD3D11Limits *out);
+/* 0, or a negative value with a reason */
+int ffp_d3d11_check_params(const FFPD3D11Limits *l, const FFPPresParams *p, char *err, size_t err_size);
+/* appends the "d3d11" entry of the capability JSON "presenters" array */
+void ffp_d3d11_caps_entry(AVBPrint *bp);
+
+typedef struct FFPD3D11 FFPD3D11;
+
+/* host_hwnd: the window the presenter fills with a child window. fail_mode (tests only): 0 none, 1 fail at the
+ * first display, 2 fail at creation, 3 report a device loss at the first display. cfg: the d3d11_* options (NULL = none). */
+FFPD3D11 *ffp_d3d11_create(void *host_hwnd, int fail_mode, const FFPD3D11Config *cfg, char *err, size_t err_size);
+void ffp_d3d11_destroy(FFPD3D11 *p);
+/* Did the last failure of the presenter (ffp_d3d11_display, ...) come from a lost / removed device? Then *reason is the
+ * HRESULT (DXGI_ERROR_DEVICE_REMOVED / RESET / HUNG / DRIVER_INTERNAL_ERROR or GetDeviceRemovedReason()). Same thread as
+ * the failed call. */
+int ffp_d3d11_device_lost(FFPD3D11 *p, unsigned *reason);
+/* d3d11_debug: moves the debug layer messages of the presenter's device to av_log ("d3d11-debug:"); at most every 250 ms,
+ * called after each presented frame */
+void ffp_d3d11_drain_debug(FFPD3D11 *p);
+/* appends the presenter members of the debug info: ,"adapter":{..},"debug_layer":..,"debug_messages":..,"fallbacks":[..] */
+void ffp_d3d11_debug_json(FFPD3D11 *p, AVBPrint *bp);
+/* remembers (once, in order of first occurrence) a short name of a fallback the presenter took */
+void ffp_d3d11_record_fallback(FFPD3D11 *p, const char *name);
+/* a new reference to an AVHWDeviceContext (D3D11VA) wrapping the presenter's ID3D11Device */
+AVBufferRef *ffp_d3d11_ref_device(FFPD3D11 *p);
+void *ffp_d3d11_device_ptr(FFPD3D11 *p);
+/* is this a D3D11 NV12/P010 frame of the device `dev` (pure function, any thread)? */
+int ffp_d3d11_frame_ok(const void *dev, const AVFrame *f);
+const FFPD3D11Limits *ffp_d3d11_limits(const FFPD3D11 *p);
+
