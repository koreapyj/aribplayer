+void ffp_d3d11_drain_debug(FFPD3D11 *p)
+{
+    if (p)
+        ffp_dbg_drain(p->dbg, "present", 1);
+}
+
+int ffp_d3d11_device_lost(FFPD3D11 *p, unsigned *reason)
+{
+    HRESULT r = S_OK;
+
+    if (!p)
+        return 0;
+    if (p->forced_lost) {
+        *reason = (unsigned)DXGI_ERROR_DEVICE_REMOVED;
+        return 1;
+    }
+    if (p->dev && (r = p->dev->lpVtbl->GetDeviceRemovedReason(p->dev)) != S_OK) {
+        *reason = (unsigned)r;
+        return 1;
+    }
+    if (ffp_last_hr == DXGI_ERROR_DEVICE_REMOVED || ffp_last_hr == DXGI_ERROR_DEVICE_RESET ||
+        ffp_last_hr == DXGI_ERROR_DEVICE_HUNG || ffp_last_hr == DXGI_ERROR_DRIVER_INTERNAL_ERROR) {
+        *reason = (unsigned)ffp_last_hr;
+        return 1;
+    }
+    return 0;
+}
+
+FFPD3D11 *ffp_d3d11_create(void *host_hwnd, int fail_mode, const FFPD3D11Config *cfg, char *err, size_t err_size)
+{
+    FFPD3D11 *p;
+    IDXGIDevice *dxdev = NULL;
+    IDXGIAdapter *ad = NULL;
+    FFPD3DDebug *dbg = NULL;
+    DXGI_ADAPTER_DESC adesc;
+    HRESULT hr;
+    int ret, i;
+
+    if (!host_hwnd || !IsWindow((HWND)host_hwnd)) {
+        ffp_set_err(err, err_size, "the d3d11 presenter needs a host window", S_OK);
+        return NULL;
+    }
+    if (fail_mode == 2) {
+        ffp_set_err(err, err_size, "forced failure (presenter_debug_fail=init)", S_OK);
+        return NULL;
+    }
+    p = av_mallocz(sizeof(*p));
+    if (!p)
+        return NULL;
+    InitializeCriticalSection(&p->cs);
+    InitializeCriticalSection(&p->fb_cs);
+    p->host = (HWND)host_hwnd;
+    p->fail_mode = fail_mode;
+    if (cfg)
+        p->cfg = *cfg;
+    if (!ffp_d3d11_get_limits_cfg(&p->cfg, &p->lim)) {
+        snprintf(err, err_size, "%s", p->lim.error[0] ? p->lim.error : "video processor unavailable");
+        goto fail;
+    }
+    hr = ffp_create_device(&p->cfg, &p->dev, &p->ctx, &dbg);
+    if (FAILED(hr)) {
+        ffp_create_device_error(&p->cfg, hr, err, err_size);
+        goto fail;
+    }
+    CHECK_HR(p->dev->lpVtbl->QueryInterface(p->dev, &ffp_IID_ID3D11VideoDevice, (void **)&p->vdev), "ID3D11VideoDevice");
+    CHECK_HR(p->ctx->lpVtbl->QueryInterface(p->ctx, &ffp_IID_ID3D11VideoContext, (void **)&p->vctx), "ID3D11VideoContext");
+    p->ctx->lpVtbl->QueryInterface(p->ctx, &ffp_IID_ID3D11VideoContext1, (void **)&p->vctx1);
+    CHECK_HR(p->dev->lpVtbl->QueryInterface(p->dev, &ffp_IID_IDXGIDevice, (void **)&dxdev), "IDXGIDevice");
+    CHECK_HR(dxdev->lpVtbl->GetAdapter(dxdev, &ad), "IDXGIDevice::GetAdapter");
+    if (SUCCEEDED(ad->lpVtbl->GetDesc(ad, &adesc)))
+        ffp_adapter_from_desc(&adesc, &p->adapter);
+    CHECK_HR(ad->lpVtbl->GetParent(ad, &ffp_IID_IDXGIFactory2, (void **)&p->factory), "IDXGIFactory2 (flip-model swap chain unavailable)");
+
+    /* wraps (and owns a reference to) our device */
+    ret = ffp_wrap_hwdevice(p->dev, dbg, 0, 0, &p->hwdev, err, err_size);
+    if (ret < 0)
+        goto fail;
+    p->dbg = dbg;
+    dbg = NULL;
+    p->hwctx = ((AVHWDeviceContext *)p->hwdev->data)->hwctx;
+    ffp_dbg_drain(p->dbg, "init", 0);
+    for (i = 0; i < FF_ARRAY_ELEMS(ffp_force_keys); i++)
+        if (ffp_force_keys[i].bits != (FFP_FORCE_NV12_SRV | FFP_FORCE_P010_SRV) &&
+            (p->cfg.force & ffp_force_keys[i].bits)) {
+            char name[48];
+            snprintf(name, sizeof(name), "force_caps:%s=0", ffp_force_keys[i].name);
+            ffp_d3d11_record_fallback(p, name);
+        }
+    FFP_REL(ad);
+    FFP_REL(dxdev);
+    if (ffp_register_class() < 0) {
+        ffp_set_err(err, err_size, "RegisterClassEx failed", S_OK);
+        goto fail;
+    }
+    p->wc_atom = 1;
+    return p;
+fail:
+    if (ad)
+        ad->lpVtbl->Release(ad);
+    if (dxdev)
+        dxdev->lpVtbl->Release(dxdev);
+    ffp_dbg_free(dbg);
+    ffp_d3d11_destroy(p);
+    return NULL;
+}
+
+static void ffp_destroy_swapchain(FFPD3D11 *p)
+{
+    ffp_vp_free(&p->disp);
+    FFP_REL(p->sc);
+    ffp_stop_window(p);
+    p->sc_w = p->sc_h = 0;
+    p->shown = 0;
+}
+
+void ffp_d3d11_destroy(FFPD3D11 *p)
+{
+    if (!p)
+        return;
+    EnterCriticalSection(&p->cs);
+    ffp_destroy_swapchain(p);
+    ffp_vp_free(&p->snap);
+    av_frame_free(&p->up_frame);
+    av_frame_free(&p->swf);
+    av_buffer_unref(&p->up_frames);
+    sws_freeContext(p->sws);
+    p->sws = NULL;
+    if (p->ctx)
+        p->ctx->lpVtbl->Flush(p->ctx);
+    FFP_REL(p->factory);
+    FFP_REL(p->vctx1);
+    FFP_REL(p->vctx);
+    FFP_REL(p->vdev);
+    FFP_REL(p->ctx);
+    FFP_REL(p->dev);
+    ffp_dbg_drain(p->dbg, "close", 0);
+    p->dbg = NULL;
+    av_buffer_unref(&p->hwdev);      /* releases its own reference to the device, and the debug layer state (last drain) */
+    LeaveCriticalSection(&p->cs);
+    if (p->wc_atom)
+        ffp_unregister_class();
+    DeleteCriticalSection(&p->fb_cs);
+    DeleteCriticalSection(&p->cs);
+    av_free(p);
+}
+
+AVBufferRef *ffp_d3d11_ref_device(FFPD3D11 *p)
+{
+    return p && p->hwdev ? av_buffer_ref(p->hwdev) : NULL;
+}
+
+void *ffp_d3d11_device_ptr(FFPD3D11 *p)
+{
+    return p ? (void *)p->dev : NULL;
+}
+
+const FFPD3D11Limits *ffp_d3d11_limits(const FFPD3D11 *p)
+{
+    return &p->lim;
+}
+
+int ffp_d3d11_frame_ok(const void *dev, const AVFrame *f)
+{
+    AVHWFramesContext *fc;
+    AVHWDeviceContext *dc;
+
+    if (!dev || !f || f->format != AV_PIX_FMT_D3D11 || !f->hw_frames_ctx)
+        return 0;
+    fc = (AVHWFramesContext *)f->hw_frames_ctx->data;
+    if (fc->sw_format != AV_PIX_FMT_NV12 && fc->sw_format != AV_PIX_FMT_P010)
+        return 0;
+    dc = fc->device_ctx;
+    return dc && dc->type == AV_HWDEVICE_TYPE_D3D11VA &&
+           ((AVD3D11VADeviceContext *)dc->hwctx)->device == (ID3D11Device *)dev;
+}
+
+
+static int ffp_upload(FFPD3D11 *p, const AVFrame *f, FFPInput *in, char *err, size_t err_size)
+{
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(f->format);
+    enum AVPixelFormat tgt;
+    const AVFrame *src = f;
+    AVFrame *hw = NULL;
+    int w = f->width, h = f->height, pw, ph, ret;
+
+    if (!desc || w <= 0 || h <= 0) {
+        ffp_set_err(err, err_size, "unsupported frame", S_OK);
+        return -1;
+    }
+    if (f->format == AV_PIX_FMT_NV12 || f->format == AV_PIX_FMT_P010LE || f->format == AV_PIX_FMT_BGRA) {
+        tgt = f->format;
+    } else if (!(desc->flags & (AV_PIX_FMT_FLAG_RGB | AV_PIX_FMT_FLAG_PAL | AV_PIX_FMT_FLAG_BITSTREAM | AV_PIX_FMT_FLAG_HWACCEL)) &&
+               desc->nb_components >= 3 && desc->log2_chroma_w == 1 && desc->log2_chroma_h == 1) {
+        tgt = desc->comp[0].depth <= 8 ? AV_PIX_FMT_NV12 : AV_PIX_FMT_P010LE;
+        if (tgt == AV_PIX_FMT_P010LE && !p->lim.p010)
+            tgt = AV_PIX_FMT_BGRA;
+    } else {
+        tgt = AV_PIX_FMT_BGRA;
+    }
+    pw = tgt == AV_PIX_FMT_BGRA ? w : (w + 1) & ~1;
+    ph = tgt == AV_PIX_FMT_BGRA ? h : (h + 1) & ~1;
+
+    if (!p->up_frames || p->up_fmt != (int)tgt || p->up_w != pw || p->up_h != ph) {
+        AVHWFramesContext *fc;
+        av_buffer_unref(&p->up_frames);
+        p->up_frames = av_hwframe_ctx_alloc(p->hwdev);
+        if (!p->up_frames) {
+            ffp_set_err(err, err_size, "av_hwframe_ctx_alloc failed", S_OK);
+            return -1;
+        }
+        fc = (AVHWFramesContext *)p->up_frames->data;
+        fc->format = AV_PIX_FMT_D3D11;
+        fc->sw_format = tgt;
+        fc->width = pw;
+        fc->height = ph;
+        fc->initial_pool_size = 4;
+        ((AVD3D11VAFramesContext *)fc->hwctx)->BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
+        ret = av_hwframe_ctx_init(p->up_frames);
+        if (ret < 0) {
+            snprintf(err, err_size, "upload surface pool failed (%s)", av_err2str(ret));
+            av_buffer_unref(&p->up_frames);
+            return -1;
+        }
+        p->up_fmt = tgt;
+        p->up_w = pw;
+        p->up_h = ph;
+    }
+
+    if ((int)tgt != f->format || pw != w || ph != h) {
+        int cs;
+
+        if (!p->swf || p->swf->format != (int)tgt || p->swf->width != pw || p->swf->height != ph) {
+            av_frame_free(&p->swf);
+            p->swf = av_frame_alloc();
+            if (!p->swf)
+                return -1;
+            p->swf->format = tgt;
+            p->swf->width = pw;
+            p->swf->height = ph;
+            if (av_frame_get_buffer(p->swf, 0) < 0) {
+                av_frame_free(&p->swf);
+                ffp_set_err(err, err_size, "out of memory", S_OK);
+                return -1;
+            }
+        }
+        if (av_frame_make_writable(p->swf) < 0)
+            return -1;
+        if (!sws_isSupportedInput(f->format)) {
+            ffp_set_err(err, err_size, "pixel format not convertible", S_OK);
+            return -1;
+        }
+        p->sws = sws_getCachedContext(p->sws, w, h, f->format, pw, ph, tgt,
+                                      tgt == AV_PIX_FMT_BGRA ? (SWS_BICUBIC | SWS_ACCURATE_RND | SWS_FULL_CHR_H_INT) : SWS_BILINEAR,
+                                      NULL, NULL, NULL);
+        if (!p->sws) {
+            ffp_set_err(err, err_size, "swscale context failed", S_OK);
+            return -1;
+        }
+        if (tgt == AV_PIX_FMT_BGRA && !(desc->flags & AV_PIX_FMT_FLAG_RGB)) {
+            switch (f->colorspace) {
+            case AVCOL_SPC_BT709:        cs = SWS_CS_ITU709;    break;
+            case AVCOL_SPC_BT470BG:
+            case AVCOL_SPC_SMPTE170M:    cs = SWS_CS_ITU601;    break;
+            case AVCOL_SPC_SMPTE240M:    cs = SWS_CS_SMPTE240M; break;
+            case AVCOL_SPC_BT2020_NCL:
+            case AVCOL_SPC_BT2020_CL:    cs = SWS_CS_BT2020;    break;
+            default:                     cs = h >= 720 ? SWS_CS_ITU709 : SWS_CS_ITU601; break;
+            }
+            sws_setColorspaceDetails(p->sws, sws_getCoefficients(cs), f->color_range == AVCOL_RANGE_JPEG,
+                                     sws_getCoefficients(SWS_CS_DEFAULT), 1, 0, 1 << 16, 1 << 16);
+        }
+        if (sws_scale(p->sws, (const uint8_t * const *)f->data, f->linesize, 0, h, p->swf->data, p->swf->linesize) < 0) {
+            ffp_set_err(err, err_size, "swscale failed", S_OK);
+            return -1;
+        }
+        src = p->swf;
+    }
+
+    hw = av_frame_alloc();
+    if (!hw)
+        return -1;
+    ret = av_hwframe_get_buffer(p->up_frames, hw, 0);
+    if (ret >= 0)
+        ret = av_hwframe_transfer_data(hw, src, 0);
+    if (ret < 0) {
+        snprintf(err, err_size, "upload failed (%s)", av_err2str(ret));
+        av_frame_free(&hw);
+        return -1;
+    }
+    av_frame_free(&p->up_frame);
+    p->up_frame = hw;
+    in->tex = (ID3D11Texture2D *)hw->data[0];
+    in->slice = (int)(intptr_t)hw->data[1];
+    in->direct = 0;
+    in->rgb = tgt == AV_PIX_FMT_BGRA;
+    in->vis_x = in->vis_y = 0;
+    in->vis_w = w;
+    in->vis_h = h;
+    in->tex_w = pw;
+    in->tex_h = ph;
+    return 0;
+}
+
+static int ffp_get_input(FFPD3D11 *p, const AVFrame *f, FFPInput *in, char *err, size_t err_size)
+{
+    memset(in, 0, sizeof(*in));
+    if (ffp_d3d11_frame_ok(p->dev, f)) {
+        D3D11_TEXTURE2D_DESC td;
+
+        in->tex = (ID3D11Texture2D *)f->data[0];
+        in->slice = (int)(intptr_t)f->data[1];
+        in->tex->lpVtbl->GetDesc(in->tex, &td);
+        in->tex_w = td.Width;
+        in->tex_h = td.Height;
+        in->direct = 1;
+        /* decoders crop the right / bottom edge from width / height, the left / top edge stays in crop_left / crop_top */
+        in->vis_x = f->crop_left;
+        in->vis_y = f->crop_top;
+        in->vis_w = FFMAX(f->width - f->crop_left, 1);
+        in->vis_h = FFMAX(f->height - f->crop_top, 1);
+        return 0;
+    }
+    if (f->hw_frames_ctx) {
+        ffp_set_err(err, err_size, "hardware frame of another device / format", S_OK);
+        return -1;
+    }
+    return ffp_upload(p, f, in, err, err_size);
+}
+
+
+static int ffp_ensure_swapchain(FFPD3D11 *p, char *err, size_t err_size)
+{
+    RECT rc;
+    int w, h;
+
+    if (!GetClientRect(p->host, &rc)) {
+        ffp_set_err(err, err_size, "GetClientRect failed", S_OK);
+        return -1;
+    }
+    w = rc.right - rc.left;
+    h = rc.bottom - rc.top;
+    if (w <= 0 || h <= 0) {
+        if (p->sc)
+            return 0;
+        w = 2;
+        h = 2;
+    }
+    if (!p->child) {
+        if (ffp_start_window(p, w, h) < 0) {
+            snprintf(err, err_size, "CreateWindowEx(child) failed (%d)", p->wres);
+            return -1;
+        }
+    }
+    if (!p->sc) {
+        DXGI_SWAP_CHAIN_DESC1 d;
+
+        memset(&d, 0, sizeof(d));
+        d.Width = w;
+        d.Height = h;
+        d.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+        d.SampleDesc.Count = 1;
+        d.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+        d.BufferCount = 3;
+        d.Scaling = DXGI_SCALING_STRETCH;
+        d.SwapEffect = DXGI_SWAP_EFFECT_FLIP_DISCARD;
+        d.AlphaMode = DXGI_ALPHA_MODE_IGNORE;
+        CHECK_HR(p->factory->lpVtbl->CreateSwapChainForHwnd(p->factory, (IUnknown *)p->dev, p->child, &d, NULL, NULL, &p->sc),
+                 "CreateSwapChainForHwnd (flip model)");
+        p->factory->lpVtbl->MakeWindowAssociation(p->factory, p->child, DXGI_MWA_NO_ALT_ENTER | DXGI_MWA_NO_WINDOW_CHANGES);
+        p->sc_w = w;
+        p->sc_h = h;
+        return 0;
+    }
+    if (w != p->sc_w || h != p->sc_h) {
+        PostMessageW(p->child, FFP_WM_SIZE, (WPARAM)w, (LPARAM)h);     /* the window thread resizes it */
+        CHECK_HR(p->sc->lpVtbl->ResizeBuffers(p->sc, 0, w, h, DXGI_FORMAT_UNKNOWN, 0), "IDXGISwapChain::ResizeBuffers");
+        p->sc_w = w;
+        p->sc_h = h;
+    }
+    return 0;
+fail:
+    return -1;
+}
+
+/* the sample aspect ratio after the rotation: like the transpose filter, 90 / 270 degrees invert it */
+static AVRational ffp_eff_sar(const AVFrame *f, int rotation)
+{
+    AVRational sar = f->sample_aspect_ratio;
+
+    if ((rotation == 90 || rotation == 270) && sar.num > 0 && sar.den > 0)
+        sar = av_inv_q(sar);
+    return sar;
+}
+
+static void ffp_rotated_size(const FFPInput *in, int rotation, int *rw, int *rh)
+{
+    if (rotation == 90 || rotation == 270) {
+        *rw = in->vis_h;
+        *rh = in->vis_w;
+    } else {
+        *rw = in->vis_w;
+        *rh = in->vis_h;
+    }
+}
+
+static int ffp_blt(FFPD3D11 *p, FFPVP *v, ID3D11VideoProcessorOutputView *ov, const FFPInput *in, const FFPPresParams *pp,
+                   const AVFrame *f, const RECT *dst, const RECT *target, char *err, size_t err_size)
+{
+    ID3D11VideoProcessorInputView *iv;
+    D3D11_VIDEO_PROCESSOR_STREAM st;
+    RECT src;
+    int lv[3];
+    HRESULT hr;
+
+    iv = ffp_vp_input_view(p->vdev, v, in->tex, in->slice, err, err_size);
+    if (!iv)
+        return -1;
+    src.left = in->vis_x;
+    src.top = in->vis_y;
+    src.right = in->vis_x + in->vis_w;
+    src.bottom = in->vis_y + in->vis_h;
+    ffp_pp_levels(&p->lim, pp, lv);
+    ffp_vp_setup(p->vctx, p->vctx1, v->vp, &p->lim, pp, lv, ffp_input_colorspace(f, in->rgb), &src, dst, target);
+    memset(&st, 0, sizeof(st));
+    st.Enable = TRUE;
+    st.pInputSurface = iv;
+    hr = p->vctx->lpVtbl->VideoProcessorBlt(p->vctx, v->vp, ov, 0, 1, &st);
+    if (FAILED(hr)) {
+        ffp_set_err(err, err_size, "VideoProcessorBlt", hr);
+        return -1;
+    }
+    return 0;
+}
+
+int ffp_d3d11_display(FFPD3D11 *p, const AVFrame *f, const FFPPresParams *pp, int *direct, char *err, size_t err_size)
+{
+    FFPInput in;
+    ID3D11Texture2D *bb = NULL;
+    ID3D11VideoProcessorOutputView *ov = NULL;
+    D3D11_VIDEO_PROCESSOR_OUTPUT_VIEW_DESC od;
+    RECT dst, target;
+    HRESULT hr;
+    int rw, rh, ret = -1;
+
+    EnterCriticalSection(&p->cs);
+    ffp_last_hr = S_OK;
+    if (p->fail_mode == 1) {
+        ffp_set_err(err, err_size, "forced failure (presenter_debug_fail)", S_OK);
+        goto done;
+    }
+    if (p->fail_mode == 3) {
+        p->forced_lost = 1;
+        ffp_set_err(err, err_size, "forced device loss (presenter_debug_fail=device_lost)", S_OK);
+        goto done;
+    }
+    if (ffp_ensure_swapchain(p, err, err_size) < 0)
+        goto done;
+    if (ffp_get_input(p, f, &in, err, err_size) < 0)
+        goto done;
+    *direct = in.direct;
+
+    CHECK_HR(p->sc->lpVtbl->GetBuffer(p->sc, 0, &ffp_IID_ID3D11Texture2D, (void **)&bb), "IDXGISwapChain::GetBuffer");
+    if (ffp_vp_ensure(p->vdev, &p->disp, in.tex_w, in.tex_h, p->sc_w, p->sc_h, err, err_size) < 0)
+        goto done;
+    memset(&od, 0, sizeof(od));
+    od.ViewDimension = D3D11_VPOV_DIMENSION_TEXTURE2D;
+    CHECK_HR(p->vdev->lpVtbl->CreateVideoProcessorOutputView(p->vdev, (ID3D11Resource *)bb, p->disp.en, &od, &ov),
+             "CreateVideoProcessorOutputView");
+    ffp_rotated_size(&in, pp->rotation, &rw, &rh);
+    dst = ffp_letterbox(p->sc_w, p->sc_h, rw, rh, ffp_eff_sar(f, pp->rotation));
+    target.left = target.top = 0;
+    target.right = p->sc_w;
+    target.bottom = p->sc_h;
+
+    ffp_lock_dev(p);
+    ret = ffp_blt(p, &p->disp, ov, &in, pp, f, &dst, &target, err, err_size);
+    ffp_unlock_dev(p);
+    if (ret < 0)
+        goto done;
+    ret = -1;
+    FFP_REL(ov);
+    FFP_REL(bb);
+    LeaveCriticalSection(&p->cs);
+
+    hr = p->sc->lpVtbl->Present(p->sc, 1, 0);
+    if (FAILED(hr)) {
+        ffp_set_err(err, err_size, hr == DXGI_ERROR_DEVICE_REMOVED ? "device removed (Present)" :
+                                   hr == DXGI_ERROR_DEVICE_RESET ? "device reset (Present)" : "Present", hr);
+        return -1;
+    }
+    if (!p->shown) {
+        PostMessageW(p->child, FFP_WM_SHOW, 0, 0);
+        p->shown = 1;
+    }
+    return 0;
+fail:
+done:
+    FFP_REL(ov);
+    FFP_REL(bb);
+    LeaveCriticalSection(&p->cs);
+    return ret;
+}
+
+void ffp_d3d11_clear(FFPD3D11 *p)
+{
+    ID3D11Texture2D *bb = NULL;
+    ID3D11RenderTargetView *rtv = NULL;
+    static const FLOAT black[4] = { 0, 0, 0, 1 };
+
+    if (!p)
+        return;
+    EnterCriticalSection(&p->cs);
+    if (p->sc && SUCCEEDED(p->sc->lpVtbl->GetBuffer(p->sc, 0, &ffp_IID_ID3D11Texture2D, (void **)&bb))) {
+        if (SUCCEEDED(p->dev->lpVtbl->CreateRenderTargetView(p->dev, (ID3D11Resource *)bb, NULL, &rtv))) {
+            p->ctx->lpVtbl->ClearRenderTargetView(p->ctx, rtv, black);
+            FFP_REL(rtv);
+        }
+        FFP_REL(bb);
+        LeaveCriticalSection(&p->cs);
+        p->sc->lpVtbl->Present(p->sc, 0, 0);
+        return;
+    }
+    LeaveCriticalSection(&p->cs);
+}
+
+int ffp_d3d11_snapshot(FFPD3D11 *p, const AVFrame *f, const FFPPresParams *pp, uint8_t **out, int *ow, int *oh,
+                       int *ostride, char *err, size_t err_size)
+{
+    FFPInput in;
+    ID3D11Texture2D *tex = NULL, *stg = NULL;
+    ID3D11VideoProcessorOutputView *ov = NULL;
+    D3D11_VIDEO_PROCESSOR_OUTPUT_VIEW_DESC od;
+    D3D11_MAPPED_SUBRESOURCE m;
+    RECT dst;
+    uint8_t *buf = NULL;
+    int rw, rh, dw, dh, y, x, ret = -1, mapped = 0;
+    AVRational sar = ffp_eff_sar(f, pp->rotation);
+
+    EnterCriticalSection(&p->cs);
+    if (ffp_get_input(p, f, &in, err, err_size) < 0)
+        goto done;
+    /* size contract of ffp_snapshot: native size after rotation, stretched by the SAR, both even */
+    ffp_rotated_size(&in, pp->rotation, &rw, &rh);
+    dw = rw;
+    dh = rh;
+    if (sar.num > 0 && sar.den > 0) {
+        double sf = av_q2d(sar);
+        if (sf > 1)
+            dw = lrint(rw * sf);
+        else if (sf < 1)
+            dh = lrint(rh / sf);
+    }
+    dw = FFMAX(2, ((dw + 1) / 2) * 2);
+    dh = FFMAX(2, ((dh + 1) / 2) * 2);
+
+    tex = ffp_make_tex(p->dev, dw, dh, DXGI_FORMAT_B8G8R8A8_UNORM, D3D11_USAGE_DEFAULT, D3D11_BIND_RENDER_TARGET, 0, NULL, 0);
+    stg = ffp_make_tex(p->dev, dw, dh, DXGI_FORMAT_B8G8R8A8_UNORM, D3D11_USAGE_STAGING, 0, D3D11_CPU_ACCESS_READ, NULL, 0);
+    if (!tex || !stg) {
+        ffp_set_err(err, err_size, "snapshot texture creation failed", S_OK);
+        goto done;
+    }
+    if (ffp_vp_ensure(p->vdev, &p->snap, in.tex_w, in.tex_h, dw, dh, err, err_size) < 0)
+        goto done;
+    memset(&od, 0, sizeof(od));
+    od.ViewDimension = D3D11_VPOV_DIMENSION_TEXTURE2D;
+    CHECK_HR(p->vdev->lpVtbl->CreateVideoProcessorOutputView(p->vdev, (ID3D11Resource *)tex, p->snap.en, &od, &ov),
+             "CreateVideoProcessorOutputView");
+    dst.left = dst.top = 0;
+    dst.right = dw;
+    dst.bottom = dh;
+
+    ffp_lock_dev(p);
+    ret = ffp_blt(p, &p->snap, ov, &in, pp, f, &dst, &dst, err, err_size);
+    if (ret >= 0) {
+        p->ctx->lpVtbl->CopyResource(p->ctx, (ID3D11Resource *)stg, (ID3D11Resource *)tex);
+        if (FAILED(p->ctx->lpVtbl->Map(p->ctx, (ID3D11Resource *)stg, 0, D3D11_MAP_READ, 0, &m))) {
+            ffp_set_err(err, err_size, "snapshot Map failed", S_OK);
+            ret = -1;
+        } else {
+            mapped = 1;
+        }
+    }
+    ffp_unlock_dev(p);
+    if (ret < 0)
+        goto done;
+    ret = -1;
+    buf = av_malloc((size_t)dw * 4 * dh);
+    if (!buf) {
+        ffp_set_err(err, err_size, "out of memory", S_OK);
+        goto done;
+    }
+    for (y = 0; y < dh; y++) {
+        const uint8_t *s = (const uint8_t *)m.pData + (size_t)y * m.RowPitch;
+        uint8_t *d = buf + (size_t)y * dw * 4;
+        memcpy(d, s, (size_t)dw * 4);
+        for (x = 0; x < dw; x++)
+            d[x * 4 + 3] = 255;
+    }
+    *out = buf;
+    *ow = dw;
+    *oh = dh;
+    *ostride = dw * 4;
+    buf = NULL;
+    ret = 0;
+fail:
+done:
+    if (mapped)
+        p->ctx->lpVtbl->Unmap(p->ctx, (ID3D11Resource *)stg, 0);
+    av_free(buf);
+    FFP_REL(ov);
+    FFP_REL(stg);
+    FFP_REL(tex);
+    LeaveCriticalSection(&p->cs);
+    return ret;
+}
+
+#else
+
+int ffp_d3d11_get_limits(FFPD3D11Limits *out)
+{
+    memset(out, 0, sizeof(*out));
+    snprintf(out->error, sizeof(out->error), "not supported on this platform");
+    return 0;
+}
+int ffp_d3d11_get_limits_cfg(const FFPD3D11Config *cfg, FFPD3D11Limits *out) { return ffp_d3d11_get_limits(out); }
