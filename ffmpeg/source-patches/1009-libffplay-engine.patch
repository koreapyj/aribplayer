+static void ffp_build_media_info(VideoState *is, AVBPrint *bp)
+{
+    AVFormatContext *ic = is->ic;
+    const AVDictionaryEntry *t;
+    int i, first = 1;
+
+    av_bprintf(bp, "{\"url\":");
+    json_string(bp, is->filename);
+    t = av_dict_get(ic->metadata, "title", NULL, 0);
+    av_bprintf(bp, ",\"title\":");
+    json_string(bp, t ? t->value : "");
+    av_bprintf(bp, ",\"format\":");
+    json_string(bp, ic->iformat->name);
+    av_bprintf(bp, ",\"duration\":");
+    json_double(bp, is->duration_s);
+    av_bprintf(bp, ",\"seekable\":%s,\"bit_rate\":%"PRId64",\"streams\":[",
+               ffp_is_seekable(is) ? "true" : "false", (int64_t)ic->bit_rate);
+
+    for (i = 0; i < ic->nb_streams; i++) {
+        AVStream *st = ic->streams[i];
+        AVCodecParameters *par = st->codecpar;
+        const char *type;
+        char fourcc[5];
+        int selected;
+
+        switch (par->codec_type) {
+        case AVMEDIA_TYPE_VIDEO:    type = "video";    selected = i == is->video_stream;    break;
+        case AVMEDIA_TYPE_AUDIO:    type = "audio";    selected = i == is->audio_stream;    break;
+        case AVMEDIA_TYPE_SUBTITLE: type = "subtitle"; selected =
+            i == is->subtitles[FFP_SUBTITLE_CAPTION].stream_index ||
+            i == is->subtitles[FFP_SUBTITLE_SUPERIMPOSE].stream_index; break;
+        default: continue;
+        }
+        if (!first)
+            av_bprintf(bp, ",");
+        first = 0;
+        av_bprintf(bp, "{\"index\":%d,\"type\":\"%s\",\"codec\":", i, type);
+        json_string(bp, avcodec_get_name(par->codec_id));
+        ffp_codec_fourcc(par, fourcc);
+        if (fourcc[0]) {
+            av_bprintf(bp, ",\"fourcc\":");
+            json_string(bp, fourcc);
+        }
+        if (par->codec_type == AVMEDIA_TYPE_VIDEO) {
+            AVRational sar = av_guess_sample_aspect_ratio(ic, st, NULL);
+            AVRational fr  = av_guess_frame_rate(ic, st, NULL);
+            const char *pf = av_get_pix_fmt_name(par->format);
+            if (sar.num <= 0 || sar.den <= 0)
+                sar = (AVRational){1, 1};
+            av_bprintf(bp, ",\"width\":%d,\"height\":%d,\"sar_num\":%d,\"sar_den\":%d,\"fps\":",
+                       par->width, par->height, sar.num, sar.den);
+            json_double(bp, fr.num > 0 && fr.den > 0 ? av_q2d(fr) : 0);
+            av_bprintf(bp, ",\"pix_fmt\":");
+            json_string(bp, pf ? pf : "");
+            av_bprintf(bp, ",\"color_transfer\":");
+            json_string(bp, av_color_transfer_name(par->color_trc));
+        } else if (par->codec_type == AVMEDIA_TYPE_AUDIO) {
+            av_bprintf(bp, ",\"sample_rate\":%d,\"channels\":%d",
+                       par->sample_rate, par->ch_layout.nb_channels);
+        } else if (par->codec_type == AVMEDIA_TYPE_SUBTITLE &&
+                   (par->codec_id == AV_CODEC_ID_ARIB_CAPTION || av_dict_get(st->metadata, "arib_type", NULL, 0))) {
+            char *end = NULL;
+            long component_tag = -1;
+            av_bprintf(bp, ",\"arib_type\":");
+            json_string(bp, ffp_arib_type(st));
+            t = av_dict_get(st->metadata, "component_tag", NULL, 0);
+            if (!t)
+                t = av_dict_get(st->metadata, "arib_component_tag", NULL, 0);
+            if (t && t->value && *t->value) {
+                long parsed = strtol(t->value, &end, 0);
+                if (end && !*end && parsed >= 0 && parsed <= 255)
+                    component_tag = parsed;
+            }
+            av_bprintf(bp, ",\"component_tag\":%ld", component_tag);
+        }
+        av_bprintf(bp, ",\"selected\":%s,\"language\":", selected ? "true" : "false");
+        t = av_dict_get(st->metadata, "language", NULL, 0);
+        json_string(bp, t && t->value[0] ? t->value : "und");
+        t = av_dict_get(st->metadata, "title", NULL, 0);
+        if (t && t->value[0]) {
+            av_bprintf(bp, ",\"title\":");
+            json_string(bp, t->value);
+        }
+        av_bprintf(bp, "}");
+    }
+    av_bprintf(bp, "]");
+    if (is->arib) {
+        /* roles at the time of the call; audio 2 may appear later (index -1 now) */
+        av_bprintf(bp, ",\"arib_audio\":{\"audio1\":%d,\"audio2\":%d}",
+                   is->arib->src[0].stream_index, is->arib->src[1].stream_index);
+    }
+    av_bprintf(bp, "}");
+}
