+static int ffp_loop_main(void *arg)
+{
+    int remaining_ms;
+
+    /* Try to work around an occasional ALSA buffer underflow issue when the
+     * period size is NPOT due to ALSA resampling by forcing the buffer size. */
+    if (!SDL_getenv("SDL_AUDIO_ALSA_SET_BUFFER_SIZE"))
+        SDL_setenv("SDL_AUDIO_ALSA_SET_BUFFER_SIZE", "1", 1);
+    if (g_ffp.audio_driver[0])
+        SDL_SetHintWithPriority(SDL_HINT_AUDIODRIVER, g_ffp.audio_driver, SDL_HINT_OVERRIDE);
+
+    /* Without a sound device the media plays without audio (the audio open fails) */
+    if (SDL_Init(SDL_INIT_AUDIO)) {
+        av_log(NULL, AV_LOG_WARNING, "Could not initialize SDL audio - %s\n", SDL_GetError());
+        SDL_Quit();
+        if (SDL_Init(0)) {
+            av_log(NULL, AV_LOG_FATAL, "Could not initialize SDL - %s\n", SDL_GetError());
+            g_ffp.loop_result = AVERROR_EXTERNAL;
+            SDL_SemPost(g_ffp.ready_sem);
+            return 0;
+        }
+    }
+    g_ffp.loop_result = 0;
+    SDL_SemPost(g_ffp.ready_sem);
+
+    for (;;) {
+        FFPlayer *ffp, *next, *add;
+        double remaining;
+        int quit, any_media = 0;
+
+        SDL_LockMutex(g_ffp.mutex);
+        add = g_ffp.pending;
+        g_ffp.pending = NULL;
+        quit = g_ffp.quit;
+        SDL_UnlockMutex(g_ffp.mutex);
+        for (; add; add = next) {
+            next = add->next;
+            add->next = g_ffp.list;
+            g_ffp.list = add;
+            add->create_result = 0;
+            SDL_SemPost(add->create_sem);
+        }
+        if (quit && !g_ffp.list)
             break;
-        case SDL_QUIT:
-        case FF_QUIT_EVENT:
-            do_exit(cur_stream);
-            break;
+
+        for (ffp = g_ffp.list; ffp; ffp = next) {
+            next = ffp->next;
+            ffp_run_cmds(ffp);      /* may unlink and release ffp (DESTROY) */
+        }
+
+        for (ffp = g_ffp.list; ffp; ffp = ffp->next)
+            any_media |= !!ffp->is;
+        remaining = any_media ? REFRESH_RATE : 0.25;
+
+        for (ffp = g_ffp.list; ffp; ffp = ffp->next)
+            if (ffp->is)
+                ffp_tick(ffp, &remaining);
+
+        remaining_ms = (int)(remaining * 1000.0);
+        SDL_LockMutex(g_ffp.mutex);
+        if (!g_ffp.wake && remaining_ms > 0)
+            SDL_CondWaitTimeout(g_ffp.cond, g_ffp.mutex, remaining_ms);
+        g_ffp.wake = 0;
+        SDL_UnlockMutex(g_ffp.mutex);
+    }
+
+    SDL_Quit();
+    return 0;
+}
