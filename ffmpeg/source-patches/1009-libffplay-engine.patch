+static int decoder_subtitle_open_arib(Decoder *dec)
+{
+    SubtitleLayer *layer = dec->subtitle_layer;
+    AVCodecContext *avctx;
+    int ret;
+
+    avctx = avcodec_alloc_context3(NULL);
+    if (!avctx)
+        return AVERROR(ENOMEM);
+    dec->avctx = avctx;
+    ret = avcodec_parameters_to_context(avctx, layer->startup_codecpar);
+    if (ret < 0)
+        return ret;
+    avctx->pkt_timebase = layer->startup_pkt_timebase;
+    avctx->codec_id = layer->startup_codec->id;
+    avctx->lowres = layer->startup_lowres;
+    if (layer->startup_fast)
+        avctx->flags2 |= AV_CODEC_FLAG2_FAST;
+
+    ret = avcodec_open2(avctx, layer->startup_codec, &layer->startup_opts);
+    if (ret < 0)
+        return ret;
+    ret = ffp_check_avoptions(layer->startup_opts);
+    if (ret < 0)
+        return ret;
+
+    ffp_dbg_subtitle_open(layer->is, layer->id, avctx, layer->startup_codec,
+                          layer->startup_stream_index, 1);
+    return 0;
+}
