+static void ffp_free_devices(AVBufferRef **devs, int n)
+{
+    int i;
+    for (i = 0; i < n; i++)
+        av_buffer_unref(&devs[i]);
+    av_free(devs);
+}
+
+/* Takes the output: the presenter table is copied, the device references are new ones. Only while no media is open. */
+static int ffp_output_set(FFPlayer *ffp, const FFPOutput *out)
+{
+    const FFPPresenter *p = out ? out->presenter : NULL;
+    AVBufferRef **devs = NULL;
+    int i, n = 0;
+
+    if (out && (out->nb_devices < 0 || (out->nb_devices && !out->devices)))
+        return FFP_EINVAL;
+    if (p && (!p->open || !p->present || !p->clear || !p->close))
+        return FFP_EINVAL;
+    if (out && out->nb_devices) {
+        if (!(devs = av_calloc(out->nb_devices, sizeof(*devs))))
+            return AVERROR(ENOMEM);
+        for (i = 0; i < out->nb_devices; i++) {
+            if (!out->devices[i])
+                continue;
+            if (!(devs[n] = av_buffer_ref(out->devices[i]))) {
+                ffp_free_devices(devs, n);
+                return AVERROR(ENOMEM);
+            }
+            n++;
+        }
+    }
+
+    SDL_LockMutex(ffp->pres_life_mutex);
+    SDL_LockMutex(ffp->pres_mutex);
+    ffp_free_devices(ffp->out_devs, ffp->nb_out_devs);
+    ffp->out_devs = devs;
+    ffp->nb_out_devs = n;
+    ffp->only_given_devices = out ? !!out->only_given_devices : 0;
+    memset(&ffp->pres, 0, sizeof(ffp->pres));
+    ffp->has_pres = !!p;
+    if (p) {
+        ffp->pres = *p;
+        av_strlcpy(ffp->pres_name, p->name ? p->name : "", sizeof(ffp->pres_name));
+        ffp->pres.name = ffp->pres_name;
+    }
+    SDL_AtomicSet(&ffp->pres_failed, 0);
+    SDL_AtomicLock(&ffp->sink_lock);
+    ffp->shown_width = ffp->shown_height = 0;
+    SDL_AtomicUnlock(&ffp->sink_lock);
+    SDL_UnlockMutex(ffp->pres_mutex);
+    SDL_UnlockMutex(ffp->pres_life_mutex);
+    return 0;
+}
+
+static void ffp_free_instance(FFPlayer *ffp)
+{
+    FFPCmd *c, *next;
+    int i;
+
+    for (c = ffp->cmd_head; c; c = next) {
+        next = c->next;
+        av_free(c->s);
+        ffp_opts_free(c->o);
+        av_free(c);
+    }
+    ffp_clear_filter_cmds(ffp);
+    av_free(ffp->vfilter);
+    av_free(ffp->afilter);
+    av_free(ffp->media_info);
+    av_frame_free(&ffp->last_frame);
+    for (i = 0; i < FFP_SUBTITLE_LAYER_COUNT; i++)
+        avsubtitle_free(&ffp->last_subtitles[i]);
+    ffp_free_devices(ffp->out_devs, ffp->nb_out_devs);
+    if (ffp->create_sem)
+        SDL_DestroySemaphore(ffp->create_sem);
+    if (ffp->mutex)
+        SDL_DestroyMutex(ffp->mutex);
+    if (ffp->emit_mutex)
+        SDL_DestroyMutex(ffp->emit_mutex);
+    if (ffp->snap_mutex)
+        SDL_DestroyMutex(ffp->snap_mutex);
+    if (ffp->dbg_mutex)
+        SDL_DestroyMutex(ffp->dbg_mutex);
+    if (ffp->pres_mutex)
+        SDL_DestroyMutex(ffp->pres_mutex);
+    if (ffp->pres_life_mutex)
+        SDL_DestroyMutex(ffp->pres_life_mutex);
+    av_free(ffp);
+}
