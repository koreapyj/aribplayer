+/* the hw device for the video graph built from vf: the "filter_hw_device" option
+ * ("type[:device]"). Created on first use and kept for the playback. *out is NULL when no device is wanted. */
+static int ffp_get_filter_hw_device(VideoState *is, const char *vf, AVBufferRef **out)
+{
+    const char *spec = is->o->filter_hw_device;
+    char *type_name, *dev;
+    enum AVHWDeviceType type;
+    int ret;
+
+    *out = NULL;
+    if (!vf || !*vf)
+        return 0;
+    if (!spec || !*spec)
+        return 0;
+    if (!is->filter_hw_device) {
+        type_name = av_strdup(spec);
+        if (!type_name)
+            return AVERROR(ENOMEM);
+        dev = strchr(type_name, ':');
+        if (dev)
+            *dev++ = '\0';
+        type = av_hwdevice_find_type_by_name(type_name);
+        if (type == AV_HWDEVICE_TYPE_NONE) {
+            av_log(NULL, AV_LOG_ERROR, "Unknown filter hw device type '%s'\n", type_name);
+            ret = AVERROR(EINVAL);
+        } else if (dev && *dev) {
+            ret = av_hwdevice_ctx_create(&is->filter_hw_device, type, dev, NULL, 0);
+            if (ret < 0)
+                av_log(NULL, AV_LOG_ERROR, "Cannot create the %s filter hw device: %s\n", spec, av_err2str(ret));
+        } else {
+            /* as for hwaccel: frames uploaded and filtered on the presenter's device are shown without a copy */
+            char why[256];
+
+            ret = ffp_get_hwdevice(is, type, &is->filter_hw_device, why, sizeof(why));
+            if (ret < 0)
+                av_log(NULL, AV_LOG_ERROR, "Cannot create the %s filter hw device: %s\n", spec, why);
+        }
+        av_free(type_name);
+        if (ret < 0)
+            return ret;
+    }
+    *out = is->filter_hw_device;
+    return 0;
+}
