+/* FFPPicture: the colour fields of a picture are always set; untagged is BT.709 above 576 lines, BT.601 below */
+static void ffp_tag_colors(AVFrame *f)
+{
+    const int hd = f->height > 576;
+    const AVPixFmtDescriptor *desc = av_pix_fmt_desc_get(f->hw_frames_ctx ?
+        ((AVHWFramesContext *)f->hw_frames_ctx->data)->sw_format : f->format);
