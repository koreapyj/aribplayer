+static void ffp_global_init(void)
+{
+    if (SDL_AtomicGet(&g_ffp.once) == 2)
+        return;
+    if (SDL_AtomicCAS(&g_ffp.once, 0, 1)) {
+        g_ffp.life_mutex = SDL_CreateMutex();
+        g_ffp.mutex      = SDL_CreateMutex();
+        g_ffp.cond       = SDL_CreateCond();
+        SDL_AtomicSet(&g_ffp.once, 2);
+    } else {
+        while (SDL_AtomicGet(&g_ffp.once) != 2)
+            SDL_Delay(1);
+    }
+}
+
+/* caller holds life_mutex */
+static int ffp_loop_start(void)
+{
+    g_ffp.quit = 0;
+    g_ffp.ready_sem = SDL_CreateSemaphore(0);
+    if (!g_ffp.ready_sem)
+        return AVERROR(ENOMEM);
+    g_ffp.loop_tid = SDL_CreateThread(ffp_loop_main, "ffplay_loop", NULL);
+    if (!g_ffp.loop_tid) {
+        SDL_DestroySemaphore(g_ffp.ready_sem);
+        return AVERROR(ENOMEM);
+    }
+    SDL_SemWait(g_ffp.ready_sem);
+    SDL_DestroySemaphore(g_ffp.ready_sem);
+    g_ffp.ready_sem = NULL;
+    if (g_ffp.loop_result < 0) {
+        SDL_WaitThread(g_ffp.loop_tid, NULL);
+        g_ffp.loop_tid = NULL;
+        return g_ffp.loop_result;
+    }
+    return 0;
+}
+
+/* caller holds life_mutex */
+static void ffp_loop_stop(void)
+{
+    SDL_LockMutex(g_ffp.mutex);
+    g_ffp.quit = 1;
+    SDL_UnlockMutex(g_ffp.mutex);
+    ffp_wake();
+    SDL_WaitThread(g_ffp.loop_tid, NULL);
+    g_ffp.loop_tid = NULL;
+}
+
+static void ffp_release(void)
+{
+    SDL_LockMutex(g_ffp.life_mutex);
+    if (--g_ffp.refcount == 0)
+        ffp_loop_stop();
+    SDL_UnlockMutex(g_ffp.life_mutex);
+}
