+static void ffp_run_cmds(FFPlayer *ffp)
+{
+    FFPCmd *c, *next;
+    int destroyed = 0;
+
+    SDL_LockMutex(ffp->mutex);
+    c = ffp->cmd_head;
+    ffp->cmd_head = ffp->cmd_tail = NULL;
+    SDL_UnlockMutex(ffp->mutex);
+
+    for (; c; c = next) {
+        next = c->next;
+        if (!destroyed)
+            destroyed = ffp_exec_cmd(ffp, c);
+        if (c->done) {
+            SDL_SemPost(c->done);       /* the caller owns c from now on */
+        } else {
+            av_free(c->s);
+            ffp_opts_free(c->o);
+            av_free(c);
+        }
+    }
+}
