+static void ffp_note_key_packet(VideoState *is, const AVPacket *pkt)
+{
+    double tb = av_q2d(is->video_st->time_base);
+    double pts_s;
+
+    if (pkt->pts == AV_NOPTS_VALUE)
+        return;
+    pts_s = pkt->pts * tb;
+    if (pkt->dts != AV_NOPTS_VALUE) {
+        double lead = (pkt->pts - pkt->dts) * tb;
+        if (lead >= 0.0 && lead <= 5.0)
+            is->seek_key_lead_s = lead;
+    }
+    if (is->seek_prev_key_valid) {
+        double interval = pts_s - is->seek_prev_key_pts_s;
+        if (interval > 0.02 && interval < 30.0)
+            is->seek_gop_est_s = is->seek_gop_est_s > 0.0 ? 0.5 * (is->seek_gop_est_s + interval) : interval;
+    }
+    is->seek_prev_key_pts_s = pts_s;
+    is->seek_prev_key_valid = 1;
+}
+
+/* Timestamp seeks must land on the video keyframe closest to the requested time, never on the one after it.
+ * avformat_seek_file() cannot do that by itself: it ignores AVSEEK_FLAG_BACKWARD, and its fallback derives the
+ * direction from the min/max window. MPEG-TS/PS positions on the packet nearest the timestamp (not a keyframe)
+ * and the decoder then waits for the next I frame, so a plain seek lands up to one GOP late. Keyframe aware
+ * indexed demuxers (MP4, MKV, ...) need an explicit pick of the nearer of the two surrounding keyframes.
+ * All computation here is in the video DTS domain: key pts = key dts + lead.
+ * direction: >0 landing must be after origin_us, <0 before it, 0 unconstrained.
+ * Returns 1 and rewrites the avformat_seek_file() arguments when a plan was made. */
+static int ffp_plan_seek(VideoState *is, int direction, int64_t origin_us,
+                         int64_t *target, int64_t *min_ts, int64_t *max_ts)
+{
+    AVStream *st = is->video_st;
+    const char *fmt = is->ic->iformat ? is->ic->iformat->name : "";
+    int64_t lead_us = (int64_t)llrint(is->seek_key_lead_s * AV_TIME_BASE);
+    int64_t want = *target - lead_us;
+
+    if (!st || (st->disposition & AV_DISPOSITION_ATTACHED_PIC))
+        return 0;
+    if (!strcmp(fmt, "mpegts") || !strcmp(fmt, "mpegtsraw") || !strcmp(fmt, "mpeg")) {
+        int64_t half_gop_us = (int64_t)llrint(is->seek_gop_est_s * 0.5 * AV_TIME_BASE);
+        int64_t x;
+        if (half_gop_us <= 0)
+            return 0;
+        /* the first keyframe at or after x (in dts) has pts in [target - G/2, target + G/2) */
+        x = want - half_gop_us;
+        if (direction > 0 && x < origin_us - lead_us + 1000)
+            x = origin_us - lead_us + 1000;
+        if (is->ic->start_time != AV_NOPTS_VALUE && x < is->ic->start_time)
+            x = is->ic->start_time;
+        *target = x;
+        *min_ts = INT64_MIN;
+        *max_ts = x;
+        return 1;
+    } else {
+        int count = avformat_index_get_entries_count(st);
+        int64_t ts, cand_us[2];
+        int idx[2], i, best = -1;
+
+        if (count <= 0)
+            return 0;
+        ts = av_rescale_q(want, AV_TIME_BASE_Q, st->time_base);
+        idx[0] = av_index_search_timestamp(st, ts, AVSEEK_FLAG_BACKWARD);
+        idx[1] = av_index_search_timestamp(st, ts, 0);
+        if (idx[0] < 0 || idx[1] < 0)
+            return 0;               /* target not bracketed by the (possibly partial) index */
+        for (i = 0; i < 2; i++) {
+            const AVIndexEntry *e = avformat_index_get_entry(st, idx[i]);
+            int64_t land;
+            if (!e)
+                return 0;
+            cand_us[i] = av_rescale_q_rnd(e->timestamp, st->time_base, AV_TIME_BASE_Q, AV_ROUND_UP);
+            land = cand_us[i] + lead_us;
+            if ((direction > 0 && land <= origin_us) || (direction < 0 && land >= origin_us))
+                continue;
+            if (best < 0 || llabs(land - *target) < llabs(cand_us[best] + lead_us - *target))
+                best = i;
+        }
+        if (best < 0)
+            return 0;
+        *target = cand_us[best];
+        *min_ts = cand_us[best] - 2;
+        *max_ts = cand_us[best] + 1;
+        return 1;
+    }
+}
+
+/* ffp_seek_keyframe: the target is found by reading the key packets of the video stream with a private demuxer (kf_ic), never by
+ * estimating from the GOP length: every key packet between the scan start and the displayed frame is seen, so the
+ * result is the adjacent keyframe of the stream whatever the GOP structure. The scan context is separate so a
+ * first / last keyframe (nothing to land on) leaves the playing demuxer, its queues and its position alone. The
+ * demuxer of the media is then seeked to just before that keyframe and the read loop drops video packets up to it. */
+#define FFP_KF_TOL_S 0.002
+
+static int ffp_kf_open(VideoState *is)
+{
+    AVFormatContext *sic = NULL;
+    AVDictionary *fo = NULL;
+    int i, ret;
+
+    if (is->kf_ic)
+        return 0;
+    if (is->kf_scan_failed)
+        return AVERROR(EIO);
+    sic = avformat_alloc_context();
+    if (!sic)
+        return AVERROR(ENOMEM);
+    sic->interrupt_callback.callback = decode_interrupt_cb;
+    sic->interrupt_callback.opaque = is;
+    av_dict_copy(&fo, is->o->format_opts, 0);
+    av_dict_set(&fo, "scan_all_pmts", "1", AV_DICT_DONT_OVERWRITE);
+    ret = avformat_open_input(&sic, is->filename, is->iformat, &fo);
+    av_dict_free(&fo);
+    if (ret < 0)
+        goto fail;
+    if (is->o->genpts)
+        sic->flags |= AVFMT_FLAG_GENPTS;
+    ret = avformat_find_stream_info(sic, NULL);
+    if (ret < 0)
+        goto fail;
+    is->kf_scan_idx = -1;
+    for (i = 0; i < (int)sic->nb_streams; i++) {
+        const AVStream *st = sic->streams[i];
+        if (st->codecpar->codec_type == AVMEDIA_TYPE_VIDEO && st->id == is->video_st->id &&
+            st->codecpar->codec_id == is->video_st->codecpar->codec_id) {
+            is->kf_scan_idx = i;
+            break;
+        }
+    }
+    if (is->kf_scan_idx < 0 && is->video_stream < (int)sic->nb_streams &&
+        sic->streams[is->video_stream]->codecpar->codec_type == AVMEDIA_TYPE_VIDEO)
+        is->kf_scan_idx = is->video_stream;
+    if (is->kf_scan_idx < 0) {
+        ret = AVERROR_STREAM_NOT_FOUND;
+        goto fail;
+    }
+    for (i = 0; i < (int)sic->nb_streams; i++)
+        sic->streams[i]->discard = i == is->kf_scan_idx ? AVDISCARD_DEFAULT : AVDISCARD_ALL;
+    is->kf_ic = sic;
+    return 0;
+fail:
+    av_log(NULL, AV_LOG_WARNING, "keyframe scan context unavailable for %s: %s\n", is->filename, av_err2str(ret));
+    avformat_close_input(&sic);
+    is->kf_scan_failed = 1;
+    return ret;
+}
+
+/* Finds the key packet adjacent to origin_s (source PTS of the displayed frame, stream time base seconds): the last
+ * one with a PTS before it (dir < 0) or the first one after it (dir > 0). Returns 1 and the key packet's DTS (us) and
+ * PTS (s), 0 when there is none (first / last keyframe), < 0 on error. A key packet within FFP_KF_TOL_S of origin_s
+ * is the displayed frame itself and is skipped. */
+static int ffp_kf_locate(VideoState *is, int dir, double origin_s, int64_t *key_dts_us, double *key_pts_s)
+{
+    AVFormatContext *sic;
+    const AVStream *sst;
+    AVPacket *pkt;
+    double tb, start_s, back, gop = is->seek_gop_est_s > 0.0 ? is->seek_gop_est_s : 2.0;
+    int attempt, rc = 0;
+
+    if (ffp_kf_open(is) < 0)
+        return -1;
+    sic = is->kf_ic;
+    sst = sic->streams[is->kf_scan_idx];
+    pkt = av_packet_alloc();
+    if (!pkt)
+        return -1;
+    tb = av_q2d(sst->time_base);
+    start_s = sic->start_time != AV_NOPTS_VALUE ? sic->start_time / (double)AV_TIME_BASE : 0.0;
+    /* previous: begin a few GOPs back and widen until a key packet before origin_s is seen;
+     * next: begin just before it, the scan ends at the first key packet after it */
+    back = dir < 0 ? FFMAX(2.5 * gop, 1.0) : 0.5;
+    for (attempt = 0; attempt < 12; attempt++) {
+        double t = origin_s - is->seek_key_lead_s - back;
+        int at_start = 0, found = 0, reached = 0;
+        int64_t t_us;
+
+        if (t <= start_s) {
+            /* "none before it" is only claimed after reading from the very first packet, and a seek to exactly the
+             * start time can land after the first key packet in MPEG-TS: aim before it */
+            t = start_s - 2.0;
+            at_start = 1;
+        }
+        t_us = (int64_t)(t * AV_TIME_BASE);
+        if (avformat_seek_file(sic, -1, INT64_MIN, t_us, t_us, 0) < 0 &&
+            av_seek_frame(sic, -1, t_us, AVSEEK_FLAG_BACKWARD) < 0) {
+            rc = -1;
+            break;
+        }
+        while (!reached && !is->abort_request) {
+            double ps;
+            if (av_read_frame(sic, pkt) < 0)
+                break;
+            if (pkt->stream_index != is->kf_scan_idx || !(pkt->flags & AV_PKT_FLAG_KEY) ||
+                pkt->pts == AV_NOPTS_VALUE) {
+                av_packet_unref(pkt);
+                continue;
+            }
+            ps = pkt->pts * tb;
+            if (dir < 0 ? ps < origin_s - FFP_KF_TOL_S : ps > origin_s + FFP_KF_TOL_S) {
+                *key_pts_s = ps;
+                *key_dts_us = av_rescale_q(pkt->dts != AV_NOPTS_VALUE ? pkt->dts : pkt->pts,
+                                           sst->time_base, AV_TIME_BASE_Q);
+                found = 1;
+                reached = dir > 0;
+            } else if (dir < 0 && ps >= origin_s - FFP_KF_TOL_S) {
+                reached = 1;
+            }
+            av_packet_unref(pkt);
+        }
+        if (is->abort_request) {
+            rc = -1;
+            break;
+        }
+        if (found) {
+            rc = 1;
+            break;
+        }
+        if (dir > 0 || at_start)
+            break;
+        back *= 2.0;
+    }
+    av_packet_free(&pkt);
+    return rc;
+}
+
+/* Arms the read thread's seek to land shortly before the located key packet. The video packets in front of it are
+ * dropped by the read loop, so the margin only has to cover the demuxer's positioning slack. */
+static void ffp_kf_arm_seek(VideoState *is)
+{
+    int64_t t = is->kf_key_dts_us - is->kf_margin_us;
+
+    if (is->ic->start_time != AV_NOPTS_VALUE && t < is->ic->start_time)
+        t = is->ic->start_time - 2 * AV_TIME_BASE;
+    is->seek_pos = t;
+    is->seek_rel = 0;
+    is->seek_flags = AVSEEK_FLAG_BACKWARD;
+    is->seek_bounds_set = 1;
+    is->seek_min = INT64_MIN;
+    is->seek_max = t;
+    is->kf_req = 1;
+    is->seek_req = 1;
+}
+
+/* The demuxer landed after the key packet (or ended without reaching one): seek again from further back. */
+static int ffp_kf_retry(VideoState *is)
+{
+    if (++is->kf_retries > 4 || !is->kf_located)
+        return 0;
+    is->kf_margin_us *= 2;
+    av_log(NULL, AV_LOG_DEBUG, "keyframe step landed late, retry %d with %.2f s margin\n",
+           is->kf_retries, is->kf_margin_us / (double)AV_TIME_BASE);
+    ffp_kf_arm_seek(is);
+    return 1;
+}
+
+static void ffp_kf_land_on(VideoState *is, int64_t key_dts_us, double key_pts_s)
+{
+    is->kf_located = 1;
+    is->kf_retries = 0;
+    is->kf_margin_us = AV_TIME_BASE / 4;
+    is->kf_key_dts_us = key_dts_us;
+    is->kf_key_pts_s = key_pts_s;
+    is->last_seek_pos = key_pts_s;
+    ffp_kf_arm_seek(is);
+}
+
+static int ffp_kf_can_scan(const VideoState *is)
+{
+    return is->video_st && is->ic && !(is->video_st->disposition & AV_DISPOSITION_ATTACHED_PIC) && !is->realtime &&
+           is->ic->pb && (is->ic->pb->seekable & AVIO_SEEKABLE_NORMAL);
+}
+
+/* Timed seeks land on the video key packet closest to target_s (source PTS, seconds), by the same exact key packet
+ * scan as the keyframe step: the last key packet at or before the target and the first one after it are read, the
+ * nearer wins (the earlier on a tie). dir < 0 requires the landing before origin_s, dir > 0 after it (the displayed
+ * frame, FFP_KF_TOL_S apart); a nearest key on the wrong side gives way to the nearest one on the right side. sic is
+ * the demuxer to scan (kf_ic, or the playing one at open). Returns 1 with the key packet's DTS (us) and PTS (s), 0 when
+ * no key packet qualifies, < 0 on error. */
+static int ffp_kf_locate_near(VideoState *is, AVFormatContext *sic, int scan_idx, double target_s, int dir,
+                              double origin_s, int64_t *key_dts_us, double *key_pts_s)
+{
+    const AVStream *sst = sic->streams[scan_idx];
+    AVPacket *pkt = av_packet_alloc();
+    double tb = av_q2d(sst->time_base), gop = is->seek_gop_est_s > 0.0 ? is->seek_gop_est_s : 2.0;
+    double start_s = sic->start_time != AV_NOPTS_VALUE ? sic->start_time / (double)AV_TIME_BASE : 0.0;
+    double back = FFMAX(1.5 * gop, 1.0);
+    struct { int64_t dts_us; double pts_s; } hit[2] = {{0}};     /* [0] last key at or before the target, [1] first after */
+    int have[2] = {0, 0}, attempt, rc = 0;
+
+    if (!pkt)
+        return -1;
+    for (attempt = 0; attempt < 12; attempt++) {
+        double t = target_s - is->seek_key_lead_s - back;
+        int at_start = 0;
+        int64_t t_us;
+
+        have[0] = have[1] = 0;
+        if (t <= start_s) {
+            t = start_s - 2.0;
+            at_start = 1;
+        }
+        t_us = (int64_t)(t * AV_TIME_BASE);
+        if (avformat_seek_file(sic, -1, INT64_MIN, t_us, t_us, 0) < 0 &&
+            av_seek_frame(sic, -1, t_us, AVSEEK_FLAG_BACKWARD) < 0) {
+            rc = -1;
+            break;
+        }
+        while (!have[1] && !is->abort_request) {
+            double ps;
+            int side;
+            if (av_read_frame(sic, pkt) < 0)
+                break;
+            if (pkt->stream_index != scan_idx || !(pkt->flags & AV_PKT_FLAG_KEY) || pkt->pts == AV_NOPTS_VALUE) {
+                av_packet_unref(pkt);
+                continue;
+            }
+            ps = pkt->pts * tb;
+            side = ps > target_s;
+            hit[side].pts_s = ps;
+            hit[side].dts_us = av_rescale_q(pkt->dts != AV_NOPTS_VALUE ? pkt->dts : pkt->pts, sst->time_base,
+                                            AV_TIME_BASE_Q);
+            have[side] = 1;
+            av_packet_unref(pkt);
+        }
+        if (is->abort_request) {
+            rc = -1;
+            break;
+        }
+        if (have[0] || at_start)
+            break;
+        back *= 2.0;
+    }
+    av_packet_free(&pkt);
+    if (rc < 0)
+        return rc;
+    {
+        int best = -1, i;
+        for (i = 0; i < 2; i++) {
+            if (!have[i])
+                continue;
+            if (dir < 0 && !(hit[i].pts_s < origin_s - FFP_KF_TOL_S))
+                continue;
+            if (dir > 0 && !(hit[i].pts_s > origin_s + FFP_KF_TOL_S))
+                continue;
+            if (best < 0 || fabs(hit[i].pts_s - target_s) < fabs(hit[best].pts_s - target_s))
+                best = i;
+        }
+        if (best < 0)
+            return 0;
+        *key_dts_us = hit[best].dts_us;
+        *key_pts_s = hit[best].pts_s;
+        return 1;
+    }
+}
