+static void ffp_report_error(VideoState *is, int code)
+{
+    if (!SDL_AtomicCAS(&is->failed, 0, 1))
+        return;
+    av_log(NULL, AV_LOG_ERROR, "%s: error %d\n", is->filename, code);
+    ffp_emit_error(is->ffp, code, is->filename);
+}
+
+/* A hardware decode error: when the presenter reports its device as lost, FFP_EVENT_ERROR carries "device_lost" and
+ * 1 is returned (the decoder stops); else 0. Video decoder thread, while the presenter of this open is open. */
+static int ffp_report_device_lost(VideoState *is, int code)
+{
+    FFPlayer *ffp = is->ffp;
+    char reason[64] = "";
+
+    if (!is->pres_open || !ffp->pres.device_lost || !ffp->pres.device_lost(ffp->pres.opaque, reason, sizeof(reason)))
+        return 0;
+    if (!SDL_AtomicCAS(&is->failed, 0, 1))
+        return 1;
+    av_log(NULL, AV_LOG_ERROR, "%s: the %s presenter's device was lost (%s), video decoder error %d\n", is->filename,
+           ffp->pres.name, reason, code);
+    ffp_emit_error_ex(ffp, code, is->filename, reason);
+    return 1;
+}
