+         * decoder for one frame; a step forward and a timed skip keep the play state */
+        if (!is->paused)
+            toggle_pause(is);
+        SDL_AtomicSet(&is->step_silence, 1);
+        ffp_set_state(ffp, FFP_ST_PAUSED, 0);
+    } else if (ffp_get_state(ffp) == FFP_ST_ENDED) {
+        ffp_set_state(ffp, is->paused ? FFP_ST_PAUSED : FFP_ST_PLAYING, 0);
+    }
+    SDL_CondSignal(is->continue_read_thread);
+}
