+/* replaces a hardware frame by its download into system memory (props kept); on failure the frame is unref'ed */
+static int ffp_download_frame(AVFrame *frame)
+{
+    AVFrame *sw = av_frame_alloc();
+    int ret = sw ? av_hwframe_transfer_data(sw, frame, 0) : AVERROR(ENOMEM);
+    if (ret >= 0)
+        ret = av_frame_copy_props(sw, frame);
+    if (ret < 0) {
+        av_log(NULL, AV_LOG_ERROR, "Failed to download hardware frame: %s\n", av_err2str(ret));
+        av_frame_free(&sw);
+        av_frame_unref(frame);
+        return ret;
+    }
+    av_frame_unref(frame);
+    av_frame_move_ref(frame, sw);
+    av_frame_free(&sw);
+    return 0;
+}
