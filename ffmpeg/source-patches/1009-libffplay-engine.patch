+static int ffp_starved(VideoState *is)
+{
+    if (is->paused || SDL_AtomicGet(&is->eof) || SDL_AtomicGet(&is->failed) || is->abort_request)
+        return 0;
+    if (is->video_st && !(is->video_st->disposition & AV_DISPOSITION_ATTACHED_PIC) &&
+        is->viddec.finished != is->videoq.serial &&
+        ffp_fq_remaining(&is->pictq) == 0 && ffp_pq_packets(&is->videoq) == 0)
+        return 1;
+    if (is->audio_st && is->auddec.finished != is->audioq.serial &&
+        ffp_fq_remaining(&is->sampq) == 0 && ffp_pq_packets(&is->audioq) == 0)
+        return 1;
+    return 0;
+}
