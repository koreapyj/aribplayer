+static void ffp_store_snapshot(FFPlayer *ffp, VideoState *is, const Frame *vp)
+{
+    int i;
+    SDL_LockMutex(ffp->snap_mutex);
+    ffp->snap_is = is;
+    if (!ffp->last_frame)
+        ffp->last_frame = av_frame_alloc();
+    if (ffp->last_frame) {
+        av_frame_unref(ffp->last_frame);
+        if (av_frame_ref(ffp->last_frame, vp->frame) < 0)
+            av_frame_unref(ffp->last_frame);
+    }
+    for (i = 0; i < FFP_SUBTITLE_LAYER_COUNT; i++) {
+        SubtitleLayer *layer = &is->subtitles[i];
+        avsubtitle_free(&ffp->last_subtitles[i]);
+        ffp->last_subtitle_width[i] = ffp->last_subtitle_height[i] = 0;
+        ffp->last_subtitle_visible[i] = i != FFP_SUBTITLE_SUPERIMPOSE || is->o->superimpose;
+        ffp->last_subtitle_is_arib[i] = layer->is_arib;
+        ffp->last_subtitle_stream_index[i] = layer->stream_index;
+        ffp->last_subtitle_generation[i] = layer->generation;
+        SDL_LockMutex(layer->packets.mutex);
+        ffp->last_subtitle_serial[i] = layer->packets.serial;
+        SDL_UnlockMutex(layer->packets.mutex);
+        SDL_LockMutex(is->dbg_mutex);
+        ffp->last_subtitle_decode_generation[i] = layer->cue_decode_generation;
+        SDL_UnlockMutex(is->dbg_mutex);
+        if (layer->active_valid && layer->active.num_rects > 0 &&
+            ffp_subtitle_copy(&ffp->last_subtitles[i], &layer->active) >= 0) {
+            ffp->last_subtitle_width[i] = layer->active_width;
+            ffp->last_subtitle_height[i] = layer->active_height;
+        }
+    }
+    SDL_UnlockMutex(ffp->snap_mutex);
+}
