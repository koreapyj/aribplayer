+static void json_string(AVBPrint *bp, const char *str)
+{
+    const uint8_t *p = (const uint8_t *)(str ? str : "");
+    const uint8_t *end = p + strlen((const char *)p);
+
+    av_bprint_chars(bp, '"', 1);
+    while (p < end) {
+        const uint8_t *start = p, *q = p;
+        int32_t c;
+
+        if (*p < 0x80) {
+            c = *p++;
+        } else if (av_utf8_decode(&c, &q, end, 0) < 0) {
+            av_bprintf(bp, "\\ufffd");
+            p++;
+            continue;
+        } else {
+            p = q;
+        }
+        switch (c) {
+        case '"':  av_bprintf(bp, "\\\""); break;
+        case '\\': av_bprintf(bp, "\\\\"); break;
+        case '\n': av_bprintf(bp, "\\n");  break;
+        case '\r': av_bprintf(bp, "\\r");  break;
+        case '\t': av_bprintf(bp, "\\t");  break;
+        case '\b': av_bprintf(bp, "\\b");  break;
+        case '\f': av_bprintf(bp, "\\f");  break;
+        default:
+            if (c < 0x20 || c == 0x7f)
+                av_bprintf(bp, "\\u%04x", c);
+            else
+                av_bprint_append_data(bp, (const char *)start, p - start);
+        }
+    }
+    av_bprint_chars(bp, '"', 1);
+}
+
+static void json_double(AVBPrint *bp, double d)
+{
+    if (isnan(d) || isinf(d))
+        d = 0;
+    av_bprintf(bp, "%.3f", d);
+}
