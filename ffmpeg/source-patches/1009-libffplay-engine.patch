+/* the creation options of ffp_create: audio_driver=<name>; 0, or FFP_EINVAL for an unknown key or a bad value */
+static int ffp_parse_create_options(const char *kv, char *audio_driver, size_t size)
+{
+    const char *line = kv;
+
+    audio_driver[0] = 0;
+    while (line && *line) {
+        const char *end = line + strcspn(line, "\n");
+        const char *eq = memchr(line, '=', end - line);
+        size_t klen = (eq ? eq : end) - line, vlen;
+        const char *val = eq ? eq + 1 : end;
+
+        vlen = end - val;
+        if (vlen && val[vlen - 1] == '\r')
+            vlen--;
+        if (klen && line[klen - 1] == '\r')
+            klen--;
+        if (klen) {
+            if (klen != 12 || memcmp(line, "audio_driver", 12) || vlen >= size) {
+                av_log(NULL, AV_LOG_ERROR, "ffp_create: unknown or invalid option '%.*s'\n", (int)klen, line);
+                return FFP_EINVAL;
+            }
+            memcpy(audio_driver, val, vlen);
+            audio_driver[vlen] = 0;
+        }
+        line = *end ? end + 1 : NULL;
+    }
+    return 0;
+}
