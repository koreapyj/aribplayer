+/* The device of `type` for this open: the presenter's, else one of FFPOutput.devices, else (only_given_devices = 0) a
+ * default device of the type. *ref is a new reference; err: the reason of a failure. */
+static int ffp_get_hwdevice(VideoState *is, enum AVHWDeviceType type, AVBufferRef **ref, char *err, size_t err_size)
+{
+    FFPlayer *ffp = is->ffp;
+    AVBufferRef *dev = ffp_device_of_type(is->pres_devs, is->nb_pres_devs, type);
+    int ret;
+
+    err[0] = 0;
+    *ref = NULL;
+    if (!dev)
+        dev = ffp_device_of_type(ffp->out_devs, ffp->nb_out_devs, type);
+    if (dev) {
+        *ref = av_buffer_ref(dev);
+        return *ref ? 0 : AVERROR(ENOMEM);
+    }
+    if (ffp->only_given_devices) {
+        snprintf(err, err_size, "no %s device was given", av_hwdevice_get_type_name(type));
+        return AVERROR(ENODEV);
+    }
+    ret = av_hwdevice_ctx_create(ref, type, NULL, NULL, 0);
+    if (ret < 0)
+        snprintf(err, err_size, "%s", av_err2str(ret));
+    return ret;
+}
