+static int ffp_parse_kv(FFPOptions *o, FFPOpenOverrides *ov, const char *kv)
+{
+    char *copy, *line, *save = NULL;
+    int ret = 0;
+
+    if (!kv || !*kv)
+        return 0;
+    copy = av_strdup(kv);
+    if (!copy)
+        return AVERROR(ENOMEM);
+
+    for (line = copy; line; line = save) {
+        char *eq;
+        save = strchr(line, '\n');
+        if (save)
+            *save++ = 0;
+        if (line[0] == '\r' && !line[1])
+            continue;
+        if (!*line)
+            continue;
+        eq = line + strlen(line);
+        if (eq > line && eq[-1] == '\r')
+            eq[-1] = 0;
+        eq = strchr(line, '=');
+        if (eq)
+            *eq++ = 0;
+        if (!*line) {
+            ret = AVERROR(EINVAL);
             break;
         }
+        ret = ffp_set_option(o, ov, line, eq ? eq : "");
+        if (ret < 0)
+            break;
     }
+    av_free(copy);
+    return ret;
 }
 
