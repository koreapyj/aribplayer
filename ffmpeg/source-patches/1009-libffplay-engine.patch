+static int ffp_subtitle_copy(AVSubtitle *dst, const AVSubtitle *src)
+{
+    AVSubtitle copy;
+    int i, row;
+
+    if (!dst || !src)
+        return AVERROR(EINVAL);
+    avsubtitle_free(dst);
+    copy = *src;
+    copy.rects = NULL;
+    copy.num_rects = 0;
+    if (src->num_rects) {
+        copy.rects = av_calloc(src->num_rects, sizeof(*copy.rects));
+        if (!copy.rects)
+            return AVERROR(ENOMEM);
+    }
+    for (i = 0; i < src->num_rects; i++) {
+        const AVSubtitleRect *from = src->rects[i];
+        AVSubtitleRect *to;
+        int stride, height;
+        size_t bytes;
+
+        if (!from)
+            goto fail;
+        to = av_mallocz(sizeof(*to));
+        if (!to)
+            goto fail;
+        *to = *from;
+        memset(to->data, 0, sizeof(to->data));
+        to->text = NULL;
+        to->ass = NULL;
+        copy.rects[i] = to;
+        copy.num_rects++;
+
+        if (from->data[0]) {
+            stride = FFABS(from->linesize[0]);
+            height = FFMAX(from->h, 0);
+            if (!stride || !height || from->w > stride || av_size_mult(stride, height, &bytes) < 0)
+                goto fail;
+            to->data[0] = av_mallocz(bytes);
+            if (!to->data[0])
+                goto fail;
+            to->linesize[0] = stride;
+            for (row = 0; row < height; row++)
+                memcpy(to->data[0] + (size_t)row * stride,
+                       from->data[0] + row * from->linesize[0], FFMIN(from->w, stride));
+        }
+        if (from->data[1]) {
+            to->data[1] = av_memdup(from->data[1], AVPALETTE_SIZE);
+            if (!to->data[1])
+                goto fail;
+        }
+    }
+    *dst = copy;
     return 0;
+
+fail:
+    avsubtitle_free(&copy);
+    return AVERROR(ENOMEM);
 }
 
