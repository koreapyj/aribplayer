+        if ((ret = ffp_parse_number(key, val, &num)) < 0)
+            return ret;
+        ov->volume = av_clip((int)num, 0, 100);
+        return 0;
+    }
+    if (!strcmp(key, "f")) {
+        o->file_iformat = av_find_input_format(val);
+        if (!o->file_iformat) {
+            av_log(NULL, AV_LOG_FATAL, "Unknown input format: %s\n", val);
+            return AVERROR(EINVAL);
+        }
+        return 0;
+    }
+    if (!strcmp(key, "sync")) {
+        if (!strcmp(val, "audio"))      o->av_sync_type = AV_SYNC_AUDIO_MASTER;
+        else if (!strcmp(val, "video")) o->av_sync_type = AV_SYNC_VIDEO_MASTER;
+        else if (!strcmp(val, "ext"))   o->av_sync_type = AV_SYNC_EXTERNAL_CLOCK;
+        else {
+            av_log(NULL, AV_LOG_ERROR, "Unknown value for %s: %s\n", key, val);
+            return AVERROR(EINVAL);
+        }
+        return 0;
+    }
+    if (!strncmp(key, "codec:", 6) || !strncmp(key, "c:", 2)) {
+        const char *spec = strchr(key, ':') + 1;
+        char **name;
+        switch (spec[0]) {
+        case 'a': name = &o->audio_codec_name;    break;
+        case 's': name = &o->subtitle_codec_name; break;
+        case 'v': name = &o->video_codec_name;    break;
         default:
+            av_log(NULL, AV_LOG_ERROR, "Invalid media specifier '%s' in option '%s'\n", spec, key);
+            return AVERROR(EINVAL);
+        }
+        av_freep(name);
+        *name = av_strdup(val);
+        return *name ? 0 : AVERROR(ENOMEM);
+    }
+    if (!strcmp(key, "i") || !strcmp(key, "loglevel") || !strcmp(key, "v") || !strcmp(key, "hide_banner"))
+        return 0;
+
+    if ((d = ffp_find_optdef(key)))
+        return ffp_set_optdef(o, d, key, val);
+    if (key[0] == 'n' && key[1] == 'o' && (d = ffp_find_optdef(key + 2)) && d->type == OT_BOOL)
+        return ffp_set_optdef(o, d, key, *val && strcmp(val, "0") && av_strcasecmp(val, "false") ? "0" : "1");
+
+    ret = ffp_opt_default(o, key, val);
+    if (ret == AVERROR_OPTION_NOT_FOUND)
+        av_log(NULL, AV_LOG_ERROR, "Unrecognized option '%s'\n", key);
+    return ret;
+}
