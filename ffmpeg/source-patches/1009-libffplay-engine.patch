+static int ffp_parse_number(const char *key, const char *val, double *out)
+{
+    char *tail;
+    double d = av_strtod(val, &tail);
+
+    if (!*val || *tail) {
+        av_log(NULL, AV_LOG_ERROR, "Expected number for %s but found: %s\n", key, val);
+        return AVERROR(EINVAL);
+    }
+    *out = d;
+    return 0;
+}
+
+static int ffp_set_optdef(FFPOptions *o, const FFPOptDef *d, const char *key, const char *val)
+{
+    uint8_t *dst = (uint8_t *)o + d->off;
+    double num;
+    int ret;
+
+    switch (d->type) {
+    case OT_BOOL:
+        if (!*val || !av_strcasecmp(val, "true") || !av_strcasecmp(val, "yes"))
+            num = 1;
+        else if (!av_strcasecmp(val, "false") || !av_strcasecmp(val, "no"))
+            num = 0;
+        else if ((ret = ffp_parse_number(key, val, &num)) < 0)
+            return ret;
+        *(int *)dst = num;
+        return 0;
+    case OT_INT:
+        if ((ret = ffp_parse_number(key, val, &num)) < 0)
+            return ret;
+        if (num < INT_MIN || num > INT_MAX || (int)num != num) {
+            av_log(NULL, AV_LOG_ERROR, "Expected int for %s but found %s\n", key, val);
+            return AVERROR(EINVAL);
+        }
+        *(int *)dst = num;
+        return 0;
+    case OT_TIME:
+        ret = av_parse_time((int64_t *)dst, val, 1);
+        if (ret < 0)
+            av_log(NULL, AV_LOG_ERROR, "Invalid duration for option %s: %s\n", key, val);
+        return ret;
+    case OT_STRING: {
+        char *str = av_strdup(val);
+        if (!str)
+            return AVERROR(ENOMEM);
+        av_free(*(char **)dst);
+        *(char **)dst = str;
+        return 0;
+    }
+    }
+    return AVERROR(EINVAL);
+}
