+
+/* runs on the video/audio decode thread, right before the next frame is fed */
+static void ffp_apply_filter_cmds(VideoState *is, int audio, AVFilterGraph *graph)
+{
+    FFPlayer *ffp = is->ffp;
+    FFPFilterCmd *keep = NULL, *keep_tail = NULL, *mine = NULL, *mine_tail = NULL, *n, *next;
+
+    SDL_LockMutex(ffp->mutex);
+    for (n = ffp->fcmd_head; n; n = next) {
+        next = n->next;
+        n->next = NULL;
+        if (n->audio == audio) {
+            if (mine_tail) mine_tail->next = n; else mine = n;
+            mine_tail = n;
+            ffp->nb_fcmds--;
+        } else {
+            if (keep_tail) keep_tail->next = n; else keep = n;
+            keep_tail = n;
+        }
+    }
+    ffp->fcmd_head = keep;
+    ffp->fcmd_tail = keep_tail;
+    SDL_UnlockMutex(ffp->mutex);
+
+    for (n = mine; n; n = next) {
+        next = n->next;
+        if (graph) {
+            char res[256] = "";
+            int ret = avfilter_graph_send_command(graph, n->target, n->cmd,
+                                                  n->arg ? n->arg : "", res, sizeof(res), 0);
+            if (ret < 0) {
+                char desc[512];
+                snprintf(desc, sizeof(desc), "%s %s %s", n->target, n->cmd, n->arg ? n->arg : "");
+                av_log(NULL, AV_LOG_WARNING, "Filter command '%s' failed: %s\n", desc, av_err2str(ret));
+                ffp_emit_filter_error(ffp, audio ? "audio" : "video", desc, ret);
+            }
+        }
+        ffp_free_filter_cmd(n);
+    }
+}
+
+static void ffp_clear_filter_cmds(FFPlayer *ffp)
+{
+    FFPFilterCmd *n, *next;
+    SDL_LockMutex(ffp->mutex);
+    for (n = ffp->fcmd_head; n; n = next) {
+        next = n->next;
+        ffp_free_filter_cmd(n);
+    }
+    ffp->fcmd_head = ffp->fcmd_tail = NULL;
+    ffp->nb_fcmds = 0;
+    SDL_UnlockMutex(ffp->mutex);
+}
