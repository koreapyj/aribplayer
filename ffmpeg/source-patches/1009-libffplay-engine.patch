+ * non-seekable source, or another seek / step in flight, nothing moves (moved 0). Asynchronous, one request at a
+ * time shared with ffp_step_frame, never buffered: 0 accepted, FFP_EBUSY while a step or keyframe step is in flight
+ * (dropped), FFP_EINVAL for invalid arguments. Completion is an immediate FFP_EVENT_POSITION and then
+ * FFP_EVENT_KEYSEEK_DONE {"direction":-1|1,"moved":0|1,"position":s,"key":s}: position is the presented output frame
+ * (media-relative seconds, as POSITION), key the source PTS of the decoder frame it came from (they differ after an
+ * output-timing filter such as IVTC); both are -1 when moved is 0. A new request is accepted from the moment
+ * KEYSEEK_DONE is raised. */
+FFP_API int         FFP_CALL ffp_seek_keyframe(FFPlayer *p, int direction);
+/* Timed relative skip with the keyframe step's completion model: lands on the video key packet closest to the displayed
+ * frame's source PTS + seconds (seconds < 0 back, > 0 forward), found by the same key packet scan and reached the same
+ * way, so the landing is exact and presented; unlike the keyframe step it keeps the play state (playing continues
+ * from the landing, paused stays paused). A
+ * backward skip lands before the displayed frame and a forward one after it: when the nearest key packet is on the
+ * wrong side the nearest one on the right side is taken; with none (a skip at the start / past the last key) nothing
+ * moves (moved 0). Shares the one-at-a-time slot with ffp_step_frame / ffp_seek_keyframe (FFP_EBUSY, never buffered)
+ * and completes with FFP_EVENT_POSITION and FFP_EVENT_KEYSEEK_DONE {"direction":-1|1,"moved":0|1,"position":s,"key":s}.
+ * Without a seekable video stream (audio only, cover art, live) it queues a plain relative ffp_seek and reports moved 0.
+ * ffp_seek itself (absolute / relative, coalescing, no done event) also lands on the key packet closest to its target
+ * for video media, as does the "ss" open option; a relative ffp_seek obeys the same direction rule. */
+FFP_API int         FFP_CALL ffp_skip(FFPlayer *p, double seconds);
+/* Open option start_paused=1: the open ends PAUSED with the first frame at the start position presented and a valid
+ * position; no audio is output and the clocks do not run until ffp_play, so playback then starts in sync from that
+ * frame. */
+FFP_API int         FFP_CALL ffp_set_volume(FFPlayer *p, int volume_0_100);   /* persists across opens */
+FFP_API int         FFP_CALL ffp_set_mute(FFPlayer *p, int mute);             /* persists across opens */
+
+FFP_API double      FFP_CALL ffp_get_position(FFPlayer *p);       /* seconds; NAN if unknown */
+FFP_API double      FFP_CALL ffp_get_duration(FFPlayer *p);       /* seconds; <= 0 if unknown/live */
+FFP_API char       *FFP_CALL ffp_get_media_info(FFPlayer *p);     /* JSON (see below) or NULL; ffp_free */
+
+FFP_API int         FFP_CALL ffp_cycle_stream(FFPlayer *p, int type);
+
+/* ARIB audio model. For an ARIB transport stream (media info "arib_audio" present) the video program's audio is
+ * "audio 1" (ADTS AAC with component tag 0x10 / 0x83 / 0x85, else the first untagged AAC) and "audio 2" (tag 0x11),
+ * both decoded in parallel; ffp_cycle_stream(FFP_STREAM_AUDIO) does nothing for such a media. pref:
+ *   FFP_ARIB_AUDIO_1 (0): always audio 1.
+ *   FFP_ARIB_AUDIO_2 (1): audio 2 wherever it has samples, audio 1 otherwise; the change back and forth is gapless
+ *                         (a 5 ms crossfade, the device stays open) and never reported. Audio 2 is entered again only
+ *                         one second after it was left, so a patchy stream does not flap.
+ * The value takes effect within the audio pipeline's latency (~0.2 s), applies to the current and to later opens of this
+ * instance (the host resets it to audio 1 when a new file should start there) and is ignored by media that is not ARIB TS.
+ * Returns 0, FFP_EINVAL for another value. */
+enum { FFP_ARIB_AUDIO_1 = 0, FFP_ARIB_AUDIO_2 = 1 };
+FFP_API int         FFP_CALL ffp_set_audio_preference(FFPlayer *p, int pref);
+/* Changes only presentation visibility (FFPOverlayLayer.visible); both decoders continue running, so an indefinite cue
+ * reappears when shown again. Superimpose visibility is independent of caption visibility. */
+FFP_API int         FFP_CALL ffp_set_subtitle_visible(FFPlayer *p, int layer, int on);
+/* Reopens only an active ARIB caption decoder with the new style; video/audio are untouched. */
+FFP_API int         FFP_CALL ffp_refresh_caption_style(FFPlayer *p, int ignore_background,
+                                                       int force_outline);
+
+/* Filters. Strings persist on the instance across opens. NULL or "" = no filter.
+ * The new graph is built by the decode thread on the next frame through ffplay's
+ * configure_video_filters/configure_audio_filters path. If the build fails,
+ * FFP_EVENT_FILTER_ERROR is raised and the previous string is restored. */
+FFP_API int         FFP_CALL ffp_set_video_filter(FFPlayer *p, const char *vf);
+FFP_API int         FFP_CALL ffp_set_audio_filter(FFPlayer *p, const char *af);
+
+/* Queues avfilter_graph_send_command(graph, target, cmd, arg) for the video graph (or the
+ * audio graph if target starts with "a:" -- the prefix is stripped). Applied on the filter
+ * thread before the next frame. Returns 0 if queued. Failures are reported asynchronously
+ * as FFP_EVENT_FILTER_ERROR. resp/resp_len may be NULL/0; if given, resp receives "queued".
+ * Commands do not change the stored filter string: hosts keep the string in sync. */
+FFP_API int         FFP_CALL ffp_filter_command(FFPlayer *p, const char *target, const char *cmd,
+                                                const char *arg, char *resp, int resp_len);
+
+/* Copies the last presented frame (after the video filter graph, so e.g. vf=transpose=1 on a
+ * 1280x720 source gives 720x1280; before display scaling) as BGRA (bytes B,G,R,A; A=255), at the filtered size
+ * stretched by SAR to the display aspect: if sar>1 width = round(w*sar); if sar<1 height = round(h/sar); both rounded
+ * to even. The frame as shown, no further processing.
+ * Rendered by FFPPresenter.readback when the presenter has one, else on the CPU (hardware frames are downloaded,
+ * swscale to BGRA).
+ * On success *out_bgra is allocated (free with ffp_free) and 0 is returned.
+ * Returns FFP_EAGAIN if no frame has been presented yet. */
+FFP_API int         FFP_CALL ffp_snapshot(FFPlayer *p, uint8_t **out_bgra, int *width,
+                                          int *height, int *stride);
+/* ffp_snapshot_ex uses the same native-size video path. FFP_SNAPSHOT_SUBTITLES composites the
+ * currently active visible bitmap layers (caption if visible; superimpose if enabled and visible).
+ * ARIB layers are re-rendered at snapshot size and the live canvas is restored; a failed re-render
+ * falls back to high-quality scaling. Bit 0 is the only supported flag. */
+enum { FFP_SNAPSHOT_SUBTITLES = 1 };
+FFP_API int         FFP_CALL ffp_snapshot_ex(FFPlayer *p, unsigned flags, uint8_t **out_bgra,
+                                             int *width, int *height, int *stride);
+FFP_API void        FFP_CALL ffp_free(void *ptr);
+
+/* JSON snapshot of the live decoder / filter graph / sync state of the current media, or NULL when nothing
+ * is open. Every value is what is actually in use at runtime (opened decoder, configured graphs, ...), see
+ * docs/libffplay-api.md for the schema. "presenter" is {"name":..,"error":"","frames_direct":N,"frames_uploaded":M,
+ * "stats":<FFPPresenter.stats_json or {}>}. Free with ffp_free. Thread-safe, never blocks
+ * for long; cheap enough to call at 4 Hz. */
+FFP_API char       *FFP_CALL ffp_get_debug_info(FFPlayer *p);
+
+/* Process-wide log sink: every av_log line (FFmpeg + libffplay, incl. the stats status line) is formatted
+ * (av_log_format_line2, with the "[ctx @ ptr]" prefix; the string keeps its trailing "\n" / "\r") and
+ * delivered as one UTF-8 string per call, from any thread. level = AV_LOG_* of the message. Messages less
+ * severe than the current ffp_set_log_level are not delivered. cb = NULL restores the default (stderr)
+ * logger. A call that started before the switch may still finish afterwards. */
+typedef void (FFP_CALL *ffp_log_cb)(void *user, int level, const char *line);
+FFP_API void        FFP_CALL ffp_set_log_callback(ffp_log_cb cb, void *user);
+
+/* Portable capability probe with the host's devices (AVBufferRef to AVHWDeviceContext; nb_devices 0 = one default
+ * device of every hardware type of this build). Blocking (device frame pools and
+ * device-to-device mapping are tested with 64x64 frames), any thread, no FFPlayer needed, not cached: every call
+ * probes. av_log output is suppressed while it runs. Returns UTF-8 JSON (schema: docs/libffplay-api.md and
+ * wvp::CapabilitySet): "devices" (one entry per given device: usable for frame pools), "decoders" (the decoders of the
+ * build that have a hwaccel of a given device type; "ok" means present, not verified on the device: decode support
+ * of the GPU is the host's probe), "interop" (map / copy between the given devices), "features". No "adapter", no
+ * "presenters": both are the host's. Free with ffp_free; NULL only when out of memory. What is fixed by the build
+ * (video filters, the decoder of each hwaccel, build features) is printed by ffcapsdump at build time. */
+FFP_API char       *FFP_CALL ffp_probe_caps(struct AVBufferRef *const *devices, int nb_devices);
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* FFTOOLS_FFPLAY_H */
