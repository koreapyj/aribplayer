+FFP_API FFPlayer *FFP_CALL ffp_create(const FFPOutput *output, const char *options_kv, ffp_event_cb cb, void *user)
+{
+    FFPlayer *ffp;
+    char audio_driver[sizeof(g_ffp.audio_driver)];
+    int ret;
+
+    if (ffp_parse_create_options(options_kv, audio_driver, sizeof(audio_driver)) < 0)
+        return NULL;
+    ffp_global_init();
+
+    SDL_LockMutex(g_ffp.life_mutex);
+    if (!g_ffp.refcount) {
+        av_strlcpy(g_ffp.audio_driver, audio_driver, sizeof(g_ffp.audio_driver));
+        if ((ret = ffp_loop_start()) < 0) {
+            SDL_UnlockMutex(g_ffp.life_mutex);
+            return NULL;
+        }
+    } else if (audio_driver[0] && strcmp(audio_driver, g_ffp.audio_driver)) {
+        av_log(NULL, AV_LOG_WARNING, "ffp_create: audio_driver=%s ignored, SDL audio already runs with '%s'\n",
+               audio_driver, g_ffp.audio_driver[0] ? g_ffp.audio_driver : "the default driver");
+    }
+    g_ffp.refcount++;
+    SDL_UnlockMutex(g_ffp.life_mutex);
+
+    ffp = av_mallocz(sizeof(*ffp));
+    if (ffp) {
+        ffp->mutex      = SDL_CreateMutex();
+        ffp->emit_mutex = SDL_CreateMutex();
+        ffp->snap_mutex = SDL_CreateMutex();
+        ffp->dbg_mutex  = SDL_CreateMutex();
+        ffp->pres_mutex = SDL_CreateMutex();
+        ffp->pres_life_mutex = SDL_CreateMutex();
+        ffp->create_sem = SDL_CreateSemaphore(0);
+    }
+    if (!ffp || !ffp->mutex || !ffp->emit_mutex || !ffp->snap_mutex || !ffp->dbg_mutex || !ffp->pres_mutex ||
+        !ffp->pres_life_mutex || !ffp->create_sem || ffp_output_set(ffp, output) < 0) {
+        if (ffp)
+            ffp_free_instance(ffp);
+        ffp_release();
+        return NULL;
+    }
+    ffp->sink.engine = ffp;
+    ffp->sink.presented = ffp_sink_presented;
+    ffp->sink.failed = ffp_sink_failed;
+    ffp->cb = cb;
+    ffp->user = user;
+    ffp->state = FFP_ST_IDLE;
+    ffp->position = NAN;
+    SDL_AtomicSet(&ffp->volume, SDL_MIX_MAXVOLUME);
+    SDL_AtomicSet(&ffp->muted, 0);
+    SDL_AtomicSet(&ffp->subtitle_visible[FFP_SUBTITLE_CAPTION], 1);
+    SDL_AtomicSet(&ffp->subtitle_visible[FFP_SUBTITLE_SUPERIMPOSE], 1);
+
+#if CONFIG_AVDEVICE
+    avdevice_register_all();
+#endif
+    avformat_network_init();
+
+    SDL_LockMutex(g_ffp.mutex);
+    ffp->next = g_ffp.pending;
+    g_ffp.pending = ffp;
+    SDL_UnlockMutex(g_ffp.mutex);
+    ffp_wake();
+    SDL_SemWait(ffp->create_sem);
+
+    if (ffp->create_result < 0) {
+        avformat_network_deinit();
+        ffp_free_instance(ffp);
+        ffp_release();
+        return NULL;
+    }
+    return ffp;
+}
+
+/* detaches the media on the display thread (the presenter is cleared), then joins its threads and closes the
+ * presenter on the calling thread */
+static void ffp_close_media(FFPlayer *ffp)
+{
+    FFPCmd c;
+
+    memset(&c, 0, sizeof(c));
+    c.type = FFP_CMD_DETACH;
+    c.done = SDL_CreateSemaphore(0);
+    if (!c.done)
+        return;
+    ffp_post(ffp, &c);
+    SDL_SemWait(c.done);
+    SDL_DestroySemaphore(c.done);
+    if (c.is_out)
+        stream_close(c.is_out);
+    ffp->step_done_pending = 0;
+    ffp->kf_done_pending = 0;
+    SDL_AtomicSet(&ffp->step_busy, 0);
+}
+
+FFP_API void FFP_CALL ffp_destroy(FFPlayer *ffp)
+{
+    FFPCmd c;
+
+    if (!ffp)
+        return;
+    memset(&c, 0, sizeof(c));
+    c.type = FFP_CMD_DESTROY;
+    c.done = SDL_CreateSemaphore(0);
+    if (c.done) {
+        ffp_post(ffp, &c);
+        SDL_SemWait(c.done);
+        SDL_DestroySemaphore(c.done);
+        if (c.is_out)
+            stream_close(c.is_out);
+    }
+    ffp_output_set(ffp, NULL);
+    SDL_LockMutex(ffp->emit_mutex);
+    ffp->cb = NULL;
+    SDL_UnlockMutex(ffp->emit_mutex);
+    ffp_free_instance(ffp);
+    avformat_network_deinit();
+    ffp_release();
+}
+
+FFP_API int FFP_CALL ffp_set_output(FFPlayer *ffp, const FFPOutput *output)
+{
+    const FFPPresenter *p = output ? output->presenter : NULL;
+
+    if (!ffp || (output && (output->nb_devices < 0 || (output->nb_devices && !output->devices))) ||
+        (p && (!p->open || !p->present || !p->clear || !p->close)))
+        return FFP_EINVAL;
+    ffp_close_media(ffp);
+    ffp_set_state(ffp, FFP_ST_STOPPED, 0);
+    return ffp_output_set(ffp, output) < 0 ? FFP_EINVAL : 0;
+}
