+static void ffp_tick(FFPlayer *ffp, double *remaining)
+{
+    VideoState *is = ffp->is;
+    int64_t now = av_gettime_relative();
+    int reverse_state;
+
+    SDL_LockMutex(ffp->mutex);
+    reverse_state = is->reverse_step_state;
+    if (reverse_state == FFP_REVERSE_STEP_RETRY) {
+        is->reverse_step_attempt++;
+        is->reverse_step_state = FFP_REVERSE_STEP_SEEKING;
+    } else if (reverse_state == FFP_REVERSE_STEP_QUEUED || reverse_state == FFP_REVERSE_STEP_FAILED) {
+        is->reverse_step_state = FFP_REVERSE_STEP_NONE;
+    }
+    SDL_UnlockMutex(ffp->mutex);
+
+    if (reverse_state == FFP_REVERSE_STEP_RETRY) {
+        /* The demuxer lands on the first key packet at or after the seek point, so a retry has to seek before the key packet
+         * preceding the displayed frame, however long the GOP is: widen the margin fourfold per attempt. */
+        const int64_t previous_max_us = is->reverse_step_seek_ts - ((3 * AV_TIME_BASE / 5) << (2 * is->reverse_step_attempt));
+        av_log(NULL, AV_LOG_DEBUG, "reverse step retry %d before source frame %.3f s\n",
+               is->reverse_step_attempt, is->reverse_step_seek_ts / (double)AV_TIME_BASE);
+        is->reverse_step_source_seen = 0;
+        is->seek_pos = previous_max_us;
+        is->seek_rel = 0;
+        is->seek_flags = AVSEEK_FLAG_BACKWARD;
+        is->seek_bounds_set = 1;
+        is->seek_min = INT64_MIN;
+        is->seek_max = previous_max_us;
+        is->seek_req = 1;
+        SDL_AtomicSet(&is->eof, 0);
+        SDL_AtomicSet(&is->eof_notified, 0);
+        SDL_CondSignal(is->continue_read_thread);
+    } else if (reverse_state == FFP_REVERSE_STEP_QUEUED) {
+        step_to_next_frame(is);
+    } else if (reverse_state == FFP_REVERSE_STEP_FAILED) {
+        if (!is->paused)
+            stream_toggle_pause(is);
+        is->step = 0;
+        ffp_api_step_end(is, 0);
+        ffp_set_state(ffp, FFP_ST_PAUSED, 0);
+    }
+
+    ffp_apply_pending_seek(ffp, is);
+    ffp_pres_report_failure(ffp);
+    {   /* the captions follow the displayed video area the presenter reports */
+        int w, h;
+        SDL_AtomicLock(&ffp->sink_lock);
+        w = ffp->shown_width;
+        h = ffp->shown_height;
+        SDL_AtomicUnlock(&ffp->sink_lock);
+        ffp_subtitle_note_video_rect(is, w, h);
+    }
+    ffp_subtitle_check_resize(is, now);
+    {   /* a re-rendered caption is waiting: redraw so it is shown while paused too */
+        int i, pending = 0;
+        SDL_LockMutex(is->dbg_mutex);
+        for (i = 0; i < FFP_SUBTITLE_LAYER_COUNT; i++)
+            pending |= is->subtitles[i].pending_rerender_valid || is->subtitles[i].pending_attime_valid;
+        SDL_UnlockMutex(is->dbg_mutex);
+        if (pending)
+            is->force_refresh = 1;
+    }
+    if (SDL_AtomicGet(&is->prepared) && !is->video_st && !is->cleared_audio_only) {
+        is->cleared_audio_only = 1;
+        ffp_pres_clear(ffp);
+    }
+
+    if (!is->paused || is->force_refresh || is->start_paused_frame) {
+        double rt = REFRESH_RATE;
+        video_refresh(is, &rt);
+        *remaining = FFMIN(*remaining, rt);
+    }
+
+    if (is->kf_pending) {
+        if (SDL_AtomicGet(&is->kf_noop) ||
+            (SDL_AtomicGet(&is->kf_serial) >= 0 && SDL_AtomicGet(&is->eof) &&
+             is->viddec.finished == is->videoq.serial && frame_queue_nb_remaining(&is->pictq) == 0) ||
+            now - is->kf_started_us > 10 * AV_TIME_BASE)
+            ffp_kf_end(is, 0);
+    }
+
+    if (is->api_step_pending && is->step && SDL_AtomicGet(&is->eof) &&
+        is->viddec.finished == is->videoq.serial && frame_queue_nb_remaining(&is->pictq) == 0) {
+        if (!is->paused)
+            stream_toggle_pause(is);
+        is->step = 0;
+        ffp_api_step_end(is, 0);
+        ffp_set_state(ffp, FFP_ST_PAUSED, 0);
+    }
+
+    if (SDL_AtomicGet(&is->prepared)) {
+        double pos = ffp_position(is);
+
+        SDL_LockMutex(ffp->mutex);
+        ffp->position = pos;
+        SDL_UnlockMutex(ffp->mutex);
+
+        if (is->step_position_pending || now - ffp->last_position_event >= FFP_POSITION_INTERVAL) {
+            ffp->last_position_event = now;
+            if (!isnan(pos)) {
+                AVBPrint bp;
+                av_bprint_init(&bp, 0, AV_BPRINT_SIZE_AUTOMATIC);
+                av_bprintf(&bp, "{\"position\":");
+                json_double(&bp, pos);
+                av_bprintf(&bp, ",\"duration\":");
+                json_double(&bp, is->duration_s);
+                av_bprintf(&bp, "}");
+                ffp_emit(ffp, FFP_EVENT_POSITION, bp.str);
+                av_bprint_finalize(&bp, NULL);
+            }
+            is->step_position_pending = 0;
+        }
+
+        if (ffp->step_done_pending) {
+            ffp->step_done_pending = 0;
+            ffp_emit_step_done(ffp, ffp->step_done_dir, ffp->step_done_moved);
+        }
+        if (ffp->kf_done_pending) {
+            ffp->kf_done_pending = 0;
+            ffp_emit_keyseek_done(ffp);
+        }
+
+        if (ffp_starved(is)) {
+            if (!ffp->starving) {
+                ffp->starving = 1;
+                ffp->starve_since = now;
+            } else if (!ffp->buffering && now - ffp->starve_since >= FFP_STARVE_DELAY) {
+                ffp->buffering = 1;
+                ffp_emit(ffp, FFP_EVENT_BUFFERING, "{\"buffering\":true}");
             }
