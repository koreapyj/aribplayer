+typedef struct FFPCapDev {
+    enum AVHWDeviceType type;
+    AVBufferRef *ref;               /* NULL: the default device of the type could not be created */
+    enum AVPixelFormat fmt, sw;     /* the formats of its test pool, AV_PIX_FMT_NONE if unknown */
+    int ok;                         /* a 64x64 frame pool works on it */
+    char error[160];
+} FFPCapDev;
+
+/* the formats of a test pool on dev: its first hardware format, NV12 (else its first software format) */
+static void ffp_caps_pool_formats(FFPCapDev *d)
+{
+    AVHWFramesConstraints *c = av_hwdevice_get_hwframe_constraints(d->ref, NULL);
+    int i;
+
+    d->fmt = d->sw = AV_PIX_FMT_NONE;
+    if (!c)
+        return;
+    if (c->valid_hw_formats)
+        d->fmt = c->valid_hw_formats[0];
+    for (i = 0; c->valid_sw_formats && c->valid_sw_formats[i] != AV_PIX_FMT_NONE; i++)
+        if (d->sw == AV_PIX_FMT_NONE || c->valid_sw_formats[i] == AV_PIX_FMT_NV12)
+            d->sw = c->valid_sw_formats[i];
+    av_hwframe_constraints_free(&c);
+}
+
+static int ffp_caps_frames(AVBufferRef *dev, enum AVPixelFormat fmt, enum AVPixelFormat sw, AVBufferRef **out)
+{
+    AVBufferRef *ref = av_hwframe_ctx_alloc(dev);
+    AVHWFramesContext *fc;
+    int ret;
+
+    if (!ref)
+        return AVERROR(ENOMEM);
+    fc = (AVHWFramesContext *)ref->data;
+    fc->format = fmt;
+    fc->sw_format = sw;
+    fc->width = fc->height = 64;
+    fc->initial_pool_size = 1;
+    ret = av_hwframe_ctx_init(ref);
+    if (ret < 0) {
+        av_buffer_unref(&ref);
+        return ret;
+    }
+    *out = ref;
+    return 0;
+}
+
+static void ffp_caps_test_device(FFPCapDev *d)
+{
+    AVBufferRef *frames = NULL;
+    int ret;
+
+    if (!d->ref)
+        return;
+    ffp_caps_pool_formats(d);
+    if (d->fmt == AV_PIX_FMT_NONE || d->sw == AV_PIX_FMT_NONE) {
+        snprintf(d->error, sizeof(d->error), "no frame formats reported by the device");
+        return;
+    }
+    ret = ffp_caps_frames(d->ref, d->fmt, d->sw, &frames);
+    if (ret < 0) {
+        snprintf(d->error, sizeof(d->error), "%s/%s frame pool: %s", av_get_pix_fmt_name(d->fmt),
+                 av_get_pix_fmt_name(d->sw), av_err2str(ret));
+        return;
+    }
+    av_buffer_unref(&frames);
+    d->ok = 1;
+}
+
+static void ffp_caps_print_devices(AVBPrint *bp, const FFPCapDev *devs, int n)
+{
+    int i;
+
+    av_bprintf(bp, ",\"devices\":[");
+    for (i = 0; i < n; i++) {
+        av_bprintf(bp, "%s{\"type\":", i ? "," : "");
+        json_string(bp, av_hwdevice_get_type_name(devs[i].type));
+        av_bprintf(bp, ",\"ok\":%s,\"name\":\"\",\"error\":", devs[i].ok ? "true" : "false");
+        json_string(bp, devs[i].error);
+        av_bprintf(bp, "}");
+    }
+    av_bprintf(bp, "]");
+}
+
+/* the decoders of the build that have a hwaccel of a probed device type; whether the GPU decodes is the host's probe */
+static void ffp_caps_decoders(AVBPrint *bp, const FFPCapDev *devs, int n)
+{
+    static const struct { const char *name; enum AVCodecID id; } codecs[] = {
+        { "h264", AV_CODEC_ID_H264 },
+        { "hevc", AV_CODEC_ID_HEVC },
+        { "mpeg2video", AV_CODEC_ID_MPEG2VIDEO },
+        { "vp9", AV_CODEC_ID_VP9 },
+        { "av1", AV_CODEC_ID_AV1 },
+        { "vc1", AV_CODEC_ID_VC1 },
+        { "mpeg4", AV_CODEC_ID_MPEG4 },
+    };
+    int first = 1, i, j, c;
+
+    av_bprintf(bp, ",\"decoders\":[");
+    for (i = 0; i < n; i++) {
+        const char *type = av_hwdevice_get_type_name(devs[i].type);
+
+        if (!devs[i].ok)
+            continue;
+        for (j = 0; j < i; j++)
+            if (devs[j].ok && devs[j].type == devs[i].type)
+                break;
+        if (j < i)
+            continue;
+        for (c = 0; c < FF_ARRAY_ELEMS(codecs); c++) {
+            const AVCodec *dflt = avcodec_find_decoder(codecs[c].id);
+            const AVCodec *dec = ffp_find_hw_decoder(codecs[c].id, dflt, devs[i].type);
+            char err[160] = "";
+
+            if (!dec)
+                snprintf(err, sizeof(err), "no %s decoder with a %s hwaccel", codecs[c].name, type);
+            av_bprintf(bp, "%s{\"codec\":", first ? "" : ",");
+            first = 0;
+            json_string(bp, codecs[c].name);
+            av_bprintf(bp, ",\"hwaccel\":");
+            json_string(bp, type);
+            av_bprintf(bp, ",\"decoder\":");
+            json_string(bp, dec ? dec->name : "");
+            av_bprintf(bp, ",\"ok\":%s,\"bit_depths\":[],\"max_width\":0,\"max_height\":0,\"error\":", dec ? "true" : "false");
+            json_string(bp, err);
+            av_bprintf(bp, "}");
+        }
+    }
+    av_bprintf(bp, "]");
+}
+
+/* maps a 64x64 frame of the `src` device to a device of dst's type derived from it; "map" = hwmap derive, no copy */
+static void ffp_caps_interop_one(AVBPrint *bp, const FFPCapDev *src, const FFPCapDev *dst, int *first)
+{
+    const char *from = av_get_pix_fmt_name(src->fmt), *to = av_get_pix_fmt_name(dst->fmt);
+    AVBufferRef *dev = NULL, *sf = NULL, *df = NULL;
+    AVFrame *a = NULL, *b = NULL;
+    char err[200] = "";
+    int ret;
+
+    ret = av_hwdevice_ctx_create_derived(&dev, dst->type, src->ref, 0);
+    if (ret < 0) {
+        snprintf(err, sizeof(err), "%s to %s mapping not usable: %s", from, to, av_err2str(ret));
+        goto done;
+    }
+    ret = ffp_caps_frames(src->ref, src->fmt, src->sw, &sf);
+    if (ret < 0) {
+        snprintf(err, sizeof(err), "%s frames: %s", from, av_err2str(ret));
+        goto done;
+    }
+    ret = av_hwframe_ctx_create_derived(&df, dst->fmt, dev, sf, AV_HWFRAME_MAP_DIRECT);
+    if (ret < 0) {
+        snprintf(err, sizeof(err), "%s to %s mapping not usable: %s", from, to, av_err2str(ret));
+        goto done;
+    }
+    a = av_frame_alloc();
+    b = av_frame_alloc();
+    if (!a || !b) {
+        snprintf(err, sizeof(err), "out of memory");
+        goto done;
+    }
+    ret = av_hwframe_get_buffer(sf, a, 0);
+    if (ret < 0) {
+        snprintf(err, sizeof(err), "%s frame allocation: %s", from, av_err2str(ret));
+        goto done;
+    }
+    b->format = dst->fmt;
+    b->hw_frames_ctx = av_buffer_ref(df);
+    ret = av_hwframe_map(b, a, AV_HWFRAME_MAP_READ);
+    if (ret < 0)
+        snprintf(err, sizeof(err), "%s to %s mapping not usable: %s", from, to, av_err2str(ret));
+done:
+    av_bprintf(bp, "%s{\"from\":", *first ? "" : ",");
+    *first = 0;
+    json_string(bp, from);
+    av_bprintf(bp, ",\"to\":");
+    json_string(bp, to);
+    av_bprintf(bp, ",\"method\":\"map\",\"ok\":%s,\"error\":", err[0] ? "false" : "true");
+    json_string(bp, err);
+    av_bprintf(bp, "}");
+    av_frame_free(&a);
+    av_frame_free(&b);
+    av_buffer_unref(&df);
+    av_buffer_unref(&sf);
+    av_buffer_unref(&dev);
+}
+
+static void ffp_caps_interop(AVBPrint *bp, const FFPCapDev *devs, int n)
+{
+    int first = 1, i, j;
+
+    av_bprintf(bp, ",\"interop\":[");
+    for (i = 0; i < n; i++)
+        for (j = 0; j < n; j++)
+            if (i != j && devs[i].ok && devs[j].ok && devs[i].type != devs[j].type)
+                ffp_caps_interop_one(bp, &devs[i], &devs[j], &first);
+    av_bprintf(bp, "]");
+}
