+static double ffp_get_rotation(const int32_t *displaymatrix)
+{
+    double theta = 0;
+    if (displaymatrix)
+        theta = -round(av_display_rotation_get(displaymatrix));
+
+    theta -= 360*floor(theta/360 + 0.9/360);
