+    if (!priv)
+        return;
+    av_opt_get_int(priv, "history_bytes", 0, &bytes);
+    av_opt_get_int(priv, "history_events", 0, &events);
+    av_opt_get_int(priv, "history_appended_bytes", 0, &appended);
+    SDL_LockMutex(layer->is->dbg_mutex);
+    dbg = &layer->is->dbg.subtitles[layer->id];
+    dbg->history_bytes = bytes;
+    dbg->history_events = events;
+    dbg->history_appended_bytes = appended;
+    SDL_UnlockMutex(layer->is->dbg_mutex);
+}
