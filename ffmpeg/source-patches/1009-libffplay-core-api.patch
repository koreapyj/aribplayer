+static void ffp_destroy_video(FFPlayer *ffp)
+{
+    if (ffp->renderer)
+        SDL_DestroyRenderer(ffp->renderer);
+    if (ffp->vk_renderer)
+        vk_renderer_destroy(ffp->vk_renderer);
+#ifdef _WIN32
+    if (ffp->window && ffp->hosted)
+        ffp_host_unhook(ffp);
+#endif
+    if (ffp->window)
+        SDL_DestroyWindow(ffp->window);
+#ifdef _WIN32
+    if (ffp->hosted)
+        ffp_host_restore(ffp);
+#endif
+    ffp->renderer = NULL;
+    ffp->vk_renderer = NULL;
+    ffp->window = NULL;
+    SDL_LockMutex(ffp->dbg_mutex);
+    ffp->dbg_renderer[0] = 0;
+    SDL_UnlockMutex(ffp->dbg_mutex);
