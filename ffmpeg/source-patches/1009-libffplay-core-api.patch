+/* ffplay.exe (own window): quit request from q/ESC/window close/SDL_QUIT.
+ * Reported as an INPUT event of type "close" (an extension to the documented types). */
+static void ffp_request_close(FFPlayer *ffp)
+{
+    ffp_emit_input(ffp, "{\"type\":\"close\"}");
