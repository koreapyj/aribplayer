+static void ffp_dbg_note_frame(VideoState *is, int path, enum AVPixelFormat dec_fmt,
+                               enum AVPixelFormat sw_fmt, enum AVPixelFormat xfer_fmt)
+{
+    FFPDebug *d = &is->dbg;
+    AVCodecContext *avctx = is->viddec.avctx;
+
+    SDL_AtomicAdd(&d->path_count[path], 1);
+    SDL_AtomicSet(&d->last_path, path + 1);
+    if (d->v_seen && d->v_dec_id == (int)dec_fmt && d->v_sw_id == (int)sw_fmt && d->v_xfer_id == (int)xfer_fmt)
+        return;
+    SDL_LockMutex(is->dbg_mutex);
+    if (!d->v_seen && d->v_hw_requested[0] && path == FFP_PATH_SOFTWARE && strcmp(d->v_hw_device, "none")) {
+        /* a device was created, but the decoder returned software frames: fell back */
+        if (!d->v_hw_error[0])
+            snprintf(d->v_hw_error, sizeof(d->v_hw_error), "decoder %s returned software frames although a %s device was set up",
+                     d->v_decoder, d->v_hw_device);
+        ffp_dbg_set_str(d->v_hw_device, sizeof(d->v_hw_device), "none");
+    }
+    d->v_seen = 1;
+    d->v_dec_id = dec_fmt;
+    d->v_sw_id = sw_fmt;
+    d->v_xfer_id = xfer_fmt;
+    ffp_dbg_set_str(d->v_pix_fmt, sizeof(d->v_pix_fmt), avctx ? av_get_pix_fmt_name(avctx->pix_fmt) : NULL);
+    ffp_dbg_set_str(d->v_dec_fmt, sizeof(d->v_dec_fmt), av_get_pix_fmt_name(dec_fmt));
+    ffp_dbg_set_str(d->v_hw_pix_fmt, sizeof(d->v_hw_pix_fmt),
+                    path != FFP_PATH_SOFTWARE ? av_get_pix_fmt_name(dec_fmt) : NULL);
+    ffp_dbg_set_str(d->v_sw_pix_fmt, sizeof(d->v_sw_pix_fmt),
+                    path != FFP_PATH_SOFTWARE && sw_fmt != AV_PIX_FMT_NONE ? av_get_pix_fmt_name(sw_fmt) : NULL);
+    ffp_dbg_set_str(d->v_xfer_fmt, sizeof(d->v_xfer_fmt),
+                    xfer_fmt != AV_PIX_FMT_NONE ? av_get_pix_fmt_name(xfer_fmt) : NULL);
+    SDL_UnlockMutex(is->dbg_mutex);
+}
