+#ifndef FFTOOLS_FFPLAY_H
+#define FFTOOLS_FFPLAY_H
+
+#include <stdint.h>
+
+#ifdef _WIN32
+#  ifdef FFP_BUILDING_DLL
+#    define FFP_API __declspec(dllexport)
+#  else
+#    define FFP_API __declspec(dllimport)
+#  endif
+#  define FFP_CALL __cdecl
+#else
+#  define FFP_API
+#  define FFP_CALL
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* return codes: AVERROR(EINVAL) and AVERROR(EAGAIN) */
+#define FFP_EINVAL (-22)
+#define FFP_EAGAIN (-11)
+
+typedef struct FFPlayer FFPlayer;
+
+enum {
+    FFP_EVENT_PREPARED     = 1,
+    FFP_EVENT_POSITION     = 2,
+    FFP_EVENT_STATE        = 3,
+    FFP_EVENT_BUFFERING    = 4,
+    FFP_EVENT_EOF          = 5,
+    FFP_EVENT_ERROR        = 6,
+    FFP_EVENT_INPUT        = 7,
+    FFP_EVENT_FILTER_ERROR = 8,
+};
+
+enum { FFP_SEEK_ABSOLUTE = 0, FFP_SEEK_RELATIVE = 1 };
+
+/* ffp_cycle_stream types (same values as AVMediaType) */
+enum { FFP_STREAM_VIDEO = 0, FFP_STREAM_AUDIO = 1, FFP_STREAM_SUBTITLE = 3 };
+
+/* Called on a library thread (player/read/decode thread). json is UTF-8, valid only
+ * for the duration of the call. Must return quickly; must not call ffp_destroy/ffp_stop/ffp_open. */
+typedef void (FFP_CALL *ffp_event_cb)(void *user, int event, const char *json);
+
+FFP_API const char *FFP_CALL ffp_version(void);                   /* FFmpeg version string, static */
+FFP_API void        FFP_CALL ffp_set_log_level(int av_log_level); /* process-wide, default AV_LOG_WARNING (24) */
+
+/* hwnd: host child window (HWND) the video is rendered into via SDL_CreateWindowFrom.
+ *       NULL = libffplay creates its own top-level window (used by ffplay.exe).
+ * Returns NULL on failure. */
+FFP_API FFPlayer   *FFP_CALL ffp_create(void *hwnd, ffp_event_cb cb, void *user);
+FFP_API void        FFP_CALL ffp_destroy(FFPlayer *p);            /* stops media, joins player thread; NULL ok */
+
+/* Opens url asynchronously (stops current media first). Returns 0 if the open was started;
+ * PREPARED or ERROR follows via the callback.
+ * options_kv: NULL or "key=value" pairs separated by '\n' (each pair split at its FIRST '=',
+ * so values may contain '=', ':' and ','). Keys: any ffplay option name without the leading
+ * '-' (vf, af, ss, t, sn, an, vn, hwaccel, loop, framedrop, infbuf, fast, ...) plus any
+ * AVFormat/AVCodec/protocol option (user_agent, headers, timeout, reconnect, ...).
+ * "vf"/"af" given here replace the instance's current filter strings.
+ * "filter_hw_device" = "type[:device]" (e.g. "d3d11va", "cuda") creates a hardware
+ * device for this playback and attaches it to every filter of the video graph (like ffmpeg's
+ * -filter_hw_device). The device is created lazily when the graph is first built; if that
+ * fails FFP_EVENT_FILTER_ERROR is raised and the previous filter string is restored. */
+FFP_API int         FFP_CALL ffp_open(FFPlayer *p, const char *url, const char *options_kv);
+FFP_API int         FFP_CALL ffp_stop(FFPlayer *p);               /* closes media; window cleared to black */
+
+FFP_API int         FFP_CALL ffp_play(FFPlayer *p);
+FFP_API int         FFP_CALL ffp_pause(FFPlayer *p);
+FFP_API int         FFP_CALL ffp_toggle_pause(FFPlayer *p);
+FFP_API int         FFP_CALL ffp_seek(FFPlayer *p, double seconds, int flags);
+FFP_API int         FFP_CALL ffp_set_volume(FFPlayer *p, int volume_0_100);   /* persists across opens */
+FFP_API int         FFP_CALL ffp_set_mute(FFPlayer *p, int mute);             /* persists across opens */
+
+FFP_API double      FFP_CALL ffp_get_position(FFPlayer *p);       /* seconds; NAN if unknown */
+FFP_API double      FFP_CALL ffp_get_duration(FFPlayer *p);       /* seconds; <= 0 if unknown/live */
+FFP_API char       *FFP_CALL ffp_get_media_info(FFPlayer *p);     /* JSON (see below) or NULL; ffp_free */
+
+FFP_API int         FFP_CALL ffp_cycle_stream(FFPlayer *p, int type);
+
+/* Filters. Strings persist on the instance across opens. NULL or "" = no filter.
+ * The new graph is built by the decode thread on the next frame through ffplay's
+ * configure_video_filters/configure_audio_filters path. If the build fails,
+ * FFP_EVENT_FILTER_ERROR is raised and the previous string is restored. */
+FFP_API int         FFP_CALL ffp_set_video_filter(FFPlayer *p, const char *vf);
+FFP_API int         FFP_CALL ffp_set_audio_filter(FFPlayer *p, const char *af);
+
+/* Queues avfilter_graph_send_command(graph, target, cmd, arg) for the video graph (or the
+ * audio graph if target starts with "a:" -- the prefix is stripped). Applied on the filter
+ * thread before the next frame. Returns 0 if queued. Failures are reported asynchronously
+ * as FFP_EVENT_FILTER_ERROR. resp/resp_len may be NULL/0; if given, resp receives "queued".
+ * Commands do not change the stored filter string: hosts keep the string in sync. */
+FFP_API int         FFP_CALL ffp_filter_command(FFPlayer *p, const char *target, const char *cmd,
+                                                const char *arg, char *resp, int resp_len);
+
+/* Copies the last displayed frame (after the video filter graph, so e.g. vf=transpose=1 on a
+ * 1280x720 source gives 720x1280; before display scaling), converted with
+ * swscale to BGRA (bytes B,G,R,A; A=255), at the filtered size stretched by SAR to the display
+ * aspect: if sar>1 width = round(w*sar); if sar<1 height = round(h/sar); both rounded to even.
+ * On success *out_bgra is allocated (free with ffp_free) and 0 is returned.
+ * Returns FFP_EAGAIN if no frame has been displayed yet. */
+FFP_API int         FFP_CALL ffp_snapshot(FFPlayer *p, uint8_t **out_bgra, int *width,
+                                          int *height, int *stride);
+FFP_API void        FFP_CALL ffp_free(void *ptr);
+
+/* JSON snapshot of the live decoder / filter graph / sync state of the current media, or NULL when nothing
+ * is open. Every value is what is actually in use at runtime (opened decoder, configured graphs, renderer
+ * object, ...), see docs/libffplay-api.md for the schema. Free with ffp_free. Thread-safe, never blocks
+ * for long; cheap enough to call at 4 Hz. */
+FFP_API char       *FFP_CALL ffp_get_debug_info(FFPlayer *p);
+
+/* Process-wide log sink: every av_log line (FFmpeg + libffplay, incl. the stats status line) is formatted
+ * (av_log_format_line2, with the "[ctx @ ptr]" prefix; the string keeps its trailing "\n" / "\r") and
+ * delivered as one UTF-8 string per call, from any thread. level = AV_LOG_* of the message. Messages less
+ * severe than the current ffp_set_log_level are not delivered. cb = NULL restores the default (stderr)
+ * logger. A call that started before the switch may still finish afterwards. */
+typedef void (FFP_CALL *ffp_log_cb)(void *user, int level, const char *line);
+FFP_API void        FFP_CALL ffp_set_log_callback(ffp_log_cb cb, void *user);
+
+/* Capability probe, once per process (blocking, may take a few seconds: creates the hw devices, checks the
+ * decoders, tests device-to-device frame mapping with 64x64 frames; no window is created, no
+ * FFPlayer instance is needed). Returns the cached result as UTF-8 JSON (schema: docs/libffplay-api.md and
+ * wvp::CapabilitySet), a copy to be released with ffp_free. Later calls return the cached JSON at once.
+ * av_log output is suppressed while the probe runs. NULL only when out of memory. */
+FFP_API char       *FFP_CALL ffp_probe_caps(void);
+
+/* Open option (ffp_open options_kv) hwframes = "download" (default) | "keep". With a hwaccel and "keep" the decoded
+ * hardware frames enter the video filter graph as hardware frames (vf such as ivtc_cuda,hwdownload,format=nv12); frames
+ * that leave the graph still in a hardware format are downloaded after it. If the graph does not configure with hardware
+ * frames, or vf is empty, frames are downloaded at decode time as with "download" (on a configuration failure
+ * FFP_EVENT_FILTER_ERROR carries "hwframes_fallback":true). ffp_get_debug_info reports hwframes_requested / hwframes. */
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* FFTOOLS_FFPLAY_H */
