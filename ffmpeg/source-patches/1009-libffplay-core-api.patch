+    n = vd->lpVtbl->GetVideoDecoderProfileCount(vd);
+    for (i = 0; i < n; i++) {
+        GUID g;
+        if (SUCCEEDED(vd->lpVtbl->GetVideoDecoderProfile(vd, i, &g)) && !memcmp(&g, profile, sizeof(g))) {
+            if (SUCCEEDED(vd->lpVtbl->CheckVideoDecoderFormat(vd, profile, (DXGI_FORMAT)fmt, &ok)))
+                return ok;
+            return 0;
+        }
+    }
+    return 0;
+}
