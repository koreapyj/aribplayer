+    case SDL_MOUSEMOTION:      ffp = ffp_find_by_window(e->motion.windowID); break;
+    case SDL_MOUSEBUTTONDOWN:
+    case SDL_MOUSEBUTTONUP:    ffp = ffp_find_by_window(e->button.windowID); break;
+    case SDL_MOUSEWHEEL:       ffp = ffp_find_by_window(e->wheel.windowID);  break;
+    case SDL_QUIT:
