+/* detaches the current media: it is no longer touched by the loop thread; the
+ * caller closes it (joins its threads) */
+static VideoState *ffp_detach_media(FFPlayer *ffp)
+{
+    VideoState *is = ffp->is;
+
+    ffp->is = NULL;
+    SDL_LockMutex(ffp->dbg_mutex);      /* no debug-info reader may touch `is` once the caller closes it */
+    ffp->dbg_is = NULL;
+    SDL_UnlockMutex(ffp->dbg_mutex);
+    if (is)
+        stream_destroy_textures(is);
+    ffp_show_black(ffp);
+    ffp->starving = ffp->buffering = 0;
+
+    SDL_LockMutex(ffp->mutex);
+    ffp->position = NAN;
+    ffp->duration = 0;
+    av_freep(&ffp->media_info);
+    SDL_UnlockMutex(ffp->mutex);
+    SDL_LockMutex(ffp->snap_mutex);
+    av_frame_free(&ffp->last_frame);
+    SDL_UnlockMutex(ffp->snap_mutex);
+    return is;
+}
