+static const char *ffp_dbg_hwdev_type(AVBufferRef *dev)
+{
+    const char *n;
+
+    if (!dev)
+        return "";
+    n = av_hwdevice_get_type_name(((AVHWDeviceContext *)dev->data)->type);
+    return n ? n : "";
+}
+
+/* "name=args" of every filter of a configured graph, in dataflow order (a filter is listed after all
+ * the filters feeding it, ties in graph order), incl. the scale/format/aresample filters that
+ * avfilter_graph_config() inserted. Results are malloc'ed JSON fragments / strings. */
+static void ffp_dbg_describe_graph(AVFilterGraph *g, int audio, char **graph_out, char **names_out,
+                                   char **nodes_out, double *speed_out)
+{
+    AVBPrint gb, nb, xb;
+    unsigned i, j, k, n = g->nb_filters, emitted = 0;
+    uint8_t *done = av_mallocz(n ? n : 1);
+    double speed = 1.0;
+    int atempo = 0;
+
+    av_bprint_init(&gb, 0, AV_BPRINT_SIZE_UNLIMITED);
+    av_bprint_init(&nb, 0, AV_BPRINT_SIZE_UNLIMITED);
+    av_bprint_init(&xb, 0, AV_BPRINT_SIZE_UNLIMITED);
+    av_bprintf(&nb, "[");
+    av_bprintf(&xb, "[");
+
+    while (done && emitted < n) {
+        AVFilterContext *c;
+        const char *fname, *hw;
+        char *args = NULL;
+        int pick = -1, is_sink;
+
+        for (i = 0; i < n && pick < 0; i++) {
+            int ready = 1;
+            if (done[i])
+                continue;
+            for (j = 0; j < g->filters[i]->nb_inputs && ready; j++) {
+                AVFilterContext *src = g->filters[i]->inputs[j] ? g->filters[i]->inputs[j]->src : NULL;
+                for (k = 0; src && k < n; k++)
+                    if (g->filters[k] == src && !done[k])
+                        ready = 0;
+            }
+            if (ready)
+                pick = i;
+        }
+        if (pick < 0) {                 /* feedback loop: take the first one left */
+            for (i = 0; i < n; i++)
+                if (!done[i]) {
+                    pick = i;
+                    break;
+                }
+        }
+        done[pick] = 1;
+        c = g->filters[pick];
+        fname = c->filter->name;
+        is_sink = !strcmp(fname, "buffersink") || !strcmp(fname, "abuffersink");
+        if (!is_sink && c->filter->priv_class && c->priv)
+            av_opt_serialize(c->priv, AV_OPT_FLAG_FILTERING_PARAM, AV_OPT_SERIALIZE_SKIP_DEFAULTS,
+                             &args, '=', ':');
+        if (args && !*args)
+            av_freep(&args);
+
+        if (!strcmp(fname, "atempo") && c->priv) {
+            double t = 0;
+            if (av_opt_get_double(c->priv, "tempo", 0, &t) >= 0 && t > 0) {
+                speed *= t;
+                atempo = 1;
+            }
+        }
+
+        hw = ffp_dbg_hwdev_type(c->hw_device_ctx);
+        if (!*hw && is_sink && !audio) {
+            AVBufferRef *fr = av_buffersink_get_hw_frames_ctx(c);
+            if (fr && ((AVHWFramesContext *)fr->data)->device_ctx) {
+                const char *tn = av_hwdevice_get_type_name(((AVHWFramesContext *)fr->data)->device_ctx->type);
+                hw = tn ? tn : "";
+            }
+        }
+
+        if (emitted) {
+            av_bprintf(&gb, ",");
+            av_bprintf(&nb, ",");
+            av_bprintf(&xb, ",");
+        }
+        av_bprintf(&gb, "%s%s%s", fname, args ? "=" : "", args ? args : "");
+        json_string(&nb, fname);
+        av_bprintf(&xb, "{\"name\":");
+        json_string(&xb, fname);
+        av_bprintf(&xb, ",\"instance\":");
+        json_string(&xb, c->name);
+        av_bprintf(&xb, ",\"args\":");
+        json_string(&xb, args ? args : "");
+        av_bprintf(&xb, ",\"hw_device\":");
+        json_string(&xb, hw);
+        av_bprintf(&xb, "}");
+        av_free(args);
+        emitted++;
+    }
+    av_bprintf(&nb, "]");
+    av_bprintf(&xb, "]");
+    av_free(done);
+
+    *graph_out = NULL;
+    *names_out = NULL;
+    *nodes_out = NULL;
+    if (av_bprint_is_complete(&gb)) av_bprint_finalize(&gb, graph_out); else av_bprint_finalize(&gb, NULL);
+    if (av_bprint_is_complete(&nb)) av_bprint_finalize(&nb, names_out); else av_bprint_finalize(&nb, NULL);
+    if (av_bprint_is_complete(&xb)) av_bprint_finalize(&xb, nodes_out); else av_bprint_finalize(&xb, NULL);
+    *speed_out = atempo ? speed : 0;
+}
