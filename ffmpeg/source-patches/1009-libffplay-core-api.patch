+/* returns 1 if the instance was destroyed (and must not be touched anymore) */
+static int ffp_exec_cmd(FFPlayer *ffp, FFPCmd *c)
+{
+    VideoState *is = ffp->is;
+    int destroyed = 0;
+
+    switch (c->type) {
+    case FFP_CMD_OPEN:
+        ffp_cmd_open(ffp, c);
+        break;
+    case FFP_CMD_DETACH:
+        c->is_out = ffp_detach_media(ffp);
+        break;
+    case FFP_CMD_DESTROY: {
+        FFPlayer **pp;
+        c->is_out = ffp_detach_media(ffp);
+        ffp_destroy_video(ffp);
+        for (pp = &g_ffp.list; *pp; pp = &(*pp)->next) {
+            if (*pp == ffp) {
+                *pp = ffp->next;
                 break;
-            case SDLK_PAGEUP:
-                if (cur_stream->ic->nb_chapters <= 1) {
-                    incr = 600.0;
-                    goto do_seek;
+            }
+        }
+        destroyed = 1;
+        break;
+    }
+    case FFP_CMD_PAUSE:
+        ffp_cmd_pause(ffp, c->i);
+        break;
+    case FFP_CMD_SEEK:
+        if (is)
+            ffp_queue_seek(is, c->d, c->i);
+        break;
+    case FFP_CMD_CYCLE:
+        if (is && is->ic && SDL_AtomicGet(&is->prepared)) {
+            stream_cycle_channel(is, c->i);
+            ffp_update_media_info(is);
+        }
+        break;
+    }
+    return destroyed;
+}
+
+static void ffp_run_cmds(FFPlayer *ffp)
+{
+    FFPCmd *c, *next;
+    int destroyed = 0;
+
+    SDL_LockMutex(ffp->mutex);
+    c = ffp->cmd_head;
+    ffp->cmd_head = ffp->cmd_tail = NULL;
+    SDL_UnlockMutex(ffp->mutex);
+
+    for (; c; c = next) {
+        next = c->next;
+        if (!destroyed)
+            destroyed = ffp_exec_cmd(ffp, c);
+        if (c->done) {
+            SDL_SemPost(c->done);       /* the caller owns c from now on */
+        } else {
+            av_free(c->s);
+            ffp_opts_free(c->o);
+            av_free(c);
+        }
+    }
+}
