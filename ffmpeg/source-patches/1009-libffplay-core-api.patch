+static void ffp_cmd_pause(FFPlayer *ffp, int want)
+{
+    VideoState *is = ffp->is;
+    int st;
+
+    if (!is)
+        return;
+    st = ffp_get_state(ffp);
+    if (want < 0)
+        want = (st == FFP_ST_ENDED) ? 0 : !is->paused;
+    if (!want && st == FFP_ST_ENDED)
+        ffp_queue_seek(is, 0.0, FFP_SEEK_ABSOLUTE);
+    if (want != !!is->paused)
+        toggle_pause(is);
+    if (SDL_AtomicGet(&is->prepared))
+        ffp_set_state(ffp, is->paused ? FFP_ST_PAUSED : FFP_ST_PLAYING, 0);
+}
