+/* bit depths (8, 10) the D3D11 video device decodes for the codec; returns the number written */
+static int ffp_caps_d3d11_depths(AVBufferRef *dev, enum AVCodecID id, int *depths)
+{
+    int i, n = 0;
+
+    for (i = 0; i < FF_ARRAY_ELEMS(ffp_cap_profiles); i++) {
+        const FFPCapProfile *p = &ffp_cap_profiles[i];
+        if (p->id != id)
+            continue;
+        if ((p->g8 && ffp_d3d11_profile_supported(dev, p->g8, DXGI_FORMAT_NV12)) ||
+            (p->g8b && ffp_d3d11_profile_supported(dev, p->g8b, DXGI_FORMAT_NV12)))
+            depths[n++] = 8;
+        if (p->g10 && ffp_d3d11_profile_supported(dev, p->g10, DXGI_FORMAT_P010))
+            depths[n++] = 10;
+        break;
+    }
+    return n;
+}
