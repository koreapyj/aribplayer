+static void ffp_dbg_stream_open(VideoState *is, AVCodecContext *avctx, const AVCodec *codec, int index)
+{
+    AVStream *st = is->ic->streams[index];
+    FFPDebug *d = &is->dbg;
+    char buf[64];
+
+    SDL_LockMutex(is->dbg_mutex);
+    switch (avctx->codec_type) {
+    case AVMEDIA_TYPE_VIDEO: {
+        AVRational sar = av_guess_sample_aspect_ratio(is->ic, st, NULL);
+        const char *dev = ffp_dbg_hwdev_type(avctx->hw_device_ctx);
+
+        d->v_open = 1;
+        d->v_index = index;
+        ffp_dbg_set_str(d->v_codec, sizeof(d->v_codec), avcodec_get_name(avctx->codec_id));
+        ffp_dbg_set_str(d->v_decoder, sizeof(d->v_decoder), codec->name);
+        ffp_dbg_set_str(d->v_hw_requested, sizeof(d->v_hw_requested), is->o->hwaccel);
+        ffp_dbg_set_str(d->v_hwf_requested, sizeof(d->v_hwf_requested), ffp_hwframes_keep(is->o) ? "keep" : "download");
+        ffp_dbg_set_str(d->v_hw_device, sizeof(d->v_hw_device), *dev ? dev : "none");
+        if (*dev && avctx->hw_device_ctx) {
+            enum AVHWDeviceType type = ((AVHWDeviceContext *)avctx->hw_device_ctx->data)->type;
+            const AVCodecHWConfig *cfg;
+            int i, found = 0;
+            for (i = 0; (cfg = avcodec_get_hw_config(codec, i)); i++)
+                if ((cfg->methods & AV_CODEC_HW_CONFIG_METHOD_HW_DEVICE_CTX) && cfg->device_type == type)
+                    found = 1;
+            if (!found) {
+                snprintf(d->v_hw_error, sizeof(d->v_hw_error), "decoder %s has no %s hwaccel for codec %s: decoding in software",
+                         codec->name, dev, avcodec_get_name(avctx->codec_id));
+                ffp_dbg_set_str(d->v_hw_device, sizeof(d->v_hw_device), "none");
+            }
+        }
+        d->v_width = avctx->width;
+        d->v_height = avctx->height;
+        d->v_sar = sar.num > 0 && sar.den > 0 ? sar : (AVRational){1, 1};
+        d->v_frame_rate = av_guess_frame_rate(is->ic, st, NULL);
+        d->v_avg_fr = st->avg_frame_rate;
+        d->v_r_fr = st->r_frame_rate;
+        d->v_tb = st->time_base;
+        d->v_start = ffp_dbg_start_time(st);
+        break;
+    }
+    case AVMEDIA_TYPE_AUDIO:
+        d->a_open = 1;
+        d->a_index = index;
+        ffp_dbg_set_str(d->a_codec, sizeof(d->a_codec), avcodec_get_name(avctx->codec_id));
+        ffp_dbg_set_str(d->a_decoder, sizeof(d->a_decoder), codec->name);
+        d->a_rate = avctx->sample_rate;
+        d->a_channels = avctx->ch_layout.nb_channels;
+        buf[0] = 0;
+        av_channel_layout_describe(&avctx->ch_layout, buf, sizeof(buf));
+        ffp_dbg_set_str(d->a_layout, sizeof(d->a_layout), buf);
+        ffp_dbg_set_str(d->a_fmt, sizeof(d->a_fmt), av_get_sample_fmt_name(avctx->sample_fmt));
+        d->a_tb = st->time_base;
+        d->a_start = ffp_dbg_start_time(st);
+        d->a_device[0] = 0;
+        d->a_out_rate = d->a_out_channels = 0;
+        break;
+    case AVMEDIA_TYPE_SUBTITLE:
+        d->s_open = 1;
+        d->s_index = index;
+        ffp_dbg_set_str(d->s_codec, sizeof(d->s_codec), avcodec_get_name(avctx->codec_id));
+        d->s_tb = st->time_base;
+        d->s_start = ffp_dbg_start_time(st);
+        break;
+    default:
+        break;
+    }
+    SDL_UnlockMutex(is->dbg_mutex);
+}
