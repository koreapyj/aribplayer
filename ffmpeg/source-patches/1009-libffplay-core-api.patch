+static void ffp_cmd_open(FFPlayer *ffp, FFPCmd *c)
+{
+    FFPOptions *o = c->o;
+    VideoState *is;
+    int ret = 0;
+
+    c->o = NULL;
+    ffp_set_state(ffp, FFP_ST_OPENING, 1);
+    ffp_clear_filter_cmds(ffp);
+
+    if (ffp->is) {      /* normally closed by ffp_open() already */
+        VideoState *old = ffp_detach_media(ffp);
+        if (old)
+            stream_close(old);
+    }
+    if (o->display_disable)
+        o->video_disable = 1;
+    if (!o->display_disable && !ffp->window)
+        ret = ffp_create_video(ffp, o);
+    if (ret < 0) {
+        ffp_emit_error(ffp, ret, c->s);
+        ffp_opts_free(o);
+        return;
+    }
+    ffp->is_full_screen = o->fullscreen;
+    ffp->last_position_event = 0;
+
+    is = stream_open(ffp, c->s, o);
+    if (!is) {
+        ffp_emit_error(ffp, AVERROR(ENOMEM), c->s);
+        return;
+    }
+    ffp->is = is;
+    SDL_LockMutex(ffp->dbg_mutex);
+    ffp->dbg_is = is;
+    SDL_UnlockMutex(ffp->dbg_mutex);
+}
