+static void ffp_stock_key(FFPlayer *ffp, VideoState *is, const SDL_Event *event)
+{
+    double incr;
+    const FFPOptions *o = is ? is->o : NULL;
+
+    if ((o && o->exit_on_keydown) || event->key.keysym.sym == SDLK_ESCAPE || event->key.keysym.sym == SDLK_q) {
+        ffp_request_close(ffp);
+        return;
+    }
+    // If we don't yet have a window, skip all key events, because read_thread might still be initializing...
+    if (!is || !is->width || !is->ic)
+        return;
+    switch (event->key.keysym.sym) {
+    case SDLK_f:
+        toggle_full_screen(is);
+        is->force_refresh = 1;
+        break;
+    case SDLK_p:
+    case SDLK_SPACE:
+        toggle_pause(is);
+        if (SDL_AtomicGet(&is->prepared))
+            ffp_set_state(ffp, is->paused ? FFP_ST_PAUSED : FFP_ST_PLAYING, 0);
+        break;
+    case SDLK_m:
+        toggle_mute(is);
+        break;
+    case SDLK_KP_MULTIPLY:
+    case SDLK_0:
+        update_volume(is, 1, SDL_VOLUME_STEP);
+        break;
+    case SDLK_KP_DIVIDE:
+    case SDLK_9:
+        update_volume(is, -1, SDL_VOLUME_STEP);
+        break;
+    case SDLK_s:
+        step_to_next_frame(is);
+        break;
+    case SDLK_a:
+        stream_cycle_channel(is, AVMEDIA_TYPE_AUDIO);
+        ffp_update_media_info(is);
+        break;
+    case SDLK_v:
+        stream_cycle_channel(is, AVMEDIA_TYPE_VIDEO);
+        ffp_update_media_info(is);
+        break;
+    case SDLK_c:
+        stream_cycle_channel(is, AVMEDIA_TYPE_VIDEO);
+        stream_cycle_channel(is, AVMEDIA_TYPE_AUDIO);
+        stream_cycle_channel(is, AVMEDIA_TYPE_SUBTITLE);
+        ffp_update_media_info(is);
+        break;
+    case SDLK_t:
+        stream_cycle_channel(is, AVMEDIA_TYPE_SUBTITLE);
+        ffp_update_media_info(is);
+        break;
+    case SDLK_w:
+        toggle_audio_display(is);
+        break;
+    case SDLK_PAGEUP:
+        if (is->ic->nb_chapters <= 1) {
+            ffp_seek_relative(is, 600.0);
+            break;
+        }
+        seek_chapter(is, 1);
+        break;
+    case SDLK_PAGEDOWN:
+        if (is->ic->nb_chapters <= 1) {
+            ffp_seek_relative(is, -600.0);
+            break;
+        }
+        seek_chapter(is, -1);
+        break;
+    case SDLK_LEFT:
+        incr = o->seek_interval ? -o->seek_interval : -10.0;
+        ffp_seek_relative(is, incr);
+        break;
+    case SDLK_RIGHT:
+        incr = o->seek_interval ? o->seek_interval : 10.0;
+        ffp_seek_relative(is, incr);
+        break;
+    case SDLK_UP:
+        ffp_seek_relative(is, 60.0);
+        break;
+    case SDLK_DOWN:
+        ffp_seek_relative(is, -60.0);
+        break;
+    default:
+        break;
+    }
+}
