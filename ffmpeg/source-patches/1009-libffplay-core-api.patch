+static char *ffp_dup_filter(FFPlayer *ffp, int audio, int *gen)
+{
+    char *r;
+    SDL_LockMutex(ffp->mutex);
+    r = av_strdup(audio ? ffp->afilter : ffp->vfilter);
+    if (gen)
+        *gen = SDL_AtomicGet(audio ? &ffp->afilter_gen : &ffp->vfilter_gen);
+    SDL_UnlockMutex(ffp->mutex);
+    return r;
+}
+
+/* a new filter string failed to configure: go back to the last good one,
+ * unless the host already replaced it again in the meantime */
+static void ffp_restore_filter(FFPlayer *ffp, int audio, int gen, const char *good)
+{
+    SDL_LockMutex(ffp->mutex);
+    if (SDL_AtomicGet(audio ? &ffp->afilter_gen : &ffp->vfilter_gen) == gen) {
+        char **dst = audio ? &ffp->afilter : &ffp->vfilter;
+        av_freep(dst);
+        *dst = good ? av_strdup(good) : NULL;
+    }
+    SDL_UnlockMutex(ffp->mutex);
+}
