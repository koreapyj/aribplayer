+static void ffp_emit_input(FFPlayer *ffp, const char *fmt, ...)
+{
+    char json[160];
+    va_list ap;
+
+    va_start(ap, fmt);
+    vsnprintf(json, sizeof(json), fmt, ap);
+    va_end(ap);
+    ffp_emit(ffp, FFP_EVENT_INPUT, json);
+}
