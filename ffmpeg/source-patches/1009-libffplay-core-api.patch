+/* av_log sink installed by ffp_set_log_callback: formats like the default callback (prefix included)
+ * and hands one string per call to the host */
+static void ffp_log_trampoline(void *avcl, int level, const char *fmt, va_list vl)
+{
+    static SDL_SpinLock fmt_lock;
+    static int print_prefix = 1;
+    char line[2048];
+    ffp_log_cb cb;
+    void *user;
+    int n;
+
+    SDL_AtomicLock(&g_ffp_log.lock);
+    cb = g_ffp_log.cb;
+    user = g_ffp_log.user;
+    SDL_AtomicUnlock(&g_ffp_log.lock);
+    if (!cb) {
+        av_log_default_callback(avcl, level, fmt, vl);
+        return;
+    }
+    level &= 0xff;
+    if (level > av_log_get_level())
+        return;
+    SDL_AtomicLock(&fmt_lock);
+    n = av_log_format_line2(avcl, level, fmt, vl, line, sizeof(line), &print_prefix);
+    SDL_AtomicUnlock(&fmt_lock);
+    if (n > 0 && line[0])
+        cb(user, level, line);
+}
+
+FFP_API void FFP_CALL ffp_set_log_callback(ffp_log_cb cb, void *user)
+{
+    SDL_AtomicLock(&g_ffp_log.lock);
+    g_ffp_log.cb = cb;
+    g_ffp_log.user = user;
+    SDL_AtomicUnlock(&g_ffp_log.lock);
+    av_log_set_callback(cb ? ffp_log_trampoline : av_log_default_callback);
 }
