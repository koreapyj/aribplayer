+FFP_API int FFP_CALL ffp_open(FFPlayer *ffp, const char *url, const char *options_kv)
+{
+    FFPOptions *o;
+    FFPOpenOverrides ov = { 0 };
+    FFPCmd *c;
+    int ret;
+
+    if (!ffp || !url || !*url)
+        return FFP_EINVAL;
+
+    o = av_mallocz(sizeof(*o));
+    if (!o)
+        return AVERROR(ENOMEM);
+    ffp_opts_defaults(o);
+    ov.volume = -1;
+    ret = ffp_parse_kv(o, &ov, options_kv);
+    if (ret < 0)
+        goto fail;
+    c = av_mallocz(sizeof(*c));
+    if (!c) {
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+    c->s = av_strdup(url);
+    if (!c->s) {
+        av_free(c);
+        ret = AVERROR(ENOMEM);
+        goto fail;
     }
+    c->type = FFP_CMD_OPEN;
