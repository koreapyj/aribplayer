+/* Hosted window resizing.
+ *
+ * SDL_CreateWindowFrom() subclasses the host HWND, so SDL's window procedure runs on the HOST's UI
+ * thread.  A host resize (maximize, full screen, SetWindowPos ...) would make SDL send
+ * SDL_WINDOWEVENT_SIZE_CHANGED -- and the D3D renderer resize its swap chain -- on that thread,
+ * concurrently with the loop thread rendering.
+ * So size messages are NOT given to SDL on the host thread, they only raise a flag.  The loop
+ * thread then feeds the same message to SDL's window procedure itself (see ffp_sync_hosted_size()),
+ * so SDL updates its window size and the renderer on the render thread. */
+#ifdef _WIN32
+#define FFP_HOST_PROP L"libffplay.player"
+
+static LRESULT CALLBACK ffp_host_wndproc(HWND h, UINT msg, WPARAM wp, LPARAM lp)
+{
+    FFPlayer *ffp = (FFPlayer *)GetPropW(h, FFP_HOST_PROP);
+
+    if (!ffp)
+        return DefWindowProcW(h, msg, wp, lp);
+    switch (msg) {
+    case WM_SIZE:
+    case WM_WINDOWPOSCHANGED:
+        SDL_AtomicSet(&ffp->size_dirty, 1);
+        return CallWindowProcW((WNDPROC)ffp->host_wndproc, h, msg, wp, lp);
+    }
+    return CallWindowProcW((WNDPROC)ffp->sdl_wndproc, h, msg, wp, lp);
+}
+
+/* Bottom layer (between SDL's procedure and the host's).  SDL's window procedure chains every
+ * message to the procedure it found, so the synthetic WM_WINDOWPOSCHANGED that the loop thread
+ * replays would reach the host's DefWindowProc, which SendMessage()s WM_SIZE / WM_MOVE to the
+ * window -- owned by ANOTHER thread.  If that thread is meanwhile blocked waiting for the loop
+ * thread (ffp_destroy joins it), both wait forever.  So during the replay this layer swallows
+ * the message instead of forwarding it to the host (the host already got the real one). */
+static LRESULT CALLBACK ffp_host_inner_wndproc(HWND h, UINT msg, WPARAM wp, LPARAM lp)
+{
+    FFPlayer *ffp = (FFPlayer *)GetPropW(h, FFP_HOST_PROP);
+
+    if (!ffp)
+        return DefWindowProcW(h, msg, wp, lp);
+    if (ffp->synth_tid && ffp->synth_tid == GetCurrentThreadId())
+        return 0;
+    return CallWindowProcW((WNDPROC)ffp->host_wndproc, h, msg, wp, lp);
+}
+
+/* before SDL_CreateWindowFrom(): interpose the bottom layer so SDL records it as "the host's" */
+static void ffp_host_prehook(FFPlayer *ffp)
+{
+    HWND h = (HWND)ffp->hwnd;
+
+    ffp->host_wndproc = (intptr_t)GetWindowLongPtrW(h, GWLP_WNDPROC);
+    SetPropW(h, FFP_HOST_PROP, ffp);
+    SetWindowLongPtrW(h, GWLP_WNDPROC, (LONG_PTR)ffp_host_inner_wndproc);
+}
+
+/* take the hooks off and give the host its own procedure back (after SDL_DestroyWindow, or when
+ * SDL did not subclass) */
+static void ffp_host_restore(FFPlayer *ffp)
+{
+    HWND h = (HWND)ffp->hwnd;
+
+    if (!h || !GetPropW(h, FFP_HOST_PROP))
+        return;
+    if ((intptr_t)GetWindowLongPtrW(h, GWLP_WNDPROC) == (intptr_t)ffp_host_inner_wndproc)
+        SetWindowLongPtrW(h, GWLP_WNDPROC, (LONG_PTR)ffp->host_wndproc);
+    RemovePropW(h, FFP_HOST_PROP);
+}
+
+static void ffp_host_hook(FFPlayer *ffp)
+{
+    HWND h = (HWND)ffp->hwnd;
+    intptr_t cur = (intptr_t)GetWindowLongPtrW(h, GWLP_WNDPROC);
+
+    ffp->sdl_wndproc = cur;
+    if (cur == (intptr_t)ffp_host_inner_wndproc) {
+        ffp->sdl_wndproc = ffp->host_wndproc;
+        ffp_host_restore(ffp);
+        return;
+    }
+    SetWindowLongPtrW(h, GWLP_WNDPROC, (LONG_PTR)ffp_host_wndproc);
+    SDL_AtomicSet(&ffp->size_dirty, 1);
+}
+
+static void ffp_host_unhook(FFPlayer *ffp)
+{
+    HWND h = (HWND)ffp->hwnd;
+
+    if (!h || !GetPropW(h, FFP_HOST_PROP))
+        return;
+    /* give SDL its procedure back first: SDL_DestroyWindow() restores the host's from there */
+    if ((intptr_t)GetWindowLongPtrW(h, GWLP_WNDPROC) == (intptr_t)ffp_host_wndproc)
+        SetWindowLongPtrW(h, GWLP_WNDPROC, (LONG_PTR)ffp->sdl_wndproc);
+}
+#endif
