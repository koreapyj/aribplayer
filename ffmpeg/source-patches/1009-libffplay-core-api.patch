+static int ffp_caps_frames(AVBufferRef *dev, enum AVPixelFormat fmt, enum AVPixelFormat sw, AVBufferRef **out)
+{
+    AVBufferRef *ref = av_hwframe_ctx_alloc(dev);
+    AVHWFramesContext *fc;
+    int ret;
+
+    if (!ref)
+        return AVERROR(ENOMEM);
+    fc = (AVHWFramesContext *)ref->data;
+    fc->format = fmt;
+    fc->sw_format = sw;
+    fc->width = fc->height = 64;
+    fc->initial_pool_size = 1;
+    if (fmt == AV_PIX_FMT_D3D11) {
+        AVD3D11VAFramesContext *dc = fc->hwctx;
+        dc->BindFlags = D3D11_BIND_DECODER | D3D11_BIND_SHADER_RESOURCE;
+    }
+    ret = av_hwframe_ctx_init(ref);
+    if (ret < 0) {
+        av_buffer_unref(&ref);
+        return ret;
     }
+    *out = ref;
+    return 0;
+}
 
