+static const AVOption *ffp_opt_find(void *obj, const char *name, const char *unit,
+                                    int opt_flags, int search_flags)
+{
+    const AVOption *o = av_opt_find(obj, name, unit, opt_flags, search_flags);
+    if (o && !o->flags)
+        return NULL;
+    return o;
+}
