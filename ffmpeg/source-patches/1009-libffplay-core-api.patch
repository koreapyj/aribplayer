+static int ffp_filter_codec_opts(const AVDictionary *opts, enum AVCodecID codec_id,
+                                 AVFormatContext *s, AVStream *st, const AVCodec *codec,
+                                 AVDictionary **dst)
+{
+    AVDictionary    *ret = NULL;
+    const AVDictionaryEntry *t = NULL;
+    int            flags = AV_OPT_FLAG_DECODING_PARAM;
+    char          prefix = 0;
+    const AVClass    *cc = avcodec_get_class();
+
+    switch (st->codecpar->codec_type) {
+    case AVMEDIA_TYPE_VIDEO:
+        prefix  = 'v';
+        flags  |= AV_OPT_FLAG_VIDEO_PARAM;
+        break;
+    case AVMEDIA_TYPE_AUDIO:
+        prefix  = 'a';
+        flags  |= AV_OPT_FLAG_AUDIO_PARAM;
+        break;
+    case AVMEDIA_TYPE_SUBTITLE:
+        prefix  = 's';
+        flags  |= AV_OPT_FLAG_SUBTITLE_PARAM;
+        break;
+    }
+
+    while ((t = av_dict_iterate(opts, t))) {
+        const AVClass *priv_class;
+        char *key = av_strdup(t->key);
+        char *p;
+
+        if (!key) {
+            av_dict_free(&ret);
+            return AVERROR(ENOMEM);
+        }
+        p = strchr(key, ':');
+
+        if (p) {
+            int err = avformat_match_stream_specifier(s, st, p + 1);
+            if (err < 0) {
+                av_free(key);
+                av_dict_free(&ret);
+                return err;
+            } else if (!err) {
+                av_free(key);
+                continue;
+            }
+            *p = 0;
+        }
+
+        if (av_opt_find(&cc, key, NULL, flags, AV_OPT_SEARCH_FAKE_OBJ) ||
+            !codec ||
+            ((priv_class = codec->priv_class) &&
+             av_opt_find(&priv_class, key, NULL, flags,
+                         AV_OPT_SEARCH_FAKE_OBJ))) {
+            av_dict_set(&ret, key, t->value, 0);
+        } else if (key[0] == prefix &&
+                   av_opt_find(&cc, key + 1, NULL, flags,
+                               AV_OPT_SEARCH_FAKE_OBJ)) {
+            av_dict_set(&ret, key + 1, t->value, 0);
+        }
+        av_free(key);
+    }
 
-    vfilters_list[nb_vfilters - 1] = av_strdup(arg);
-    if (!vfilters_list[nb_vfilters - 1])
+    *dst = ret;
+    return 0;
+}
+
+static int ffp_setup_find_stream_info_opts(AVFormatContext *s,
+                                           AVDictionary *local_codec_opts,
+                                           AVDictionary ***dst)
+{
+    int ret;
+    AVDictionary **opts;
+
+    *dst = NULL;
+
+    if (!s->nb_streams)
+        return 0;
+
+    opts = av_calloc(s->nb_streams, sizeof(*opts));
+    if (!opts)
         return AVERROR(ENOMEM);
 
+    for (int i = 0; i < s->nb_streams; i++) {
+        ret = ffp_filter_codec_opts(local_codec_opts, s->streams[i]->codecpar->codec_id,
+                                    s, s->streams[i], NULL, &opts[i]);
+        if (ret < 0)
+            goto fail;
+    }
+    *dst = opts;
     return 0;
+fail:
+    for (int i = 0; i < s->nb_streams; i++)
+        av_dict_free(&opts[i]);
+    av_freep(&opts);
+    return ret;
+}
