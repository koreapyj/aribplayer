+static void ffp_emit(FFPlayer *ffp, int event, const char *json)
+{
+    SDL_LockMutex(ffp->emit_mutex);
+    if (ffp->cb)
+        ffp->cb(ffp->user, event, json);
+    SDL_UnlockMutex(ffp->emit_mutex);
+}
+
+static const char *const ffp_state_names[] = {
+    "idle", "opening", "playing", "paused", "stopped", "ended", "error"
+};
+
+static void ffp_set_state(FFPlayer *ffp, int state, int force)
+{
+    SDL_LockMutex(ffp->emit_mutex);
+    if (ffp->state != state || force) {
+        char json[64];
+        ffp->state = state;
+        snprintf(json, sizeof(json), "{\"state\":\"%s\"}", ffp_state_names[state]);
+        if (ffp->cb)
+            ffp->cb(ffp->user, FFP_EVENT_STATE, json);
+    }
+    SDL_UnlockMutex(ffp->emit_mutex);
+}
+
+static int ffp_get_state(FFPlayer *ffp)
+{
+    int st;
+    SDL_LockMutex(ffp->emit_mutex);
+    st = ffp->state;
+    SDL_UnlockMutex(ffp->emit_mutex);
+    return st;
+}
+
+static void ffp_emit_error(FFPlayer *ffp, int code, const char *url)
+{
+    char msg[AV_ERROR_MAX_STRING_SIZE];
+    AVBPrint bp;
+
+    if (av_strerror(code, msg, sizeof(msg)) < 0)
+        snprintf(msg, sizeof(msg), "Error %d", code);
+    av_bprint_init(&bp, 0, AV_BPRINT_SIZE_UNLIMITED);
+    av_bprintf(&bp, "{\"code\":%d,\"message\":", code);
+    json_string(&bp, msg);
+    av_bprintf(&bp, ",\"url\":");
+    json_string(&bp, url);
+    av_bprintf(&bp, "}");
+    SDL_LockMutex(ffp->emit_mutex);
+    if (av_bprint_is_complete(&bp))
+        ffp_emit(ffp, FFP_EVENT_ERROR, bp.str);
+    ffp_set_state(ffp, FFP_ST_ERROR, 0);
+    SDL_UnlockMutex(ffp->emit_mutex);
+    av_bprint_finalize(&bp, NULL);
+}
+
+static void ffp_report_error(VideoState *is, int code)
+{
+    if (!SDL_AtomicCAS(&is->failed, 0, 1))
+        return;
+    av_log(NULL, AV_LOG_ERROR, "%s: error %d\n", is->filename, code);
+    ffp_emit_error(is->ffp, code, is->filename);
+}
+
+/* hwframes_fb: the failure made the player fall back from hwframes=keep to download ("hwframes_fallback":true) */
+static void ffp_emit_filter_error_ex(FFPlayer *ffp, const char *type, const char *filter, int code, int hwframes_fb)
+{
+    char msg[AV_ERROR_MAX_STRING_SIZE];
+    AVBPrint bp;
+
+    if (av_strerror(code, msg, sizeof(msg)) < 0)
+        snprintf(msg, sizeof(msg), "Error %d", code);
+    av_bprint_init(&bp, 0, AV_BPRINT_SIZE_UNLIMITED);
+    av_bprintf(&bp, "{\"type\":\"%s\",\"filter\":", type);
+    json_string(&bp, filter);
+    av_bprintf(&bp, ",\"code\":%d,\"message\":", code);
+    json_string(&bp, msg);
+    if (hwframes_fb)
+        av_bprintf(&bp, ",\"hwframes_fallback\":true,\"error\":");
+    if (hwframes_fb)
+        json_string(&bp, msg);
+    av_bprintf(&bp, "}");
+    if (av_bprint_is_complete(&bp))
+        ffp_emit(ffp, FFP_EVENT_FILTER_ERROR, bp.str);
+    av_bprint_finalize(&bp, NULL);
+}
+
+static void ffp_emit_filter_error(FFPlayer *ffp, const char *type, const char *filter, int code)
+{
+    ffp_emit_filter_error_ex(ffp, type, filter, code, 0);
+}
