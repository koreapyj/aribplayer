+    ARG_OPT("codec",           0,          "force decoder", "decoder_name"),
+    ARG_OPT("acodec",          OPT_EXPERT, "force audio decoder", "decoder_name"),
+    ARG_OPT("scodec",          OPT_EXPERT, "force subtitle decoder", "decoder_name"),
+    ARG_OPT("vcodec",          OPT_EXPERT, "force video decoder", "decoder_name"),
+    BOOL_OPT(B_AUTOROTATE,     0,          "automatically rotate video"),
+    BOOL_OPT(B_FIND_STREAM_INFO, OPT_INPUT | OPT_EXPERT, "read and decode the streams to fill missing information with heuristics"),
+    ARG_OPT("filter_threads",  OPT_EXPERT, "number of filter threads per graph", ""),
+    BOOL_OPT(B_ENABLE_VULKAN,  0,          "enable vulkan renderer"),
+    ARG_OPT("vulkan_params",   OPT_EXPERT, "vulkan configuration using a list of key=value pairs separated by ':'", ""),
+    ARG_OPT("video_bg",        OPT_EXPERT, "set video background for transparent videos", ""),
+    ARG_OPT("hwaccel",         OPT_EXPERT, "use HW accelerated decoding", ""),
+    { NULL, },
+};
+
+static void show_usage(void)
+{
+    av_log(NULL, AV_LOG_INFO, "Simple media player\n");
+    av_log(NULL, AV_LOG_INFO, "usage: %s [options] input_file\n", program_name);
+    av_log(NULL, AV_LOG_INFO, "\n");
+}
+
+void show_help_default(const char *opt, const char *arg)
+{
+    av_log_set_callback(log_callback_help);
+    show_usage();
+    show_help_options(options, "Main options:", 0, OPT_EXPERT);
+    show_help_options(options, "Advanced options:", OPT_EXPERT, 0);
+    printf("\n");
+    show_help_children(avcodec_get_class(), AV_OPT_FLAG_DECODING_PARAM);
+    show_help_children(avformat_get_class(), AV_OPT_FLAG_DECODING_PARAM);
+    show_help_children(avfilter_get_class(), AV_OPT_FLAG_FILTERING_PARAM);
+    printf("\nWhile playing:\n"
+           "q, ESC              quit\n"
+           "f                   toggle full screen\n"
+           "p, SPC              pause\n"
+           "m                   toggle mute\n"
+           "9, 0                decrease and increase volume respectively\n"
+           "/, *                decrease and increase volume respectively\n"
+           "a                   cycle audio channel in the current program\n"
+           "v                   cycle video channel\n"
+           "t                   cycle subtitle channel in the current program\n"
+           "c                   cycle program\n"
+           "w                   cycle video filters or show modes\n"
+           "s                   activate frame-step mode\n"
+           "left/right          seek backward/forward by 10 seconds or a custom interval if -seek_interval is set\n"
+           "down/up             seek backward/forward 1 minute\n"
+           "page down/page up   seek to previous/next chapter or backward/forward 10 minutes if no chapters\n"
+           "right mouse click   seek to percentage in file corresponding to fraction of width\n"
+           "left double-click   toggle full screen\n"
+           );
+}
+
+static void add_dict(const AVDictionary *d)
+{
+    const AVDictionaryEntry *e = NULL;
+
+    while ((e = av_dict_iterate(d, e)))
+        if (!strchr(e->key, '\n') && !strchr(e->value, '\n') && !strchr(e->key, '='))
+            add_kv(e->key, e->value);
+}
+
+static void FFP_CALL on_event(void *user, int event, const char *json)
+{
+    switch (event) {
+    case FFP_EVENT_INPUT:
+        if (strstr(json, "\"type\":\"close\""))
+            quit_requested = 1;
+        break;
+    case FFP_EVENT_EOF:
+        if (autoexit_set)
+            quit_requested = 1;
+        break;
+    case FFP_EVENT_ERROR:
+        exit_status = 1;
+        quit_requested = 1;
+        break;
+    }
+}
+
+int main(int argc, char **argv)
+{
+    FFPlayer *player;
+    int i, ret;
+
+    init_dynload();
+
+    av_log_set_flags(AV_LOG_SKIP_REPEATED);
+    parse_loglevel(argc, argv, options);
+
+    signal(SIGINT , sigterm_handler);
+    signal(SIGTERM, sigterm_handler);
+
+    show_banner(argc, argv, options);
+
+    for (i = 0; i < B_NB; i++)
+        bool_vals[i] = -1;
+    av_bprint_init(&kv, 0, AV_BPRINT_SIZE_UNLIMITED);
+
+    ret = parse_options(NULL, argc, argv, options, opt_input_file);
+    if (ret < 0)
+        exit(ret == AVERROR_EXIT ? 0 : 1);
+
+    if (!input_filename) {
+        show_usage();
+        av_log(NULL, AV_LOG_FATAL, "An input file must be specified\n");
+        av_log(NULL, AV_LOG_FATAL,
+               "Use -h to get full help or, even better, run 'man %s'\n", program_name);
+        exit(1);
+    }
+
+    for (i = 0; i < B_NB; i++) {
+        if (i == B_I)
+            continue;
+        if (bool_vals[i] != -1)
+            av_bprintf(&kv, "%s=%d\n", bool_names[i], bool_vals[i]);
+    }
+    if (bool_vals[B_STATS] == -1)
+        add_kv("stats", "-1");
+    autoexit_set = bool_vals[B_AUTOEXIT] > 0;
+    add_dict(format_opts);
+    add_dict(codec_opts);
+    add_dict(sws_dict);
+    add_dict(swr_opts);
+
+    if (!av_bprint_is_complete(&kv)) {
+        av_log(NULL, AV_LOG_FATAL, "Out of memory\n");
+        exit(1);
+    }
+
+    player = ffp_create(NULL, on_event, NULL);
+    if (!player) {
+        av_log(NULL, AV_LOG_FATAL, "Failed to initialize the player!\n");
+        exit(1);
+    }
+    ret = ffp_open(player, input_filename, kv.str);
+    if (ret < 0) {
+        av_log(NULL, AV_LOG_FATAL, "Failed to open '%s': %s\n", input_filename, av_err2str(ret));
+        exit_status = 1;
+    } else {
+        while (!quit_requested)
+            av_usleep(10000);
+    }
+
+    ffp_destroy(player);
+
+    uninit_opts();
+    av_bprint_finalize(&kv, NULL);
+    av_freep(&input_filename);
+    if (bool_vals[B_STATS] != 0)
+        printf("\n");
+    av_log(NULL, AV_LOG_QUIET, "%s", "");
+    return exit_status;
+}
