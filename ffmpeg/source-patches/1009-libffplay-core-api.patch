+/* (re)build the audio graph from the instance's current filter string; if that
+ * string does not configure, raise FILTER_ERROR, go back to the last good
+ * string and configure with that instead */
+static int ffp_configure_audio(VideoState *is, int force_output_format, int *gen_out)
+{
+    FFPlayer *ffp = is->ffp;
+    int gen, ret, fallback = 0;
+    char *af = ffp_dup_filter(ffp, 1, &gen);
+
+    ret = configure_audio_filters(is, af, force_output_format);
+    if (ret < 0 && af) {
+        ffp_emit_filter_error(ffp, "audio", af, ret);
+        ffp_restore_filter(ffp, 1, gen, is->afilter_good);
+        ret = configure_audio_filters(is, is->afilter_good, force_output_format);
+        fallback = 1;
+    }
+    if (ret >= 0 && !fallback) {
+        av_free(is->afilter_good);
+        is->afilter_good = af;
+        af = NULL;
+    }
+    av_free(af);
+    if (gen_out)
+        *gen_out = gen;
+    return ret;
+}
