+static int ffp_is_seekable(VideoState *is)
+{
+    AVFormatContext *ic = is->ic;
+
+    if (is->duration_s <= 0 || (ic->ctx_flags & AVFMTCTX_UNSEEKABLE))
+        return 0;
+    if (ic->pb && (ic->pb->seekable & AVIO_SEEKABLE_NORMAL))
+        return 1;
+    return !strcmp(ic->iformat->name, "hls") || !strcmp(ic->iformat->name, "applehttp");
+}
+
+/* 4 printable ASCII chars: the container's codec_tag, else the RIFF tag of the codec id (video/audio); "" when none */
+static void ffp_codec_fourcc(const AVCodecParameters *par, char out[5])
+{
+    unsigned tag = par->codec_tag;
+    int i, ok;
+
+    for (int pass = 0; pass < 2; pass++) {
+        ok = tag != 0;
+        for (i = 0; i < 4; i++) {
+            unsigned c = (tag >> (8 * i)) & 0xff;
+            if (c < 0x20 || c > 0x7e)
+                ok = 0;
+        }
+        if (ok)
+            break;
+        if (pass == 0) {
+            const struct AVCodecTag *table = par->codec_type == AVMEDIA_TYPE_VIDEO ? avformat_get_riff_video_tags() :
+                                             par->codec_type == AVMEDIA_TYPE_AUDIO ? avformat_get_riff_audio_tags() : NULL;
+            const struct AVCodecTag *const tags[] = { table, NULL };
+            tag = table ? av_codec_get_tag(tags, par->codec_id) : 0;
+        }
+    }
+    for (i = 0; i < 4; i++)
+        out[i] = ok ? (tag >> (8 * i)) & 0xff : 0;
+    out[ok ? 4 : 0] = 0;
+}
+
+static void ffp_build_media_info(VideoState *is, AVBPrint *bp)
+{
+    AVFormatContext *ic = is->ic;
+    const AVDictionaryEntry *t;
+    int i, first = 1;
+
+    av_bprintf(bp, "{\"url\":");
+    json_string(bp, is->filename);
+    t = av_dict_get(ic->metadata, "title", NULL, 0);
+    av_bprintf(bp, ",\"title\":");
+    json_string(bp, t ? t->value : "");
+    av_bprintf(bp, ",\"format\":");
+    json_string(bp, ic->iformat->name);
+    av_bprintf(bp, ",\"duration\":");
+    json_double(bp, is->duration_s);
+    av_bprintf(bp, ",\"seekable\":%s,\"bit_rate\":%"PRId64",\"render\":{\"width\":%d,\"height\":%d},\"streams\":[",
+               ffp_is_seekable(is) ? "true" : "false", (int64_t)ic->bit_rate,
+               is->ffp->render_w, is->ffp->render_h);
+
+    for (i = 0; i < ic->nb_streams; i++) {
+        AVStream *st = ic->streams[i];
+        AVCodecParameters *par = st->codecpar;
+        const char *type;
+        char fourcc[5];
+        int selected;
+
+        switch (par->codec_type) {
+        case AVMEDIA_TYPE_VIDEO:    type = "video";    selected = i == is->video_stream;    break;
+        case AVMEDIA_TYPE_AUDIO:    type = "audio";    selected = i == is->audio_stream;    break;
+        case AVMEDIA_TYPE_SUBTITLE: type = "subtitle"; selected = i == is->subtitle_stream; break;
+        default: continue;
+        }
+        if (!first)
+            av_bprintf(bp, ",");
+        first = 0;
+        av_bprintf(bp, "{\"index\":%d,\"type\":\"%s\",\"codec\":", i, type);
+        json_string(bp, avcodec_get_name(par->codec_id));
+        ffp_codec_fourcc(par, fourcc);
+        if (fourcc[0]) {
+            av_bprintf(bp, ",\"fourcc\":");
+            json_string(bp, fourcc);
+        }
+        if (par->codec_type == AVMEDIA_TYPE_VIDEO) {
+            AVRational sar = av_guess_sample_aspect_ratio(ic, st, NULL);
+            AVRational fr  = av_guess_frame_rate(ic, st, NULL);
+            const char *pf = av_get_pix_fmt_name(par->format);
+            if (sar.num <= 0 || sar.den <= 0)
+                sar = (AVRational){1, 1};
+            av_bprintf(bp, ",\"width\":%d,\"height\":%d,\"sar_num\":%d,\"sar_den\":%d,\"fps\":",
+                       par->width, par->height, sar.num, sar.den);
+            json_double(bp, fr.num > 0 && fr.den > 0 ? av_q2d(fr) : 0);
+            av_bprintf(bp, ",\"pix_fmt\":");
+            json_string(bp, pf ? pf : "");
+            av_bprintf(bp, ",\"color_transfer\":");
+            json_string(bp, av_color_transfer_name(par->color_trc));
+        } else if (par->codec_type == AVMEDIA_TYPE_AUDIO) {
+            av_bprintf(bp, ",\"sample_rate\":%d,\"channels\":%d",
+                       par->sample_rate, par->ch_layout.nb_channels);
+        }
+        av_bprintf(bp, ",\"selected\":%s,\"language\":", selected ? "true" : "false");
+        t = av_dict_get(st->metadata, "language", NULL, 0);
+        json_string(bp, t && t->value[0] ? t->value : "und");
+        t = av_dict_get(st->metadata, "title", NULL, 0);
+        if (t && t->value[0]) {
+            av_bprintf(bp, ",\"title\":");
+            json_string(bp, t->value);
+        }
+        av_bprintf(bp, "}");
+    }
+    av_bprintf(bp, "]}");
+}
+
+static void ffp_update_media_info(VideoState *is)
+{
+    FFPlayer *ffp = is->ffp;
+    AVBPrint bp;
+    char *json = NULL;
+
+    av_bprint_init(&bp, 0, AV_BPRINT_SIZE_UNLIMITED);
+    ffp_build_media_info(is, &bp);
+    if (av_bprint_is_complete(&bp))
+        av_bprint_finalize(&bp, &json);
+    else
+        av_bprint_finalize(&bp, NULL);
+    SDL_LockMutex(ffp->mutex);
+    av_free(ffp->media_info);
+    ffp->media_info = json;
+    SDL_UnlockMutex(ffp->mutex);
+}
+
+/* called by the read thread once the streams are open */
+static void ffp_notify_prepared(VideoState *is)
+{
+    FFPlayer *ffp = is->ffp;
+    AVFormatContext *ic = is->ic;
+    const AVDictionaryEntry *t;
+    AVRational sar = {1, 1};
+    int w = 0, h = 0;
+    AVBPrint bp;
+
+    if (is->video_st) {
+        w = is->video_st->codecpar->width;
+        h = is->video_st->codecpar->height;
+        sar = av_guess_sample_aspect_ratio(ic, is->video_st, NULL);
+        if (sar.num <= 0 || sar.den <= 0)
+            sar = (AVRational){1, 1};
+    }
+    is->duration_s = (!is->realtime && ic->duration != AV_NOPTS_VALUE && ic->duration > 0) ?
+                     ic->duration / (double)AV_TIME_BASE : 0;
+    is->start_off_s = ic->start_time != AV_NOPTS_VALUE ? ic->start_time / (double)AV_TIME_BASE : 0;
+
+    SDL_LockMutex(ffp->mutex);
+    ffp->duration = is->duration_s;
+    SDL_UnlockMutex(ffp->mutex);
+    ffp_update_media_info(is);
+
+    av_bprint_init(&bp, 0, AV_BPRINT_SIZE_UNLIMITED);
+    av_bprintf(&bp, "{\"duration\":");
+    json_double(&bp, is->duration_s);
+    av_bprintf(&bp, ",\"seekable\":%s,\"has_video\":%s,\"has_audio\":%s,\"width\":%d,\"height\":%d,"
+               "\"sar_num\":%d,\"sar_den\":%d,\"title\":",
+               ffp_is_seekable(is) ? "true" : "false", is->video_st ? "true" : "false",
+               is->audio_st ? "true" : "false", w, h, sar.num, sar.den);
+    t = av_dict_get(ic->metadata, "title", NULL, 0);
+    json_string(&bp, t ? t->value : "");
+    av_bprintf(&bp, "}");
+
+    SDL_AtomicSet(&is->prepared, 1);
+    SDL_LockMutex(ffp->emit_mutex);
+    if (av_bprint_is_complete(&bp))
+        ffp_emit(ffp, FFP_EVENT_PREPARED, bp.str);
+    ffp_set_state(ffp, is->paused ? FFP_ST_PAUSED : FFP_ST_PLAYING, 0);
+    SDL_UnlockMutex(ffp->emit_mutex);
+    av_bprint_finalize(&bp, NULL);
+}
