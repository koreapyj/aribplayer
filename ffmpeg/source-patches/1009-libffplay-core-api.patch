+static void ffp_post(FFPlayer *ffp, FFPCmd *c)
+{
+    c->next = NULL;
+    SDL_LockMutex(ffp->mutex);
+    if (ffp->cmd_tail)
+        ffp->cmd_tail->next = c;
+    else
+        ffp->cmd_head = c;
+    ffp->cmd_tail = c;
+    SDL_UnlockMutex(ffp->mutex);
+    ffp_wake();
+}
