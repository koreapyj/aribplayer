+/* AVOption passthrough: routes a codec/format/protocol/sws/swr option into the
+ * per-instance dictionaries (same logic as cmdutils' opt_default()). */
+static int ffp_opt_default(FFPOptions *opts, const char *opt, const char *arg)
+{
+    const AVOption *o;
+    int consumed = 0;
+    char opt_stripped[128];
+    const char *p;
+    const AVClass *cc = avcodec_get_class(), *fc = avformat_get_class();
+    const AVClass *sc = sws_get_class();
+    const AVClass *swr_class = swr_get_class();
+#define FFP_DICT_FLAGS ((o->type == AV_OPT_TYPE_FLAGS && (arg[0] == '-' || arg[0] == '+')) ? AV_DICT_APPEND : 0)
+
+    if (!(p = strchr(opt, ':')))
+        p = opt + strlen(opt);
+    av_strlcpy(opt_stripped, opt, FFMIN(sizeof(opt_stripped), p - opt + 1));
+
+    if ((o = ffp_opt_find(&cc, opt_stripped, NULL, 0,
+                          AV_OPT_SEARCH_CHILDREN | AV_OPT_SEARCH_FAKE_OBJ)) ||
+        ((opt[0] == 'v' || opt[0] == 'a' || opt[0] == 's') &&
+         (o = ffp_opt_find(&cc, opt + 1, NULL, 0, AV_OPT_SEARCH_FAKE_OBJ)))) {
+        av_dict_set(&opts->codec_opts, opt, arg, FFP_DICT_FLAGS);
+        consumed = 1;
+    }
+    if ((o = ffp_opt_find(&fc, opt, NULL, 0,
+                          AV_OPT_SEARCH_CHILDREN | AV_OPT_SEARCH_FAKE_OBJ))) {
+        av_dict_set(&opts->format_opts, opt, arg, FFP_DICT_FLAGS);
+        consumed = 1;
+    }
+    if (!consumed && (o = ffp_opt_find(&sc, opt, NULL, 0,
+                                       AV_OPT_SEARCH_CHILDREN | AV_OPT_SEARCH_FAKE_OBJ))) {
+        if (!strcmp(opt, "srcw") || !strcmp(opt, "srch") ||
+            !strcmp(opt, "dstw") || !strcmp(opt, "dsth") ||
+            !strcmp(opt, "src_format") || !strcmp(opt, "dst_format")) {
+            av_log(NULL, AV_LOG_ERROR, "Directly using swscale dimensions/format options is not supported\n");
+            return AVERROR(EINVAL);
+        }
+        av_dict_set(&opts->sws_dict, opt, arg, FFP_DICT_FLAGS);
+        consumed = 1;
+    }
+    if (!consumed && (o = ffp_opt_find(&swr_class, opt, NULL, 0,
+                                       AV_OPT_SEARCH_CHILDREN | AV_OPT_SEARCH_FAKE_OBJ))) {
+        av_dict_set(&opts->swr_opts, opt, arg, FFP_DICT_FLAGS);
+        consumed = 1;
+    }
+#undef FFP_DICT_FLAGS
+
+    return consumed ? 0 : AVERROR_OPTION_NOT_FOUND;
+}
