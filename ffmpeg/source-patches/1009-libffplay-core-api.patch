+static int ffp_post_simple(FFPlayer *ffp, int type, double d, int i)
+{
+    FFPCmd *c = av_mallocz(sizeof(*c));
+
+    if (!c)
+        return AVERROR(ENOMEM);
+    c->type = type;
+    c->d = d;
+    c->i = i;
+    ffp_post(ffp, c);
+    return 0;
+}
