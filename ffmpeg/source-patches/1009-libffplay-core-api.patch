+static void ffp_dbg_set_graph(VideoState *is, AVFilterGraph *g, int audio)
+{
+    char *graph, *names, *nodes;
+    double speed;
+    FFPDebug *d = &is->dbg;
+
+    if (!is->dbg_mutex || !g)
+        return;
+    ffp_dbg_describe_graph(g, audio, &graph, &names, &nodes, &speed);
+    SDL_LockMutex(is->dbg_mutex);
+    if (audio) {
+        av_free(d->af_graph); av_free(d->af_names); av_free(d->af_nodes);
+        d->af_graph = graph; d->af_names = names; d->af_nodes = nodes;
+        d->af_speed = speed;
+    } else {
+        av_free(d->vf_graph); av_free(d->vf_names); av_free(d->vf_nodes);
+        d->vf_graph = graph; d->vf_names = names; d->vf_nodes = nodes;
+    }
+    SDL_UnlockMutex(is->dbg_mutex);
+}
