+/* one frame passed a stage (0 decoded, 1 left the filter graph, 2 presented); called by the owning thread */
+static void ffp_dbg_fps_note(VideoState *is, int stage)
+{
+    FFPDebug *d = &is->dbg;
+    FFPFpsMeter *m = stage == 0 ? &d->fps_dec : stage == 1 ? &d->fps_flt : &d->fps_disp;
+
+    if (!is->dbg_mutex)
+        return;
+    SDL_LockMutex(is->dbg_mutex);
+    m->ts[m->head] = av_gettime_relative();
+    m->head = (m->head + 1) % FFP_FPS_RING;
+    if (m->count < FFP_FPS_RING)
+        m->count++;
+    m->total++;
+    SDL_UnlockMutex(is->dbg_mutex);
+}
+
+/* frames per second over the frames of the last 1.5 s (caller holds dbg_mutex); NAN = not measurable
+ * (fewer than 2 frames in the window, or the latest frame is old: paused / stalled) */
+static double ffp_fps_measure(const FFPFpsMeter *m, int64_t now)
+{
+    int64_t newest, oldest = 0;
+    int i, n = 0;
+
+    if (m->count < 2)
+        return NAN;
+    newest = m->ts[(m->head + FFP_FPS_RING - 1) % FFP_FPS_RING];
+    for (i = 0; i < m->count; i++) {
+        int64_t t = m->ts[(m->head + FFP_FPS_RING - 1 - i) % FFP_FPS_RING];
+        if (now - t > FFP_FPS_WINDOW_US)
+            break;
+        oldest = t;
+        n++;
+    }
+    if (n < 2 || newest <= oldest)
+        return NAN;
+    /* allow at least two average frame intervals (and 0.5 s) since the last frame */
+    if (now - newest > FFMAX(500000, 2 * (newest - oldest) / (n - 1)))
+        return NAN;
+    return (n - 1) * 1000000.0 / (double)(newest - oldest);
+}
