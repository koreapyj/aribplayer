+/* Record a decoded event; with a caption, ctx->caption moves into the history (it takes ownership).
+ * An event at a pts that is already there (a replay after a seek) replaces it. */
+static int aribcaption_save_history(ARIBCaptionContext *ctx, int64_t subtitle_pts,
+                                    uint32_t start, uint32_t end, int clear)
+{
+    ARIBCaptionStore *s = &ctx->store;
+    ARIBCaptionHistory h = { 0 };
+    int pos;
+
+    if (subtitle_pts == AV_NOPTS_VALUE)
+        return 0;
+    if (!clear) {
+        h.caption = ctx->caption;
+        ctx->caption = (aribcc_caption_t){ 0 };
+        h.bytes = aribcaption_caption_bytes(&h.caption);
+    } else {
+        h.bytes = sizeof(h);
+    }
+    h.render_pts = ctx->pts;
+    h.subtitle_pts = subtitle_pts;
+    h.start_display_time = start;
+    h.end_display_time = end;
+    h.clear = clear;
+
+    pos = aribcaption_store_upper(s, subtitle_pts);
+    for (int i = pos - 1; i >= 0 && s->events[i].subtitle_pts == subtitle_pts; i--) {
+        if (s->events[i].clear == clear) {
+            s->bytes += h.bytes - s->events[i].bytes;
+            aribcc_caption_cleanup(&s->events[i].caption);
+            s->events[i] = h;
+            goto stored;
+        }
+    }
+    if (s->count == s->alloc) {
+        int alloc = s->alloc ? s->alloc * 2 : 64;
+        ARIBCaptionHistory *events = av_realloc_array(s->events, alloc, sizeof(*events));
+
+        if (!events) {
+            aribcc_caption_cleanup(&h.caption);
+            return AVERROR(ENOMEM);
+        }
+        s->events = events;
+        s->alloc = alloc;
+    }
+    memmove(&s->events[pos + 1], &s->events[pos], (s->count - pos) * sizeof(*s->events));
+    s->events[pos] = h;
+    s->count++;
+    s->bytes += h.bytes;
+stored:
+    ctx->history_appended_bytes += h.bytes;
+    ctx->anchor_pts = subtitle_pts;
+    aribcaption_span_note(ctx, subtitle_pts, 1);
+    av_log(ctx, AV_LOG_VERBOSE, "ARIB caption history: %s at %"PRId64" us (%zu bytes) end %"PRIu32" ms, %d events, %zu bytes\n",
+           clear ? "clear" : "caption", subtitle_pts, h.bytes, end, s->count, s->bytes);
+    aribcaption_store_evict(ctx);
+    aribcaption_publish_stats(ctx);
+    return 0;
+}
+
+static uint32_t aribcaption_history_signature(const ARIBCaptionContext *ctx)
+{
+    uint32_t sig = 1;
+
+    sig = sig * 31 + ctx->avctx->profile;
+    sig = sig * 31 + ctx->caption_type;
+    sig = sig * 31 + ctx->encoding_scheme;
+    sig = sig * 31 + ctx->replace_msz_ascii;
+    sig = sig * 31 + ctx->replace_msz_japanese;
+    return sig;
+}
