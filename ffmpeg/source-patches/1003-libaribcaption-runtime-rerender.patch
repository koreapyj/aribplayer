+/* Keep the events within the window around the newest decoded one and the byte budget; when the budget
+ * is exceeded the event farthest from it (normally the oldest) goes first. */
+static void aribcaption_store_evict(ARIBCaptionContext *ctx)
+{
+    ARIBCaptionStore *s = &ctx->store;
+    int64_t window = (int64_t)ctx->history_window * AV_TIME_BASE;
+    int64_t hi_limit = INT64_MAX;
+    int evicted = 0;
+
+    while (s->count) {
+        const ARIBCaptionHistory *first = &s->events[0];
+        const ARIBCaptionHistory *last = &s->events[s->count - 1];
+        int64_t anchor = ctx->anchor_pts != AV_NOPTS_VALUE ? ctx->anchor_pts : last->subtitle_pts;
+        int drop_first;
+
+        if (first->subtitle_pts < anchor - window)
+            drop_first = 1;
+        else if (last->subtitle_pts > anchor + window)
+            drop_first = 0;
+        else if ((int64_t)s->bytes > ctx->history_max_bytes)
+            drop_first = anchor - first->subtitle_pts >= last->subtitle_pts - anchor;
+        else
+            break;
+
+        if (drop_first) {
+            s->bytes -= first->bytes;
+            aribcc_caption_cleanup(&s->events[0].caption);
+            memmove(&s->events[0], &s->events[1], (s->count - 1) * sizeof(s->events[0]));
+        } else {
+            hi_limit = FFMIN(hi_limit, last->subtitle_pts - 1);
+            s->bytes -= last->bytes;
+            aribcc_caption_cleanup(&s->events[s->count - 1].caption);
+        }
+        s->count--;
+        evicted++;
+    }
+    if (!evicted)
+        return;
+    if (!s->count) {
+        s->nb_spans = 0;
+        ctx->span_open = 0;
+    } else {
+        aribcaption_spans_clip(ctx, s->events[0].subtitle_pts, hi_limit);
+    }
+    av_log(ctx, AV_LOG_VERBOSE, "ARIB caption history: evicted %d events, %d kept (%zu bytes)\n",
+           evicted, s->count, s->bytes);
+}
