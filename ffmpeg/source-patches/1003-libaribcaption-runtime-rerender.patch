+/* Histories of closed decoders, keyed by media identity, so a reopen of the same file (the decoder is new)
+ * continues from them. A different key never sees them. */
+static AVMutex parked_mutex = AV_MUTEX_INITIALIZER;
+static struct {
+    char *key;
+    uint32_t sig;
+    int64_t stamp;
+    ARIBCaptionStore store;
+} parked[ARIBC_PARKED_MAX];
+static int64_t parked_stamp;
+
+static void aribcaption_adopt_history(ARIBCaptionContext *ctx)
+{
+    if (!ctx->history_key || !*ctx->history_key)
+        return;
+    ff_mutex_lock(&parked_mutex);
+    for (int i = 0; i < ARIBC_PARKED_MAX; i++) {
+        if (!parked[i].key || strcmp(parked[i].key, ctx->history_key))
+            continue;
+        if (parked[i].sig == ctx->history_sig) {
+            ctx->store = parked[i].store;
+            parked[i].store = (ARIBCaptionStore){ 0 };
+            av_log(ctx, AV_LOG_VERBOSE, "ARIB caption history: adopted %d events (%zu bytes)\n",
+                   ctx->store.count, ctx->store.bytes);
+        } else {
+            aribcaption_store_free(&parked[i].store);
+        }
+        av_freep(&parked[i].key);
+        break;
+    }
+    ff_mutex_unlock(&parked_mutex);
+    if (ctx->store.count)
+        ctx->anchor_pts = ctx->store.events[ctx->store.count - 1].subtitle_pts;
+    aribcaption_publish_stats(ctx);
+}
+
+static void aribcaption_park_history(ARIBCaptionContext *ctx)
+{
+    int slot = -1;
+
+    aribcaption_span_close(ctx);
+    if (!ctx->history_key || !*ctx->history_key || !ctx->store.count) {
+        aribcaption_store_free(&ctx->store);
+        return;
+    }
+    ff_mutex_lock(&parked_mutex);
+    for (int i = 0; i < ARIBC_PARKED_MAX; i++) {
+        if (parked[i].key && !strcmp(parked[i].key, ctx->history_key)) {
+            slot = i;
+            break;
+        }
+    }
+    for (int i = 0; slot < 0 && i < ARIBC_PARKED_MAX; i++)
+        if (!parked[i].key)
+            slot = i;
+    if (slot < 0) {
+        slot = 0;
+        for (int i = 1; i < ARIBC_PARKED_MAX; i++)
+            if (parked[i].stamp < parked[slot].stamp)
+                slot = i;
+    }
+    aribcaption_store_free(&parked[slot].store);
+    av_freep(&parked[slot].key);
+    parked[slot].key = av_strdup(ctx->history_key);
+    if (parked[slot].key) {
+        parked[slot].sig = ctx->history_sig;
+        parked[slot].stamp = ++parked_stamp;
+        parked[slot].store = ctx->store;
+        ctx->store = (ARIBCaptionStore){ 0 };
+    }
+    ff_mutex_unlock(&parked_mutex);
+    aribcaption_store_free(&ctx->store);
+}
