+static int aribcaption_rerender(ARIBCaptionContext *ctx, AVSubtitle *sub,
+                                int *got_sub_ptr, const AVPacket *avpkt)
+{
+    int ret, frame_changed, idx = -1;
+    int canvas_changed = ctx->canvas_width != ctx->applied_canvas_width ||
+                         ctx->canvas_height != ctx->applied_canvas_height;
+    int at_time = !!(avpkt->flags & AV_PKT_FLAG_ARIB_ACTIVE_AT);
+    const ARIBCaptionStore *s = &ctx->store;
+    int64_t target = AV_NOPTS_VALUE;
+    ARIBCaptionHistory *h;
+
+    if (!ctx->renderer)
+        return 0;
+
+    if (avpkt->pts != AV_NOPTS_VALUE)
+        target = av_rescale_q(avpkt->pts, ctx->time_base, AV_TIME_BASE_Q);
+
+    if (at_time) {
+        /* The caption on screen at target, from the history: the latest event at or before it (1 ms
+         * tolerance, as the cue queue). Only inside a range whose events were all decoded; a clear event,
+         * or a finished duration, leaves nothing. */
+        if (target != AV_NOPTS_VALUE && aribcaption_span_covers(ctx, target)) {
+            int upper = aribcaption_store_upper(s, target + 1000);
+            const ARIBCaptionHistory *e = upper > 0 ? &s->events[upper - 1] : NULL;
+
+            if (e && !e->clear &&
+                (e->end_display_time == UINT32_MAX ||
+                 target < e->subtitle_pts + (int64_t)e->end_display_time * 1000))
+                idx = upper - 1;
+        }
+        if (idx < 0 && !canvas_changed)
+            return 0;
+    } else if (target != AV_NOPTS_VALUE) {
+        for (int i = aribcaption_store_upper(s, target) - 1;
+             i >= 0 && s->events[i].subtitle_pts == target; i--) {
+            if (!s->events[i].clear) {
+                idx = i;
+                break;
+            }
+        }
+    } else {
+        for (int i = s->count - 1; i >= 0; i--) {
+            if (!s->events[i].clear) {
+                idx = i;
+                break;
+            }
+        }
+    }
+
+    if (!canvas_changed && !at_time &&
+        (avpkt->pts == AV_NOPTS_VALUE || idx < 0 ||
+         s->events[idx].subtitle_pts == ctx->rendered_subtitle_pts))
+        return 0;
+
+    ctx->sub = sub;
+    ctx->avpkt = avpkt;
+    if (idx >= 0 && s->events[idx].caption.plane_width > 0 &&
+        s->events[idx].caption.plane_height > 0) {
+        ctx->plane_width = s->events[idx].caption.plane_width;
+        ctx->plane_height = s->events[idx].caption.plane_height;
+    }
+    ret = aribcaption_update_frame_size(ctx, canvas_changed, &frame_changed);
+    if (ret < 0)
+        return ret;
+    if (frame_changed)
+        ff_dlog(ctx, "canvas resized; re-rendering active bitmap caption\n");
+    if (idx < 0)
+        return 0;
+
+    h = &ctx->store.events[idx];
+    /* The renderer copies the caption; the history keeps ownership. Appending
+     * an older pts re-inserts it and invalidates the renderer's image cache. */
+    if (!aribcc_renderer_append_caption(ctx->renderer, &h->caption)) {
+        av_log(ctx, AV_LOG_ERROR,
+               "aribcc_renderer_append_caption() returned with error.\n");
+        return AVERROR_EXTERNAL;
+    }
+    ctx->pts = h->render_pts;
+    ret = aribcaption_trans_bitmap_subtitle(ctx, &h->caption, 0);
+    if (ret < 0)
+        return ret;
+    ctx->rendered_subtitle_pts = h->subtitle_pts;
+    if (ret > 0) {
+        *got_sub_ptr = 1;
+        sub->pts = h->subtitle_pts;
+        sub->start_display_time = h->start_display_time;
+        sub->end_display_time = h->end_display_time;
+        for (int i = 0; i < sub->num_rects; i++)
+            sub->rects[i]->flags |= AV_SUBTITLE_FLAG_RERENDER;
+        ff_dlog(ctx, "rerendered bitmap caption at pts=%"PRId64"\n",
+                h->render_pts);
+    }
+    return 0;
+}
