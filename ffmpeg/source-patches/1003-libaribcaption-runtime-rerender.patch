+static size_t aribcaption_caption_bytes(const aribcc_caption_t *c)
+{
+    size_t bytes = sizeof(*c);
+    uint32_t seen[8];
+    int nb_seen = 0;
+
+    if (c->text)
+        bytes += strlen(c->text) + 1;
+    bytes += (size_t)c->region_count * sizeof(*c->regions);
+    for (uint32_t i = 0; i < c->region_count; i++) {
+        const aribcc_caption_region_t *region = &c->regions[i];
+
+        bytes += (size_t)region->char_count * sizeof(*region->chars);
+        for (uint32_t j = 0; c->drcs_map && j < region->char_count; j++) {
+            const aribcc_caption_char_t *ch = &region->chars[j];
+            aribcc_drcs_t *drcs;
+            uint8_t *pixels = NULL;
+            size_t size = 0;
+            int dup = 0;
+
+            if (ch->type == ARIBCC_CHARTYPE_TEXT)
+                continue;
+            for (int k = 0; k < nb_seen; k++)
+                dup |= seen[k] == ch->drcs_code;
+            if (dup)
+                continue;
+            if (nb_seen < FF_ARRAY_ELEMS(seen))
+                seen[nb_seen++] = ch->drcs_code;
+            drcs = aribcc_drcsmap_get(c->drcs_map, ch->drcs_code);
+            if (!drcs)
+                continue;
+            aribcc_drcs_get_pixels(drcs, &pixels, &size);
+            bytes += size + 64;
+        }
+    }
+    return bytes;
+}
