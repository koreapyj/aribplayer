+static void aribcaption_store_free(ARIBCaptionStore *s)
+{
+    for (int i = 0; i < s->count; i++)
+        aribcc_caption_cleanup(&s->events[i].caption);
+    av_freep(&s->events);
+    *s = (ARIBCaptionStore){ 0 };
+}
+
+static void aribcaption_publish_stats(ARIBCaptionContext *ctx)
+{
+    ctx->history_bytes = ctx->store.bytes;
+    ctx->history_count = ctx->store.count;
+}
+
+/* Number of events with subtitle_pts <= pts. */
+static int aribcaption_store_upper(const ARIBCaptionStore *s, int64_t pts)
+{
+    int lo = 0, hi = s->count;
+
+    while (lo < hi) {
+        int mid = lo + (hi - lo) / 2;
+
+        if (s->events[mid].subtitle_pts <= pts)
+            lo = mid + 1;
+        else
+            hi = mid;
+    }
+    return lo;
+}
+
+static void aribcaption_spans_merge(ARIBCaptionStore *s)
+{
+    int n = 0;
+
+    for (int i = 0; i < s->nb_spans; i++) {
+        if (n && s->spans[i].lo <= s->spans[n - 1].hi) {
+            s->spans[n - 1].hi = FFMAX(s->spans[n - 1].hi, s->spans[i].hi);
+        } else {
+            s->spans[n++] = s->spans[i];
+        }
+    }
+    s->nb_spans = n;
+}
+
+static void aribcaption_span_close(ARIBCaptionContext *ctx)
+{
+    ARIBCaptionStore *s = &ctx->store;
+    int i;
+
+    if (!ctx->span_open)
+        return;
+    ctx->span_open = 0;
+    if (s->nb_spans == ARIBC_SPANS_MAX) {
+        memmove(&s->spans[0], &s->spans[1], (ARIBC_SPANS_MAX - 1) * sizeof(s->spans[0]));
+        s->nb_spans--;
+    }
+    for (i = s->nb_spans; i > 0 && s->spans[i - 1].lo > ctx->span.lo; i--)
+        s->spans[i] = s->spans[i - 1];
+    s->spans[i] = ctx->span;
+    s->nb_spans++;
+    aribcaption_spans_merge(s);
+}
+
+/* A packet (event or not) was decoded at pts. Everything between the first event after a discontinuity
+ * and the newest packet has been seen in order, so the caption state in that range is known. */
+static void aribcaption_span_note(ARIBCaptionContext *ctx, int64_t pts, int is_event)
+{
+    ARIBCaptionStore *s = &ctx->store;
+
+    if (pts == AV_NOPTS_VALUE)
+        return;
+    if (!ctx->span_open) {
+        for (int i = 0; i < s->nb_spans; i++) {
+            if (s->spans[i].lo <= pts && pts <= s->spans[i].hi) {
+                ctx->span = s->spans[i];
+                memmove(&s->spans[i], &s->spans[i + 1], (s->nb_spans - i - 1) * sizeof(s->spans[0]));
+                s->nb_spans--;
+                ctx->span_open = 1;
+                break;
+            }
+        }
+        if (!ctx->span_open && is_event) {
+            ctx->span.lo = ctx->span.hi = pts;
+            ctx->span_open = 1;
+        }
+        if (!ctx->span_open)
+            return;
+    } else if (pts > ctx->span.hi) {
+        ctx->span.hi = pts;
+    }
+    for (int i = 0; i < s->nb_spans;) {
+        if (s->spans[i].lo <= ctx->span.hi && s->spans[i].hi >= ctx->span.lo) {
+            ctx->span.lo = FFMIN(ctx->span.lo, s->spans[i].lo);
+            ctx->span.hi = FFMAX(ctx->span.hi, s->spans[i].hi);
+            memmove(&s->spans[i], &s->spans[i + 1], (s->nb_spans - i - 1) * sizeof(s->spans[0]));
+            s->nb_spans--;
+        } else {
+            i++;
+        }
+    }
+}
+
+static int aribcaption_span_covers(const ARIBCaptionContext *ctx, int64_t pts)
+{
+    if (ctx->span_open && ctx->span.lo <= pts && pts <= ctx->span.hi)
+        return 1;
+    for (int i = 0; i < ctx->store.nb_spans; i++)
+        if (ctx->store.spans[i].lo <= pts && pts <= ctx->store.spans[i].hi)
+            return 1;
+    return 0;
+}
+
+/* Clip the known ranges to the events that are still kept: [lo, hi] (hi = INT64_MAX: no limit). */
+static void aribcaption_spans_clip(ARIBCaptionContext *ctx, int64_t lo, int64_t hi)
+{
+    ARIBCaptionStore *s = &ctx->store;
+    int n = 0;
+
+    for (int i = 0; i < s->nb_spans; i++) {
+        ARIBCaptionSpan span = s->spans[i];
+
+        span.lo = FFMAX(span.lo, lo);
+        span.hi = FFMIN(span.hi, hi);
+        if (span.lo <= span.hi)
+            s->spans[n++] = span;
+    }
+    s->nb_spans = n;
+    if (ctx->span_open) {
+        ctx->span.lo = FFMAX(ctx->span.lo, lo);
+        ctx->span.hi = FFMIN(ctx->span.hi, hi);
+        if (ctx->span.lo > ctx->span.hi)
+            ctx->span_open = 0;
+    }
+}
