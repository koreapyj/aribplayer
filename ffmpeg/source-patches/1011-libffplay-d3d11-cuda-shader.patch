+static int ffp_shader_route(const FFPD3D11Limits *l, const FFPPresParams *pp)
+{
+    int levels[3];
+    if ((pp->rotation && !l->rotate) || ((pp->flip_h || pp->flip_v) && !l->mirror)) return 1;
+    if (!pp->eq_on) return 0;
+    if (pp->gamma != 1.0) return 1;
+    return ffp_pp_levels(l, pp, levels) < 0;
+}
+
+static int ffp_shader_avail(const FFPD3D11 *p)
+{
+    return !(p->cfg.force & FFP_FORCE_SHADER) && !p->shader_failed;
+}
+
+static int ffp_input_p010(const FFPInput *in)
+{
+    D3D11_TEXTURE2D_DESC td;
+
+    in->tex->lpVtbl->GetDesc(in->tex, &td);
+    return td.Format == DXGI_FORMAT_P010;
+}
+
+enum { FFP_ROUTE_PICK_VP = 0, FFP_ROUTE_PICK_SHADER = 1, FFP_ROUTE_PICK_DOWNLOAD = 2 };
+
+/* The route of a picture: the VideoProcessor, the pixel shader, or (P010 that the video processor cannot take, with no
+ * shader) a download that is uploaded as BGRA. display: the picture is presented (the d3d11_route option applies and
+ * is recorded); a snapshot only needs a route that works. -1 with err: no route can do the presenter parameters. */
+static int ffp_pick_route(FFPD3D11 *p, const FFPInput *in, const FFPPresParams *pp, int display, char *err, size_t err_size)
+{
+    int params = ffp_shader_route(&p->lim, pp);
+    int p010 = !p->lim.p010 && ffp_input_p010(in);
+    int avail = ffp_shader_avail(p);
+    int route;
+
+    if (params && !avail) {
+        snprintf(err, err_size, "the presenter parameters need the pixel shader route, which is unavailable");
+        return -1;
+    }
+    route = params || (p010 && avail) ? FFP_ROUTE_PICK_SHADER : p010 ? FFP_ROUTE_PICK_DOWNLOAD : FFP_ROUTE_PICK_VP;
+    if (display && p->cfg.route) {
+        int vp = p->cfg.route == FFP_ROUTE_VP;
+        int possible = vp ? !params && !p010 : avail;
+        char name[48];
+
+        snprintf(name, sizeof(name), "route_forced%s:%s", possible ? "" : "_unavailable", vp ? "vp" : "shader");
+        ffp_d3d11_record_fallback(p, name);
+        if (possible)
+            route = vp ? FFP_ROUTE_PICK_VP : FFP_ROUTE_PICK_SHADER;
+    }
+    return route;
+}
+
+static int ffp_upload(FFPD3D11 *p, const AVFrame *f, FFPInput *in, char *err, size_t err_size);
+
+/* A D3D11 frame that the video processor / shader cannot take as is (another pixel format: Intel HEVC 4:2:2 / 4:4:4
+ * decode, P010 without video processor P010 and without the shader route; another device): downloaded, then it
+ * takes the path of a system frame (swscale to NV12 / P010 / BGRA, upload). */
+static int ffp_download_input(FFPD3D11 *p, const AVFrame *f, FFPInput *in, char *err, size_t err_size)
+{
+    int ret;
+
+    if (!p->dl && !(p->dl = av_frame_alloc())) {
+        ffp_set_err(err, err_size, "out of memory", S_OK);
+        return -1;
+    }
+    av_frame_unref(p->dl);
+    ret = av_hwframe_transfer_data(p->dl, f, 0);
+    if (ret >= 0)
+        ret = av_frame_copy_props(p->dl, f);
+    if (ret < 0) {
+        snprintf(err, err_size, "download of a D3D11 frame failed (%s)", av_err2str(ret));
+        return -1;
+    }
+    return ffp_upload(p, p->dl, in, err, err_size);
+}
