+        FAILED(dxdev->lpVtbl->GetAdapter(dxdev, &adapter)))
+        goto done;
+    r = ffp_cuda_registry_create(dev, adapter, &ordinal);
+    if (!r) goto done;
+    snprintf(index, sizeof(index), "%d", (int)ordinal);
+    if (av_hwdevice_ctx_create(&cuda, AV_HWDEVICE_TYPE_CUDA, index, NULL, 0) < 0)
+        goto done;
+    r->context = ((AVCUDADeviceContext *)((AVHWDeviceContext *)cuda->data)->hwctx)->cuda_ctx;
+    write_cuda = (CopyHostToDevice)(void *)GetProcAddress(r->dll, "cuMemcpyHtoD_v2");
+    if (!write_cuda) goto done;
+    shader = ffp_cuda_shader_create(dev, err, sizeof(err));
+    if (!shader) goto done;
+    buf = ffp_cuda_pool_alloc(r, NULL, sizeof(yuv));
+    if (!buf) goto done;
+    entry = ffp_cuda_lookup(r, &(AVFrame){ .buf = { buf }, .data = { buf->data } });
+    if (!entry) goto done;
