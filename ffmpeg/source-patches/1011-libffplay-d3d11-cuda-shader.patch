+/* Creates the CUDA context on the presenter's adapter (with the zero-copy pool hook) once, for the first open that uses
+ * CUDA; it then lives as long as the presenter. Interop is optional: absence of CUDA must not disable D3D11VA/system.
+ * Returns 1 when a CUDA device is available. Called on the player thread before the open's decoder / filters. */
+int ffp_d3d11_ensure_cuda(FFPD3D11 *p)
+{
+    IDXGIDevice *dxdev = NULL;
+    IDXGIAdapter *ad = NULL;
+    if (!p)
+        return 0;
+    EnterCriticalSection(&p->cs);
+    if (!p->cuda_tried) {
+        p->cuda_tried = 1;
+        /* d3d11_force_caps cuda_import=0: as if the interop could not be set up */
+        if (!(p->cfg.force & FFP_FORCE_CUDA_IMPORT) &&
+            SUCCEEDED(p->dev->lpVtbl->QueryInterface(p->dev, &ffp_IID_IDXGIDevice, (void **)&dxdev)) &&
+            SUCCEEDED(dxdev->lpVtbl->GetAdapter(dxdev, &ad))) {
+            CUdevice ordinal = -1;
+            p->cuda_reg = ffp_cuda_registry_create(p->dev, ad, &ordinal);
+            if (p->cuda_reg) {
+                char index[32];
+                snprintf(index, sizeof(index), "%d", (int)ordinal);
+                if (av_hwdevice_ctx_create(&p->cuda_dev, AV_HWDEVICE_TYPE_CUDA, index, NULL, 0) >= 0) {
+                    AVHWDeviceContext *dc = (AVHWDeviceContext *)p->cuda_dev->data;
+                    AVCUDADeviceContext *ch = dc->hwctx;
+                    p->cuda_reg->context = ch->cuda_ctx;
+                    ch->pool_alloc = p->cuda_copy_only ? NULL : ffp_cuda_pool_alloc;
+                    ch->pool_alloc_opaque = p->cuda_reg;
+                    ch->pool_recycle = p->cuda_copy_only ? NULL : ffp_cuda_pool_recycle;
+                    dc->user_opaque = p->cuda_reg;
+                    dc->free = ffp_cuda_device_free;
+                    InterlockedIncrement(&p->cuda_reg->refs); /* CUDA device owns registry until pool teardown */
+                } else {
+                    ffp_cuda_registry_unref(p->cuda_reg);
+                    p->cuda_reg = NULL;
+                }
+            }
+        }
+        FFP_REL(ad);
+        FFP_REL(dxdev);
+    }
+    LeaveCriticalSection(&p->cs);
+    return p->cuda_dev != NULL;
+}
