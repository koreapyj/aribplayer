+    unsigned input[4];   /* storage w,h, pitch in bytes, UV offset in bytes */
+    unsigned crop[4];    /* x,y,w,h */
+    unsigned flags[4];   /* raw, p010, eq_on, rotation/90 */
+    unsigned transform[4]; /* flip_h, flip_v, y_fast, uv_fast */
+    int fast[4];         /* Y coefficient, Y offset, UV coefficient, UV offset */
+    float eq[4];         /* contrast, brightness, saturation, gamma */
+    float color[4];      /* Kr, Kb, full-range, reserved */
+    float dest[4];       /* x,y,width,height */
+} FFPCudaShaderCB;
+
+static const char cs_vs_source[] =
+    "float4 main(uint id : SV_VertexID) : SV_Position {\n"
+    "  float2 p = float2((id << 1) & 2, id & 2);\n"
+    "  return float4(p * float2(2,-2) + float2(-1,1), 0, 1);\n"
+    "}\n";
+
+static const char cs_ps_source[] =
+    "ByteAddressBuffer rawData : register(t0);\n"
+    "Texture2D<float> texY : register(t1);\n"
+    "Texture2D<float2> texUV : register(t2);\n"
+    "Texture2DArray<float> arrayY : register(t4);\n"
+    "Texture2DArray<float2> arrayUV : register(t5);\n"
+    "Texture2DArray<float4> texRGB : register(t6);\n"
+    "SamplerState linearClamp : register(s0);\n"
+    "cbuffer Parameters : register(b0) {\n"
+    " uint4 input; uint4 crop; uint4 flags; uint4 transform;\n"
+    " int4 fast; float4 eq; float4 color; float4 dest;\n"
+    "};\n"
+    "uint bytesAt(uint offset, uint count) {\n"
+    " uint size; rawData.GetDimensions(size);\n"
+    " if (offset > size || count > size - offset) return 0;\n"
+    " uint a = rawData.Load(offset & ~3u);\n"
+    " if (count == 1) return (a >> ((offset & 3u)*8u)) & 255u;\n"
+    " return (a >> ((offset & 3u)*8u)) & 65535u;\n"
+    "}\n"
+    "float2 fetchUV(int2 p) {\n"
+    " int2 limit = int2((input.xy + 1u) / 2u) - 1;\n"
+    " p = clamp(p, int2(0,0), limit);\n"
+    " if (flags.x == 0u) return texUV.Load(int3(p,0));\n"
+    " if (flags.x == 2u) return arrayUV.Load(int4(p,transform.w,0));\n"
+    " uint bpp = flags.y != 0u ? 4u : 2u;\n"
+    " uint off = input.w + uint(p.y)*input.z + uint(p.x)*bpp;\n"
+    " float denom = flags.y != 0u ? 65535.0 : 255.0;\n"
+    " return float2(bytesAt(off, bpp/2u), bytesAt(off+bpp/2u, bpp/2u))/denom;\n"
+    "}\n"
+    "float fetchY(int2 p) {\n"
+    " p = clamp(p, int2(0,0), int2(input.xy)-1);\n"
+    " if (flags.x == 0u) return texY.Load(int3(p,0));\n"
+    " if (flags.x == 2u) return arrayY.Load(int4(p,transform.w,0));\n"
+    " uint bpp = flags.y != 0u ? 2u : 1u;\n"
+    " uint off = uint(p.y)*input.z + uint(p.x)*bpp;\n"
+    " return bytesAt(off,bpp)/(flags.y != 0u ? 65535.0 : 255.0);\n"
+    "}\n"
+    "float sampleY(float2 s) {\n"
+    " float2 q = clamp(s - 0.5, float2(crop.xy), float2(crop.xy+crop.zw)-1.0);\n"
+    " int2 p = int2(floor(q)); float2 f = frac(q);\n"
+    " int2 hi = int2(crop.xy+crop.zw)-1;\n"
+    " float a=fetchY(p), b=fetchY(min(p+int2(1,0),hi));\n"
+    " float c=fetchY(min(p+int2(0,1),hi)), d=fetchY(min(p+int2(1,1),hi));\n"
+    " return lerp(lerp(a,b,f.x),lerp(c,d,f.x),f.y);\n"
+    "}\n"
+    "float2 sampleUV(float2 s) {\n"
+    " int2 lo = int2(crop.xy/2u);\n"
+    " int2 hi = int2((crop.xy+crop.zw-1u)/2u);\n"
+    " float2 q = clamp(s*0.5-0.5, float2(lo), float2(hi));\n"
+    " int2 p=int2(floor(q)); float2 f=frac(q);\n"
+    " float2 a=fetchUV(p), b=fetchUV(min(p+int2(1,0),hi));\n"
+    " float2 c=fetchUV(min(p+int2(0,1),hi)), d=fetchUV(min(p+int2(1,1),hi));\n"
+    " return lerp(lerp(a,b,f.x),lerp(c,d,f.x),f.y);\n"
+    "}\n"
+    "float fastEq(float v, int coef, int off) {\n"
+    " int code = clamp((int)floor(v*255.0+0.5),0,255);\n"
+    " return clamp(((code*coef)>>12)+off,0,255)/255.0;\n"
+    "}\n"
+    "float lutEq(float v) {\n"
+    " float code = floor(v*255.0+0.5)/255.0;\n"
+    " float t = eq.x*(code-0.5)+0.5+eq.y;\n"
+    " if (t <= 0.0) return 0.0;\n"
+    " t = pow(t,1.0/eq.w);\n"
+    " return min(255.0,floor(256.0*t))/255.0;\n"
+    "}\n"
+    "float4 main(float4 pos : SV_Position) : SV_Target {\n"
+    " float2 uv=(pos.xy-dest.xy)/dest.zw;\n"
+    " if (any(uv < 0.0) || any(uv >= 1.0)) return float4(0,0,0,1);\n"
+    " if (transform.x != 0u) uv.x=1.0-uv.x;\n"
+    " if (transform.y != 0u) uv.y=1.0-uv.y;\n"
+    " if (flags.w == 1u) uv=float2(uv.y,1.0-uv.x);\n"
+    " else if (flags.w == 2u) uv=1.0-uv;\n"
+    " else if (flags.w == 3u) uv=float2(1.0-uv.y,uv.x);\n"
+    " float2 s=float2(crop.xy)+uv*float2(crop.zw);\n"
+    " float y; float2 chroma;\n"
+    " if (flags.x == 3u) {\n"
+    "  float3 rgb=texRGB.SampleLevel(linearClamp,float3(s/input.xy,0),0).rgb;\n"
+    "  float kr=color.x,kb=color.y,kg=1.0-kr-kb;\n"
+    "  float lum=dot(rgb,float3(kr,kg,kb));\n"
+    "  y=(lum*219.0+16.0)/255.0;\n"
+    "  chroma=float2((rgb.b-lum)/(2.0*(1.0-kb)),(rgb.r-lum)/(2.0*(1.0-kr)))*224.0/255.0+0.5;\n"
+    " } else { y=sampleY(s); chroma=sampleUV(s); }\n"
+    " if (flags.z != 0u) {\n"
+    "  if (transform.z != 0u) y=fastEq(y,fast.x,fast.y);\n"
+    "  else if (eq.x != 1.0 || eq.y != 0.0 || eq.w != 1.0) y=lutEq(y);\n"
+    "  if (eq.z != 1.0) {\n"
+    "    chroma.x=fastEq(chroma.x,fast.z,fast.w);\n"
+    "    chroma.y=fastEq(chroma.y,fast.z,fast.w);\n"
+    "  }\n"
+    " }\n"
+    " float scale = color.z != 0.0 ? 1.0 : 255.0/219.0;\n"
+    " float y0=(y-(color.z != 0.0 ? 0.0 : 16.0/255.0))*scale;\n"
+    " float2 c=(chroma-0.5)*(color.z != 0.0 ? 1.0 : 255.0/224.0);\n"
+    " float kr=color.x, kb=color.y, kg=1.0-kr-kb;\n"
+    " float r=y0+2.0*(1.0-kr)*c.y;\n"
+    " float b=y0+2.0*(1.0-kb)*c.x;\n"
+    " float g=(y0-kr*r-kb*b)/kg;\n"
+    " return float4(saturate(r),saturate(g),saturate(b),1.0);\n"
+    "}\n";
+
+static void cs_error(char *err, size_t n, const char *what, HRESULT hr)
+{
+    if (err && n)
+        snprintf(err, n, "%s (0x%08lx)", what, (unsigned long)hr);
+}
+
+static void ffp_cuda_shader_free(FFPCudaShader *s)
+{
+    if (!s) return;
+    CS_REL(s->sampler);
+    CS_REL(s->raster);
+    CS_REL(s->constants);
+    CS_REL(s->ps);
+    CS_REL(s->vs);
+    CS_REL(s->device);
+    HeapFree(GetProcessHeap(), 0, s);
+}
+
+typedef HRESULT (WINAPI *CSCompileFn)(LPCVOID, SIZE_T, LPCSTR,
+                                      const D3D_SHADER_MACRO *, ID3DInclude *,
+                                      LPCSTR, LPCSTR, UINT, UINT, ID3DBlob **, ID3DBlob **);
+static HRESULT cs_compile(CSCompileFn fn, const char *source, const char *profile,
+                          ID3DBlob **blob, char *err, size_t n)
+{
+    ID3DBlob *messages = NULL;
+    HRESULT hr = fn(source, strlen(source), "ffp_cuda_shader", NULL, NULL,
+                    "main", profile, D3DCOMPILE_ENABLE_STRICTNESS, 0, blob, &messages);
+    if (FAILED(hr) && err && n) {
+        if (messages)
+            snprintf(err, n, "D3DCompile %s: %.*s", profile,
+                     (int)(messages->lpVtbl->GetBufferSize(messages) < 500 ?
+                           messages->lpVtbl->GetBufferSize(messages) : 500),
+                     (const char *)messages->lpVtbl->GetBufferPointer(messages));
+        else cs_error(err, n, "D3DCompile", hr);
+    }
+    CS_REL(messages);
+    return hr;
+}
+
+/* Caller owns returned handle; no import library dependency on d3dcompiler.
+ * Not thread-safe against concurrent use of the same immediate context. */
+static FFPCudaShader *ffp_cuda_shader_create(ID3D11Device *dev, char *err, size_t n)
+{
+    static const WCHAR *dlls[] = { L"d3dcompiler_47.dll", L"d3dcompiler_43.dll" };
+    HMODULE module = NULL;
+    CSCompileFn compile = NULL;
+    ID3DBlob *vsb = NULL, *psb = NULL;
+    D3D11_BUFFER_DESC bd;
+    D3D11_RASTERIZER_DESC rd;
+    D3D11_SAMPLER_DESC sm;
+    FFPCudaShader *s = NULL;
+    HRESULT hr;
+    unsigned i;
+
+    if (!dev) { cs_error(err, n, "null D3D11 device", E_INVALIDARG); return NULL; }
+    for (i = 0; i < sizeof(dlls)/sizeof(dlls[0]); ++i) {
+        module = LoadLibraryW(dlls[i]);
+        if (module) {
+            compile = (CSCompileFn)(void *)GetProcAddress(module, "D3DCompile");
+            if (compile) break;
+            FreeLibrary(module);
+            module = NULL;
+        }
+    }
+    if (!compile) { cs_error(err, n, "D3DCompile unavailable", E_FAIL); return NULL; }
+    s = (FFPCudaShader *)HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*s));
+    if (!s) { cs_error(err,n,"out of memory",E_OUTOFMEMORY); goto fail; }
+    s->device = dev;
+    dev->lpVtbl->AddRef(dev);
+    if (FAILED(cs_compile(compile, cs_vs_source, "vs_5_0", &vsb, err, n)) ||
+        FAILED(cs_compile(compile, cs_ps_source, "ps_5_0", &psb, err, n))) goto fail;
+    hr = dev->lpVtbl->CreateVertexShader(dev, vsb->lpVtbl->GetBufferPointer(vsb),
+                                          vsb->lpVtbl->GetBufferSize(vsb), NULL, &s->vs);
+    if (FAILED(hr)) { cs_error(err,n,"CreateVertexShader",hr); goto fail; }
+    hr = dev->lpVtbl->CreatePixelShader(dev, psb->lpVtbl->GetBufferPointer(psb),
+                                         psb->lpVtbl->GetBufferSize(psb), NULL, &s->ps);
+    if (FAILED(hr)) { cs_error(err,n,"CreatePixelShader",hr); goto fail; }
+    memset(&bd, 0, sizeof(bd));
+    bd.ByteWidth = sizeof(FFPCudaShaderCB);
+    bd.Usage = D3D11_USAGE_DEFAULT;
+    bd.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+    hr = dev->lpVtbl->CreateBuffer(dev, &bd, NULL, &s->constants);
+    if (FAILED(hr)) { cs_error(err,n,"CreateBuffer(constants)",hr); goto fail; }
+    memset(&rd, 0, sizeof(rd));
+    rd.FillMode = D3D11_FILL_SOLID;
+    rd.CullMode = D3D11_CULL_NONE;
+    rd.DepthClipEnable = TRUE;
+    hr = dev->lpVtbl->CreateRasterizerState(dev, &rd, &s->raster);
+    if (FAILED(hr)) { cs_error(err,n,"CreateRasterizerState",hr); goto fail; }
+    memset(&sm, 0, sizeof(sm));
+    sm.Filter = D3D11_FILTER_MIN_MAG_MIP_LINEAR;
+    sm.AddressU = sm.AddressV = sm.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+    sm.MaxLOD = D3D11_FLOAT32_MAX;
+    hr = dev->lpVtbl->CreateSamplerState(dev, &sm, &s->sampler);
+    if (FAILED(hr)) { cs_error(err,n,"CreateSamplerState",hr); goto fail; }
+    CS_REL(vsb); CS_REL(psb); FreeLibrary(module);
+    return s;
+fail:
+    CS_REL(vsb); CS_REL(psb);
+    if (module) FreeLibrary(module);
+    ffp_cuda_shader_free(s);
+    return NULL;
+}
+
+/* FFmpeg vf_eq.c calls process_c for gamma==1 && abs(contrast)<7.9;
+ * identity planes bypass it. C integer division truncates toward zero. */
+static void cs_fast(double contrast, double brightness, int *coef, int *offset)
+{
+    *coef = (int)(contrast * 4096.0);
+    *offset = ((int)(100.0 * brightness + 100.0) * 511) / 200 -
+              128 - *coef / 32;
+}
+
+/* Check physical plane size too: a matching view format does not prove that
+ * an SRV has enough texels, and Texture2D.Load outside its range returns zero. */
+static int cs_plane_extent(ID3D11ShaderResourceView *srv, unsigned width, unsigned height)
+{
+    static const GUID iid_texture2d = { 0x6f15aaf2, 0xd208, 0x4e89,
+                                         { 0x9a,0xb4,0x48,0x95,0x35,0xd3,0x4f,0x9c } };
+    ID3D11Resource *resource = NULL;
+    ID3D11Texture2D *texture = NULL;
+    D3D11_TEXTURE2D_DESC desc;
+    int ok = 0;
+    srv->lpVtbl->GetResource(srv, &resource);
+    if (resource && SUCCEEDED(resource->lpVtbl->QueryInterface(resource,
+                               &iid_texture2d, (void **)&texture))) {
+        texture->lpVtbl->GetDesc(texture, &desc);
+        ok = desc.Width >= width && desc.Height >= height &&
+             desc.SampleDesc.Count == 1;
+    }
+    CS_REL(texture);
+    CS_REL(resource);
+    return ok;
+}
+
+static void cs_letterbox(RECT *dst, unsigned tw, unsigned th, unsigned w, unsigned h,
+                         const AVFrame *frame, int rot)
+{
+    double ar = (double)w / h;
+    double dw, dh;
+    int sar_num = frame->sample_aspect_ratio.num;
+    int sar_den = frame->sample_aspect_ratio.den;
+    if (sar_num > 0 && sar_den > 0)
+        ar *= (rot == 90 || rot == 270) ?
+              (double)sar_den / sar_num : (double)sar_num / sar_den;
+    dw = (double)th * ar;
+    dh = th;
+    if (dw > tw) { dw = tw; dh = dw / ar; }
+    /* ffplay presenter rounds to even pixel extents before centering. */
+    dst->right = (LONG)fmax(1.0, floor(dw + 0.5) - (double)((unsigned)floor(dw + 0.5) & 1u));
+    dst->bottom = (LONG)fmax(1.0, floor(dh + 0.5) - (double)((unsigned)floor(dh + 0.5) & 1u));
+    dst->left = ((LONG)tw - dst->right) / 2;
+    dst->top = ((LONG)th - dst->bottom) / 2;
+    dst->right += dst->left;
+    dst->bottom += dst->top;
+}
+
+/* 0 on success, -1 with err filled. RTV must be BGRA8 UNORM, single sample,
+ * same device, and cover geometry.target_width x target_height. The caller
+ * serializes all use of ctx (and any FFmpeg hwctx lock) and owns presentation.
+ * This function intentionally changes IA/VS/PS/RS/OM state: caller must restore
+ * its own pipeline state if it uses the same context for other drawing.
+ */
+static int ffp_cuda_shader_render(FFPCudaShader *s, ID3D11DeviceContext *ctx,
+                           ID3D11RenderTargetView *rtv, const FFPCudaShaderInput *in,
+                           const AVFrame *frame, const FFPPresParams *pp,
+                           const FFPCudaShaderGeometry *geom, char *err, size_t n)
+{
+    FFPCudaShaderCB cb;
+    D3D11_VIEWPORT vp;
+    D3D11_SHADER_RESOURCE_VIEW_DESC sd;
+    D3D11_BUFFER_DESC bd;
+    ID3D11Resource *res = NULL;
+    ID3D11Buffer *buffer = NULL;
+    ID3D11ShaderResourceView *views[7] = { 0 };
+    ID3D11ShaderResourceView *nullviews[7] = { 0 };
+    ID3D11Buffer *nullcb = NULL;
+    ID3D11RenderTargetView *nullrtv = NULL;
+    RECT dst;
+    unsigned x, y, w, h, cw, ch, bpp, uvrow;
+    uint64_t end_y, end_uv;
+    double kr, kb;
+    int rotation;
+    static const GUID iid_buffer = { 0x48570b85, 0xd1ee, 0x4fcd,
+                                      { 0xa2,0x50,0xeb,0x35,0x07,0x22,0xb0,0x37 } };
+    static const float black[4] = { 0, 0, 0, 1 };
+
+    if (!s || !ctx || !rtv || !in || !frame || !pp || !geom ||
+        !geom->target_width || !geom->target_height ||
+        geom->target_width > D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION ||
+        geom->target_height > D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION ||
+        !in->storage_width || !in->storage_height ||
+        in->storage_width > D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION ||
+        in->storage_height > D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION ||
+        ((!!in->raw + !!in->rgb + !!in->ay + !!in->y) != 1) ||
+        (in->ay && !in->auv) || (in->y && !in->uv) ||
+        frame->width <= 0 || frame->height <= 0 ||
+        frame->crop_left >= (size_t)frame->width || frame->crop_top >= (size_t)frame->height ||
+        (pp->rotation != 0 && pp->rotation != 90 && pp->rotation != 180 && pp->rotation != 270) ||
+        (pp->flip_h != 0 && pp->flip_h != 1) || (pp->flip_v != 0 && pp->flip_v != 1) ||
+        (pp->eq_on && (!isfinite(pp->brightness) || !isfinite(pp->contrast) ||
+                       !isfinite(pp->saturation) || !isfinite(pp->gamma) ||
+                       pp->brightness < -1 || pp->brightness > 1 ||
+                       pp->contrast < -1000 || pp->contrast > 1000 ||
+                       pp->saturation < 0 || pp->saturation > 3 ||
+                       pp->gamma < 0.1 || pp->gamma > 10))) {
+        cs_error(err,n,"invalid CUDA shader arguments",E_INVALIDARG); return -1;
+    }
+    /* The shader produces SDR BGRA. PQ/HLG and constant-luminance BT.2020
+     * require a transfer/tone mapping or nonlinear conversion not provided here. */
+    if (frame->color_trc == AVCOL_TRC_SMPTE2084 ||
+        frame->color_trc == AVCOL_TRC_ARIB_STD_B67 ||
+        frame->colorspace == AVCOL_SPC_BT2020_CL) {
+        cs_error(err,n,"HDR/BT.2020-CL conversion not implemented",E_INVALIDARG);
+        return -1;
+    }
+    x = (unsigned)frame->crop_left; y = (unsigned)frame->crop_top;
+    w = (unsigned)frame->width - x; h = (unsigned)frame->height - y;
+    if (x >= in->storage_width || y >= in->storage_height ||
+        w > in->storage_width-x || h > in->storage_height-y) {
+        cs_error(err,n,"visible rectangle outside source",E_INVALIDARG); return -1;
+    }
+    bpp = in->p010 ? 2u : 1u;
+    cw = (in->storage_width + 1u)/2u; ch = (in->storage_height + 1u)/2u;
+    uvrow = cw * bpp * 2u;
+    if (in->raw) {
+        in->raw->lpVtbl->GetDesc(in->raw, &sd);
+        if (sd.ViewDimension != D3D11_SRV_DIMENSION_BUFFEREX ||
+            sd.Format != DXGI_FORMAT_R32_TYPELESS ||
+            sd.BufferEx.Flags != D3D11_BUFFEREX_SRV_FLAG_RAW || sd.BufferEx.FirstElement != 0 ||
+            !in->raw_pitch || (in->raw_pitch & 3u) || (in->raw_uv_offset & 3u) ||
+            in->raw_pitch < in->storage_width*bpp || in->raw_pitch < uvrow) {
+            cs_error(err,n,"invalid raw buffer view/stride",E_INVALIDARG); return -1;
+        }
+        in->raw->lpVtbl->GetResource(in->raw, &res);
+        if (!res || FAILED(res->lpVtbl->QueryInterface(res, &iid_buffer, (void **)&buffer))) {
+            CS_REL(res); cs_error(err,n,"raw SRV is not a buffer",E_INVALIDARG); return -1;
+        }
+        buffer->lpVtbl->GetDesc(buffer, &bd);
+        end_y = (uint64_t)(in->storage_height-1u)*in->raw_pitch +
+                (uint64_t)in->storage_width*bpp;
+        end_uv = (uint64_t)in->raw_uv_offset + (uint64_t)(ch-1u)*in->raw_pitch + uvrow;
+        if (end_y > in->raw_uv_offset || end_uv > bd.ByteWidth ||
+            end_uv > (uint64_t)sd.BufferEx.NumElements*4u || end_uv > UINT_MAX) {
+            CS_REL(buffer); CS_REL(res);
+            cs_error(err,n,"raw buffer too small for planes",E_INVALIDARG); return -1;
+        }
+        CS_REL(buffer); CS_REL(res);
+    } else if (!in->rgb) {
+        D3D11_SHADER_RESOURCE_VIEW_DESC yd, uvd;
+        ID3D11ShaderResourceView *yv = in->ay ? in->ay : in->y;
+        ID3D11ShaderResourceView *uvv = in->auv ? in->auv : in->uv;
+        yv->lpVtbl->GetDesc(yv, &yd);
+        uvv->lpVtbl->GetDesc(uvv, &uvd);
+        if (yd.ViewDimension != (in->ay ? D3D11_SRV_DIMENSION_TEXTURE2DARRAY : D3D11_SRV_DIMENSION_TEXTURE2D) ||
+            uvd.ViewDimension != (in->ay ? D3D11_SRV_DIMENSION_TEXTURE2DARRAY : D3D11_SRV_DIMENSION_TEXTURE2D) ||
+            yd.Format != (in->p010 ? DXGI_FORMAT_R16_UNORM : DXGI_FORMAT_R8_UNORM) ||
+            uvd.Format != (in->p010 ? DXGI_FORMAT_R16G16_UNORM : DXGI_FORMAT_R8G8_UNORM) ||
+            !cs_plane_extent(yv, in->storage_width, in->storage_height) ||
+            !cs_plane_extent(uvv, cw, ch)) {
+            cs_error(err,n,"invalid texture plane SRVs",E_INVALIDARG); return -1;
+        }
+    }
+    rotation = pp->rotation;
+    if (geom->destination) dst = *geom->destination;
+    else cs_letterbox(&dst,geom->target_width,geom->target_height,
+                      rotation == 90 || rotation == 270 ? h : w,
+                      rotation == 90 || rotation == 270 ? w : h,frame,rotation);
+    if (dst.left < 0 || dst.top < 0 || dst.right <= dst.left || dst.bottom <= dst.top ||
+        dst.right > (LONG)geom->target_width || dst.bottom > (LONG)geom->target_height) {
+        cs_error(err,n,"destination outside target",E_INVALIDARG); return -1;
+    }
+    memset(&cb,0,sizeof(cb));
+    cb.input[0]=in->storage_width; cb.input[1]=in->storage_height;
+    cb.input[2]=in->raw_pitch; cb.input[3]=in->raw_uv_offset;
