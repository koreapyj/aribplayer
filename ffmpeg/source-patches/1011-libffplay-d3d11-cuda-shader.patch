+static int ffp_cuda_probe_zero_copy(void)
+{
+    ID3D11Device *dev = NULL;
+    ID3D11DeviceContext *ctx = NULL;
+    IDXGIDevice *dxdev = NULL;
+    IDXGIAdapter *adapter = NULL;
