+/* CUDA post-filter snapshot using the same shader as display. Included after
+ * ffp_make_tex/ffp_eff_sar by ffplay_d3d11.c. */
+static int ffp_cuda_snapshot(FFPD3D11 *p, const AVFrame *f, const FFPPresParams *pp,
+                             uint8_t **out, int *ow, int *oh, int *ostride,
+                             char *err, size_t err_size)
+{
+    ID3D11Texture2D *tex = NULL, *stg = NULL;
+    ID3D11RenderTargetView *rtv = NULL;
+    D3D11_MAPPED_SUBRESOURCE m;
+    uint8_t *pixels = NULL;
+    AVRational sar = ffp_eff_sar(f, pp->rotation);
+    int rw = f->width, rh = f->height, dw, dh, y, direct = 0, ret = -1, mapped = 0;
+    if (pp->rotation == 90 || pp->rotation == 270) {
+        rw = f->height;
+        rh = f->width;
+    }
+    dw = rw;
+    dh = rh;
+    if (sar.num > 0 && sar.den > 0) {
+        double ratio = av_q2d(sar);
+        if (ratio > 1) dw = lrint(rw * ratio);
+        else if (ratio < 1) dh = lrint(rh / ratio);
+    }
+    dw = FFMAX(2, ((dw + 1) / 2) * 2);
+    dh = FFMAX(2, ((dh + 1) / 2) * 2);
+    EnterCriticalSection(&p->cs);
+    tex = ffp_make_tex(p->dev, dw, dh, DXGI_FORMAT_B8G8R8A8_UNORM,
+                       D3D11_USAGE_DEFAULT, D3D11_BIND_RENDER_TARGET, 0, NULL, 0);
+    stg = ffp_make_tex(p->dev, dw, dh, DXGI_FORMAT_B8G8R8A8_UNORM,
+                       D3D11_USAGE_STAGING, 0, D3D11_CPU_ACCESS_READ, NULL, 0);
+    if (!tex || !stg || FAILED(p->dev->lpVtbl->CreateRenderTargetView(p->dev,
+                                         (ID3D11Resource *)tex, NULL, &rtv))) {
+        ffp_set_err(err, err_size, "CUDA snapshot texture/RTV creation failed", S_OK);
+        goto done;
+    }
+    if (ffp_cuda_render(p, f, pp, rtv, dw, dh, &direct, err, err_size) != 0) {
+        if (!err[0]) ffp_set_err(err, err_size, "CUDA snapshot frame retired after remap", S_OK);
+        goto done;
+    }
+    p->ctx->lpVtbl->CopyResource(p->ctx, (ID3D11Resource *)stg, (ID3D11Resource *)tex);
+    if (FAILED(p->ctx->lpVtbl->Map(p->ctx, (ID3D11Resource *)stg, 0, D3D11_MAP_READ, 0, &m))) {
+        ffp_set_err(err, err_size, "CUDA snapshot readback Map failed", S_OK);
+        goto done;
+    }
+    mapped = 1;
+    pixels = av_malloc((size_t)dw * dh * 4);
+    if (!pixels) goto done;
+    for (y = 0; y < dh; y++)
+        memcpy(pixels + (size_t)y * dw * 4,
+               (const uint8_t *)m.pData + (size_t)y * m.RowPitch, dw * 4);
+    *out = pixels;
+    *ow = dw;
+    *oh = dh;
+    *ostride = dw * 4;
+    pixels = NULL;
+    ret = 0;
+done:
+    av_free(pixels);
+    if (mapped) p->ctx->lpVtbl->Unmap(p->ctx, (ID3D11Resource *)stg, 0);
+    FFP_REL(rtv);
+    FFP_REL(stg);
+    FFP_REL(tex);
+    LeaveCriticalSection(&p->cs);
+    return ret;
+}
