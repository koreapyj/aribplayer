+    FFP_REL(readback);
+    FFP_REL(tex);
+    av_buffer_unref(&cuda);
+    ffp_cuda_registry_unref(r);
+    FFP_REL(adapter);
+    FFP_REL(dxdev);
+    FFP_REL(ctx);
+    ffp_dbg_drain(dbg, "probe", 0);
+    FFP_REL(dev);
+    ffp_dbg_free(dbg);
+    return ok;
