+/* CUDA -> D3D11 frame import. Included by ffplay_d3d11.c after its private types. */
+static void ffp_cuda_release_planes(FFPD3D11 *p)
+{
+    int i;
+    FFPCudaRegistry *r = p->cuda_reg;
+    for (i = 0; i < 2; i++) {
+        FFP_REL(p->cuda_plane_views[i]);
+        if (p->cuda_plane_resources[i] && r) {
+            r->unreg(p->cuda_plane_resources[i]);
+            p->cuda_plane_resources[i] = NULL;
+        }
+        FFP_REL(p->cuda_planes[i]);
+    }
+    p->cuda_plane_w = p->cuda_plane_h = 0;
+}
+
+static int ffp_cuda_make_planes(FFPD3D11 *p, int w, int h, int p010,
+                                 char *err, size_t err_size)
+{
+    static const DXGI_FORMAT y_formats[] = { DXGI_FORMAT_R8_UNORM, DXGI_FORMAT_R16_UNORM };
+    static const DXGI_FORMAT uv_formats[] = { DXGI_FORMAT_R8G8_UNORM, DXGI_FORMAT_R16G16_UNORM };
+    FFPCudaRegistry *r = p->cuda_reg;
+    int i;
+    if (p->cuda_plane_w == w && p->cuda_plane_h == h && p->cuda_plane_p010 == p010)
+        return 0;
+    ffp_cuda_release_planes(p);
+    for (i = 0; i < 2; i++) {
+        D3D11_TEXTURE2D_DESC td = { 0 };
+        D3D11_SHADER_RESOURCE_VIEW_DESC sv = { 0 };
+        td.Width = i ? (w + 1) / 2 : w;
+        td.Height = i ? (h + 1) / 2 : h;
+        td.MipLevels = td.ArraySize = 1;
+        td.Format = i ? uv_formats[p010] : y_formats[p010];
+        td.SampleDesc.Count = 1;
+        td.Usage = D3D11_USAGE_DEFAULT;
+        td.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+        if (FAILED(p->dev->lpVtbl->CreateTexture2D(p->dev, &td, NULL, &p->cuda_planes[i])) ||
+            r->reg(&p->cuda_plane_resources[i], (ID3D11Resource *)p->cuda_planes[i], 0) != CUDA_SUCCESS) {
+            ffp_set_err(err, err_size, "CUDA fallback texture registration failed", S_OK);
+            goto fail;
+        }
+        sv.Format = td.Format;
+        sv.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2D;
+        sv.Texture2D.MipLevels = 1;
+        if (FAILED(p->dev->lpVtbl->CreateShaderResourceView(p->dev, (ID3D11Resource *)p->cuda_planes[i], &sv,
+                                                           &p->cuda_plane_views[i]))) {
+            ffp_set_err(err, err_size, "CUDA fallback SRV creation failed", S_OK);
+            goto fail;
+        }
+    }
+    p->cuda_plane_w = w;
+    p->cuda_plane_h = h;
+    p->cuda_plane_p010 = p010;
+    return 0;
+fail:
+    ffp_cuda_release_planes(p);
+    return -1;
+}
+
+/* Caller owns a frame reference and serializes D3D immediate-context access.
+ * The CUDA context synchronization is needed for NVDEC and async CUDA filters. */
+static int ffp_cuda_render(FFPD3D11 *p, const AVFrame *f, const FFPPresParams *pp,
+                            ID3D11RenderTargetView *rtv, int tw, int th, int *direct,
+                            char *err, size_t err_size)
+{
+    FFPCudaRegistry *r = p->cuda_reg;
+    FFPCudaEntry *e = NULL;
+    FFPCudaShaderInput in = { 0 };
+    FFPCudaShaderGeometry geo = { 0 };
+    AVHWFramesContext *fc = (AVHWFramesContext *)f->hw_frames_ctx->data;
+    CUcontext previous = NULL;
+    CUdeviceptr newptr;
+    size_t mapped_size;
+    int ret = -1, unmapped = 0, copy_mapped = 0, i, p010;
+    if (!r || !ffp_d3d11_cuda_frame_ok(((AVHWDeviceContext *)p->cuda_dev->data)->hwctx, f)) {
+        ffp_set_err(err, err_size, "CUDA frame does not belong to presenter device", S_OK);
+        return -1;
+    }
+    if (!p->cuda_shader && !(p->cuda_shader = ffp_cuda_shader_create(p->dev, err, err_size)))
+        return -1;
+    p010 = fc->sw_format == AV_PIX_FMT_P010;
+    in.p010 = p010;
+    in.storage_width = fc->width;
+    in.storage_height = fc->height;
+    geo.target_width = tw;
+    geo.target_height = th;
+    if (r->push(r->context) != CUDA_SUCCESS) {
+        ffp_set_err(err, err_size, "cuCtxPushCurrent failed", S_OK);
+        return -1;
+    }
+    if (r->sync() != CUDA_SUCCESS) {
+        ffp_set_err(err, err_size, "CUDA decoder/filter synchronization failed", S_OK);
+        goto done;
+    }
+    e = ffp_cuda_lookup(r, f);
+    /* A remap that relocated the pointer invalidates the old AVBufferRef data
+     * (and its plane offsets). Neither the raw SRV nor a CUDA device copy from
+     * those stale addresses is safe. Skip only this frame, not the presenter. */
+    if (e && e->retired) {
+        if (InterlockedCompareExchange(&e->dropped_counted, 1, 0) == 0)
+            InterlockedIncrement(&p->frames_dropped_readdress);
+        ret = 1;
+        goto done;
+    }
