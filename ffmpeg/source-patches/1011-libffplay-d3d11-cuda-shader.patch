+         * checkout callback. Keep flush-time remapping: cuGraphicsMapResources
+         * orders after the preceding D3D read, and the held AVBufferRef blocks
+         * decoder reuse. The pool recycle predicate destroys retired entries
+         * on last release instead of ever exposing their stale pointers. */
+        CUresult map_result = r->map(1, &e->resource, NULL);
+        if (map_result != CUDA_SUCCESS) {
+            snprintf(err, err_size, "CUDA buffer remap failed (%d)", (int)map_result);
+            ret = -1;
+        } else {
+            CUresult pointer_result = r->get_pointer(&newptr, &mapped_size, e->resource);
+            e->mapped = 1;
+            if (pointer_result != CUDA_SUCCESS || !newptr || mapped_size < e->size) {
+                snprintf(err, err_size, "CUDA buffer remap pointer lookup failed (%d)", (int)pointer_result);
+                ret = -1;
+            } else if (newptr != e->pointer ||
+                       (p->cuda_readdress_every > 0 && ret == 0 &&
+                        InterlockedIncrement(&p->cuda_displays) % p->cuda_readdress_every == 0)) {
+                /* The test hook simulates relocation after a real map/pointer
+                 * lookup; never fabricate a CUDA pointer or read stale data. */
+                InterlockedExchange(&e->retired, 1);
+                InterlockedIncrement(&p->frames_cuda_readdressed);
+            }
+        }
+    }
+    r->pop(&previous);
+    return ret;
+}
