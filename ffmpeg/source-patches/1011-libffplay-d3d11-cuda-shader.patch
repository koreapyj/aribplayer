+     * device allocation. Neither needs a host copy. */
+    if (e && f->linesize[0] == f->linesize[1] &&
+        (CUdeviceptr)f->data[1] >= e->pointer &&
+        (CUdeviceptr)f->data[1] - e->pointer < e->size) {
+        if (e->mapped && r->unmap(1, &e->resource, NULL) != CUDA_SUCCESS) {
+            ffp_set_err(err, err_size, "CUDA buffer unmap failed", S_OK);
+            goto done;
+        }
+        e->mapped = 0;
+        unmapped = 1;
+        in.raw = e->srv;
+        in.raw_pitch = f->linesize[0];
+        in.raw_uv_offset = (unsigned)((CUdeviceptr)f->data[1] - e->pointer);
+        *direct = 1;
+    } else {
+        if (ffp_cuda_make_planes(p, fc->width, fc->height, p010, err, err_size) < 0)
+            goto done;
+        if (r->map(2, p->cuda_plane_resources, NULL) != CUDA_SUCCESS) {
+            ffp_set_err(err, err_size, "CUDA texture map failed", S_OK);
+            goto done;
+        }
+        copy_mapped = 1;
+        for (i = 0; i < 2; i++) {
+            CUDA_MEMCPY2D c = { 0 };
+            CUarray dst;
+            int rowbytes = i ? ((fc->width + 1) / 2) * (p010 ? 4 : 2) : fc->width * (p010 ? 2 : 1);
+            int rows = i ? (fc->height + 1) / 2 : fc->height;
+            if (r->get_array(&dst, p->cuda_plane_resources[i], 0, 0) != CUDA_SUCCESS) {
+                ffp_set_err(err, err_size, "CUDA texture array lookup failed", S_OK);
+                goto done;
+            }
+            c.srcMemoryType = CU_MEMORYTYPE_DEVICE;
+            c.srcDevice = (CUdeviceptr)f->data[i];
+            c.srcPitch = f->linesize[i];
+            c.dstMemoryType = CU_MEMORYTYPE_ARRAY;
+            c.dstArray = dst;
+            c.WidthInBytes = rowbytes;
+            c.Height = rows;
+            if (rowbytes > f->linesize[i] || r->copy2d(&c) != CUDA_SUCCESS) {
+                ffp_set_err(err, err_size, "cuMemcpy2D to fallback plane failed", S_OK);
+                goto done;
+            }
+        }
+        if (r->sync() != CUDA_SUCCESS || r->unmap(2, p->cuda_plane_resources, NULL) != CUDA_SUCCESS) {
+            ffp_set_err(err, err_size, "CUDA fallback unmap failed", S_OK);
+            goto done;
+        }
+        copy_mapped = 0;
+        in.y = p->cuda_plane_views[0];
+        in.uv = p->cuda_plane_views[1];
+        *direct = 0;
+    }
+    ffp_lock_dev(p);
+    ret = ffp_cuda_shader_render(p->cuda_shader, p->ctx, rtv, &in, f, pp, &geo, err, err_size);
