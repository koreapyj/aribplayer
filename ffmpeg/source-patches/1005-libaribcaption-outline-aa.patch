+/* Renders a copy of the caption with the forced outline applied, so the caption itself (kept in the
+ * history, and possibly rendered by a later decoder with other style options) stays as decoded.
+ * append_caption: 1 appends it to the renderer and reports a clear; 2 appends it for a re-render; 0 renders
+ * what the renderer holds. */
+static int aribcaption_trans_bitmap_subtitle(ARIBCaptionContext *ctx,
+                                             const aribcc_caption_t *source,
+                                             int append_caption)
+{
+    aribcc_caption_t styled = *source;
+    int ret;
+
+    if (ctx->force_stroke_text && source->region_count) {
+        styled.regions = av_memdup(source->regions, source->region_count * sizeof(*source->regions));
+        if (!styled.regions)
+            return AVERROR(ENOMEM);
+        for (uint32_t i = 0; i < styled.region_count; i++) {
+            aribcc_caption_region_t *region = &styled.regions[i];
+
+            if (!region->char_count) {
+                region->chars = NULL;
+                continue;
+            }
+            region->chars = av_memdup(source->regions[i].chars, region->char_count * sizeof(*region->chars));
+            if (!region->chars) {
+                while (i--)
+                    av_freep(&styled.regions[i].chars);
+                av_freep(&styled.regions);
+                return AVERROR(ENOMEM);
+            }
+        }
+        aribcaption_prepare_forced_outline(ctx, &styled);
+    }
+    ret = aribcaption_render_bitmap(ctx, &styled, append_caption);
+    if (styled.regions != source->regions) {
+        for (uint32_t i = 0; i < styled.region_count; i++)
+            av_freep(&styled.regions[i].chars);
+        av_freep(&styled.regions);
+    }
+    return ret;
+}
