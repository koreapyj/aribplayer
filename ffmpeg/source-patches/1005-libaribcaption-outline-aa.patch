+/* Give library-forced outlines an opaque copy of the character background color.
+ * Explicit ARIB stroke styles retain both their style and their specified color. */
+static void aribcaption_prepare_forced_outline(ARIBCaptionContext *ctx,
+                                               aribcc_caption_t *caption)
+{
+    if (!ctx->force_stroke_text)
+        return;
+
+    for (int i = 0; i < caption->region_count; i++) {
+        aribcc_caption_region_t *region = &caption->regions[i];
+        for (int j = 0; j < region->char_count; j++) {
+            aribcc_caption_char_t *ch = &region->chars[j];
+
+            if (ch->style & ARIBCC_CHARSTYLE_STROKE)
+                continue;
+            ch->style |= ARIBCC_CHARSTYLE_STROKE;
+            ch->stroke_color = ARIBCC_MAKE_RGBA(ARIBCC_COLOR_R(ch->back_color),
+                                                ARIBCC_COLOR_G(ch->back_color),
+                                                ARIBCC_COLOR_B(ch->back_color),
+                                                0xFF);
         }
     }
 }
