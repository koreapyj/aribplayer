+static int clut_add_color(ARIBCaptionContext *ctx, uint32_t rgba)
+{
+    int idx = clut_find(ctx, rgba);
+
+    if (idx >= 0)
+        return idx;
+    if (ctx->clut_idx >= AVPALETTE_COUNT) {
+        ctx->clut_overflow++;
+        return -1;
+    }
+    idx = ctx->clut_idx++;
+    ctx->clut[idx] = rgba;
+    return idx;
+}
