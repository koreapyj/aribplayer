+/*
+ * ARIB detection. A program is ARIB when its PMT carries two or more distinct
+ * markers of ARIB STD-B10/B24 (program descriptors 0xC1 digital copy control,
+ * 0xDE content availability, 0xF6 access control; ES descriptors 0xC8 video
+ * decode control, 0xC1; stream_type 0x0D data carousel), or when it has an
+ * ARIB caption/superimpose stream, which is specific enough alone. Neither
+ * the network id nor the CA_system_id is used (SKY Perfect JSAT carries 0x0001).
+ */
+enum {
+    ARIB_PRG_C1  = 1 << 0,
+    ARIB_PRG_DE  = 1 << 1,
+    ARIB_PRG_F6  = 1 << 2,
+    ARIB_ES_C8   = 1 << 3,
+    ARIB_ES_C1   = 1 << 4,
+    ARIB_ST_0D   = 1 << 5,
+    ARIB_MARKERS = (1 << 6) - 1,
+    ARIB_CAPTION = 1 << 6,
+};
+
+static const char *const arib_marker_names[] = {
+    "prg_c1", "prg_de", "prg_f6", "es_c8", "es_c1", "st_0d", "caption",
+};
+
+static int arib_scan_es_descriptors(const uint8_t *p, const uint8_t *end,
+                                    int stream_type)
+{
+    int marks = 0, tag = -1, data_component_id = -1;
+
+    if (stream_type == 0x0d)
+        marks |= ARIB_ST_0D;
+    while (end - p >= 2) {
+        int desc_tag = p[0], desc_len = p[1];
+        if (desc_len > end - p - 2)
+            break;
+        switch (desc_tag) {
+        case 0xc8: marks |= ARIB_ES_C8; break;
+        case 0xc1: marks |= ARIB_ES_C1; break;
+        case STREAM_IDENTIFIER_DESCRIPTOR:
+            if (desc_len >= 1)
+                tag = p[2];
+            break;
+        case DATA_COMPONENT_DESCRIPTOR:
+            if (desc_len >= 2)
+                data_component_id = AV_RB16(p + 2);
+            break;
+        }
+        p += 2 + desc_len;
+    }
+    if (stream_type == STREAM_TYPE_PRIVATE_DATA && tag >= 0 &&
+        ((data_component_id == 0x0008 && tag >= 0x30 && tag <= 0x3f) ||
+         (data_component_id == 0x0012 && (tag == 0x87 || tag == 0x88))))
+        marks |= ARIB_CAPTION;
+    return marks;
+}
+
+/*
+ * Publishes the verdict of one complete PMT: AVProgram metadata "arib" ("1" or
+ * "0"; absent until a PMT was evaluated) and "arib_markers" (what matched),
+ * and the format metadata "arib" ("1" if any program is ARIB). Re-run for
+ * every new PMT version, so a later version can change the verdict.
+ */
+static void arib_update_program(MpegTSContext *ts, struct Program *prg,
+                                unsigned int programid, int marks)
+{
+    AVFormatContext *s = ts->stream;
+    int arib = (marks & ARIB_CAPTION) || av_popcount(marks & ARIB_MARKERS) >= 2;
+    const AVDictionaryEntry *e;
+    char list[64] = "";
+    int any = 0;
+
+    if (prg)
+        prg->arib = arib;
+    for (int i = 0; i < FF_ARRAY_ELEMS(arib_marker_names); i++)
+        if (marks & (1 << i))
+            av_strlcatf(list, sizeof(list), "%s%s", *list ? "," : "", arib_marker_names[i]);
+    for (int i = 0; i < s->nb_programs; i++) {
+        AVProgram *program = s->programs[i];
+        if (program->id == programid) {
+            av_dict_set(&program->metadata, "arib", arib ? "1" : "0", 0);
+            av_dict_set(&program->metadata, "arib_markers", list, 0);
+        }
+        e = av_dict_get(program->metadata, "arib", NULL, 0);
+        if (e && e->value[0] == '1')
+            any = 1;
+    }
+    av_dict_set(&s->metadata, "arib", any ? "1" : "0", 0);
+}
