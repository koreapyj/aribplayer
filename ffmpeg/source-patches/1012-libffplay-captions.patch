+
+    /* Applied after the queue so a cue that started this tick wins over a re-render of the old one. */
+    SDL_LockMutex(layer->is->dbg_mutex);
+    pending_valid = layer->pending_rerender_valid;
+    if (pending_valid) {
+        pending = layer->pending_rerender;
+        pending_serial = layer->pending_rerender_serial;
+        pending_width = layer->pending_rerender_width;
+        pending_height = layer->pending_rerender_height;
+        pending_generation = layer->pending_rerender_generation;
+        memset(&layer->pending_rerender, 0, sizeof(layer->pending_rerender));
+        layer->pending_rerender_valid = 0;
+    }
+    SDL_UnlockMutex(layer->is->dbg_mutex);
