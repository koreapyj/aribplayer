+    (void)data;
+    SDL_LockMutex(request->mutex);
+    if (!request->done) {
+        request->result = AVERROR_EXIT;
+        request->done = 1;
+        SDL_CondSignal(request->cond);
+    }
+    SDL_UnlockMutex(request->mutex);
+    ffp_subtitle_snapshot_request_unref(request);
+}
+
+static void ffp_subtitle_snapshot_complete(FFPSubtitleSnapshotRequest *request,
+                                           int result, AVSubtitle *rendered)
+{
+    SDL_LockMutex(request->mutex);
+    if (!request->done) {
+        if (result >= 0 && rendered) {
+            request->rendered = *rendered;
+            memset(rendered, 0, sizeof(*rendered));
+        }
+        request->result = result;
+        request->done = 1;
+        SDL_CondSignal(request->cond);
+    }
+    SDL_UnlockMutex(request->mutex);
+}
+
+static FFPSubtitleSnapshotRequest *ffp_subtitle_snapshot_request_from_packet(const AVPacket *pkt)
+{
+    FFPSubtitleSnapshotRequest *request;
+
+    if (!pkt || !pkt->opaque_ref || pkt->opaque_ref->size < sizeof(*request))
+        return NULL;
+    request = (FFPSubtitleSnapshotRequest *)pkt->opaque_ref->data;
+    return request->magic == FFP_SUBTITLE_SNAPSHOT_MAGIC ? request : NULL;
+}
+
+static int ffp_subtitle_snapshot_matches(const AVSubtitle *subtitle,
+                                        const FFPSubtitleSnapshotRequest *request)
+{
+    int i;
+
+    if (!subtitle || subtitle->format != 0 || !subtitle->num_rects ||
+        subtitle->pts != request->expected_pts ||
+        subtitle->start_display_time != request->expected_start_display_time ||
+        subtitle->end_display_time != request->expected_end_display_time)
+        return 0;
+    for (i = 0; i < subtitle->num_rects; i++) {
+        const AVSubtitleRect *rect = subtitle->rects[i];
+        if (!rect || !(rect->flags & AV_SUBTITLE_FLAG_RERENDER))
+            return 0;
+    }
+    return 1;
+}
+
+static int ffp_subtitle_snapshot_state_matches(SubtitleLayer *layer,
+                                               const FFPSubtitleSnapshotRequest *request)
+{
+    int serial;
+    uint64_t decode_generation;
+
+    SDL_LockMutex(layer->packets.mutex);
+    serial = layer->packets.serial;
+    SDL_UnlockMutex(layer->packets.mutex);
+    SDL_LockMutex(layer->is->dbg_mutex);
+    decode_generation = layer->cue_decode_generation;
+    SDL_UnlockMutex(layer->is->dbg_mutex);
+
+    return serial == request->serial && decode_generation == request->base_decode_generation;
+}
+
+static int decoder_subtitle_snapshot_set_canvas(Decoder *d, int width, int height)
+{
+    char size[48];
+
+    snprintf(size, sizeof(size), "%dx%d", width, height);
+    return av_opt_set(d->avctx->priv_data, "canvas_size", size, 0);
+}
+
+static void decoder_subtitle_snapshot_count(SubtitleLayer *layer)
+{
+    SDL_LockMutex(layer->is->dbg_mutex);
+    layer->re_renders++;
+    layer->is->dbg.subtitles[layer->id].re_renders = layer->re_renders;
+    SDL_UnlockMutex(layer->is->dbg_mutex);
+}
+
+/* Runs only on the subtitle decoder thread. The temporary results stay private: neither the playback cue
+ * queue nor its PTS/generation state is changed, and the original decoder canvas is always restored. */
+static void decoder_subtitle_snapshot(Decoder *d, FFPSubtitleSnapshotRequest *request)
+{
+    SubtitleLayer *layer = d->subtitle_layer;
+    AVPacket empty_pkt = { 0 };
+    AVSubtitle rendered = { 0 };
+    AVSubtitle restored = { 0 };
+    int old_width, old_height;
+    int got_rendered = 0, got_restored = 0;
+    int ret, restore_ret, exact_ok = 0, restore_ok = 0;
+
+    empty_pkt.pts = empty_pkt.dts = AV_NOPTS_VALUE;
+    /* Name the requested cue so the codec re-renders exactly that one (inverse of sub.pts derivation). */
+    if (request->expected_pts != AV_NOPTS_VALUE &&
+        d->avctx->pkt_timebase.num > 0 && d->avctx->pkt_timebase.den > 0)
+        empty_pkt.pts = av_rescale_q(request->expected_pts, AV_TIME_BASE_Q, d->avctx->pkt_timebase);
+    if (!layer || !layer->is_arib || request->stream_index != layer->stream_index ||
+        d->pkt_serial != request->serial ||
+        !ffp_subtitle_snapshot_state_matches(layer, request)) {
+        ret = AVERROR(EAGAIN);
+        goto done;
+    }
+
+    SDL_LockMutex(layer->is->dbg_mutex);
+    old_width = layer->canvas_width;
+    old_height = layer->canvas_height;
+    SDL_UnlockMutex(layer->is->dbg_mutex);
+    if (old_width <= 0 || old_height <= 0 || request->width <= 0 || request->height <= 0) {
+        ret = AVERROR(EINVAL);
+        goto done;
+    }
+
+    if (old_width == request->width && old_height == request->height) {
+        AVSubtitle intermediate = { 0 };
+        int got_intermediate = 0;
+        int temporary_width = request->width < INT_MAX ? request->width + 1 : request->width - 1;
+
+        /* Force the runtime path to produce a fresh bitmap even if a resize request already moved the
+         * decoder to this size but its replacement has not reached the playback cue model yet. */
+        ret = decoder_subtitle_snapshot_set_canvas(d, temporary_width, request->height);
+        if (ret < 0) {
+            AVSubtitle retry = { 0 };
+            int got_retry = 0;
+            restore_ret = decoder_subtitle_snapshot_set_canvas(d, old_width, old_height);
+            if (restore_ret >= 0) {
+                decoder_subtitle_snapshot_count(layer);
+                avcodec_decode_subtitle2(d->avctx, &retry, &got_retry, &empty_pkt);
+            }
+            avsubtitle_free(&retry);
+            goto done;
+        }
+        decoder_subtitle_snapshot_count(layer);
+        ret = avcodec_decode_subtitle2(d->avctx, &intermediate, &got_intermediate, &empty_pkt);
+        avsubtitle_free(&intermediate);
+
+        restore_ret = decoder_subtitle_snapshot_set_canvas(d, old_width, old_height);
+        if (restore_ret < 0) {
+            av_log(d->avctx, AV_LOG_ERROR, "could not restore ARIB subtitle canvas to %dx%d after snapshot: %s\n",
+                   old_width, old_height, av_err2str(restore_ret));
+            ret = restore_ret;
+            goto snapshot_done;
+        }
+        decoder_subtitle_snapshot_count(layer);
+        ret = avcodec_decode_subtitle2(d->avctx, &rendered, &got_rendered, &empty_pkt);
+        if (ret >= 0) {
+            restore_ok = 1;
+            if (got_rendered && ffp_subtitle_snapshot_matches(&rendered, request))
+                exact_ok = 1;
+        } else {
+            AVSubtitle retry = { 0 };
+            int got_retry = 0;
+            av_log(d->avctx, AV_LOG_WARNING, "ARIB snapshot rerender at the live canvas failed: %s\n",
+                   av_err2str(ret));
+            avsubtitle_free(&rendered);
+            restore_ret = avcodec_decode_subtitle2(d->avctx, &retry, &got_retry, &empty_pkt);
+            if (restore_ret >= 0)
+                restore_ok = 1;
+            avsubtitle_free(&retry);
+        }
+        goto snapshot_done;
+    }
+
+    ret = decoder_subtitle_snapshot_set_canvas(d, request->width, request->height);
+    if (ret < 0) {
+        av_log(d->avctx, AV_LOG_WARNING, "could not set ARIB snapshot canvas to %dx%d: %s\n",
+               request->width, request->height, av_err2str(ret));
+        goto done;
+    }
+    decoder_subtitle_snapshot_count(layer);
+    ret = avcodec_decode_subtitle2(d->avctx, &rendered, &got_rendered, &empty_pkt);
+    if (ret >= 0 && got_rendered && ffp_subtitle_snapshot_matches(&rendered, request))
+        exact_ok = 1;
+
+    restore_ret = decoder_subtitle_snapshot_set_canvas(d, old_width, old_height);
+    if (restore_ret < 0) {
+        av_log(d->avctx, AV_LOG_ERROR, "could not restore ARIB subtitle canvas to %dx%d after snapshot: %s\n",
+               old_width, old_height, av_err2str(restore_ret));
+    } else {
+        decoder_subtitle_snapshot_count(layer);
+        restore_ret = avcodec_decode_subtitle2(d->avctx, &restored, &got_restored, &empty_pkt);
+        if (restore_ret < 0)
+            av_log(d->avctx, AV_LOG_WARNING, "ARIB subtitle canvas restore rerender failed: %s\n",
+                   av_err2str(restore_ret));
+        else
+            restore_ok = 1;
+    }
+
+snapshot_done:
+    if (exact_ok && restore_ok && ffp_subtitle_snapshot_state_matches(layer, request))
+        ret = 0;
+    else
+        ret = AVERROR_INVALIDDATA;
+
+done:
+    if (ret >= 0)
+        ffp_subtitle_snapshot_complete(request, 0, &rendered);
+    else
+        ffp_subtitle_snapshot_complete(request, ret, NULL);
+    avsubtitle_free(&rendered);
+    avsubtitle_free(&restored);
+}
+
+static int ffp_subtitle_snapshot_rerender(SubtitleLayer *layer, int stream_index, int serial,
+                                          uint64_t base_generation, uint64_t base_decode_generation,
+                                          int width, int height, const AVSubtitle *expected,
+                                          AVSubtitle *rendered)
+{
+    FFPSubtitleSnapshotRequest *request = NULL;
+    AVPacket *pkt = NULL;
+    int ret;
+
+    if (!layer || !expected || !rendered || stream_index < 0 || !expected->num_rects ||
+        width <= 0 || height <= 0)
+        return AVERROR(EINVAL);
+    request = av_mallocz(sizeof(*request));
+    if (!request)
+        return AVERROR(ENOMEM);
+    request->magic = FFP_SUBTITLE_SNAPSHOT_MAGIC;
+    request->width = width;
+    request->height = height;
+    request->serial = serial;
+    request->stream_index = stream_index;
+    request->base_generation = base_generation;
+    request->base_decode_generation = base_decode_generation;
+    request->expected_pts = expected->pts;
+    request->expected_start_display_time = expected->start_display_time;
+    request->expected_end_display_time = expected->end_display_time;
+    request->mutex = SDL_CreateMutex();
+    request->cond = SDL_CreateCond();
+    request->refs = 1;
+    request->result = AVERROR(EAGAIN);
+    if (!request->mutex || !request->cond) {
+        if (request->cond)
+            SDL_DestroyCond(request->cond);
+        if (request->mutex)
+            SDL_DestroyMutex(request->mutex);
+        av_free(request);
+        return AVERROR(ENOMEM);
+    }
+
+    pkt = av_packet_alloc();
+    if (!pkt) {
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+    pkt->buf = av_buffer_alloc(1);
+    if (!pkt->buf) {
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+    pkt->data = pkt->buf->data;
+    pkt->size = 0;
+    pkt->pts = pkt->dts = AV_NOPTS_VALUE;
+    pkt->stream_index = stream_index;
+    SDL_LockMutex(request->mutex);
+    request->refs++;
+    SDL_UnlockMutex(request->mutex);
+    pkt->opaque_ref = av_buffer_create((uint8_t *)request, sizeof(*request),
+                                       ffp_subtitle_snapshot_packet_free, request, 0);
+    if (!pkt->opaque_ref) {
+        ffp_subtitle_snapshot_request_unref(request);
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+
+    ret = packet_queue_put(&layer->packets, pkt);
+    if (ret < 0)
+        goto fail;
+    av_packet_free(&pkt);
+
+    SDL_LockMutex(request->mutex);
+    while (!request->done) {
+        if (SDL_CondWaitTimeout(request->cond, request->mutex,
+                                FFP_SUBTITLE_SNAPSHOT_TIMEOUT_MS) != 0)
+            break;
+    }
+    if (request->done && request->result >= 0) {
+        *rendered = request->rendered;
+        memset(&request->rendered, 0, sizeof(request->rendered));
+        ret = 0;
+    } else if (request->done) {
+        ret = request->result;
+    } else {
+        ret = AVERROR(EAGAIN);
+    }
+    SDL_UnlockMutex(request->mutex);
+    ffp_subtitle_snapshot_request_unref(request);
+    return ret;
+
+fail:
+    av_packet_free(&pkt);
+    ffp_subtitle_snapshot_request_unref(request);
+    return ret;
+}
