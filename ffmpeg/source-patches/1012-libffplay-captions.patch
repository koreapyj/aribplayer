+/* Replaces the displayed bitmap with a re-render of the same cue; takes *sub only when it returns 1.
+ * The codec re-renders the cue named by the request even when it has decoded later cues ahead of
+ * playback, so identity is the cue's own pts/start/end, not the decode count. A newer cue already
+ * on screen changes active_generation and still wins. */
+static int ffp_subtitle_apply_rerender(SubtitleLayer *layer, AVSubtitle *sub, int serial,
+                                       uint64_t generation, int width, int height)
+{
+    if (!layer->active_valid || layer->active_generation != generation ||
+        layer->active_serial != serial || layer->active.pts != sub->pts ||
+        layer->active.start_display_time != sub->start_display_time ||
+        layer->active.end_display_time != sub->end_display_time)
+        return 0;
+    avsubtitle_free(&layer->active);
+    layer->active = *sub;
+    memset(sub, 0, sizeof(*sub));
+    layer->active_width = width;
+    layer->active_height = height;
+    return 1;
+}
+
+/* Asks the decoder for the cue that is on screen at the landing frame of a seek or open: its packet
+ * lies before the landing point and is not read again. The decoder answers from its caption history,
+ * for the part of the file it has decoded in this session. */
+static int ffp_subtitle_queue_attime(SubtitleLayer *layer, double pts, int serial)
+{
+    AVPacket *pkt = av_packet_alloc();
+    FFPSubtitleAtTimeRequest *request;
+    int ret;
+
+    if (!pkt)
+        return AVERROR(ENOMEM);
+    pkt->buf = av_buffer_alloc(1);
+    pkt->opaque_ref = av_buffer_allocz(sizeof(*request));
+    if (!pkt->buf || !pkt->opaque_ref ||
+        layer->startup_pkt_timebase.num <= 0 || layer->startup_pkt_timebase.den <= 0) {
+        av_packet_free(&pkt);
+        return AVERROR(ENOMEM);
+    }
+    pkt->data = pkt->buf->data;
+    pkt->size = 0;
+    pkt->dts = AV_NOPTS_VALUE;
+    pkt->pts = av_rescale_q(llrint(pts * AV_TIME_BASE), AV_TIME_BASE_Q, layer->startup_pkt_timebase);
+    pkt->flags |= AV_PKT_FLAG_ARIB_ACTIVE_AT;
+    pkt->stream_index = layer->stream_index;
+    request = (FFPSubtitleAtTimeRequest *)pkt->opaque_ref->data;
+    request->magic = FFP_SUBTITLE_ATTIME_MAGIC;
+    request->serial = serial;
+    ret = packet_queue_put(&layer->packets, pkt);
+    av_packet_free(&pkt);
+    return ret;
+}
