+static void decoder_subtitle_resize(Decoder *d)
+{
+    SubtitleLayer *layer = d->subtitle_layer;
+    FFPSubtitleResizeRequest *request;
+    char size[48];
+    int ret;
+
+    d->subtitle_rerender = 0;
+    d->subtitle_rerender_generation = 0;
+    d->subtitle_rerender_decode_generation = 0;
+    d->subtitle_attime = 0;
+    if (!layer || !d->pkt->opaque_ref)
+        return;
+    if (d->pkt->opaque_ref->size >= sizeof(FFPSubtitleAtTimeRequest) &&
+        ((FFPSubtitleAtTimeRequest *)d->pkt->opaque_ref->data)->magic == FFP_SUBTITLE_ATTIME_MAGIC) {
+        d->subtitle_attime = 1;
+        d->subtitle_attime_serial = ((FFPSubtitleAtTimeRequest *)d->pkt->opaque_ref->data)->serial;
+        return;
+    }
+    if (d->pkt->opaque_ref->size < sizeof(*request))
+        return;
+    request = (FFPSubtitleResizeRequest *)d->pkt->opaque_ref->data;
+    if (request->magic != FFP_SUBTITLE_RESIZE_MAGIC)
+        return;
+
+    snprintf(size, sizeof(size), "%dx%d", request->width, request->height);
+    ret = av_opt_set(d->avctx->priv_data, "canvas_size", size, 0);
+    if (ret < 0) {
+        av_log(d->avctx, AV_LOG_WARNING, "could not resize ARIB subtitle canvas to %s: %s\n",
+               size, av_err2str(ret));
+        return;
+    }
+    SDL_LockMutex(layer->is->dbg_mutex);
+    layer->canvas_width = request->width;
+    layer->canvas_height = request->height;
+    layer->re_renders++;
+    layer->is->dbg.subtitles[layer->id].canvas_width = request->width;
+    layer->is->dbg.subtitles[layer->id].canvas_height = request->height;
+    layer->is->dbg.subtitles[layer->id].re_renders = layer->re_renders;
+    SDL_UnlockMutex(layer->is->dbg_mutex);
+    d->subtitle_rerender = 1;
+    d->subtitle_rerender_generation = request->base_generation;
+    d->subtitle_rerender_decode_generation = request->base_decode_generation;
+}
