+static int ffp_find_arib_stream(AVFormatContext *ic, int video_index, const char *wanted_type)
+{
+    AVProgram *program = video_index >= 0 ? av_find_program_from_stream(ic, NULL, video_index) : NULL;
+    int pass, i;
+
+    for (pass = 0; pass < (program && av_strcasecmp(wanted_type, "superimpose") ? 2 : 1); pass++) {
+        int count = pass == 0 && program ? program->nb_stream_indexes : ic->nb_streams;
+        for (i = 0; i < count; i++) {
+            int index = pass == 0 && program ? program->stream_index[i] : i;
+            AVStream *st = ic->streams[index];
+            const char *type;
+            if (st->codecpar->codec_type != AVMEDIA_TYPE_SUBTITLE ||
+                st->codecpar->codec_id != AV_CODEC_ID_ARIB_CAPTION)
+                continue;
+            type = ffp_arib_type(st);
+            if (!av_strcasecmp(type, wanted_type))
+                return index;
+        }
+    }
+    return -1;
+}
+
+static int ffp_find_non_super_subtitle(AVFormatContext *ic, int video_index)
+{
+    AVProgram *program = video_index >= 0 ? av_find_program_from_stream(ic, NULL, video_index) : NULL;
+    int pass, i;
+
+    for (pass = 0; pass < (program ? 2 : 1); pass++) {
+        int count = pass == 0 && program ? program->nb_stream_indexes : ic->nb_streams;
+        for (i = 0; i < count; i++) {
+            int index = pass == 0 && program ? program->stream_index[i] : i;
+            AVStream *st = ic->streams[index];
+            if (st->codecpar->codec_type == AVMEDIA_TYPE_SUBTITLE && !ffp_arib_is_superimpose(st))
+                return index;
+        }
+    }
+    return -1;
+}
