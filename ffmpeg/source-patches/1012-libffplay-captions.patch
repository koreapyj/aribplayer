+static void ffp_d3d_overlay_free(FFPOverlayRect *rects, uint8_t **pixels, int count)
+{
+    int i;
+    if (pixels) {
+        for (i = 0; i < count; i++)
+            av_free(pixels[i]);
+    }
+    av_free(pixels);
+    av_free(rects);
+}
+
+static int ffp_d3d_overlay_build(VideoState *is, SubtitleLayer *layer,
+                                 FFPOverlayRect **out_rects, uint8_t ***out_pixels, int *out_count)
+{
+    FFPOverlayRect *rects = NULL;
+    uint8_t **pixels = NULL;
+    int count = 0, i;
+
+    *out_rects = NULL;
+    *out_pixels = NULL;
+    *out_count = 0;
+    if (!layer->active_valid || layer->active.format != 0 || !layer->active.num_rects)
+        return 0;
+    rects = av_calloc(layer->active.num_rects, sizeof(*rects));
+    pixels = av_calloc(layer->active.num_rects, sizeof(*pixels));
+    if (!rects || !pixels)
+        goto nomem;
+
+    for (i = 0; i < layer->active.num_rects; i++) {
+        AVSubtitleRect *r = layer->active.rects[i];
+        int x, y, w, h, sx, sy, stride;
+        const uint8_t *src[4];
+        int src_stride[4];
+        uint8_t *dst[4];
+        int dst_stride[4];
+
+        if (!r || !r->data[0] || !r->data[1] || r->w <= 0 || r->h <= 0)
+            continue;
+        x = av_clip(r->x, 0, layer->active_width);
+        y = av_clip(r->y, 0, layer->active_height);
+        w = av_clip(r->w - (x - r->x), 0, layer->active_width - x);
+        h = av_clip(r->h - (y - r->y), 0, layer->active_height - y);
+        sx = x - r->x;
+        sy = y - r->y;
+        if (w <= 0 || h <= 0)
+            continue;
+        stride = w * 4;
+        pixels[count] = av_malloc((size_t)stride * h);
+        if (!pixels[count])
+            goto nomem;
+        src[0] = r->data[0] + sy * r->linesize[0] + sx;
+        src[1] = r->data[1];
+        src[2] = src[3] = NULL;
+        src_stride[0] = r->linesize[0];
+        src_stride[1] = r->linesize[1];
+        src_stride[2] = src_stride[3] = 0;
+        dst[0] = pixels[count];
+        dst[1] = dst[2] = dst[3] = NULL;
+        dst_stride[0] = stride;
+        dst_stride[1] = dst_stride[2] = dst_stride[3] = 0;
+        is->subtitle_rgba_ctx = sws_getCachedContext(is->subtitle_rgba_ctx, w, h, AV_PIX_FMT_PAL8,
+            w, h, AV_PIX_FMT_RGBA, SWS_POINT, NULL, NULL, NULL);
+        if (!is->subtitle_rgba_ctx)
+            goto nomem;
+        if (sws_scale(is->subtitle_rgba_ctx, src, src_stride, 0, h, dst, dst_stride) < 0)
+            goto nomem;
+        rects[count].rgba = pixels[count];
+        rects[count].x = x;
+        rects[count].y = y;
+        rects[count].width = w;
+        rects[count].height = h;
+        rects[count].stride = stride;
+        count++;
+    }
+    *out_rects = rects;
+    *out_pixels = pixels;
+    *out_count = count;
+    return 0;
+
+nomem:
+    ffp_d3d_overlay_free(rects, pixels, layer->active.num_rects);
+    return AVERROR(ENOMEM);
+}
+
+static int ffp_d3d_sync_overlays(VideoState *is)
+{
+    FFPlayer *ffp = is->ffp;
+    int i;
+    for (i = 0; i < FFP_SUBTITLE_LAYER_COUNT; i++) {
+        SubtitleLayer *layer = &is->subtitles[i];
+        FFPOverlayLayer overlay;
+        FFPOverlayRect *rects = NULL, placeholder;
+        uint8_t **pixels = NULL;
+        int rect_count = 0;
+        int canvas_width, canvas_height;
+        int width, height, visible, content_changed;
+        char err[256] = "";
+        int ret;
+
+        SDL_LockMutex(is->dbg_mutex);
+        canvas_width = layer->canvas_width;
+        canvas_height = layer->canvas_height;
+        SDL_UnlockMutex(is->dbg_mutex);
+        width = layer->active_valid ? layer->active_width : canvas_width;
+        height = layer->active_valid ? layer->active_height : canvas_height;
+        visible = ffp_subtitle_visible(is, i);
+        content_changed = layer->d3d_generation != layer->generation ||
+                          layer->d3d_canvas_width != width || layer->d3d_canvas_height != height;
+        memset(&overlay, 0, sizeof(overlay));
+        memset(&placeholder, 0, sizeof(placeholder));
+        overlay.generation = layer->generation;
+        overlay.visible = visible;
+        overlay.canvas_width = width;
+        overlay.canvas_height = height;
+        if (content_changed) {
+            ret = ffp_d3d_overlay_build(is, layer, &rects, &pixels, &rect_count);
+            if (ret < 0) {
+                av_log(NULL, AV_LOG_WARNING, "could not convert D3D11 subtitle overlay: %s\n", av_err2str(ret));
+                continue;
+            }
+            overlay.rects = rects;
+            overlay.rect_count = rect_count;
+        } else {
+            overlay.rects = layer->d3d_rect_count ? &placeholder : NULL;
+            overlay.rect_count = layer->d3d_rect_count;
+        }
+        if (content_changed || layer->d3d_visible != visible) {
+            ret = ffp_d3d11_set_overlay(ffp->d3d, i, &overlay, err, sizeof(err));
+            if (ret < 0) {
+                av_log(NULL, AV_LOG_WARNING, "D3D11 %s overlay update failed: %s\n",
+                       i == FFP_SUBTITLE_CAPTION ? "caption" : "superimpose",
+                       err[0] ? err : "unknown error");
+            } else {
+                if (content_changed) {
+                    layer->d3d_generation = layer->generation;
+                    layer->d3d_canvas_width = width;
+                    layer->d3d_canvas_height = height;
+                    layer->d3d_rect_count = rect_count;
+                    if (layer->active_valid && rect_count)
+                        SDL_AtomicAdd(&layer->cues_uploaded, 1);
+                }
+                layer->d3d_visible = visible;
+            }
+        }
+        ffp_d3d_overlay_free(rects, pixels, rect_count);
+    }
+    return 0;
+}
