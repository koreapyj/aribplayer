+static void ffp_subtitle_check_resize(VideoState *is, int64_t now)
+{
+    int i;
+    for (i = 0; i < FFP_SUBTITLE_LAYER_COUNT; i++) {
+        SubtitleLayer *layer = &is->subtitles[i];
+        int width, height;
+        if (!layer->is_arib || layer->stream_index < 0 ||
+            layer->resize_candidate_width <= 0 || layer->resize_candidate_height <= 0 ||
+            now - layer->resize_candidate_since < 100000)
+            continue;
+        SDL_LockMutex(is->dbg_mutex);
+        width = layer->canvas_width;
+        height = layer->canvas_height;
+        SDL_UnlockMutex(is->dbg_mutex);
+        /* A request still unapplied after 0.5 s was lost (a seek / flush at open drops queued packets): ask again,
+         * otherwise a window resize right after open would leave the canvas at the pre-resize size (blurry). */
+        if ((width != layer->resize_candidate_width || height != layer->resize_candidate_height) &&
+            (layer->resize_requested_width != layer->resize_candidate_width ||
+             layer->resize_requested_height != layer->resize_candidate_height ||
+             now - layer->resize_requested_at > 500000)) {
+            if (ffp_subtitle_queue_resize(layer, layer->resize_candidate_width,
