+int ffp_d3d11_snapshot_with_overlays(FFPD3D11 *p, const AVFrame *f, const FFPPresParams *pp,
+                                     const FFPOverlayLayer layers[FFP_OVERLAY_LAYER_COUNT],
+                                     uint8_t **out, int *w, int *h, int *stride,
+                                     char *err, size_t err_size)
