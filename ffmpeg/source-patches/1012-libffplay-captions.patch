+            layer->active_counted_shown = 0;
+            layer->active_serial = sp->serial;
+            layer->active_width = sp->width;
+            layer->active_height = sp->height;
+            layer->active_start = cue_start;
+            layer->active_end = cue_end;
+            layer->active_generation = layer->generation;
+        }
+        frame_queue_next(queue);
