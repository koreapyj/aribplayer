+static int ffp_arib_is_superimpose(AVStream *st)
+{
+    const char *type = ffp_arib_type(st);
+    return !av_strcasecmp(type, "superimpose");
+}
+
+/* Identity of a caption stream of a file: the ARIB decoder keeps its caption history under it, so a
+ * reopen of the same file (a new decoder) continues from it and another file starts empty. Streams
+ * that are not local files have no identity (the history is not shared). */
+static void ffp_history_key(AVFormatContext *ic, int stream_index, int layer, char *key, size_t size)
+{
+    int64_t file_size = ic->pb ? avio_size(ic->pb) : -1;
+    const char *url = ic->url ? ic->url : "";
+    const char *path = url;
+    wchar_t wide[4096];
+    struct _stat64 st;
+
+    key[0] = 0;
+    av_strstart(url, "file:", &path);
+    if (strstr(path, "://") || file_size <= 0)
+        return;
+    if (MultiByteToWideChar(CP_UTF8, 0, path, -1, wide, FF_ARRAY_ELEMS(wide)) <= 0 || _wstat64(wide, &st) < 0)
+        return;
+    snprintf(key, size, "%s|%"PRId64"|%"PRId64"|%d|%d", url, file_size, (int64_t)st.st_mtime, stream_index, layer);
+}
+
+static void ffp_subtitle_canvas_size(VideoState *is, int video_w, int video_h, AVRational sar,
+                                     int *canvas_w, int *canvas_h)
+{
+    SDL_Rect rect = { 0, 0, 1, 1 };
+    int out_w = 0, out_h = 0;
+
+    SDL_LockMutex(is->ffp->mutex);
+    out_w = is->ffp->render_w;
+    out_h = is->ffp->render_h;
+    SDL_UnlockMutex(is->ffp->mutex);
+    if (out_w <= 0 || out_h <= 0) {
+        out_w = FFMAX(is->width, 1);
+        out_h = FFMAX(is->height, 1);
+    }
+    if (video_w <= 0 || video_h <= 0) {
+        if (is->video_st) {
+            video_w = is->video_st->codecpar->width;
+            video_h = is->video_st->codecpar->height;
+        }
+    }
+    if (video_w > 0 && video_h > 0) {
+        if (sar.num <= 0 || sar.den <= 0)
+            sar = (AVRational){ 1, 1 };
+        calculate_display_rect(&rect, 0, 0, out_w, out_h, video_w, video_h, sar);
+    }
+    *canvas_w = FFMAX(rect.w, 1);
+    *canvas_h = FFMAX(rect.h, 1);
+}
