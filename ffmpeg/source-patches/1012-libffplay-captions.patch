+static void ffp_subtitle_update_layer(SubtitleLayer *layer, double pts, int serial)
+{
+    Frame *sp;
+    FrameQueue *queue = &layer->frames;
+    AVSubtitle pending = { 0 };
+    int pending_valid, pending_serial = 0, pending_width = 0, pending_height = 0;
+    uint64_t pending_generation = 0;
+    AVSubtitle attime = { 0 };
+    int attime_valid, attime_serial = 0, attime_width = 0, attime_height = 0;
+    int packet_serial;
+
+    /* video and subtitle packet queues have independent serial counters; serial is the video frame's */
+    SDL_LockMutex(layer->packets.mutex);
+    packet_serial = layer->packets.serial;
+    SDL_UnlockMutex(layer->packets.mutex);
+    if (layer->active_valid && layer->active_serial != layer->packets.serial)
+        ffp_subtitle_clear_active(layer, 1);
+    if (layer->is_arib && layer->stream_index >= 0 && !isnan(pts) && serial == layer->is->videoq.serial &&
+        layer->attime_requested_serial != packet_serial &&
