+static void ffp_subtitle_clear_active(SubtitleLayer *layer, int count_clear)
+{
+    if (layer->active_valid) {
+        avsubtitle_free(&layer->active);
+        layer->active_valid = 0;
+        layer->active_counted_shown = 0;
+        layer->active_serial = -1;
+        layer->active_width = layer->active_height = 0;
+        layer->active_start = layer->active_end = NAN;
+        layer->active_generation = 0;
+        layer->generation++;
+        if (count_clear)
+            SDL_AtomicAdd(&layer->cues_cleared, 1);
+    }
+}
