+static int ffp_snapshot_blend_layer(uint8_t *dst, int dw, int dh, int dstride,
+                                    const FFPOverlayLayer *layer, char *err, size_t n)
+{
+    uint64_t total_bytes = 0;
+    int i;
+    if (!layer || !layer->visible || !layer->rect_count)
+        return 0;
+    if (layer->rect_count < 0 || layer->rect_count > FFP_OVERLAY_MAX_RECTS ||
+        !layer->rects || layer->canvas_width <= 0 || layer->canvas_height <= 0 ||
+        layer->canvas_width > D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION ||
+        layer->canvas_height > D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION) {
+        ffp_set_err(err, n, "invalid snapshot bitmap overlay layer", E_INVALIDARG);
+        return -1;
+    }
+    for (i = 0; i < layer->rect_count; i++) {
+        const FFPOverlayRect *r = &layer->rects[i];
+        double x, y, rw, rh;
+        int x0, y0, x1, y1, py, px;
+        if (!r->rgba || r->width <= 0 || r->height <= 0 || r->stride <= 0 ||
+            (int64_t)r->stride < (int64_t)r->width * 4 ||
+            r->width > D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION ||
+            r->height > D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION ||
+            (uint64_t)r->width * (uint64_t)r->height * 4u > FFP_OVERLAY_MAX_BYTES - total_bytes) {
+            ffp_set_err(err, n, "invalid snapshot RGBA bitmap rect", E_INVALIDARG);
+            return -1;
+        }
+        total_bytes += (uint64_t)r->width * (uint64_t)r->height * 4u;
+        x = (double)r->x * dw / layer->canvas_width;
+        y = (double)r->y * dh / layer->canvas_height;
+        rw = (double)r->width * dw / layer->canvas_width;
+        rh = (double)r->height * dh / layer->canvas_height;
+        if (rw <= 0 || rh <= 0)
+            continue;
+        x0 = (int)FFMIN((double)dw, FFMAX(0.0, floor(x)));
+        y0 = (int)FFMIN((double)dh, FFMAX(0.0, floor(y)));
+        x1 = (int)FFMAX(0.0, FFMIN((double)dw, ceil(x + rw)));
+        y1 = (int)FFMAX(0.0, FFMIN((double)dh, ceil(y + rh)));
+        for (py = y0; py < y1; py++) {
+            double sy = ((py + 0.5 - y) / rh) * r->height - 0.5;
+            for (px = x0; px < x1; px++) {
+                float rgba[4];
+                double sx = ((px + 0.5 - x) / rw) * r->width - 0.5;
+                double a;
+                uint8_t *d = dst + (size_t)py * dstride + (size_t)px * 4;
+                ffp_overlay_sample_rgba(r, sx, sy, rgba);
+                a = rgba[3];
+                if (a <= 0.0) continue;
+                d[0] = (uint8_t)av_clip((int)lrint(rgba[2] * a + d[0] * (1.0 - a)), 0, 255);
+                d[1] = (uint8_t)av_clip((int)lrint(rgba[1] * a + d[1] * (1.0 - a)), 0, 255);
+                d[2] = (uint8_t)av_clip((int)lrint(rgba[0] * a + d[2] * (1.0 - a)), 0, 255);
+                d[3] = 255;
+            }
+        }
+    }
+    return 0;
+}
