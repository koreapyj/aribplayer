+#define FFP_OVERLAY_MAX_RECTS 1024
+#define FFP_OVERLAY_MAX_BYTES (64u * 1024u * 1024u)
+
+static void ffp_overlay_cache_free(FFPOverlayCache *c)
+{
+    int i;
+    if (!c) return;
+    for (i = 0; i < c->rect_count; i++) {
+        FFP_REL(c->rects[i].srv);
+        FFP_REL(c->rects[i].texture);
+    }
+    av_freep(&c->rects);
+    c->rect_count = 0;
+}
