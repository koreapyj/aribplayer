+static int ffp_snapshot_composite_subtitle(uint8_t *bgra, int width, int height, int stride,
+                                           const AVSubtitle *subtitle, int canvas_w, int canvas_h)
+{
+    int i;
+    if (!bgra || !subtitle || canvas_w <= 0 || canvas_h <= 0 || width <= 0 || height <= 0)
+        return 0;
+    for (i = 0; i < subtitle->num_rects; i++) {
+        AVSubtitleRect *r = subtitle->rects[i];
+        int x, y, w, h, sx, sy, dx, dy, dw, dh, row, col;
+        struct SwsContext *sws;
+        uint8_t *converted = NULL;
+        const uint8_t *src[4];
+        int src_stride[4];
+        uint8_t *dst[4];
+        int dst_stride[4];
+
+        if (!r || !r->data[0] || !r->data[1] || r->w <= 0 || r->h <= 0)
+            continue;
+        x = av_clip(r->x, 0, canvas_w);
+        y = av_clip(r->y, 0, canvas_h);
+        w = av_clip(r->w - (x - r->x), 0, canvas_w - x);
+        h = av_clip(r->h - (y - r->y), 0, canvas_h - y);
+        sx = x - r->x;
+        sy = y - r->y;
+        if (w <= 0 || h <= 0)
+            continue;
+        dx = av_rescale_rnd(x, width, canvas_w, AV_ROUND_NEAR_INF);
+        dy = av_rescale_rnd(y, height, canvas_h, AV_ROUND_NEAR_INF);
+        dw = av_rescale_rnd(x + w, width, canvas_w, AV_ROUND_NEAR_INF) - dx;
+        dh = av_rescale_rnd(y + h, height, canvas_h, AV_ROUND_NEAR_INF) - dy;
+        dx = av_clip(dx, 0, width);
+        dy = av_clip(dy, 0, height);
+        dw = av_clip(dw, 0, width - dx);
+        dh = av_clip(dh, 0, height - dy);
+        if (dw <= 0 || dh <= 0)
+            continue;
+        converted = av_malloc((size_t)dw * dh * 4);
+        if (!converted)
+            return AVERROR(ENOMEM);
+        sws = sws_getContext(w, h, AV_PIX_FMT_PAL8, dw, dh, AV_PIX_FMT_BGRA,
+                             SWS_BICUBIC | SWS_ACCURATE_RND, NULL, NULL, NULL);
+        if (!sws) {
+            av_free(converted);
+            return AVERROR(ENOMEM);
+        }
+        src[0] = r->data[0] + sy * r->linesize[0] + sx;
+        src[1] = r->data[1];
+        src[2] = src[3] = NULL;
+        src_stride[0] = r->linesize[0];
+        src_stride[1] = r->linesize[1];
+        src_stride[2] = src_stride[3] = 0;
+        dst[0] = converted;
+        dst[1] = dst[2] = dst[3] = NULL;
+        dst_stride[0] = dw * 4;
+        dst_stride[1] = dst_stride[2] = dst_stride[3] = 0;
+        if (sws_scale(sws, src, src_stride, 0, h, dst, dst_stride) < 0) {
+            sws_freeContext(sws);
+            av_free(converted);
+            return AVERROR(EINVAL);
+        }
+        sws_freeContext(sws);
+        for (row = 0; row < dh; row++) {
+            uint8_t *out = bgra + (size_t)(dy + row) * stride + (size_t)dx * 4;
+            const uint8_t *in = converted + (size_t)row * dw * 4;
+            for (col = 0; col < dw; col++, out += 4, in += 4) {
+                unsigned a = in[3], ia = 255 - a;
+                out[0] = (uint8_t)((in[0] * a + out[0] * ia + 127) / 255);
+                out[1] = (uint8_t)((in[1] * a + out[1] * ia + 127) / 255);
+                out[2] = (uint8_t)((in[2] * a + out[2] * ia + 127) / 255);
+                out[3] = 255;
+            }
+        }
+        av_free(converted);
+    }
+    return 0;
+}
+
+FFP_API int FFP_CALL ffp_snapshot_ex(FFPlayer *ffp, unsigned flags, uint8_t **out_bgra,
+                                     int *width, int *height, int *stride)
+{
+    AVSubtitle subtitles[FFP_SUBTITLE_LAYER_COUNT] = { { 0 } };
+    AVFrame *src = NULL;
+    uint8_t *composite = NULL;
+    int canvas_w[FFP_SUBTITLE_LAYER_COUNT] = { 0, 0 };
+    int canvas_h[FFP_SUBTITLE_LAYER_COUNT] = { 0, 0 };
+    int visible[FFP_SUBTITLE_LAYER_COUNT] = { 0, 0 };
+    int is_arib[FFP_SUBTITLE_LAYER_COUNT] = { 0, 0 };
+    int serial[FFP_SUBTITLE_LAYER_COUNT] = { 0, 0 };
+    int stream_index[FFP_SUBTITLE_LAYER_COUNT] = { -1, -1 };
+    uint64_t generation[FFP_SUBTITLE_LAYER_COUNT] = { 0, 0 };
+    uint64_t decode_generation[FFP_SUBTITLE_LAYER_COUNT] = { 0, 0 };
+    int i, ret;
+
+    if (!ffp || !out_bgra || !width || !height || !stride || (flags & ~FFP_SNAPSHOT_SUBTITLES))
+        return FFP_EINVAL;
+    if (!(flags & FFP_SNAPSHOT_SUBTITLES))
+        return ffp_snapshot(ffp, out_bgra, width, height, stride);
+
+    SDL_LockMutex(ffp->snap_mutex);
+    if (ffp->last_frame && ffp->last_frame->buf[0])
+        src = av_frame_clone(ffp->last_frame);
+    for (i = 0; i < FFP_SUBTITLE_LAYER_COUNT; i++) {
+        visible[i] = SDL_AtomicGet(&ffp->subtitle_visible[i]) && ffp->last_subtitle_visible[i];
+        canvas_w[i] = ffp->last_subtitle_width[i];
+        canvas_h[i] = ffp->last_subtitle_height[i];
+        is_arib[i] = ffp->last_subtitle_is_arib[i];
+        serial[i] = ffp->last_subtitle_serial[i];
+        stream_index[i] = ffp->last_subtitle_stream_index[i];
+        generation[i] = ffp->last_subtitle_generation[i];
+        decode_generation[i] = ffp->last_subtitle_decode_generation[i];
+        if (visible[i] && ffp->last_subtitles[i].num_rects &&
+            ffp_subtitle_copy(&subtitles[i], &ffp->last_subtitles[i]) < 0)
+            visible[i] = 0;
+    }
+    SDL_UnlockMutex(ffp->snap_mutex);
+    if (!src) {
+        ret = FFP_EAGAIN;
+        goto end;
+    }
+    ret = ffp->pres_ops->snapshot(ffp, src, out_bgra, width, height, stride);
+    src = NULL; /* presenter consumes the clone */
+    if (ret < 0)
+        goto end;
+    composite = av_memdup(*out_bgra, (size_t)*stride * *height);
+    if (!composite) {
+        av_log(NULL, AV_LOG_WARNING, "subtitle snapshot allocation failed; using video-only snapshot\n");
+        ret = 0;
+        goto end;
+    }
+    for (i = 0; i < FFP_SUBTITLE_LAYER_COUNT; i++) {
+        if (visible[i] && subtitles[i].num_rects) {
+            if (is_arib[i] && stream_index[i] >= 0 &&
+                (canvas_w[i] != *width || canvas_h[i] != *height)) {
+                AVSubtitle rerendered = { 0 };
+                int rerender_ret = AVERROR(EAGAIN);
+
+                /* Keep the video frame and its cue snapshot paired. The mutex also prevents the media
+                 * from being destroyed while the request is queued and serviced by its decoder thread. */
+                SDL_LockMutex(ffp->snap_mutex);
+                if (ffp->snap_is && ffp->last_subtitle_is_arib[i] &&
+                    ffp->last_subtitle_stream_index[i] == stream_index[i] &&
+                    ffp->last_subtitle_serial[i] == serial[i] &&
+                    ffp->last_subtitle_generation[i] == generation[i] &&
+                    ffp->last_subtitle_decode_generation[i] == decode_generation[i]) {
+                    rerender_ret = ffp_subtitle_snapshot_rerender(&ffp->snap_is->subtitles[i],
+                        stream_index[i], serial[i], generation[i], decode_generation[i],
+                        *width, *height, &subtitles[i], &rerendered);
+                }
+                SDL_UnlockMutex(ffp->snap_mutex);
+                if (rerender_ret >= 0) {
+                    avsubtitle_free(&subtitles[i]);
+                    subtitles[i] = rerendered;
+                    canvas_w[i] = *width;
+                    canvas_h[i] = *height;
+                } else {
+                    av_log(NULL, AV_LOG_WARNING,
+                           "ARIB snapshot exact re-render failed for layer %d; using high-quality scaled bitmap: %s\n",
+                           i, av_err2str(rerender_ret));
+                }
+            }
+            ret = ffp_snapshot_composite_subtitle(composite, *width, *height, *stride,
+                &subtitles[i], canvas_w[i], canvas_h[i]);
+            if (ret < 0) {
+                av_log(NULL, AV_LOG_WARNING, "subtitle snapshot composition failed; using video-only snapshot: %s\n",
+                       av_err2str(ret));
+                ret = 0;
+                goto end;
+            }
+        }
+    }
+    memcpy(*out_bgra, composite, (size_t)*stride * *height);
+    ret = 0;
+end:
+    av_free(composite);
+    for (i = 0; i < FFP_SUBTITLE_LAYER_COUNT; i++)
+        avsubtitle_free(&subtitles[i]);
+    av_frame_free(&src);
+    return ret;
+}
