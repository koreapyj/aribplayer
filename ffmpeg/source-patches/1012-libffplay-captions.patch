+
+    SDL_LockMutex(layer->is->dbg_mutex);
+    attime_valid = layer->pending_attime_valid;
+    if (attime_valid) {
+        attime = layer->pending_attime;
+        attime_serial = layer->pending_attime_serial;
+        attime_width = layer->pending_attime_width;
+        attime_height = layer->pending_attime_height;
+        memset(&layer->pending_attime, 0, sizeof(layer->pending_attime));
+        layer->pending_attime_valid = 0;
+    }
+    SDL_UnlockMutex(layer->is->dbg_mutex);
+    if (attime_valid) {
+        /* Only onto an empty screen of the same serial that no queued cue or clear has touched: whatever the
+         * queue applied is the newer state. */
+        if (!layer->active_valid && attime_serial == packet_serial && layer->event_serial != packet_serial &&
+            attime.num_rects > 0) {
+            layer->generation++;
+            layer->active = attime;
+            memset(&attime, 0, sizeof(attime));
+            layer->active_valid = 1;
+            layer->active_counted_shown = 0;
+            layer->active_serial = attime_serial;
+            layer->active_width = attime_width;
+            layer->active_height = attime_height;
