+FFP_API int FFP_CALL ffp_test_d3d11_readback_last(FFPlayer *ffp, uint8_t **out_bgra,
+                                                  int *width, int *height, int *stride,
+                                                  int *video_x, int *video_y,
+                                                  int *video_width, int *video_height)
+{
+    FFPD3D11OverlayStats stats;
+    char err[256] = "";
+    int ret;
+
+    if (!ffp || !out_bgra || !width || !height || !stride || !video_x || !video_y ||
+        !video_width || !video_height)
+        return FFP_EINVAL;
+    *out_bgra = NULL;
+    *width = *height = *stride = 0;
+    *video_x = *video_y = *video_width = *video_height = 0;
+
+    /* pres_mutex pins the presenter across both internal queries; each query also takes the
+     * presenter's critical section while copying/reading its state. The returned pixels are
+     * an owned copy, so callers never touch the presenter's live staging/readback buffer. */
+    SDL_LockMutex(ffp->pres_mutex);
+    if (!ffp->d3d) {
+        ret = FFP_EAGAIN;
+    } else {
+        ffp_d3d11_overlay_stats(ffp->d3d, &stats);
+        ret = ffp_d3d11_readback_last(ffp->d3d, out_bgra, width, height, stride, err, sizeof(err));
+        if (ret < 0) {
+            ret = !strcmp(err, "no composed back-buffer readback available") ?
+                  FFP_EAGAIN : AVERROR_EXTERNAL;
+        } else {
+            *video_x = stats.video_rect.x;
+            *video_y = stats.video_rect.y;
+            *video_width = stats.video_rect.width;
+            *video_height = stats.video_rect.height;
+        }
+    }
+    SDL_UnlockMutex(ffp->pres_mutex);
+    return ret;
+}
