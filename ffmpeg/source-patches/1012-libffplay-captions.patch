+static int decoder_start(Decoder *d, int stream_index, int (*fn)(void *),
+                         const char *thread_name, void *arg)
+{
+    int ret;
+
+    packet_queue_start(d->queue, stream_index);
+    ret = decoder_start_thread(d, fn, thread_name, arg);
+    if (ret < 0) {
+        packet_queue_abort(d->queue);
+        packet_queue_flush(d->queue);
+    }
+    return ret;
+}
