+static void ffp_overlay_sample_rgba(const FFPOverlayRect *r, double sx, double sy, float rgba[4])
+{
+    int x0, y0, x1, y1, k;
+    double fx, fy, alpha = 0.0, premul[3] = { 0, 0, 0 };
+    double weights[4];
+    const uint8_t *px[4];
+    if (sx < 0) sx = 0;
+    if (sy < 0) sy = 0;
+    if (sx > r->width - 1) sx = r->width - 1;
+    if (sy > r->height - 1) sy = r->height - 1;
+    x0 = (int)floor(sx); y0 = (int)floor(sy);
+    x1 = FFMIN(x0 + 1, r->width - 1); y1 = FFMIN(y0 + 1, r->height - 1);
+    fx = sx - x0; fy = sy - y0;
+    weights[0] = (1.0 - fx) * (1.0 - fy);
+    weights[1] = fx * (1.0 - fy);
+    weights[2] = (1.0 - fx) * fy;
+    weights[3] = fx * fy;
+    px[0] = r->rgba + (size_t)y0 * r->stride + (size_t)x0 * 4;
+    px[1] = r->rgba + (size_t)y0 * r->stride + (size_t)x1 * 4;
+    px[2] = r->rgba + (size_t)y1 * r->stride + (size_t)x0 * 4;
+    px[3] = r->rgba + (size_t)y1 * r->stride + (size_t)x1 * 4;
+    for (k = 0; k < 4; k++) {
+        double a = px[k][3] / 255.0;
+        alpha += weights[k] * a;
+        premul[0] += weights[k] * a * px[k][0];
+        premul[1] += weights[k] * a * px[k][1];
+        premul[2] += weights[k] * a * px[k][2];
+    }
+    rgba[3] = (float)alpha;
+    for (k = 0; k < 3; k++)
+        rgba[k] = alpha > 1e-8 ? (float)(premul[k] / alpha) : 0.0f;
+}
