+/* Test-only synchronous copy, called on the immediate-context owner while the
+ * presenter lock is held. It is disabled in normal playback. */
+static void ffp_overlay_capture_readback(FFPD3D11 *p, ID3D11Texture2D *bb, int w, int h)
+{
+    D3D11_TEXTURE2D_DESC td;
+    D3D11_MAPPED_SUBRESOURCE mapped;
+    size_t bytes;
+    int y;
+    if (!p->overlay_readback_enabled || !bb)
+        return;
+    if (!p->overlay_readback_staging || p->overlay_readback_stage_w != w || p->overlay_readback_stage_h != h) {
+        FFP_REL(p->overlay_readback_staging);
+        memset(&td, 0, sizeof(td));
+        td.Width = (UINT)w; td.Height = (UINT)h;
+        td.MipLevels = td.ArraySize = 1;
+        td.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+        td.SampleDesc.Count = 1;
+        td.Usage = D3D11_USAGE_STAGING;
+        td.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        if (FAILED(p->dev->lpVtbl->CreateTexture2D(p->dev, &td, NULL, &p->overlay_readback_staging)))
+            goto fail;
+        p->overlay_readback_stage_w = w;
+        p->overlay_readback_stage_h = h;
+    }
+    p->ctx->lpVtbl->CopyResource(p->ctx, (ID3D11Resource *)p->overlay_readback_staging, (ID3D11Resource *)bb);
+    if (FAILED(p->ctx->lpVtbl->Map(p->ctx, (ID3D11Resource *)p->overlay_readback_staging, 0, D3D11_MAP_READ, 0, &mapped)))
+        goto fail;
+    bytes = (size_t)w * 4u * (size_t)h;
+    if (bytes / 4u / (size_t)h != (size_t)w) {
+        p->ctx->lpVtbl->Unmap(p->ctx, (ID3D11Resource *)p->overlay_readback_staging, 0);
+        goto fail;
+    }
+    if (p->overlay_readback_capacity < bytes) {
+        uint8_t *new_data = av_realloc(p->overlay_readback_data, bytes);
+        if (!new_data) {
+            p->ctx->lpVtbl->Unmap(p->ctx, (ID3D11Resource *)p->overlay_readback_staging, 0);
+            goto fail;
+        }
+        p->overlay_readback_data = new_data;
+        p->overlay_readback_capacity = bytes;
+    }
+    for (y = 0; y < h; y++)
+        memcpy(p->overlay_readback_data + (size_t)y * w * 4,
+               (const uint8_t *)mapped.pData + (size_t)y * mapped.RowPitch, (size_t)w * 4);
+    p->overlay_readback_stride = w * 4;
+    p->ctx->lpVtbl->Unmap(p->ctx, (ID3D11Resource *)p->overlay_readback_staging, 0);
+    p->overlay_readback_w = w;
+    p->overlay_readback_h = h;
+    p->overlay_readback_valid = 1;
+    p->overlay_readback_rects = p->overlay_frame_rects;     /* seq and rects change together under cs */
+    p->overlay_readback_seq++;
+    return;
+fail:
+    p->overlay_readback_valid = 0;
+    InterlockedIncrement64(&p->overlay_readback_failures);
+}
+
+int ffp_d3d11_set_overlay(FFPD3D11 *p, int layer, const FFPOverlayLayer *overlay,
+                          char *err, size_t err_size)
+{
+    int ret;
+    if (!p || layer < 0 || layer >= FFP_OVERLAY_LAYER_COUNT) {
+        ffp_set_err(err, err_size, "invalid bitmap overlay target", E_INVALIDARG);
+        return -1;
+    }
+    EnterCriticalSection(&p->cs);
+    ret = ffp_overlay_cache_update(p, &p->overlay[layer], overlay, err, err_size);
+    LeaveCriticalSection(&p->cs);
+    return ret;
+}
+
+void ffp_d3d11_overlay_stats(const FFPD3D11 *p, FFPD3D11OverlayStats *out)
+{
+    int i;
+    if (!out) return;
+    memset(out, 0, sizeof(*out));
+    if (!p) return;
+    EnterCriticalSection((CRITICAL_SECTION *)&p->cs);
+    out->video_rect = p->overlay_video_rect;
+    for (i = 0; i < FFP_OVERLAY_LAYER_COUNT; i++) {
+        out->canvas_width[i] = p->overlay[i].canvas_width;
+        out->canvas_height[i] = p->overlay[i].canvas_height;
+        out->generation[i] = p->overlay[i].generation;
+    }
+    out->readback_seq = (uint64_t)p->overlay_readback_seq;
+    out->readback_rects = (uint64_t)p->overlay_readback_rects;
+    LeaveCriticalSection((CRITICAL_SECTION *)&p->cs);
+    out->cue_uploads = InterlockedCompareExchange64((LONG64 *)&p->overlay_cue_uploads, 0, 0);
+    out->rects_uploaded = InterlockedCompareExchange64((LONG64 *)&p->overlay_rects_uploaded, 0, 0);
+    out->cues_shown = InterlockedCompareExchange64((LONG64 *)&p->overlay_cues_shown, 0, 0);
+    out->rects_drawn = InterlockedCompareExchange64((LONG64 *)&p->overlay_rects_drawn, 0, 0);
+    out->draw_failures = InterlockedCompareExchange64((LONG64 *)&p->overlay_draw_failures, 0, 0);
+    out->readback_failures = InterlockedCompareExchange64((LONG64 *)&p->overlay_readback_failures, 0, 0);
+}
+
+void ffp_d3d11_readback_test_enable(FFPD3D11 *p, int enable)
+{
+    if (!p) return;
+    EnterCriticalSection(&p->cs);
+    p->overlay_readback_enabled = !!enable;
+    if (!enable) p->overlay_readback_valid = 0;
+    LeaveCriticalSection(&p->cs);
+}
+
+int ffp_d3d11_readback_last(FFPD3D11 *p, uint8_t **bgra, int *w, int *h,
+                            int *stride, char *err, size_t err_size)
+{
+    uint8_t *copy;
+    if (!p || !bgra || !w || !h || !stride) {
+        ffp_set_err(err, err_size, "invalid D3D11 readback arguments", E_INVALIDARG);
+        return -1;
+    }
+    *bgra = NULL;
+    EnterCriticalSection(&p->cs);
+    if (!p->overlay_readback_valid || !p->overlay_readback_data) {
+        LeaveCriticalSection(&p->cs);
+        ffp_set_err(err, err_size, "no composed back-buffer readback available", E_FAIL);
+        return -1;
+    }
+    copy = av_memdup(p->overlay_readback_data,
+                     (size_t)p->overlay_readback_stride * p->overlay_readback_h);
+    if (!copy) {
+        LeaveCriticalSection(&p->cs);
+        ffp_set_err(err, err_size, "readback allocation failed", E_OUTOFMEMORY);
+        return -1;
+    }
+    *bgra = copy;
+    *w = p->overlay_readback_w;
+    *h = p->overlay_readback_h;
+    *stride = p->overlay_readback_stride;
+    LeaveCriticalSection(&p->cs);
+    return 0;
+}
