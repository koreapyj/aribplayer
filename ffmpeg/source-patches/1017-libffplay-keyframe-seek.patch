+/* Ends the keyframe step in flight (loop thread). ffp_tick emits the final position event and then
+ * FFP_EVENT_KEYSEEK_DONE. moved: a keyframe was presented; its output / source PTS ride along. */
+static void ffp_kf_end(VideoState *is, int moved)
+{
+    FFPlayer *ffp = is->ffp;
+    if (!is->kf_pending)
+        return;
+    is->kf_pending = 0;
+    SDL_AtomicSet(&is->kf_noop, 0);
+    is->kf_land_key = moved ? is->kf_key_pts_s : NAN;
+    is->kf_land_disp = moved ? is->displayed_source_pts : NAN;
+    is->step_position_pending = 1;
+    ffp->kf_done_dir = is->kf_dir;
+    ffp->kf_done_moved = moved;
+    ffp->kf_done_position = moved && isfinite(is->displayed_video_pts) ?
+                            FFMAX(is->displayed_video_pts - is->start_off_s, 0) : NAN;
+    ffp->kf_done_key = moved && isfinite(is->displayed_source_pts) ?
+                       FFMAX(is->displayed_source_pts - is->start_off_s, 0) : NAN;
+    ffp->kf_done_pending = 1;
+}
+
+static void ffp_emit_keyseek_done(FFPlayer *ffp)
+{
+    char json[160];
+    snprintf(json, sizeof(json), "{\"direction\":%d,\"moved\":%d,\"position\":%.6f,\"key\":%.6f}",
+             ffp->kf_done_dir, ffp->kf_done_moved,
+             isfinite(ffp->kf_done_position) ? ffp->kf_done_position : -1.0,
+             isfinite(ffp->kf_done_key) ? ffp->kf_done_key : -1.0);
+    SDL_AtomicSet(&ffp->step_busy, 0);
+    ffp_emit(ffp, FFP_EVENT_KEYSEEK_DONE, json);
+}
