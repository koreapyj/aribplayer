+/* Caller holds dbg_mutex. type: 0 decoded, 1 filtered, 2 presented, 3 early-drop, 4 late-drop, 5 presenter-rejected, 6 audio. */
+static void ffp_dbg_trace_event_locked(FFPDebug *d, int type, int64_t count, double pts, int serial, int64_t at_us,
+                                      int dxgi_valid, uint32_t present_count, uint32_t sync_refresh_count,
+                                      uint64_t sync_qpc_time, uint64_t sync_gpu_time,
+                                      uint64_t gpu_total_us, uint64_t gpu_frames, uint64_t gpu_last_us)
+{
+    FFPDebugFrameEvent *e = &d->frame_trace[d->frame_trace_head];
+    e->type = type;
+    e->count = count;
+    e->pts = pts;
+    e->serial = serial;
+    e->at_us = at_us;
+    e->dxgi_valid = dxgi_valid;
+    e->dxgi_present_count = present_count;
+    e->dxgi_sync_refresh_count = sync_refresh_count;
+    e->dxgi_sync_qpc_time = sync_qpc_time;
+    e->dxgi_sync_gpu_time = sync_gpu_time;
+    e->d3d_gpu_total_us = gpu_total_us;
+    e->d3d_gpu_frames = gpu_frames;
+    e->d3d_gpu_last_us = gpu_last_us;
+    d->frame_trace_head = (d->frame_trace_head + 1) % FFP_FRAME_TRACE_RING;
+    if (d->frame_trace_count < FFP_FRAME_TRACE_RING)
+        d->frame_trace_count++;
+}
