+static int ffp_reverse_step_holding(VideoState *is)
+{
+    int state;
+    SDL_LockMutex(is->ffp->mutex);
+    state = is->reverse_step_state;
+    SDL_UnlockMutex(is->ffp->mutex);
+    return state == FFP_REVERSE_STEP_SEEKING || state == FFP_REVERSE_STEP_SCANNING ||
+           state == FFP_REVERSE_STEP_RETRY;
+}
+
+/* Ends the API step in flight (loop thread). ffp_tick emits the final position event and then FFP_EVENT_STEP_DONE. */
+static void ffp_api_step_end(VideoState *is, int moved)
+{
+    FFPlayer *ffp = is->ffp;
+    is->api_step_pending = 0;
+    SDL_AtomicSet(&is->api_step_active, 0);
+    is->step_position_pending = 1;
+    ffp->step_done_dir = is->api_step_dir;
+    ffp->step_done_moved = moved;
+    ffp->step_done_pending = 1;
+}
+
+static void ffp_emit_step_done(FFPlayer *ffp, int direction, int moved)
+{
+    char json[64];
+    snprintf(json, sizeof(json), "{\"direction\":%d,\"moved\":%d}", direction, moved);
+    SDL_AtomicSet(&ffp->step_busy, 0);
+    ffp_emit(ffp, FFP_EVENT_STEP_DONE, json);
+}
