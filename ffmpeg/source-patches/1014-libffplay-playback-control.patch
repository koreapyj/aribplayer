+static void ffp_dbg_drop_note(VideoState *is, int stage, double pts, int serial)
+{
+    FFPDebug *d = &is->dbg;
+    FFPDebugFrameMark *mark = stage == 0 ? &d->early_drop : stage == 1 ? &d->late_drop : &d->presenter_drop;
+    int64_t count;
+    int64_t now_us;
+    SDL_LockMutex(is->dbg_mutex);
+    if (stage == 2)
+        d->presenter_drop_count++;
+    count = stage == 0 ? is->frame_drops_early : stage == 1 ? is->frame_drops_late : d->presenter_drop_count;
+    now_us = av_gettime_relative();
+    mark->pts = pts;
+    mark->serial = serial;
+    mark->at_us = now_us;
+    ffp_dbg_trace_event_locked(d, stage + 3, count, pts, serial, now_us, 0, 0, 0, 0, 0, 0, 0, 0);
+    SDL_UnlockMutex(is->dbg_mutex);
+}
