+static void ffp_frame_gpu_timer_free(FFPD3D11 *p)
+{
+    int i;
+    for (i = 0; i < (int)(sizeof(p->frame_gpu_timers) / sizeof(p->frame_gpu_timers[0])); i++) {
+        FFP_REL(p->frame_gpu_timers[i].disjoint);
+        FFP_REL(p->frame_gpu_timers[i].begin);
+        FFP_REL(p->frame_gpu_timers[i].end);
+        p->frame_gpu_timers[i].pending = 0;
+    }
+}
+
+static int ffp_frame_gpu_timer_ensure(FFPD3D11 *p)
+{
+    D3D11_QUERY_DESC qd;
+    int i;
+    if (p->frame_gpu_timer_unavailable)
+        return -1;
+    for (i = 0; i < (int)(sizeof(p->frame_gpu_timers) / sizeof(p->frame_gpu_timers[0])); i++) {
+        FFPFrameGpuTimer *t = &p->frame_gpu_timers[i];
+        HRESULT hr;
+        if (t->disjoint && t->begin && t->end)
+            continue;
+        memset(&qd, 0, sizeof(qd));
+        qd.Query = D3D11_QUERY_TIMESTAMP_DISJOINT;
+        hr = p->dev->lpVtbl->CreateQuery(p->dev, &qd, &t->disjoint);
+        if (FAILED(hr)) goto fail;
+        qd.Query = D3D11_QUERY_TIMESTAMP;
+        hr = p->dev->lpVtbl->CreateQuery(p->dev, &qd, &t->begin);
+        if (FAILED(hr)) goto fail;
+        hr = p->dev->lpVtbl->CreateQuery(p->dev, &qd, &t->end);
+        if (FAILED(hr)) goto fail;
+    }
+    return 0;
+fail:
+    ffp_frame_gpu_timer_free(p);
+    p->frame_gpu_timer_unavailable = 1;
+    return -1;
+}
