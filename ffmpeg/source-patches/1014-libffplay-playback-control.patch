+        for (i = 0; i < 2; i++) {
+            const AVIndexEntry *e = avformat_index_get_entry(st, idx[i]);
+            int64_t land;
+            if (!e)
+                return 0;
+            cand_us[i] = av_rescale_q_rnd(e->timestamp, st->time_base, AV_TIME_BASE_Q, AV_ROUND_UP);
