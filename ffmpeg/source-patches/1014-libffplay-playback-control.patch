+    SDL_LockMutex(is->ffp->mutex);
+    reverse_state = is->reverse_step_state;
+    SDL_UnlockMutex(is->ffp->mutex);
+    SDL_LockMutex(is->dbg_mutex);
+    if (d->seek_debug_pending && (d->seek_debug_serial < 0 || d->seek_debug_serial == serial)) {
+        d->seek_keyframe_s = pts;
+        d->seek_debug_pending = 0;
+    }
+    /* the audio trim's keyframe: only the first frame of the flushed (post-seek) serial, never a late pre-seek frame */
+    if (isfinite(pts) && SDL_AtomicGet(&is->seek_audio_align_pending) && !SDL_AtomicGet(&is->seek_audio_keyframe_ready) &&
+        serial == SDL_AtomicGet(&is->seek_audio_video_serial)) {
+        SDL_AtomicSet(&is->seek_audio_video_pts_ms, (int)lrint(pts * 1000.0));
+        SDL_AtomicSet(&is->seek_audio_keyframe_ready, 1);
+    }
+    if (key_frame && isfinite(pts)) {
+        if (d->source_keyframe_serial == serial && isfinite(d->source_keyframe_s)) {
+            double interval = pts - d->source_keyframe_s;
+            if (interval > 0.0 && interval < 10.0)
+                d->seek_gop_s = interval;
+        }
+        d->source_keyframe_s = pts;
+        d->source_keyframe_serial = serial;
+    }
     SDL_UnlockMutex(is->dbg_mutex);
 }
 
