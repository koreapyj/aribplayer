+/*
+ * Build-time tool for the libffplay host: writes what is fixed by this FFmpeg + libffplay build (video filters with
+ * their pad formats and options, the decoder that carries each hwaccel, libffplay's build features) as X-macro calls
+ * that the host compiles in:
+ *   FFCAPS_VERSION("8.1.3-Jellyfin")
+ *   FFCAPS_FEATURE("hwframes_keep")
+ *   FFCAPS_DECODER("h264", "cuda", "h264")
+ *   FFCAPS_FILTER("ivtc_cuda", "list", ("cuda"), 1, ("tff", "cthresh"), 1)   name, formats, pix_fmts, options known,
+ *                                                                           options, hw_device
+ * No hardware device is created, so the output is the same on every machine.
+ *
+ *   ffcapsdump <output file>
+ */
+
+#include <stdio.h>
+#include <string.h>
+
+#include "libavutil/avutil.h"
+#include "libavutil/bprint.h"
+#include "libavutil/hwcontext.h"
+#include "libavutil/opt.h"
+#include "libavutil/pixdesc.h"
+#include "libavcodec/avcodec.h"
+#include "libavfilter/avfilter.h"
+#include "libavfilter/filters.h"
+
+/* libffplay features that do not depend on the machine (the probe adds presenter_d3d11 when the presenter works) */
+static const char *const caps_features[] = { "hwframes_keep", "presenter_params", "upload_hw_sink" };
+
+static void c_string(AVBPrint *bp, const char *str)
+{
+    const unsigned char *p = (const unsigned char *)(str ? str : "");
+
+    av_bprint_chars(bp, '"', 1);
+    for (; *p; p++) {
+        if (*p == '"' || *p == '\\')
+            av_bprintf(bp, "\\%c", *p);
+        else if (*p < 0x20 || *p >= 0x7f)
+            av_bprintf(bp, "\\x%02x\"\"", *p);
+        else
+            av_bprint_chars(bp, *p, 1);
+    }
+    av_bprint_chars(bp, '"', 1);
+}
+
+static const char *const caps_hw_suffixes[] = {
+    "_cuda", "_opencl", "_qsv", "_vaapi", "_vulkan", "_npp", "_d3d11", "_amf", "_vdpau", "_videotoolbox", "_vpp",
+};
+
+/* filters whose option names the planner needs although they are not hardware filters */
+static const char *const caps_option_filters[] = {
+    "fieldmatch", "decimate", "bwdif", "yadif", "transpose", "hflip", "vflip", "eq", "setpts", "null", "scale", "format",
+    "hwupload", "hwdownload", "hwmap", "hwupload_cuda", "tonemap", "fps", "pullup",
+};
+
+static int caps_str_in(const char *s, const char *const *list, int n)
+{
+    int i;
+    for (i = 0; i < n; i++)
+        if (!strcmp(s, list[i]))
+            return 1;
+    return 0;
+}
+
+static void caps_filters(AVBPrint *bp)
+{
+    const AVFilter *f;
+    void *it = NULL;
+
+    while ((f = av_filter_iterate(&it))) {
+        const enum AVPixelFormat *pf = NULL;
+        enum AVPixelFormat single[2] = { AV_PIX_FMT_NONE, AV_PIX_FMT_NONE };
+        const char *kind;
+        int nin = avfilter_filter_pad_count(f, 0), nout = avfilter_filter_pad_count(f, 1);
+        int hw = 0, k, ln = (int)strlen(f->name), with_options;
+
+        if (nin > 0) {
+            if (avfilter_pad_get_type(f->inputs, 0) != AVMEDIA_TYPE_VIDEO)
+                continue;
+        } else if (!((f->flags & AVFILTER_FLAG_DYNAMIC_INPUTS) && nout > 0 &&
+                     avfilter_pad_get_type(f->outputs, 0) == AVMEDIA_TYPE_VIDEO)) {
+            continue;                       /* source (inputs added at init time: only filters with video output count) */
+        }
+        if (nout == 0 && !(f->flags & AVFILTER_FLAG_DYNAMIC_OUTPUTS))
+            continue;
+
+        switch (fffilter(f)->formats_state) {
+        case FF_FILTER_FORMATS_PIXFMT_LIST:   kind = "list"; pf = fffilter(f)->formats.pixels_list; break;
+        case FF_FILTER_FORMATS_SINGLE_PIXFMT: kind = "list"; single[0] = fffilter(f)->formats.pix_fmt; pf = single; break;
+        case FF_FILTER_FORMATS_QUERY_FUNC:
+        case FF_FILTER_FORMATS_QUERY_FUNC2:   kind = "dynamic"; break;
+        case FF_FILTER_FORMATS_PASSTHROUGH:   kind = "any"; break;
+        default:                              kind = "dynamic"; break;
+        }
+        if (pf) {
+            for (k = 0; pf[k] != AV_PIX_FMT_NONE; k++) {
+                const AVPixFmtDescriptor *pd = av_pix_fmt_desc_get(pf[k]);
+                if (pd && (pd->flags & AV_PIX_FMT_FLAG_HWACCEL))
+                    hw = 1;
+            }
+        }
+        if (f->flags & AVFILTER_FLAG_HWDEVICE)
+            hw = 1;
+        for (k = 0; k < FF_ARRAY_ELEMS(caps_hw_suffixes); k++) {
+            int sl = (int)strlen(caps_hw_suffixes[k]);
+            if (ln > sl && !strcmp(f->name + ln - sl, caps_hw_suffixes[k]))
+                hw = 1;
+        }
+        if (!strncmp(f->name, "hwupload", 8) || !strncmp(f->name, "hwdownload", 10) || !strcmp(f->name, "hwmap"))
+            hw = 1;
+        with_options = hw || caps_str_in(f->name, caps_option_filters, FF_ARRAY_ELEMS(caps_option_filters));
+
+        av_bprintf(bp, "FFCAPS_FILTER(");
+        c_string(bp, f->name);
+        av_bprintf(bp, ", \"%s\", (", kind);
+        if (pf) {
+            for (k = 0; pf[k] != AV_PIX_FMT_NONE; k++) {
+                av_bprintf(bp, "%s", k ? ", " : "");
+                c_string(bp, av_get_pix_fmt_name(pf[k]));
+            }
+        }
+        av_bprintf(bp, "), %d, (", with_options);
+        if (with_options) {
+            const AVClass *cls = f->priv_class;
+            const AVOption *o = NULL;
+            int n = 0;
+
+            while (cls && (o = av_opt_next(&cls, o))) {
+                if (o->type == AV_OPT_TYPE_CONST)
+                    continue;
+                av_bprintf(bp, "%s", n++ ? ", " : "");
+                c_string(bp, o->name);
+            }
+        }
+        av_bprintf(bp, "), %d)\n", (f->flags & AVFILTER_FLAG_HWDEVICE) ? 1 : 0);
+    }
+}
+
+static int caps_has_hw(const AVCodec *codec, enum AVHWDeviceType type)
+{
+    const AVCodecHWConfig *cfg;
+    int i;
+    for (i = 0; (cfg = avcodec_get_hw_config(codec, i)); i++)
+        if ((cfg->methods & AV_CODEC_HW_CONFIG_METHOD_HW_DEVICE_CTX) && cfg->device_type == type)
+            return 1;
+    return 0;
+}
+
+/* the decoder that carries the hwaccel: the default decoder of the codec, else another one with that hw config */
+static const AVCodec *caps_find_decoder(enum AVCodecID id, enum AVHWDeviceType type)
+{
+    const AVCodec *dflt = avcodec_find_decoder(id), *c;
+    void *it = NULL;
+
+    if (dflt && caps_has_hw(dflt, type))
+        return dflt;
+    while ((c = av_codec_iterate(&it)))
+        if (c->id == id && av_codec_is_decoder(c) && c != dflt && caps_has_hw(c, type))
+            return c;
+    return NULL;
+}
+
+static void caps_decoders(AVBPrint *bp)
+{
+    static const struct { const char *name; enum AVCodecID id; } codecs[] = {
+        { "h264", AV_CODEC_ID_H264 }, { "hevc", AV_CODEC_ID_HEVC }, { "mpeg2video", AV_CODEC_ID_MPEG2VIDEO },
+        { "vp9", AV_CODEC_ID_VP9 }, { "av1", AV_CODEC_ID_AV1 }, { "vc1", AV_CODEC_ID_VC1 }, { "mpeg4", AV_CODEC_ID_MPEG4 },
+    };
+    static const char *const types[] = { "d3d11va", "cuda", "d3d12va", "dxva2" };
+    int t, c;
+
+    for (t = 0; t < FF_ARRAY_ELEMS(types); t++) {
+        enum AVHWDeviceType type = av_hwdevice_find_type_by_name(types[t]);
+        if (type == AV_HWDEVICE_TYPE_NONE)
+            continue;
+        for (c = 0; c < FF_ARRAY_ELEMS(codecs); c++) {
+            const AVCodec *dec = caps_find_decoder(codecs[c].id, type);
+            av_bprintf(bp, "FFCAPS_DECODER(");
+            c_string(bp, codecs[c].name);
+            av_bprintf(bp, ", ");
+            c_string(bp, types[t]);
+            av_bprintf(bp, ", ");
+            c_string(bp, dec ? dec->name : "");
+            av_bprintf(bp, ")\n");
+        }
+    }
+}
+
+int main(int argc, char **argv)
+{
+    AVBPrint bp;
+    FILE *out;
+    int i, ok;
+
+    if (argc != 2) {
+        fprintf(stderr, "usage: ffcapsdump <output file>\n");
+        return 2;
+    }
+    av_bprint_init(&bp, 0, AV_BPRINT_SIZE_UNLIMITED);
+    av_bprintf(&bp, "FFCAPS_VERSION(");
+    c_string(&bp, av_version_info());
+    av_bprintf(&bp, ")\n");
+    for (i = 0; i < FF_ARRAY_ELEMS(caps_features); i++) {
+        av_bprintf(&bp, "FFCAPS_FEATURE(");
+        c_string(&bp, caps_features[i]);
+        av_bprintf(&bp, ")\n");
+    }
+    caps_decoders(&bp);
+    caps_filters(&bp);
+    if (!av_bprint_is_complete(&bp)) {
+        av_bprint_finalize(&bp, NULL);
+        return 1;
+    }
+    out = fopen(argv[1], "wb");
+    ok = out && fwrite(bp.str, 1, bp.len, out) == bp.len;
+    if (out && fclose(out))
+        ok = 0;
+    av_bprint_finalize(&bp, NULL);
+    if (!ok) {
+        fprintf(stderr, "ffcapsdump: cannot write %s\n", argv[1]);
+        return 1;
+    }
+    return 0;
+}
