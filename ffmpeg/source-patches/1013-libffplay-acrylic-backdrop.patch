+        FAILED(cs_compile(compile, ffp_acrylic_blur_ps_source, "ps_5_0", &bsb, err, n)) ||
+        FAILED(cs_compile(compile, ffp_acrylic_composite_ps_source, "ps_5_0", &csb, err, n)))
