+static void ffp_acrylic_renderer_free(FFPAcrylicRenderer *r)
+{
+    if (!r) return;
+    CS_REL(r->sampler);
+    CS_REL(r->scissor_raster);
+    CS_REL(r->raster);
+    CS_REL(r->constants);
+    CS_REL(r->composite_ps);
+    CS_REL(r->blur_ps);
