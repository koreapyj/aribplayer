+        p->acrylic_small[0] && p->acrylic_small_srv[0] && p->acrylic_small_rtv[0] &&
+        p->acrylic_small[1] && p->acrylic_small_srv[1] && p->acrylic_small_rtv[1] &&
+        p->acrylic_noise && p->acrylic_noise_srv)
+        return 0;
