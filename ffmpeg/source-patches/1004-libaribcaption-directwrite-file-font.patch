+#if defined(_WIN32) && defined(ARIBCC_USE_DIRECTWRITE)
+static int aribcaption_has_file_font(const char *font)
+{
+    const char *fonts = font;
+
+    while (fonts && *fonts) {
+        char *font_family = av_get_token(&fonts, ",");
+        int has_file_font;
+
+        if (!font_family)
+            return AVERROR(ENOMEM);
+        has_file_font = av_strstart(font_family, "file:", NULL);
+        av_free(font_family);
+        if (has_file_font)
+            return 1;
+        if (*fonts)
+            fonts++;
+    }
+
+    return 0;
+}
+#endif
