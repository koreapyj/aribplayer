+/* the bind bits of a decoder pool that exist only because of AVD3D11VADeviceContext.decoder_bind_flags[_p010] */
+static UINT d3d11va_decoder_extra_flags(const AVD3D11VADeviceContext *device_hwctx, enum AVPixelFormat sw_format)
+{
+    UINT flags = sw_format == AV_PIX_FMT_P010 || sw_format == AV_PIX_FMT_P012 ?
+                 device_hwctx->decoder_bind_flags_p010 : device_hwctx->decoder_bind_flags;
+    return flags & ~device_hwctx->BindFlags;
+}
+
+/* CreateTexture2D for a decoder pool. A driver may reject the extra decoder bind bits at the real frame size: the
+ * texture is then created again without them and the pool keeps the plain flags (counted in decoder_bind_fallbacks). */
+static HRESULT d3d11va_create_decoder_texture(AVHWFramesContext *ctx, D3D11_TEXTURE2D_DESC *texDesc,
+                                              ID3D11Texture2D **tex)
+{
+    AVD3D11VADeviceContext *device_hwctx = ctx->device_ctx->hwctx;
+    D3D11VAFramesContext              *s = ctx->hwctx;
+    AVD3D11VAFramesContext        *hwctx = &s->p;
+    UINT drop = (texDesc->BindFlags & D3D11_BIND_DECODER) ?
+                d3d11va_decoder_extra_flags(device_hwctx, ctx->sw_format) & texDesc->BindFlags : 0;
+    HRESULT hr;
+
+    if (drop && device_hwctx->decoder_bind_test_fail > 0) {
+        device_hwctx->decoder_bind_test_fail--;
+        hr = E_FAIL;
+    } else {
+        hr = ID3D11Device_CreateTexture2D(device_hwctx->device, texDesc, NULL, tex);
+    }
+    if (FAILED(hr) && drop) {
+        av_log(ctx, AV_LOG_WARNING, "Could not create the decoder texture with bind flags 0x%x (%lx), "
+               "retrying without 0x%x\n", (unsigned)texDesc->BindFlags, (long)hr, (unsigned)drop);
+        texDesc->BindFlags &= ~drop;
+        hr = ID3D11Device_CreateTexture2D(device_hwctx->device, texDesc, NULL, tex);
+        if (SUCCEEDED(hr)) {
+            hwctx->BindFlags &= ~drop;
+            InterlockedIncrement((volatile LONG *)&device_hwctx->decoder_bind_fallbacks);
+        }
+    }
+    return hr;
+}
