+/*
+ * vf_ivtc_videotoolbox -- hardware inverse telecine (field-matching) through
+ * Metal compute, on VideoToolbox (CVPixelBuffer / IOSurface) frames.
+ *
+ * The Metal backend of the shared ivtc core (ivtc_common.c), for the zero-copy
+ * VideoToolbox decode -> Metal -> present/encode chain on macOS:
+ *   -hwaccel videotoolbox -hwaccel_output_format videotoolbox ... -vf ivtc_videotoolbox
+ *
+ * Every plane is bound through CVMetalTextureCache without a copy. All work
+ * goes through one in-order command queue; the only waits are the reads of the
+ * match accumulators (one per frame) and of the decimation diffs (one per
+ * 5-frame cycle), both from shared-storage buffers. Kernel parameters travel
+ * inline with each dispatch (setBytes), so a synth still in flight never
+ * races a later analysis.
+ */
+
+#include "libavutil/avassert.h"
+#include "libavutil/common.h"
+#include "libavutil/hwcontext.h"
+#include "libavutil/hwcontext_videotoolbox.h"
+#include "libavutil/mem.h"
+#include "libavutil/objc.h"
+#include "libavutil/opt.h"
+#include "libavutil/pixdesc.h"
+
+#include "avfilter.h"
+#include "filters.h"
+#include "ivtc.h"
+#include "metal/utils.h"
+#include "video.h"
+
+extern char ff_vf_ivtc_videotoolbox_metallib_data[];
+extern unsigned int ff_vf_ivtc_videotoolbox_metallib_len;
+
+#define DIV_UP(a, b) (((a) + (b) - 1) / (b))
+
+#define IVTC_VT_POOL_SIZE 16   // cycle + dec_prev + downstream refs, like ivtc_d3d11
+
+enum { PIPE_ABSDIFF, PIPE_DIFFMAP, PIPE_COMPARE, PIPE_DIFF, PIPE_WEAVE_Y, PIPE_WEAVE_UV, PIPE_NB };
+enum { BUF_D, BUF_F, BUF_CMP, BUF_DIFF, BUF_NB };
+enum { TEX_A_Y, TEX_B_Y, TEX_A_UV, TEX_B_UV, TEX_DST_Y, TEX_DST_UV, TEX_NB };
+
+// must match struct IvtcParams in metal/vf_ivtc_videotoolbox.metal
+typedef struct IvtcVTParams {
+    int   width;
+    int   height;
+    int   hf;
+    int   tff;
+    int   nbx;
+    int   out_offset;
+    int   first;
+    int   pad0;
+    float scale;
+    float maxval;
+    float pad1;
+    float pad2;
+} IvtcVTParams;
+
+typedef struct API_AVAILABLE(macos(10.11), ios(8.0)) IvtcVTContext {
+    IVTCContext ivtc;
+
+    AVBufferRef       *device_ref;
+    AVBufferRef       *input_frames_ref;
+    AVHWFramesContext *input_frames;
+
+    id<MTLDevice>               mtlDevice;
+    id<MTLLibrary>              mtlLibrary;
+    id<MTLCommandQueue>         mtlQueue;
+    id<MTLComputePipelineState> mtlPipeline[PIPE_NB];
+    id<MTLBuffer>               mtlBuffer[BUF_NB];   // D, F (private); cmp, diff (shared, read by the host)
+    id<MTLCommandBuffer>        mtlLast;             // most recently committed, not yet waited for
+    CVMetalTextureCacheRef      textureCache;
+
+    MTLPixelFormat fmt_y;        // per-plane texture formats of sw_format
+    MTLPixelFormat fmt_uv;
+
+    int   sw_format;             // enum AVPixelFormat
+    int   pad0;
+    float scale_fm;              // raw luma -> 0..255 (fieldmatch units)
+    float scale_diff;            // raw luma -> 0..1   (decimation units)
+    float maxval;                // UNORM -> raw container integer
+    float pad1;
+} IvtcVTContext API_AVAILABLE(macos(10.11), ios(8.0));
+
+// Using sizeof(IvtcVTContext) outside of an availability check will error
+// if we're targeting an older OS version, so we need to calculate the size ourselves
+// (we'll statically verify it's correct in ivtc_videotoolbox_init behind a check)
+#define IVTC_VT_CTX_SIZE (sizeof(IVTCContext) + sizeof(void*) * (3 + 3 + PIPE_NB + BUF_NB + 1 + 1) + \
+                          sizeof(MTLPixelFormat) * 2 + sizeof(int) * 2 + sizeof(float) * 4)
+
+// ---- helpers --------------------------------------------------------------
+
+static CVPixelBufferRef ivtc_vt_pixbuf(const AVFrame *frame)
+{
+    return (CVPixelBufferRef)frame->data[3];
+}
+
+// Y (plane 0) or UV (plane 1) texture of a frame; the CVMetalTextureRef keeps
+// the MTLTexture alive and must outlive the command buffer that reads it.
+static CVMetalTextureRef ivtc_vt_plane(AVFilterContext *avctx, const AVFrame *frame, int plane)
+    API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    IvtcVTContext *ctx = avctx->priv;
+    return ff_metal_texture_from_pixbuf(avctx, ctx->textureCache, ivtc_vt_pixbuf(frame), plane,
+                                        plane ? ctx->fmt_uv : ctx->fmt_y);
+}
+
+static void ivtc_vt_release(CVMetalTextureRef *refs, int n)
+{
+    for (int i = 0; i < n; i++) {
+        if (refs[i])
+            CFRelease(refs[i]);
+        refs[i] = NULL;
+    }
+}
+
+// One IVTC_WG x IVTC_WG threadgroup grid of `pipe` over the bound textures,
+// all four buffers and the inline parameters.
+static void ivtc_vt_dispatch(IvtcVTContext *ctx, id<MTLCommandBuffer> cb, int pipe,
+                             CVMetalTextureRef const tex[TEX_NB], const IvtcVTParams *params,
+                             int grid_x, int grid_y) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    id<MTLComputeCommandEncoder> enc = [cb computeCommandEncoder];
+    [enc setComputePipelineState:ctx->mtlPipeline[pipe]];
+    for (int i = 0; i < TEX_NB; i++)
+        if (tex[i])
+            [enc setTexture:CVMetalTextureGetTexture(tex[i]) atIndex:i];
+    for (int i = 0; i < BUF_NB; i++)
+        [enc setBuffer:ctx->mtlBuffer[i] offset:0 atIndex:i];
+    [enc setBytes:params length:sizeof(*params) atIndex:BUF_NB];
+    [enc dispatchThreadgroups:MTLSizeMake(grid_x, grid_y, 1)
+        threadsPerThreadgroup:MTLSizeMake(IVTC_WG, IVTC_WG, 1)];
+    [enc endEncoding];
+}
+
+// Commit, remember as the newest in-flight buffer; the texture refs are
+// released once the GPU is done with them.
+static void ivtc_vt_commit(IvtcVTContext *ctx, id<MTLCommandBuffer> cb,
+                           CVMetalTextureRef const tex[TEX_NB]) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    CVMetalTextureRef t0 = tex[0], t1 = tex[1], t2 = tex[2], t3 = tex[3], t4 = tex[4], t5 = tex[5];
+    [cb addCompletedHandler:^(id<MTLCommandBuffer> done) {
+        (void)done;
+        if (t0) CFRelease(t0);
+        if (t1) CFRelease(t1);
+        if (t2) CFRelease(t2);
+        if (t3) CFRelease(t3);
+        if (t4) CFRelease(t4);
+        if (t5) CFRelease(t5);
+    }];
+    [cb commit];
+    ff_objc_release(&ctx->mtlLast);
+    ctx->mtlLast = [cb retain];
+}
+
+// Block until the newest command buffer has executed; command buffers on one
+// queue complete in commit order, so everything older is done too.
+static int ivtc_vt_wait(AVFilterContext *avctx) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    IvtcVTContext *ctx = avctx->priv;
+    id<MTLCommandBuffer> cb = ctx->mtlLast;
+    if (!cb)
+        return 0;
+    [cb waitUntilCompleted];
+    if (cb.status == MTLCommandBufferStatusError) {
+        av_log(avctx, AV_LOG_ERROR, "Metal command buffer failed: %s\n",
+               cb.error ? cb.error.localizedDescription.UTF8String : "unknown error");
+        ff_objc_release(&ctx->mtlLast);
+        return AVERROR_EXTERNAL;
+    }
+    ff_objc_release(&ctx->mtlLast);
+    return 0;
+}
+
+static void ivtc_vt_sync(AVFilterContext *avctx)
+{
+    if (@available(macOS 10.11, iOS 8.0, *)) {
+        @autoreleasepool {
+            ivtc_vt_wait(avctx);
+        }
+    }
+}
+
+// ---- one-time GPU init (pipelines, score/diff buffers) --------------------
+
+static int ivtc_init_metal(AVFilterContext *avctx) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    IvtcVTContext *ctx = avctx->priv;
+    IVTCContext *s = &ctx->ivtc;
+    static const char *const names[PIPE_NB] = {
+        [PIPE_ABSDIFF]  = "fm_absdiff",
+        [PIPE_DIFFMAP]  = "fm_diffmap",
+        [PIPE_COMPARE]  = "fm_compare_accum",
+        [PIPE_DIFF]     = "ivtc_diff",
+        [PIPE_WEAVE_Y]  = "weave_y",
+        [PIPE_WEAVE_UV] = "weave_uv",
+    };
+    NSUInteger field_px = (NSUInteger)s->luma_w * s->luma_hf;
+    NSError *err = nil;
+    CVReturn cvret;
+    int i;
+
+    ctx->mtlDevice = MTLCreateSystemDefaultDevice();
+    if (!ctx->mtlDevice) {
+        av_log(avctx, AV_LOG_ERROR, "Unable to find Metal device\n");
+        return AVERROR_EXTERNAL;
+    }
+    av_log(avctx, AV_LOG_VERBOSE, "Using Metal device: %s\n", ctx->mtlDevice.name.UTF8String);
+
+    {
+        dispatch_data_t libData = dispatch_data_create(ff_vf_ivtc_videotoolbox_metallib_data,
+                                                       ff_vf_ivtc_videotoolbox_metallib_len, nil, nil);
+        ctx->mtlLibrary = [ctx->mtlDevice newLibraryWithData:libData error:&err];
+        dispatch_release(libData);
+    }
+    if (err || !ctx->mtlLibrary) {
+        av_log(avctx, AV_LOG_ERROR, "Failed to load Metal library: %s\n",
+               err ? err.description.UTF8String : "unknown error");
+        return AVERROR_EXTERNAL;
+    }
+
+    for (i = 0; i < PIPE_NB; i++) {
+        id<MTLFunction> fn = [ctx->mtlLibrary newFunctionWithName:[NSString stringWithUTF8String:names[i]]];
+        if (!fn) {
+            av_log(avctx, AV_LOG_ERROR, "Metal function %s not found\n", names[i]);
+            return AVERROR_EXTERNAL;
+        }
+        ctx->mtlPipeline[i] = [ctx->mtlDevice newComputePipelineStateWithFunction:fn error:&err];
+        [fn release];
+        if (err || !ctx->mtlPipeline[i]) {
+            av_log(avctx, AV_LOG_ERROR, "Failed to create Metal pipeline %s: %s\n", names[i],
+                   err ? err.description.UTF8String : "unknown error");
+            return AVERROR_EXTERNAL;
+        }
+        if (ctx->mtlPipeline[i].maxTotalThreadsPerThreadgroup < IVTC_WG * IVTC_WG) {
+            av_log(avctx, AV_LOG_ERROR, "Metal pipeline %s allows only %lu threads per group, need %d\n",
+                   names[i], (unsigned long)ctx->mtlPipeline[i].maxTotalThreadsPerThreadgroup,
+                   IVTC_WG * IVTC_WG);
+            return AVERROR_EXTERNAL;
+        }
+    }
+
+    ctx->mtlQueue = [ctx->mtlDevice newCommandQueue];
+    if (!ctx->mtlQueue) {
+        av_log(avctx, AV_LOG_ERROR, "Failed to create Metal command queue\n");
+        return AVERROR_EXTERNAL;
+    }
+
+    ctx->mtlBuffer[BUF_D]    = [ctx->mtlDevice newBufferWithLength:FFMAX(field_px, 1) * sizeof(uint32_t)
+                                                           options:MTLResourceStorageModePrivate];
+    ctx->mtlBuffer[BUF_F]    = [ctx->mtlDevice newBufferWithLength:FFMAX(field_px, 1) * sizeof(uint32_t)
+                                                           options:MTLResourceStorageModePrivate];
+    ctx->mtlBuffer[BUF_CMP]  = [ctx->mtlDevice newBufferWithLength:(NSUInteger)s->nwg * 6 * sizeof(float)
+                                                           options:MTLResourceStorageModeShared];
+    ctx->mtlBuffer[BUF_DIFF] = [ctx->mtlDevice newBufferWithLength:(NSUInteger)s->nwg * IVTC_CYCLE * sizeof(float)
+                                                           options:MTLResourceStorageModeShared];
+    for (i = 0; i < BUF_NB; i++) {
+        if (!ctx->mtlBuffer[i]) {
+            av_log(avctx, AV_LOG_ERROR, "Failed to create Metal buffer %d\n", i);
+            return AVERROR_EXTERNAL;
+        }
+    }
+    memset(ctx->mtlBuffer[BUF_DIFF].contents, 0, ctx->mtlBuffer[BUF_DIFF].length);
+
+    cvret = CVMetalTextureCacheCreate(NULL, NULL, ctx->mtlDevice, NULL, &ctx->textureCache);
+    if (cvret != kCVReturnSuccess) {
+        av_log(avctx, AV_LOG_ERROR, "Failed to create CVMetalTextureCache: %d\n", cvret);
+        return AVERROR_EXTERNAL;
+    }
+    return 0;
+}
+
+static int ivtc_vt_init_gpu(AVFilterContext *avctx)
+{
+    if (@available(macOS 10.11, iOS 8.0, *)) {
+        @autoreleasepool {
+            return ivtc_init_metal(avctx);
+        }
+    }
+    return AVERROR(ENOSYS);
+}
+
+// ---- GPU hooks ------------------------------------------------------------
+
+// compare_fields accumulators (C vs P) in three chained kernels, then one
+// blocking read of the per-group partials, summed here.
+static int ivtc_vt_match_accum(AVFilterContext *avctx, AVFrame *prevf, AVFrame *curf,
+                               AVFrame *nextf, int tff, double A[3], double B[3])
+{
+    IvtcVTContext *ctx = avctx->priv;
+    IVTCContext *s = &ctx->ivtc;
+    IvtcVTParams params = {
+        .width  = s->luma_w,
+        .height = s->luma_h,
+        .hf     = s->luma_hf,
+        .tff    = tff,
+        .nbx    = s->nwgx,
+        .scale  = ctx->scale_fm,
+        .maxval = ctx->maxval,
+    };
+    int w = s->luma_w, hf = s->luma_hf;
+    int ret, i;
+
+    (void)nextf;
+
+    if (@available(macOS 10.11, iOS 8.0, *)) {
+        @autoreleasepool {
+            CVMetalTextureRef tex[TEX_NB] = { NULL };
+            id<MTLCommandBuffer> cb;
+
+            tex[TEX_A_Y] = ivtc_vt_plane(avctx, curf, 0);
+            tex[TEX_B_Y] = ivtc_vt_plane(avctx, prevf, 0);
+            if (!tex[TEX_A_Y] || !tex[TEX_B_Y]) {
+                ivtc_vt_release(tex, TEX_NB);
+                return AVERROR_EXTERNAL;
+            }
+
+            cb = [ctx->mtlQueue commandBuffer];
+            if (hf > 0) {
+                ivtc_vt_dispatch(ctx, cb, PIPE_ABSDIFF, tex, &params, DIV_UP(w, IVTC_WG), DIV_UP(hf, IVTC_WG));
+                ivtc_vt_dispatch(ctx, cb, PIPE_DIFFMAP, tex, &params, DIV_UP(w, IVTC_WG), DIV_UP(hf, IVTC_WG));
+            }
+            ivtc_vt_dispatch(ctx, cb, PIPE_COMPARE, tex, &params, s->nwgx, s->nwgy);
+            ivtc_vt_commit(ctx, cb, tex);   // owns the texture refs from here
+            if ((ret = ivtc_vt_wait(avctx)) < 0)
+                return ret;
+
+            const float *cmp = ctx->mtlBuffer[BUF_CMP].contents;
+            for (i = 0; i < s->nwg; i++) {
+                A[0] += cmp[i*6+0]; A[1] += cmp[i*6+1]; A[2] += cmp[i*6+2];
+                B[0] += cmp[i*6+3]; B[1] += cmp[i*6+4]; B[2] += cmp[i*6+5];
+            }
+        }
+        return 0;
+    }
+    return AVERROR(ENOSYS);
+}
+
+// Weave the chosen match into dst (all planes), candidate geometry as in
+// opencl/ivtc.cl: C keeps cur; P/N keep cur's first field and borrow the
+// second from prev/next; B/U keep cur's second field and borrow the first.
+static int ivtc_vt_synth(AVFilterContext *avctx, AVFrame *dst, AVFrame *prev,
+                         AVFrame *cur, AVFrame *next, int tff, int match)
+{
+    IvtcVTContext *ctx = avctx->priv;
+    IVTCContext *s = &ctx->ivtc;
+    IvtcVTParams params = {
+        .width  = s->luma_w,
+        .height = s->luma_h,
+        .first  = tff ? 0 : 1,   // parity of the first (top) field rows
+    };
+    AVFrame *src_first, *src_second;
+
+    switch (match) {
+    case 1:  src_first = cur;  src_second = prev; break; // P
+    case 2:  src_first = cur;  src_second = next; break; // N
+    case 3:  src_first = prev; src_second = cur;  break; // B
+    case 4:  src_first = next; src_second = cur;  break; // U
+    default: src_first = cur;  src_second = cur;  break; // C
+    }
+
+    if (@available(macOS 10.11, iOS 8.0, *)) {
+        @autoreleasepool {
+            CVMetalTextureRef tex[TEX_NB] = { NULL };
+            id<MTLCommandBuffer> cb;
+            int i;
+
+            tex[TEX_A_Y]    = ivtc_vt_plane(avctx, src_first,  0);
+            tex[TEX_B_Y]    = ivtc_vt_plane(avctx, src_second, 0);
+            tex[TEX_A_UV]   = ivtc_vt_plane(avctx, src_first,  1);
+            tex[TEX_B_UV]   = ivtc_vt_plane(avctx, src_second, 1);
+            tex[TEX_DST_Y]  = ivtc_vt_plane(avctx, dst, 0);
+            tex[TEX_DST_UV] = ivtc_vt_plane(avctx, dst, 1);
+            for (i = 0; i < TEX_NB; i++) {
+                if (!tex[i]) {
+                    ivtc_vt_release(tex, TEX_NB);
+                    return AVERROR_EXTERNAL;
+                }
+            }
+
+            cb = [ctx->mtlQueue commandBuffer];
+            if (src_first == src_second) {
+                // C: a plain copy, on the GPU so it is ordered with the rest
+                id<MTLBlitCommandEncoder> blit = [cb blitCommandEncoder];
+                for (i = 0; i < 2; i++) {
+                    id<MTLTexture> from = CVMetalTextureGetTexture(tex[i ? TEX_A_UV : TEX_A_Y]);
+                    id<MTLTexture> to   = CVMetalTextureGetTexture(tex[i ? TEX_DST_UV : TEX_DST_Y]);
+                    [blit copyFromTexture:from sourceSlice:0 sourceLevel:0
+                             sourceOrigin:MTLOriginMake(0, 0, 0)
+                               sourceSize:MTLSizeMake(from.width, from.height, 1)
+                                toTexture:to destinationSlice:0 destinationLevel:0
+                        destinationOrigin:MTLOriginMake(0, 0, 0)];
+                }
+                [blit endEncoding];
+            } else {
+                ivtc_vt_dispatch(ctx, cb, PIPE_WEAVE_Y, tex, &params,
+                                 DIV_UP(s->luma_w, IVTC_WG), DIV_UP(s->luma_h, IVTC_WG));
+                ivtc_vt_dispatch(ctx, cb, PIPE_WEAVE_UV, tex, &params,
+                                 DIV_UP((s->luma_w + 1) >> 1, IVTC_WG), DIV_UP((s->luma_h + 1) >> 1, IVTC_WG));
+            }
+            ivtc_vt_commit(ctx, cb, tex);   // no wait: the core holds the input refs until the next read
+        }
+        CVBufferPropagateAttachments(ivtc_vt_pixbuf(cur), ivtc_vt_pixbuf(dst));
+        return 0;
+    }
+    return AVERROR(ENOSYS);
+}
+
+// ivtc_diff emits one abs-diff sum per 16x16 group into its slice; all
+// dispatches are enqueued first, then ONE blocking read of the whole buffer.
+static int ivtc_vt_diff_cycle(AVFilterContext *avctx, AVFrame *const a[IVTC_CYCLE],
+                              AVFrame *const b[IVTC_CYCLE], const float **sums, int *stride)
+{
+    IvtcVTContext *ctx = avctx->priv;
+    IVTCContext *s = &ctx->ivtc;
+    IvtcVTParams params = {
+        .width  = s->luma_w,
+        .height = s->luma_h,
+        .nbx    = s->nwgx,
+        .scale  = ctx->scale_diff,
+        .maxval = ctx->maxval,
+    };
+    int ret, i;
+
+    if (@available(macOS 10.11, iOS 8.0, *)) {
+        @autoreleasepool {
+            CVMetalTextureRef refs[IVTC_CYCLE][2] = { { NULL } };
+            id<MTLCommandBuffer> cb = [ctx->mtlQueue commandBuffer];
+
+            for (i = 0; i < IVTC_CYCLE; i++) {
+                CVMetalTextureRef tex[TEX_NB] = { NULL };
+                if (!b[i])
+                    continue;
+                refs[i][0] = ivtc_vt_plane(avctx, a[i], 0);
+                refs[i][1] = ivtc_vt_plane(avctx, b[i], 0);
+                if (!refs[i][0] || !refs[i][1]) {
+                    ret = AVERROR_EXTERNAL;
+                    goto fail;
+                }
+                tex[TEX_A_Y] = refs[i][0];
+                tex[TEX_B_Y] = refs[i][1];
+                params.out_offset = i * s->nwg;
+                ivtc_vt_dispatch(ctx, cb, PIPE_DIFF, tex, &params, s->nwgx, s->nwgy);
+            }
+            {
+                CVMetalTextureRef none[TEX_NB] = { NULL };
+                ivtc_vt_commit(ctx, cb, none);
+            }
+            ret = ivtc_vt_wait(avctx);
+        fail:
+            for (i = 0; i < IVTC_CYCLE; i++)
+                ivtc_vt_release(refs[i], 2);
+            if (ret < 0)
+                return ret;
+        }
+        *sums   = ctx->mtlBuffer[BUF_DIFF].contents;
+        *stride = s->nwg;
+        return 0;
+    }
+    return AVERROR(ENOSYS);
+}
+
+// ---- filter plumbing ------------------------------------------------------
+
+static int ivtc_config_input(AVFilterLink *inlink)
+{
+    FilterLink          *l = ff_filter_link(inlink);
+    AVFilterContext *avctx = inlink->dst;
+    IvtcVTContext     *ctx = avctx->priv;
+
+    if (!l->hw_frames_ctx) {
+        av_log(avctx, AV_LOG_ERROR, "ivtc_videotoolbox requires a VideoToolbox hardware frames "
+               "context on the input (decode with -hwaccel_output_format videotoolbox, "
+               "or insert hwupload).\n");
+        return AVERROR(EINVAL);
+    }
+
+    av_buffer_unref(&ctx->input_frames_ref);
+    ctx->input_frames_ref = av_buffer_ref(l->hw_frames_ctx);
+    if (!ctx->input_frames_ref)
+        return AVERROR(ENOMEM);
+    ctx->input_frames = (AVHWFramesContext*)ctx->input_frames_ref->data;
+    if (ctx->input_frames->format != AV_PIX_FMT_VIDEOTOOLBOX)
+        return AVERROR(EINVAL);
+    if (ctx->input_frames->sw_format != AV_PIX_FMT_NV12 &&
+        ctx->input_frames->sw_format != AV_PIX_FMT_P010) {
+        av_log(avctx, AV_LOG_ERROR, "ivtc_videotoolbox supports NV12 and P010 only, got %s\n",
+               av_get_pix_fmt_name(ctx->input_frames->sw_format));
+        return AVERROR(ENOSYS);
+    }
+
+    av_log(avctx, AV_LOG_INFO, "ivtc_videotoolbox: %dx%d sw_format %s.\n",
+           inlink->w, inlink->h, av_get_pix_fmt_name(ctx->input_frames->sw_format));
+    return 0;
+}
+
+static int ivtc_config_output(AVFilterLink *outlink)
+{
+    FilterLink           *l = ff_filter_link(outlink);
+    AVFilterContext  *avctx = outlink->src;
+    AVFilterLink    *inlink = avctx->inputs[0];
+    IvtcVTContext      *ctx = avctx->priv;
+    const AVPixFmtDescriptor *desc;
+    AVHWFramesContext *output_frames;
+    int ret;
+
+    av_assert0(ctx->input_frames);
+    ctx->sw_format = ctx->input_frames->sw_format;
+    if (ctx->sw_format == AV_PIX_FMT_P010) {
+        ctx->fmt_y  = MTLPixelFormatR16Unorm;
+        ctx->fmt_uv = MTLPixelFormatRG16Unorm;
+    } else {
+        ctx->fmt_y  = MTLPixelFormatR8Unorm;
+        ctx->fmt_uv = MTLPixelFormatRG8Unorm;
+    }
+
+    // luma scale for the kernels: same values as ivtc_cuda / ivtc_d3d11,
+    // applied to the whole container integer recovered from the UNORM read
+    desc = av_pix_fmt_desc_get(ctx->sw_format);
+    {
+        double maxval = (double)((1 << (desc->comp[0].depth + desc->comp[0].shift)) - 1);
+        ctx->maxval     = (float)maxval;
+        ctx->scale_fm   = (float)(255.0 / maxval);
+        ctx->scale_diff = (float)(1.0 / maxval);
+    }
+
+    av_buffer_unref(&ctx->device_ref);
+    ctx->device_ref = av_buffer_ref(ctx->input_frames->device_ref);
+    if (!ctx->device_ref)
+        return AVERROR(ENOMEM);
+
+    // own fixed-size output pool (same sw_format), so the woven frames can go
+    // straight to the presenter or encoder
+    av_buffer_unref(&l->hw_frames_ctx);
+    l->hw_frames_ctx = av_hwframe_ctx_alloc(ctx->device_ref);
+    if (!l->hw_frames_ctx)
+        return AVERROR(ENOMEM);
+    output_frames = (AVHWFramesContext*)l->hw_frames_ctx->data;
+    output_frames->format    = AV_PIX_FMT_VIDEOTOOLBOX;
+    output_frames->sw_format = ctx->sw_format;
+    output_frames->width     = inlink->w;
+    output_frames->height    = inlink->h;
+    ((AVVTFramesContext *)output_frames->hwctx)->color_range =
+        ((AVVTFramesContext *)ctx->input_frames->hwctx)->color_range;
+
+    if ((ret = ff_filter_init_hw_frames(avctx, outlink, IVTC_VT_POOL_SIZE)) < 0)
+        return ret;
+    ret = av_hwframe_ctx_init(l->hw_frames_ctx);
+    if (ret < 0) {
+        av_buffer_unref(&l->hw_frames_ctx);
+        av_log(avctx, AV_LOG_ERROR, "Failed to initialise VideoToolbox frame "
+               "context for output: %d\n", ret);
+        return ret;
+    }
+
+    outlink->w = inlink->w;
+    outlink->h = inlink->h;
+    return ff_ivtc_config_output_common(outlink);
+}
+
+static int ivtc_init(AVFilterContext *avctx)
+{
+    IvtcVTContext *ctx = avctx->priv;
+    IVTCContext *s = &ctx->ivtc;
+
+    if (@available(macOS 10.11, iOS 8.0, *)) {
+        // Ensure we calculated IVTC_VT_CTX_SIZE correctly
+        static_assert(IVTC_VT_CTX_SIZE == sizeof(IvtcVTContext), "Incorrect IVTC_VT_CTX_SIZE value!");
+    } else {
+        av_log(avctx, AV_LOG_ERROR, "Metal is not available on this OS version\n");
+        return AVERROR(ENOSYS);
+    }
+
+    ff_ivtc_init_common(avctx);
+    s->init        = ivtc_vt_init_gpu;
+    s->match_accum = ivtc_vt_match_accum;
+    s->synth       = ivtc_vt_synth;
+    s->diff_cycle  = ivtc_vt_diff_cycle;
+    s->sync        = ivtc_vt_sync;
+    return 0;
+}
+
+static av_cold void ivtc_uninit_metal(AVFilterContext *avctx) API_AVAILABLE(macos(10.11), ios(8.0))
+{
+    IvtcVTContext *ctx = avctx->priv;
+    int i;
+
+    ff_objc_release(&ctx->mtlLast);
+    for (i = 0; i < BUF_NB; i++)
+        ff_objc_release(&ctx->mtlBuffer[i]);
+    for (i = 0; i < PIPE_NB; i++)
+        ff_objc_release(&ctx->mtlPipeline[i]);
+    ff_objc_release(&ctx->mtlQueue);
+    ff_objc_release(&ctx->mtlLibrary);
+    ff_objc_release(&ctx->mtlDevice);
+    if (ctx->textureCache) {
+        CFRelease(ctx->textureCache);
+        ctx->textureCache = NULL;
+    }
+}
+
+static av_cold void ivtc_uninit(AVFilterContext *avctx)
+{
+    IvtcVTContext *ctx = avctx->priv;
+
+    ff_ivtc_uninit_common(avctx);   // syncs the GPU first
+    if (@available(macOS 10.11, iOS 8.0, *)) {
+        @autoreleasepool {
+            ivtc_uninit_metal(avctx);
+        }
+    }
+
+    av_buffer_unref(&ctx->device_ref);
+    av_buffer_unref(&ctx->input_frames_ref);
+    ctx->input_frames = NULL;
+}
