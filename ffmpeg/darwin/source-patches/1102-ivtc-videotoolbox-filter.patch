+/*
+ * Metal port of the field-matching / decimation kernels in d3d11/ivtc.hlsl
+ * (themselves a port of vf_ivtc_cuda.cu). Planes are UNORM textures (R8/RG8
+ * for NV12, R16/RG16 for P010); every analysis read is rounded back to the raw
+ * container integer and multiplied by `scale`, so the values match the CUDA
+ * and D3D11 paths (raw * scale): 0..255 luma units for the fieldmatch kernels,
+ * 0..1 for the decimation diff. Reads clamp to the plane edge. The weave
+ * kernels copy whole fields and need no rounding.
+ *
+ * Every kernel is dispatched in IVTC_WG x IVTC_WG threadgroups
+ * (dispatchThreadgroups, not dispatchThreads): the reductions assume exactly
+ * IVTC_NT threads per group and one output slot per group.
+ */
+
+#include <metal_stdlib>
+
+using namespace metal;
+
+#define IVTC_WG 16
+#define IVTC_NT (IVTC_WG * IVTC_WG)
+
+// must match IvtcVTParams in vf_ivtc_videotoolbox.m
+struct IvtcParams {
+    int   width;
+    int   height;
+    int   hf;
+    int   tff;
+    int   nbx;
+    int   out_offset;   // ivtc_diff: slice offset into diff_buf
+    int   first;        // weave: parity of the rows taken from tex_a
+    int   pad0;
+    float scale;
+    float maxval;       // UNORM -> raw container integer
+    float pad1;
+    float pad2;
+};
+
+// texture slots: 0 a_y, 1 b_y, 2 a_uv, 3 b_uv, 4 dst_y, 5 dst_uv
+// buffer slots:  0 D, 1 F, 2 cmp, 3 diff, 4 params
+
+static inline float px(texture2d<float, access::read> tex, int x, int y, constant IvtcParams &p)
+{
+    x = clamp(x, 0, p.width - 1);
+    y = clamp(y, 0, p.height - 1);
+    return round(tex.read(uint2(x, y)).x * p.maxval) * p.scale;
+}
+
+/* =====================================================================
+ * vf_fieldmatch compare_fields port (Stage 1: C-vs-P primary match).
+ * Works in 0..255 luma units so fieldmatch's integer thresholds (3,19,23,42)
+ * apply unchanged; "field rows" index the borrowed parity: borrowed image
+ * row yb = 2*fy + (tff?1:0).
+ * ===================================================================== */
+
+// |cur.borrowed - cand.borrowed| per borrowed field row -> D[fy*width + x] (0..255)
+kernel void fm_absdiff(texture2d<float, access::read> tex_a_y [[texture(0)]],
+                       texture2d<float, access::read> tex_b_y [[texture(1)]],
+                       device uint *D_buf                     [[buffer(0)]],
+                       constant IvtcParams &p                 [[buffer(4)]],
+                       uint2 id                               [[thread_position_in_grid]])
+{
+    int x  = id.x;
+    int fy = id.y;
+    if (x >= p.width || fy >= p.hf)
+        return;
+    int yb = 2 * fy + (p.tff ? 1 : 0);
+    float d = abs(px(tex_a_y, x, yb, p) - px(tex_b_y, x, yb, p));
+    D_buf[fy * p.width + x] = d > 255.0f ? 255u : (uint)(int)(d + 0.5f);
+}
+
+// build_diff_map: flag bits 1/2/4 per field-row diff magnitude + clustering.
+kernel void fm_diffmap(device const uint *D_buf [[buffer(0)]],
+                       device uint *F_buf       [[buffer(1)]],
+                       constant IvtcParams &p   [[buffer(4)]],
+                       uint2 id                 [[thread_position_in_grid]])
+{
+    int x  = id.x;
+    int fy = id.y;
+    int width = p.width, hf = p.hf;
+    int u, count;
+    if (x >= width || fy >= hf)
+        return;
+    F_buf[fy * width + x] = 0;
+    if (fy < 1 || fy >= hf - 1 || x < 1 || x >= width - 1)
+        return;
+    int diff = D_buf[fy * width + x];
+    if (diff <= 3)
+        return;
+    count = 0;
+    for (u = x - 1; u < x + 2 && count < 2; u++) {
+        count += D_buf[(fy - 1) * width + u] > 3;
+        count += D_buf[ fy      * width + u] > 3;
+        count += D_buf[(fy + 1) * width + u] > 3;
+    }
+    if (count <= 1)
+        return;
+    uint f = 1;
+    if (diff > 19) {
+        int upper = 0, lower = 0;
+        count = 0;
+        for (u = x - 1; u < x + 2 && count < 6; u++) {
+            if (D_buf[(fy - 1) * width + u] > 19) { count++; upper = 1; }
+            if (D_buf[ fy      * width + u] > 19)   count++;
+            if (D_buf[(fy + 1) * width + u] > 19) { count++; lower = 1; }
+        }
+        if (count > 3) {
+            if (upper && lower) {
+                f |= 1 << 1;
+            } else {
+                int upper2 = 0, lower2 = 0;
+                int ulo = max(x - 4, 0), uhi = min(x + 5, width);
+                for (u = ulo; u < uhi; u++) {
+                    if (fy >= 2      && D_buf[(fy - 2) * width + u] > 19) upper2 = 1;
+                    if (                D_buf[(fy - 1) * width + u] > 19) upper  = 1;
+                    if (                D_buf[(fy + 1) * width + u] > 19) lower  = 1;
+                    if (fy < hf - 2  && D_buf[(fy + 2) * width + u] > 19) lower2 = 1;
+                }
+                if ((upper && (lower || upper2)) || (lower && (upper || lower2)))
+                    f |= 1 << 1;
+                else if (count > 5)
+                    f |= 1 << 2;
+            }
+        }
+    }
+    F_buf[fy * width + x] = f;
+}
+
+// compare_fields accumulation for match1=C (cur, tex_a) vs match2=cand (tex_b).
+// Each group writes 6 partials: {Ac,Am,Aml, Bc,Bm,Bml} -> cmp_buf[blk*6 + 0..5].
+kernel void fm_compare_accum(texture2d<float, access::read> tex_a_y [[texture(0)]],
+                             texture2d<float, access::read> tex_b_y [[texture(1)]],
+                             device const uint *F_buf               [[buffer(1)]],
+                             device float *cmp_buf                  [[buffer(2)]],
+                             constant IvtcParams &p                 [[buffer(4)]],
+                             uint2 id                               [[thread_position_in_grid]],
+                             uint2 gid                              [[threadgroup_position_in_grid]],
+                             uint tid                               [[thread_index_in_threadgroup]])
+{
+    threadgroup float l[IVTC_NT * 6];
+    int x  = id.x;
+    int y  = id.y;
+    int width = p.width, height = p.height, hf = p.hf;
+    int kp = p.tff ? 0 : 1;              // kept parity
+    int bf = p.tff ? 1 : 0;              // borrowed parity
+    uint k, s;
+
+    float Ac = 0, Am = 0, Aml = 0, Bc = 0, Bm = 0, Bml = 0;
+    if (x >= 8 && x < width - 8 && (y & 1) == kp && y >= 2 && y < height - 2) {
+        float t1 = px(tex_a_y, x, y - 2, p) + 4.0f * px(tex_a_y, x, y, p) + px(tex_a_y, x, y + 2, p);
+        float a  = abs(3.0f * (px(tex_a_y, x, y - 1, p) + px(tex_a_y, x, y + 1, p)) - t1);
+        float b  = abs(3.0f * (px(tex_b_y, x, y - 1, p) + px(tex_b_y, x, y + 1, p)) - t1);
+        // mask flags at the two borrowed field rows adjacent to kept row y
+        int fa = (y - 1 - bf) >> 1, fb = (y + 1 - bf) >> 1;
+        uint m = 0;
+        if (fa >= 0 && fa < hf) m |= F_buf[fa * width + x];
+        if (fb >= 0 && fb < hf) m |= F_buf[fb * width + x];
+        if (a > 23.0f && (m & 1)) Ac += a;
+        if (a > 42.0f) { if (m & 2) Am += a; if (m & 4) Aml += a; }
+        if (b > 23.0f && (m & 1)) Bc += b;
+        if (b > 42.0f) { if (m & 2) Bm += b; if (m & 4) Bml += b; }
+    }
+
+    // planar layout l[k*NT + tid], same tree as the CUDA kernel
+    l[0*IVTC_NT+tid] = Ac; l[1*IVTC_NT+tid] = Am; l[2*IVTC_NT+tid] = Aml;
+    l[3*IVTC_NT+tid] = Bc; l[4*IVTC_NT+tid] = Bm; l[5*IVTC_NT+tid] = Bml;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (s = IVTC_NT / 2; s > 0; s >>= 1) {
+        if (tid < s)
+            for (k = 0; k < 6; k++)
+                l[k*IVTC_NT+tid] += l[k*IVTC_NT+tid+s];
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    if (tid == 0) {
+        uint blk = gid.y * p.nbx + gid.x;
+        for (k = 0; k < 6; k++)
+            cmp_buf[blk*6+k] = l[k*IVTC_NT];
+    }
+}
+
+/*
+ * Luma SAD between two frames for decimation duplicate detection. Each group
+ * writes its partial sum to diff_buf[out_offset + blk]; the host reduces.
+ */
+kernel void ivtc_diff(texture2d<float, access::read> tex_a_y [[texture(0)]],
+                      texture2d<float, access::read> tex_b_y [[texture(1)]],
+                      device float *diff_buf                 [[buffer(3)]],
+                      constant IvtcParams &p                 [[buffer(4)]],
+                      uint2 id                               [[thread_position_in_grid]],
+                      uint2 gid                              [[threadgroup_position_in_grid]],
+                      uint tid                               [[thread_index_in_threadgroup]])
+{
+    threadgroup float l[IVTC_NT];
+    int x = id.x;
+    int y = id.y;
+    uint s;
+
+    float d = 0.0f;
+    if (x < p.width && y < p.height)
+        d = abs(px(tex_a_y, x, y, p) - px(tex_b_y, x, y, p));
+
+    l[tid] = d;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (s = IVTC_NT / 2; s > 0; s >>= 1) {
+        if (tid < s)
+            l[tid] += l[tid + s];
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    if (tid == 0)
+        diff_buf[p.out_offset + gid.y * p.nbx + gid.x] = l[0];
+}
+
+/*
+ * Field weave: rows of parity `first` come from tex_a, the others from tex_b
+ * (the CUDA backend does this with pitched 2D copies).
+ */
+kernel void weave_y(texture2d<float, access::read>  tex_a_y [[texture(0)]],
+                    texture2d<float, access::read>  tex_b_y [[texture(1)]],
+                    texture2d<float, access::write> dst_y   [[texture(4)]],
+                    constant IvtcParams &p                  [[buffer(4)]],
+                    uint2 id                                [[thread_position_in_grid]])
+{
+    int x = id.x;
+    int y = id.y;
+    if (x >= p.width || y >= p.height)
+        return;
+    float v = (y & 1) == p.first ? tex_a_y.read(id).x : tex_b_y.read(id).x;
+    dst_y.write(float4(v, 0, 0, 0), id);
+}
+
+kernel void weave_uv(texture2d<float, access::read>  tex_a_uv [[texture(2)]],
+                     texture2d<float, access::read>  tex_b_uv [[texture(3)]],
+                     texture2d<float, access::write> dst_uv   [[texture(5)]],
+                     constant IvtcParams &p                   [[buffer(4)]],
+                     uint2 id                                 [[thread_position_in_grid]])
+{
+    int x = id.x;
+    int y = id.y;
+    if (x >= (p.width + 1) >> 1 || y >= (p.height + 1) >> 1)
+        return;
+    float2 v = (y & 1) == p.first ? tex_a_uv.read(id).xy : tex_b_uv.read(id).xy;
+    dst_uv.write(float4(v.x, v.y, 0, 0), id);
+}
