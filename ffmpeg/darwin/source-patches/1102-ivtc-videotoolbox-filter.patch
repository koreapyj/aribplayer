+static const AVFilterPad ivtc_videotoolbox_inputs[] = {
+    {
+        .name         = "default",
+        .type         = AVMEDIA_TYPE_VIDEO,
+        .config_props = &ivtc_config_input,
+    },
+};
+
+static const AVFilterPad ivtc_videotoolbox_outputs[] = {
+    {
+        .name         = "default",
+        .type         = AVMEDIA_TYPE_VIDEO,
+        .config_props = &ivtc_config_output,
+    },
+};
