+const FFFilter ff_vf_ivtc_videotoolbox = {
+    .p.name         = "ivtc_videotoolbox",
+    .p.description  = NULL_IF_CONFIG_SMALL("Inverse telecine (field matching) for VideoToolbox frames using Metal compute."),
+    .p.priv_class   = &ivtc_videotoolbox_class,
+    .p.flags        = AVFILTER_FLAG_HWDEVICE,
+    .priv_size      = IVTC_VT_CTX_SIZE,
+    .init           = &ivtc_init,
+    .uninit         = &ivtc_uninit,
+    .activate       = &ff_ivtc_activate,
+    FILTER_INPUTS(ivtc_videotoolbox_inputs),
+    FILTER_OUTPUTS(ivtc_videotoolbox_outputs),
+    FILTER_SINGLE_PIXFMT(AV_PIX_FMT_VIDEOTOOLBOX),
+    .flags_internal = FF_FILTER_FLAG_HWFRAME_AWARE,
+};
