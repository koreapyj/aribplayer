#include <winver.h>
#include "aribplayer_version.h"   // generated by CMake from ARIBPLAYER_VERSION

// Icon 1 is the exe's own icon (the first icon resource) and is loaded by App.cpp for the window class.
1 ICON "aribplayer.ico"   // assets/icon (on the resource include path)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ARIBPLAYER_VERSION_COMMAS
 PRODUCTVERSION ARIBPLAYER_VERSION_COMMAS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "ARIB Player contributors"
            VALUE "FileDescription", "ARIB Player"
            VALUE "FileVersion", ARIBPLAYER_VERSION_STRING
            VALUE "InternalName", "aribplayer"
            VALUE "OriginalFilename", "aribplayer.exe"
            VALUE "ProductName", "ARIB Player"
            VALUE "ProductVersion", ARIBPLAYER_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

#include "resource.h"
// THIRD-PARTY-NOTICES.txt (UTF-8, repo root, on the resource include path) shown by Settings > Open source licenses.
IDR_THIRD_PARTY_NOTICES RCDATA "THIRD-PARTY-NOTICES.txt"
